@model ACA360.Core.Models.PortalForgotPasswordViewModel
@{
    ViewBag.Title = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ACA360 Employee Portal</title>
    <link rel="stylesheet" href="~/css/material-icons.css">
    <link rel="stylesheet" href="~/css/CommonStyle.css">
    <link rel="stylesheet" href="~/css/fonts.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/css/loginstyle.css" rel="stylesheet" />

    <style>
        .floating-group {
            position: relative;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="login-form">
            <h1>Reset your <span class="text-warning">password</span></h1>
            <h5>Verify your identity to set a new password</h5>
            <br />

            <div asp-validation-summary="ModelOnly" class="text-warning mb-2"></div>

            <form asp-area="Portal" asp-controller="Account" asp-action="ForgotPassword" method="post">
                <div class="mb-3">
                    <div class="floating-group">
                        <input type="email" asp-for="Email" autofocus class="form-control" placeholder=" " required />
                        <label asp-for="Email" class="form-label">Work email</label>
                    </div>
                    <span asp-validation-for="Email" class="error-message"></span>
                </div>

                <div class="mb-3">
                    <div class="floating-group">
                        <input type="text" asp-for="Last4SSN" class="form-control" placeholder=" " maxlength="4" inputmode="numeric" required />
                        <label asp-for="Last4SSN" class="form-label">Last 4 digits of SSN</label>
                    </div>
                    <span asp-validation-for="Last4SSN" class="error-message"></span>
                </div>

                <div class="mb-3">
                    <div class="floating-group">
                        <input type="date" asp-for="DateOfBirth" class="form-control" placeholder=" " required />
                        <label asp-for="DateOfBirth" class="form-label">Date of birth</label>
                    </div>
                    <span asp-validation-for="DateOfBirth" class="error-message"></span>
                </div>

                <button type="submit" class="btn css-rsbo1m w-100 mb-2"><span class="material-icons">verified_user</span>&nbsp;Verify &amp; Continue</button>
            </form>

            <p class="mt-3 mb-0"><a asp-area="Portal" asp-controller="Account" asp-action="Login"><small>&larr; Back to sign in</small></a></p>
        </div>

        <div class="right-image d-none d-md-block"></div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
