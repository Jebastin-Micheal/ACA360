@using ACA360.Web.ViewComponents
@model ACA360.Web.Models.SystemSettingsViewModel
@{
    ViewData["Title"] = "System Settings";
}
@await Component.InvokeAsync("Breadcrumb", new {
pageTitle = "System Settings",
    items = new List<BreadcrumbItem>
{
    new BreadcrumbItem { Title = "Employer", Url = Url.Action("Index", "Employer"), IsActive = false },
    new BreadcrumbItem { Title = "System Settings", Url = "", IsActive = true }
}
})
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="card shadow p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3 class="mb-1"><i class="fa fa-sliders-h text-primary"></i> System Console</h3>
            <p class="text-muted mb-0">Manage platform configuration, security, and operations.</p>
        </div>
        <div>
            @if (Model.MaintenanceMode)
            {
                <span class="badge bg-danger fs-6"><i class="fa fa-lock"></i> Maintenance Mode ON</span>
            }
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-3 mb-4">
        <div class="card shadow">
            <div class="list-group list-group-flush" id="settingsTabs" role="tablist">
                <div class="list-group-item bg-light fw-bold text-uppercase small text-muted">Configuration</div>
                <a class="list-group-item list-group-item-action active" data-bs-toggle="list" href="#general"><i class="fa fa-globe me-2 text-primary"></i> General</a>
                <a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#smtp"><i class="fa fa-envelope me-2 text-warning"></i> Email (SMTP)</a>
                <a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#irs"><i class="fa fa-university me-2 text-danger"></i> IRS AIR</a>
                <!-- NEW: Filing Year Tab -->
                <a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#filingYear"><i class="fa fa-calendar-alt me-2 text-primary"></i> Filing Year & IRS Penalty Rates</a>
                <a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#api"><i class="fa fa-laptop-code me-2 text-success"></i> API</a>

                <div class="list-group-item bg-light fw-bold text-uppercase small text-muted mt-2">Operations</div>
                <a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#operations"><i class="fa fa-server me-2 text-info"></i> Maintenance</a>
                <a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#security"><i class="fa fa-shield-alt me-2 text-success"></i> Security</a>
                <a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#database"><i class="fa fa-database me-2 text-secondary"></i> Database</a>
                <a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#automation"><i class="fa fa-robot me-2 text-dark"></i> Automation</a>

                <div class="list-group-item bg-light fw-bold text-uppercase small text-muted mt-2">Audit</div>
                <a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#audit"><i class="fa fa-history me-2"></i> Audit Log</a>
                <a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#errorlog"><i class="fa fa-history me-2"></i> Error Log</a>
            </div>
        </div>
    </div>

    <div class="col-md-9">
        <div class="tab-content">

            <div class="tab-pane fade show active" id="general">
                <div class="card shadow p-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">General Settings</h5>
                    <form onsubmit="return saveSettings(event, this, '@Url.Action("SaveGeneralSettings")')">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Application Name</label>
                            <input asp-for="General.AppName" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Support Email</label>
                            <input asp-for="General.SupportEmail" class="form-control" />
                        </div>
                        <button type="submit" class="btn btn-primary"><i class="fa fa-save me-2"></i> Save Changes</button>
                    </form>
                </div>
            </div>

            <div class="tab-pane fade" id="smtp">
                <div class="card shadow p-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">SMTP Configuration</h5>
                    <form onsubmit="return saveSettings(event, this, '@Url.Action("SaveSmtpSettings")')">

                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label class="form-label">Host</label>
                                <input asp-for="Smtp.Host" class="form-control" placeholder="smtp.office365.com" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Port</label>
                                <input asp-for="Smtp.Port" class="form-control" placeholder="587" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Username</label>
                                <input asp-for="Smtp.Username" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Password</label>
                                <input asp-for="Smtp.Password" type="password" class="form-control" placeholder="••••••" />
                            </div>
                        </div>
                        <div class="form-check mb-3 ms-3">
                            <input asp-for="Smtp.EnableSsl" class="form-check-input" type="checkbox" />
                            <label class="form-check-label">Enable SSL</label>
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-outline-secondary" onclick="testSmtp()">
                                <i class="fa fa-plug me-2"></i> Test Connection
                            </button>
                            <button type="submit" class="btn btn-warning">
                                <i class="fa fa-save me-2"></i> Save SMTP
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="tab-pane fade" id="irs">
                <div class="card shadow p-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2 text-danger">IRS AIR Configuration</h5>
                    <form onsubmit="return saveSettings(event, this, '@Url.Action("SaveIrsSettings")')">

                        <div class="mb-3">
                            <label class="form-label">Transmitter Control Code (TCC)</label>
                            <input asp-for="Irs.Tcc" class="form-control font-monospace" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Transmitter EIN</label>
                            <input asp-for="Irs.TransmitterEin" class="form-control font-monospace" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Software ID</label>
                            <input asp-for="Irs.SoftwareId" class="form-control font-monospace" />
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-outline-secondary" onclick="testIrs()">
                                <i class="fa fa-check-circle me-2"></i> Validate Config
                            </button>
                            <button type="submit" class="btn btn-danger">
                                <i class="fa fa-save me-2"></i> Save IRS Config
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            <!-- NEW: Filing Year Tab Content -->
            <div class="tab-pane fade" id="filingYear">
                <div class="card shadow p-4" id="filingYearContainer">
                    @* Loaded via AJAX from FilingYearController *@
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary"></div>
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="api">
                <div class="card shadow p-4">
                    <div class="card-header">
                        <h5 class="fw-bold mb-3 border-bottom pb-2 text-success">API Management</h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="ToggleApi" method="post">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="apiSwitch"
                                       name="isEnabled" value="true" @(Model.IsApiEnabled ? "checked" : "")
                                       onchange="this.form.submit()">
                                <label class="form-check-label" for="apiSwitch">
                                    @if (Model.IsApiEnabled)
                                    {
                                        <span class="text-success">API Online</span>
                                    }
                                    else
                                    {

                                        <span class="text-danger">API Disabled (Maintenance Mode)</span>
                                    }
                                </label>
                            </div>
                            <small class="text-muted">Disabling this will immediately reject all external integration requests.</small>
                        </form>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="operations">
                <div class="card shadow p-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">System Operations</h5>

                    
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h6 class="fw-bold mb-0">Cache Management</h6>
                            <small class="text-muted">Clear server-side memory cache.</small>
                        </div>
                        <button id="btnClearCache" class="btn btn-outline-danger btn-sm"><i class="fa fa-trash me-1"></i> Clear</button>
                    </div>
                    <hr />

                    <div class="mb-3">
                        <h6 class="fw-bold">System Health</h6>
                        <button id="btnHealthCheck" class="btn btn-outline-primary btn-sm mb-2"><i class="fa fa-stethoscope me-1"></i> Run Diagnostics</button>
                        <div id="healthResults" class="p-2 bg-light rounded" style="display:none;"></div>
                    </div>
                    <hr />

                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-0 text-warning">Maintenance Mode</h6>
                            <small class="text-muted">Lock system for non-admins.</small>
                        </div>
                        <div class="form-check form-switch">
                            <input type="checkbox" id="maintenanceToggle" class="form-check-input" @(Model.MaintenanceMode ? "checked" : "") style="width: 3em; height: 1.5em;">
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="security">
                <div class="card shadow p-4">
                    @await Html.PartialAsync("_SecuritySettings", Model.Security)
                </div>
            </div>

            <div class="tab-pane fade" id="database">
                <div class="card shadow p-4">
                    @await Html.PartialAsync("_DatabaseSettings", Model.Database)
                </div>
            </div>

            <div class="tab-pane fade" id="automation">
                <div class="card shadow p-4">
                    @await Html.PartialAsync("_AutomationSettings", Model.Automation)
                </div>
            </div>

            <div class="tab-pane fade" id="audit">
                <div class="card shadow">
                    <div class="card-header border-bottom bg-light">
                        <h5 class="mb-3">Unified Audit Trail</h5>

                        <div class="row g-2">
                            <div class="col-md-3">
                                <input type="text" id="auditSearch" class="form-control form-control-sm" placeholder="Search logs..." onkeyup="debounceAuditLoad()">
                            </div>
                            <div class="col-md-2">
                                <select id="auditType" class="form-select form-select-sm" onchange="loadAuditPage(1)">
                                    <option value="All">All Activities</option>
                                    <option value="Email">Email</option>
                                    <option value="Portal Access">Portal Access</option>
                                    <option value="File Upload">File Upload</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <input type="date" id="auditStart" class="form-control form-control-sm" onchange="loadAuditPage(1)">
                            </div>
                            <div class="col-md-2">
                                <input type="date" id="auditEnd" class="form-control form-control-sm" onchange="loadAuditPage(1)">
                            </div>
                            <div class="col-md-3 text-end">
                                <button class="btn btn-sm btn-outline-secondary" onclick="loadAuditPage(1)"><i class="fa fa-sync me-2"></i> Refresh</button>
                                @* <button class="btn btn-sm btn-outline-primary" onclick="exportAudit()"><i class="fa fa-download"></i> Export</button> *@
                                <a href="@Url.Action("ExportAuditLogs", "System")" target="_blank" class="btn btn-sm btn-outline-primary">
                                    <i class="fa fa-file-excel me-1"></i> Export CSV
                                </a>
                            </div>
                        </div>
                    </div>

                    <div id="auditGridContainer" style="min-height: 200px;">
                        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="errorlog">

                <div class="row g-4 mb-4">
                    <div class="col-sm-6 col-xl-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-start justify-content-between">
                                    <div class="content-left">
                                        <span class="text-muted">Total Logs</span>
                                        <div class="d-flex align-items-end mt-2">
                                            <h4 class="mb-0 me-2" id="statTotalLogs">0</h4>
                                        </div>
                                    </div>
                                    <span class="badge bg-label-primary rounded p-2">
                                        <i class="bx bx-list-ul bx-sm"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-start justify-content-between">
                                    <div class="content-left">
                                        <span class="text-muted">Total Errors (All Time)</span>
                                        <div class="d-flex align-items-end mt-2">
                                            <h4 class="mb-0 me-2 text-danger" id="statTotalErrors">0</h4>
                                        </div>
                                    </div>
                                    <span class="badge bg-label-danger rounded p-2">
                                        <i class="bx bx-error-circle bx-sm"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-start justify-content-between">
                                    <div class="content-left">
                                        <span class="text-muted">Today's Errors</span>
                                        <div class="d-flex align-items-end mt-2">
                                            <h4 class="mb-0 me-2 text-warning" id="statTodayErrors">0</h4>
                                        </div>
                                    </div>
                                    <span class="badge bg-label-warning rounded p-2">
                                        <i class="bx bx-time bx-sm"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Data Table Card -->
                <div class="card shadow ui-table-responsive">

                    <!-- Header with Toggle Button -->
                    <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">System Error Logs</h5>
                        <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#customFilterCollapse" aria-expanded="false" aria-controls="customFilterCollapse">
                            <i class="bx bx-filter-alt me-1"></i> Advanced Filters
                        </button>
                    </div>

                    <!-- Collapsible Custom Filters -->
                    <div class="collapse" id="customFilterCollapse">
                        <div class="card-body border-bottom bg-lighter">
                            <div class="row g-3 align-items-end">
                                @* <div class="col-md-3">
                         <label class="form-label">Level</label>
                         <select id="customFilterLevel" class="form-select form-select-sm">
                             <option value="">All Levels</option>
                             <option value="Info">Info</option>
                             <option value="Error">Error</option>
                             <option value="Fatal">Fatal</option>
                         </select>
                     </div> *@
                                <div class="col-md-3">
                                    <label class="form-label">Start Date</label>
                                    <input type="date" id="customFilterStartDate" class="form-control form-control-sm">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">End Date</label>
                                    <input type="date" id="customFilterEndDate" class="form-control form-control-sm">
                                </div>
                                <div class="col-md-3">
                                    <div class="d-flex gap-2">
                                        <button id="btnRefreshErrors" class="btn btn-primary btn-sm flex-grow-1">
                                            <i class="bx bx-check me-1"></i> Apply
                                        </button>
                                        <button id="btnClearFilters" class="btn btn-outline-secondary btn-sm flex-grow-1">
                                            <i class="bx bx-reset me-1"></i> Reset
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-datatable table-responsive pt-0">
                        <!-- Added Sneat styling classes: table-bordered, table-hover, table-striped -->
                        <table class="datatables-basic table table-bordered table-hover table-striped ui-table" id="errorLogDataTable">
                            <thead>
                                <tr>
                                    <th style="width: 40px;"></th>
                                    <th>Level</th>
                                    <th>Type</th>
                                    <th>Message</th>
                                    <th>IP Address</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Move the Modal Shell here -->
<div class="modal fade" id="FilingYearFormModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="FilingYearFormModalLabel"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card"><div class="card-body form-body"></div></div>
            </div>
            <div class="modal-footer py-3">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="filingYearForm" class="btn btn-primary form_save">Save</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        // --- GENERIC SAVE HANDLER ---
        function saveSettings(e, form, url) {
                e.preventDefault();
            var formData = $(form).serialize();

            // Show loading state if button exists
            var btn = $(form).find('button[type="submit"]');
            var originalText = btn.html();
            btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Saving...');

                $.post(url, formData)
        .done(function (res) {
            btn.prop('disabled', false).html(originalText);
            if (res.success) {
                Swal.fire({ title: "Saved", text: res.message, icon: "success", timer: 1500, showConfirmButton: false });
            } else {
                Swal.fire("Error", res.message || "Failed to save settings.", "error");
            }
        })
        .fail(function () {
            btn.prop('disabled', false).html(originalText);
            Swal.fire("Error", "An error occurred while saving settings.", "error");
        });
            return false;
        }

        // --- EXISTING HANDLERS (Preserved) ---
        $("#btnClearCache").click(() => {
            Swal.fire({ title: "Clear Cache?", icon: "warning", showCancelButton: true, confirmButtonText: "Yes" })
                .then(r => r.isConfirmed && $.post("/System/ClearCache", res => Swal.fire("Success", res.message, "success")));
        });

        $("#btnHealthCheck").click(() => {
            $("#healthResults").show().html(`<div class="spinner-border text-primary"></div> Running diagnostics...`);
            $.get("/System/HealthCheck", res => {
                let html = "<ul class='list-group list-group-flush'>";
                Object.keys(res).forEach(k => {
                    let badge = res[k] === "Healthy" || res[k] === "Online" ? "success" : "danger";
                    html += `<li class='list-group-item d-flex justify-content-between align-items-center'>
                                ${k} <span class='badge bg-${badge}'>${res[k]}</span>
                             </li>`;
                });
                html += "</ul>";
                $("#healthResults").html(html);
            });
        });

                // Maintenance Toggle
        $("#maintenanceToggle").change(function () {

            const checkbox = $(this);
            const enabled = checkbox.is(":checked");

            // Ask for confirmation
            Swal.fire({
                title: "Are you sure?",
                text: `You are about to turn maintenance mode ${enabled ? "ON" : "OFF"}.`,
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes",
                cancelButtonText: "No"
            }).then(result => {

                // If user clicked "No", revert toggle
                if (!result.isConfirmed) {
                    checkbox.prop("checked", !enabled);
                    return;
                }

                // // Update label text
                // checkbox.closest(".switch").find(".switch-label").text(enabled ? "Enabled" : "Disabled");

                // Send update request
                $.post("/System/ToggleMaintenanceMode", { enabled }, res => {
                    Swal.fire("Updated", res.message, "success");
                    setTimeout(() => location.reload(), 1000);
                });
            });

        });


        // Add handlers for Database/Automation/Security save buttons if they use IDs in their partials
        // (Ensure IDs in partials match what you expect here if you move logic out of partial scripts)
    </script>
    <script>
        var currentSortCol = 'Time';
        var currentSortDir = 'DESC';

        // Initial Load
        $(document).ready(function() {
            // Only load if this tab is active (Optimization)
            $('a[data-bs-toggle="list"][href="#audit"]').on('shown.bs.tab', function (e) {
                 loadAuditPage(1);
            });
        });

        function loadAuditPage(page) {
            $("#auditGridContainer").css("opacity", "0.5");

            var request = {
                Page: page,
                PageSize: 10,
                Search: $("#auditSearch").val(),
                ActivityType: $("#auditType").val(),
                StartDate: $("#auditStart").val(),
                EndDate: $("#auditEnd").val(),
                SortColumn: currentSortCol,
                SortDirection: currentSortDir
            };

            $.get('@Url.Action("GetAuditLogPartial", "System")', request, function(html) {
                $("#auditGridContainer").html(html).css("opacity", "1");
            });
        }

        // Debounce Search (Wait 500ms after typing stops)
        var timeout = null;
        function debounceAuditLoad() {
            clearTimeout(timeout);
            timeout = setTimeout(function () {
                loadAuditPage(1);
            }, 500);
        }

        function sortAudit(col) {
            if(currentSortCol === col) {
                currentSortDir = (currentSortDir === 'ASC' ? 'DESC' : 'ASC');
            } else {
                currentSortCol = col;
                currentSortDir = 'ASC';
            }
            loadAuditPage(1);
        }

        function exportAudit() {
            // Implement CSV export logic later
            toastr.info("Export feature coming soon.");
        }
            function testSmtp() {
            var btn = $(event.target).closest('button');
            var originalText = btn.html();
            btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Testing...');

            $.post('@Url.Action("TestSmtp")', function(res) {
                btn.prop('disabled', false).html(originalText);
                if(res.success) Swal.fire("Success", res.message, "success");
                else Swal.fire("Connection Failed", res.message, "error");
            });
        }

        function testIrs() {
            $.post('@Url.Action("TestIrsConfig")', function(res) {
                if(res.success) Swal.fire("Valid", res.message, "success");
                else Swal.fire("Invalid Configuration", res.message, "error");
            });
        }
                // Load irsPenalty
        $('a[href="#irsPenalty"]').on('shown.bs.tab', function () {
            loadPenaltyTab();
        });

        function loadPenaltyTab(year = null) {
            var url = '@Url.Action("GetIrsPenaltyRates")';
            if(year) {
                url += '?yearFilter=' + year;
            }

            $.get(url, function(html) {
                $('#penaltyContainer').html(html);
                // If a filter was applied, persist the value in the input after reload
                if(year) $('#yearFilterInput').val(year);
            });
        }
    </script>
    <script>
        $(document).ready(function () {
            $('a[data-bs-toggle="list"][href="#errorlog"]').on('shown.bs.tab', function (e) {

                loadErrorStats(); // Load top cards

                if (!$.fn.DataTable.isDataTable('#errorLogDataTable')) {

                    var dt = $('#errorLogDataTable').DataTable({
                        serverSide: true,
                        processing: true,
                        ajax: {
                            url: '@Url.Action("GetErrorLogsDataTables", "System")',
                            type: 'POST',
                            data: function (d) {
                                // Pass custom filters to the server
                                d.customLevel = $('#customFilterLevel').val();
                                d.startDate = $('#customFilterStartDate').val();
                                d.endDate = $('#customFilterEndDate').val();
                            }
                            },
                            // 1. Removes the "Show entries" text, leaving only the dropdown
                         language:
                         {
                              lengthMenu: '_MENU_',
                              search: '',
                              searchPlaceholder: 'Search...'
                         },

                        columns: [
                            {
                                className: 'details-control text-center',
                                orderable: false,
                                data: null,
                                defaultContent: '<i class="bx bx-chevron-right text-primary fs-4 cursor-pointer"></i>'
                            },
                            {
                                data: 'level',
                                name: 'Level',
                                render: function (data) {
                                    if (data === "Error" || data === "Fatal") return '<span class="badge bg-label-danger">' + data + '</span>';
                                    return '<span class="badge bg-label-info">' + data + '</span>';
                                }
                            },
                            { data: 'type', name: 'Type' },
                            { data: 'message', name: 'Message' },
                            { data: 'user_Ip', name: 'User_Ip' },
                            {
                                data: 'loggedOnDate',
                                name: 'LoggedOnDate',
                                render: function(data) {
                                    return new Date(data).toLocaleString([], { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute:'2-digit' });
                                }
                            }
                        ],
                        order: [[5, 'desc']],
                        // Sneat-specific DOM layout formatting
                        dom:
                            '<"row mx-2 pt-3 pb-2"' +
                                '<"col-md-6 d-flex align-items-center justify-content-start gap-3"f l>' +
                                '<"col-md-6 d-flex align-items-center justify-content-end"B>' +
                            '>t' +
                            '<"row mx-2 pt-3 pb-3"' +
                                '<"col-md-6"i>' +
                                '<"col-md-6 d-flex justify-content-end"p>' +
                            '>',
                        buttons: [
                            {
                                extend: 'collection',
                                className: 'btn btn-label-primary me-2',
                                text: '<i class="bx bx-export me-1"></i>Export',
                                buttons: [
                                    { extend: 'print', className: 'dropdown-item' },
                                    { extend: 'csv', className: 'dropdown-item' },
                                    { extend: 'excel', className: 'dropdown-item' },
                                    { extend: 'pdf', className: 'dropdown-item' }
                                ]
                            },
                            {
                                extend: 'colvis',
                                className: 'btn btn-label-secondary',
                                text: '<i class="bx bx-show me-1"></i>Columns',
                                columnText: function (dt, idx, title) {
                                    return '<span class="text-truncate">' + title + '</span>';}
                            }
                        ],
                        displayLength: 10,
                        lengthMenu: [10, 25, 50, 100],
                        // Ensures pagination utilizes Bootstrap 5 / Sneat rounded styling
                        classes: {
                            sPageButton: 'paginate_button page-item',
                            sPageButtonActive: 'active',
                        }
                    });

                    // Expand / Collapse Arrow Event Fix
                    $('#errorLogDataTable tbody').on('click', 'td.details-control', function () {
                        var tr = $(this).closest('tr');
                        var row = dt.row(tr);
                        var icon = $(this).find('i');

                        if (row.child.isShown()) {
                            row.child.hide();
                            tr.removeClass('shown');
                            icon.removeClass('bx-chevron-down').addClass('bx-chevron-right');
                        } else {
                            var d = row.data();
                            var childHtml =
                                '<div class="p-3 bg-lighter rounded text-start border">' +
                                    '<strong>Call Site:</strong> ' + (d.callSite || 'N/A') + '<br/>' +
                                    '<strong class="mt-2 d-block">Stack Trace:</strong>' +
                                    '<pre class="bg-dark text-white p-3 mt-1 rounded" style="max-height: 250px; overflow-y: auto;"><small>' + (d.stackTrace || 'No stack trace.') + '</small></pre>' +
                                '</div>';
                            row.child(childHtml).show();
                            tr.addClass('shown');
                            icon.removeClass('bx-chevron-right').addClass('bx-chevron-down');
                        }
                    });

                     // Apply Filters Button
            $('#btnRefreshErrors').on('click', function() {
                dt.ajax.reload();
                loadErrorStats(); // Update the top cards
            });

            // Reset Filters Button
            $('#btnClearFilters').on('click', function() {
                // Clear all custom inputs
                $('#customFilterLevel').val('');
                $('#customFilterStartDate').val('');
                $('#customFilterEndDate').val('');

                // Clear the default DataTables search box
                dt.search('');

                // Reload the table and stats
                dt.ajax.reload();
                loadErrorStats();
            });
                }
            });
        });

        // Function to populate the top summary cards
        function loadErrorStats() {
            $.get('@Url.Action("GetErrorStats", "System")', function(data) {
                $('#statTotalLogs').text(data.totalLogs);
                $('#statTotalErrors').text(data.totalErrors);
                $('#statTodayErrors').text(data.todayErrors);
            });
        }

    </script>

    <!-- Existing system scripts -->
    <script src="~/js/common-grid.js"></script>
    <script>
        // Trigger the fetch when the Filing Year tab is clicked
        $('a[data-bs-toggle="list"][href="#filingYear"]').on('shown.bs.tab', function () {

            // 1. Prevent reloading if we've already fetched the table
            if ($('#filingYearContainer').find('table').length > 0) return;

            // 2. Fetch HTML from the SYSTEM controller
            $.get('@Url.Action("FilingYearListPartial", "System")', {
                pageIndex: 1,
                PageSize: 10,
                search: '',
                sortColumn: 0,
                sortOrder: 'asc'
            }, function (html) {

                // 3. Inject the HTML
                $('#filingYearContainer').html(html);

                // 4. Initialize GridManager pointing to the SYSTEM controller
                GridManager.init({
                    url: '@Url.Action("FilingYearListPartial", "System")', // FIXED URL
                    container: '#filingYearContainer',
                    loadingContainer: '#loader',
                    cookieName: 'view_mode_filingyears',
                    state: {
                        pageIndex: 1,
                        pageSize: 10,
                        search: '',
                        sortColumn: 0,
                        sortOrder: 'asc'
                    }
                });

            }).fail(function() {
                $('#filingYearContainer').html('<div class="text-danger text-center py-4">Error loading Filing Year data.</div>');
            });
        });

        // 5. Update CRUD URLs to target /System/ instead of /FilingYear/
        $(document).on('click', '#add_FilingYear_controls', function () {
            $.ajax({
                type: "POST",
                url: '/System/Add_New', // FIXED URL
                success: function (data) {
                    $('#FilingYearFormModal .form-body').html(data);
                    $('#FilingYearFormModalLabel').text('Add New');
                    $('#FilingYear_Id').val(0);
                    new bootstrap.Modal(document.getElementById('FilingYearFormModal')).show();
                }
            });
        });

        $(document).on('click', '.edit-filingyear-btn', function () {
            $.ajax({
                type: 'GET',
                url: '/System/GetFilingYear_by_ID', // FIXED URL
                data: { id: String($(this).data('id')) },
                success: function (data) {
                    $('#FilingYearFormModal .form-body').html(data);
                    $('#FilingYearFormModalLabel').text('Edit');
                    new bootstrap.Modal(document.getElementById('FilingYearFormModal')).show();
                }
            });
        });

                 // Remove the red border dynamically ONLY if the value is not empty and not zero
        $(document).on('input change', '#filingYearForm :input[required]', function () {
            var val = $(this).val().trim();
            if (val !== "" && parseFloat(val) !== 0) {
                $(this).removeClass('border-danger');
            } else {
                $(this).addClass('border-danger');
            }
        });

        $(document).on('click', '.form_save', function (e) {
            e.preventDefault();
            var $form = $('#filingYearForm');
            var isValid = true;

                // 1. Loop through all required fields to check if they are empty OR zero
        $form.find(':input[required]').each(function () {
            var val = $(this).val().trim();

            if (val === "" || parseFloat(val) === 0) {
                // Apply ONLY a red border, no text message
                $(this).addClass('border-danger');
                isValid = false;
            } else {
                $(this).removeClass('border-danger');
            }
        });

            // 2. If any required field is empty, stop the submission completely
            if (!isValid) {
                return false;
            }

            // 3. If valid, proceed with the SweetAlert confirmation
            Swal.fire({
                title: 'Confirm Save?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save it!',
                target: document.getElementById('FilingYearFormModal')
            }).then((result) => {
                if (result.isConfirmed) {
                    var formData = {
                        FilingYear: {
                            Id: $('#FilingYear_Id').val(),
                            Year: $('#Year').val(),
                            FpgPremium: $('#FpgPremium').val(),
                            FpgPercent: $('#FpgPercent').val(),
                            RopHours: $('#RopHours').val(),
                            OfferPercent: $('#OfferPercent').val(),
                            PenaltyAAnnual: $('#PenaltyAAnnual').val(),
                            PenaltyBAnnual: $('#PenaltyBAnnual').val(),
                            IsActive: $('#IsActive').val() === "true"
                        }
                    };

                    $.ajax({
                        type: "POST",
                        url: '/System/AddOrUpdate',
                        data: formData,
                        success: function (res) {
                            if (res.success) {
                                Swal.fire({ icon: 'success', title: 'Success', text: res.message, timer: 2000, showConfirmButton: false })
                                    .then(() => { $('#FilingYearFormModal').modal('hide'); GridManager.reload(); });
                            } else {
                                Swal.fire({ icon: 'error', title: 'Error', text: res.message, target: document.getElementById('FilingYearFormModal') });
                            }
                        }
                    });
                }
            });
        });


    </script>
}