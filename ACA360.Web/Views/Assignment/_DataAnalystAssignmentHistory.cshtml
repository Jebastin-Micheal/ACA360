@using ACA360.Core.Models
@model List<DataAnalystAssignment>
<style>
    .avatar-sm {
        width: 36px;
        height: 36px;
    }

    .avatar-lg {
        width: 80px;
        height: 80px;
    }

    .badge {
        padding: 0.35em 0.65em;
        font-size: 0.75em;
    }

    .table th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    .table td {
        vertical-align: middle;
    }
</style>
<div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
        <div class="modal-header bg-primary text-white">
            <h5 class="modal-title">
                <i class="fas fa-history me-2"></i>Data Analyst Assignment History
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        @if (Model != null && Model.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-striped">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Data Analyst</th>
                                            <th>Assigned By</th>
                                            <th>Start Date</th>
                                            <th>End Date</th>
                                            <th>Duration</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var assignment in Model)
                                        {
                                            var duration = "";
                                            if (assignment.EndDate.HasValue)
                                            {
                                                var timeSpan = assignment.EndDate.Value - assignment.StartDate;
                                                duration = $"{timeSpan.Days} days";
                                            }
                                            else if (assignment.IsActive)
                                            {
                                                var timeSpan = DateTime.UtcNow - assignment.StartDate;
                                                duration = $"{timeSpan.Days} days (ongoing)";
                                            }

                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="avatar-sm bg-info rounded-circle d-flex align-items-center justify-content-center me-2">
                                                            <i class="fas fa-user-chart text-white fs-6"></i>
                                                        </div>
                                                        <div>
                                                            <span class="fw-medium">@assignment.DataAnalystName</span>
                                                            <div class="text-muted small">ID: @assignment.Analyst_UserID</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="avatar-sm bg-secondary rounded-circle d-flex align-items-center justify-content-center me-2">
                                                            <i class="fas fa-user-shield text-white fs-6"></i>
                                                        </div>
                                                        <div>
                                                            <span class="fw-medium">@assignment.AssignedByAdmin</span>
                                                            <div class="text-muted small">Admin ID: @assignment.AssignedBy_AdminID</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="d-flex flex-column">
                                                        <span class="fw-medium">@assignment.StartDate.ToString("MMM dd, yyyy")</span>
                                                        <span class="text-muted small">@assignment.StartDate.ToString("hh:mm tt")</span>
                                                    </div>
                                                </td>
                                                <td>
                                                    @if (assignment.EndDate.HasValue)
                                                    {
                                                        <div class="d-flex flex-column">
                                                            <span class="fw-medium">@assignment.EndDate.Value.ToString("MMM dd, yyyy")</span>
                                                            <span class="text-muted small">@assignment.EndDate.Value.ToString("hh:mm tt")</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-info">Current Assignment</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark border">@duration</span>
                                                </td>
                                                <td>
                                                    @if (assignment.IsActive && !assignment.EndDate.HasValue)
                                                    {
                                                        <span class="badge bg-success">
                                                            <i class="fas fa-check-circle me-1"></i>Active
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">
                                                            <i class="fas fa-times-circle me-1"></i>Inactive
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                        }

                                    </tbody>
                                </table>
                            </div>

                            <div class="mt-4">
                                <h6 class="text-muted mb-3">
                                    <i class="fas fa-chart-line me-2"></i>Assignment Summary
                                </h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="card border-0 bg-light">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <h6 class="text-muted mb-1">Total Assignments</h6>
                                                        <h4 class="mb-0">@Model.Count</h4>
                                                    </div>
                                                    <div class="avatar-sm bg-primary rounded-circle d-flex align-items-center justify-content-center">
                                                        <i class="fas fa-list-ol text-white fs-4"></i>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="card border-0 bg-light">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <h6 class="text-muted mb-1">Current Analyst</h6>
                                                        @{
                                                            var currentAssignment = Model.FirstOrDefault(a => a.IsActive && !a.EndDate.HasValue);
                                                        }
                                                        @if (currentAssignment != null)
                                                        {
                                                            <h4 class="mb-0">@currentAssignment.DataAnalystName</h4>
                                                        }
                                                        else
                                                        {
                                                            <h4 class="mb-0 text-danger">Unassigned</h4>
                                                        }
                                                    </div>
                                                    <div class="avatar-sm bg-success rounded-circle d-flex align-items-center justify-content-center">
                                                        <i class="fas fa-user-check text-white fs-4"></i>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <div class="avatar-lg mx-auto mb-4 bg-light rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="fas fa-history text-muted fs-1"></i>
                                </div>
                                <h5 class="text-muted mb-3">No Assignment History Found</h5>
                                <p class="text-muted mb-0">This employer hasn't been assigned to any data analysts yet.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer py-3">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                <i class="fas fa-times me-1"></i>Close
            </button>
            @if (Model != null && Model.Any())
            {
                <button type="button" class="btn btn-outline-primary" onclick="exportToExcel()">
                    <i class="fas fa-download me-1"></i>Export
                </button>
            }
        </div>
    </div>
</div>



<script>
    function exportToExcel() {
        // Implement export functionality
       // console.log('Exporting data analyst assignment history to Excel');

        // You can implement AJAX call to export endpoint here
        $.ajax({
            url: '@Url.Action("ExportDataAnalystAssignmentHistory", "DataAnalyst")',
            type: 'POST',
            data: { employerId: @Model?.FirstOrDefault()?.EmployerID ?? 0 },
            xhrFields: {
                responseType: 'blob'
            },
            success: function (blob) {
                var link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                link.download = 'DataAnalyst_Assignment_History.xlsx';
                link.click();
            },
            error: function () {
                showToast('Error', 'Failed to export data', 'error');
            }
        });
    }
</script>