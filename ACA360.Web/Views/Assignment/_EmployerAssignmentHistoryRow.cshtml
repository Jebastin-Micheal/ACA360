@using ACA360.Core.Models
@model EmployerAssignmentHistoryItem
@{
    // Day math on calendar dates, not raw timestamps: Jul 02 -> Jul 03 = 1 day
    // (timestamp subtraction floors to 0 days when under 24 hours).
    var endForCalc = (Model.EndDate ?? DateTime.UtcNow).Date;
    int days = (endForCalc - Model.StartDate.Date).Days;
    string daysText = days == 1 ? "1 day" : $"{days} days";

    string period = Model.StartDate.ToString("MMM dd, yyyy")
                    + " - "
                    + (Model.EndDate.HasValue ? Model.EndDate.Value.ToString("MMM dd, yyyy") : "Present")
                    + $" ({daysText})";
}
<tr>
    <td>
        <span class="fw-medium">@(string.IsNullOrWhiteSpace(Model.StaffName) ? $"User #{Model.StaffUserID}" : Model.StaffName)</span>
    </td>
    <td>
        @(string.IsNullOrWhiteSpace(Model.AssignedByName) ? "-" : Model.AssignedByName)
    </td>
    <td>
        <span class="text-nowrap">@period</span>
    </td>
    <td>
        @if (Model.IsActive && !Model.EndDate.HasValue)
        {
            <span class="badge bg-success"><i class="bx bx-check-circle me-1"></i>Active</span>
        }
        else
        {
            <span class="badge bg-secondary"><i class="bx bx-x-circle me-1"></i>Inactive</span>
        }
    </td>
</tr>
