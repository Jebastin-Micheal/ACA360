@using ACA360.Core.Models.ACA360.Core.Models
@model IEnumerable<PdfTemplate>
@using ACA360.Web.ViewComponents
@{
    ViewData["Title"] = "Manage PDF Templates";
}
@await Component.InvokeAsync("Breadcrumb", new {
pageTitle = "Manage PDF Templates",
    items = new List<BreadcrumbItem>
{
    new BreadcrumbItem { Title = "Employer", Url = Url.Action("Index", "Employer"), IsActive = false },
    new BreadcrumbItem { Title = "Master Settings", Url = "", IsActive = false },
    new BreadcrumbItem { Title = "IRS Templates", Url = "", IsActive = true }
}
})
<div class="card mb-6">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">IRS Form Templates</h5>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#uploadModal">
            <i class='bx bx-upload me-1'></i> Upload New Template
        </button>
    </div>
    <div class="table-responsive text-nowrap ui-table-responsive">
        <table class="table table-hover ui-table">
            <thead>
                <tr>
                    <th>Tax Year</th>
                    <th>Form Type</th>
                    <th>File Name</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center py-4">No templates found. Upload one to get started.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="badge bg-label-primary">@item.TaxYear</span></td>
                        <td><strong>@item.FormType</strong></td>
                        <td>@item.FileName</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Archived</span>
                            }
                        </td>
                        <td>
                            <!-- Primary Action: Map Fields -->
                            <a asp-action="MapFields" asp-route-id="@item.TemplateId" title="Map Fields">
                                <i class="icon-base bx bx-map-alt bg-info icon-md"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.TemplateId" title="Map Fields">
                                <i class="icon-base bx bx-edit icon-sm bg-info fs-4 text-secondary"></i>
                            </a>
                            <!-- Secondary Actions Dropdown -->
                            <a href="javascript:;" class="btn btn-icon dropdown-toggle hide-arrow action-dots-btn" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="icon-base bx bx-dots-vertical-rounded icon-md"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end m-0">                            
                                <!-- Delete Action -->
                                <form asp-action="Delete" asp-route-id="@item.TemplateId" method="post"
                                      onsubmit="return confirm('Are you sure? This will delete the file and all mappings.');" class="m-0 p-0">
                                    <button type="submit" class="dropdown-item w-100 text-start">
                                        <i class="icon-base bx bx-trash bg-danger icon-md me-2"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="uploadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload IRS Template</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Upload" method="post" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label">Form Type</label>
                                    <select name="formType" class="form-select" required>
                                        <option value="1095-C">1095-C (Employee)</option>
                                        <option value="1094-C">1094-C (Transmittal)</option>
                                        <option value="1095-B">1095-B (Coverage)</option>
                                        <option value="1094-B">1094-B (Transmittal)</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Tax Year</label>
                                    <input type="number" name="taxYear" class="form-control" value="@(DateTime.Now.Year)" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Blank PDF File</label>
                                    <input type="file" name="file" class="form-control" accept=".pdf" required />
                                    <div class="form-text">Upload the official "Fillable" PDF from IRS.gov.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Upload</button>
                </div>
            </form>
        </div>
    </div>
</div>