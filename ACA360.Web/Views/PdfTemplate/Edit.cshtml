@using ACA360.Core.Models.ACA360.Core.Models
@model PdfTemplate

@{
    ViewData["Title"] = "Edit Template";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h4>Edit Template: @Model.FileName</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="TemplateId" />

                    <div class="mb-3">
                        <label asp-for="FormType" class="form-label">Form Type</label>
                        <select asp-for="FormType" class="form-select">
                            <option value="1095-C">1095-C</option>
                            <option value="1094-C">1094-C</option>
                            <option value="1095-B">1095-B</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TaxYear" class="form-label">Tax Year</label>
                        <input asp-for="TaxYear" class="form-control" type="number" />
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">Active Template</label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>