@using ACA360.Core.Constants
@model ACA360.Core.Models.FilingDashboardViewModel
@using ACA360.Web.ViewComponents

@{
    ViewData["Title"] = "Filing Center";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var toolbarConfig = new
    {
        IsEmployerPage = false,
        CustomButtons = "" // Kept empty; Tax Year dropdown is placed in the header instead
    };
}

@await Component.InvokeAsync("Breadcrumb", new {
pageTitle = "Filing Center",
    items = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "Employer", Url = Url.Action("Index", "Employer"), IsActive = false },
        new BreadcrumbItem { Title = "Filing Center", Url = "", IsActive = true }
    }
})

<div id="FilingListContainerWrapper" style="position:relative;">

    <div id="loader" class="loader" style="display:none;">
        <div class="spinner"></div>
    </div>

    <div class="card mb-6">

        <div class="card-body">
            @{
                ViewBag.ShowFilterButton = false;
                ViewBag.ShowViewModeToggle = false;
            }


            <div class="row mb-4 g-3">
                <div class="col-md-3">
                    <div class="card shadow-sm h-100" style="cursor:pointer; border:1px solid #e0e0e0;" onclick="filterByStatus('')">
                        <div class="card-body d-flex justify-content-between align-items-start">
                            <div>
                                <div class="text-muted small mb-2">Total Employers</div>
                                <div class="h3 mb-0 fw-bold" id="summaryTotalCount">@Model.StatusSummary.TotalCount</div>
                            </div>
                            <div class="rounded d-flex align-items-center justify-content-center"
                                 style="width:44px;height:44px;background-color:#e7e9fd;">
                                <i class='bx bxs-briefcase' style="font-size:22px;color:#5b5fc7;"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm h-100" style="cursor:pointer; border:1px solid #e0e0e0;" onclick="filterByStatus('0')">
                        <div class="card-body d-flex justify-content-between align-items-start">
                            <div>
                                <div class="text-muted small mb-2">Not Started</div>
                                <div class="h3 mb-0 fw-bold text-secondary" id="summaryNotStartedCount">@Model.StatusSummary.NotStartedCount</div>
                            </div>
                            <div class="rounded d-flex align-items-center justify-content-center"
                                 style="width:44px;height:44px;background-color:#fde8e8;">
                                <i class='bx bx-edit-alt' style="font-size:22px;color:#e53e3e;"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm h-100" style="cursor:pointer; border:1px solid #e0e0e0;" onclick="filterByStatus('1')">
                        <div class="card-body d-flex justify-content-between align-items-start">
                            <div>
                                <div class="text-muted small mb-2">Draft Generated</div>
                                <div class="h3 mb-0 fw-bold text-info" id="summaryDraftCount">@Model.StatusSummary.DraftGeneratedCount</div>
                            </div>
                            <div class="rounded d-flex align-items-center justify-content-center"
                                 style="width:44px;height:44px;background-color:#d9f1ff;">
                                <i class='bx bxs-file-blank' style="font-size:22px;color:#0dcaf0;"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm h-100" style="cursor:pointer; border:1px solid #e0e0e0;" onclick="filterByStatus('2')">
                        <div class="card-body d-flex justify-content-between align-items-start">
                            <div>
                                <div class="text-muted small mb-2">Finalized / Locked</div>
                                <div class="h3 mb-0 fw-bold text-success" id="summaryFinalizedCount">@Model.StatusSummary.FinalizedCount</div>
                            </div>
                            <div class="rounded d-flex align-items-center justify-content-center"
                                 style="width:44px;height:44px;background-color:#d4f4dd;">
                                <i class='bx bxs-check-shield' style="font-size:22px;color:#28a745;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-primary view-tab-btn active" data-view="active">
                        <i class='bx bx-folder-open me-1'></i> Active Filings
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary view-tab-btn" data-view="archive">
                        <i class='bx bx-archive me-1'></i> Archive
                    </button>
                </div>

                <form method="get" class="d-flex align-items-center gap-2">
                    <label class="fw-semibold text-nowrap mb-0">Tax Year:</label>
                    <select id="filingYear" name="year" asp-for="SelectedYear" asp-items="ViewBag.Years"
                            class="form-select form-select-sm" style="width: 100px;"
                            onchange="this.form.submit()">
                    </select>
                </form>
            </div>

            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                <div class="flex-grow-1" style="min-width:280px;">
                    @await Html.PartialAsync("_GridToolbarCommon", toolbarConfig)
                </div>

                <div class="d-flex align-items-center gap-2" id="statusPillsRow">
                    <span class="fw-semibold text-nowrap">Status:</span>
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-sm btn-primary status-filter-btn active" data-status="">All</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary status-filter-btn" data-status="0">Not Started</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary status-filter-btn" data-status="1">Draft Generated</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary status-filter-btn" data-status="2">Finalized / Locked</button>
                    </div>
                </div>
            </div>


            <div class="row">
                <div id="FilingListContainer">
                    @await Html.PartialAsync("_FilingListPartial", Model)
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filing Timeline Modal -->
<div class="modal fade" id="filingTimelineModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class='bx bx-history me-1'></i> Filing Timeline
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="filingTimelineModalBody">
                <!-- AJAX content loads here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/common-grid.js"></script>

    <script>
        let currentView = 'active';
        let currentStatusFilter = -1;

               function filterByStatus(status) {
            if (currentView === 'archive') {
                $('.view-tab-btn').removeClass('btn-primary active').addClass('btn-outline-secondary');
                $('.view-tab-btn[data-view="active"]').removeClass('btn-outline-secondary').addClass('btn-primary active');
                currentView = 'active';
                $('#statusPillsRow').removeClass('d-none');
            }

            $('.status-filter-btn').removeClass('btn-primary active').addClass('btn-outline-secondary');
            $('.status-filter-btn[data-status="' + status + '"]').removeClass('btn-outline-secondary').addClass('btn-primary active');

            currentStatusFilter = (status === '') ? -1 : parseInt(status);
            GridManager.setPageIndex(1);
        }

        function filterByArchive() {
            $('.view-tab-btn[data-view="archive"]').click();
        }

        $(document).ready(function () {
            const currentYear = $('#filingYear').val();

            GridManager.init({
                url: '@Url.Action("FilingListPartial", "Filing")?year=' + currentYear,
                container: '#FilingListContainer',
                loadingContainer: '#loader',
                cookieName: 'view_mode_filings',
                state: {
                    pageIndex: @(Model.Metadata?.CurrentPage ?? 1),
                    pageSize: @(Model.Metadata?.PageSize ?? 10),
                    search: '@Html.Raw(Model.Search ?? "")',
                    sortColumn: '@Html.Raw(Model.SortColumn)',
                    sortOrder: '@Html.Raw(Model.SortOrder ?? "")',
                    viewMode: 'List'
                },
                additionalParams: function () {
                    return { statusFilter: currentStatusFilter };
                }
            });

            // Active Filings & Archive Tab Click
            $('.view-tab-btn').on('click', function () {
                $('.view-tab-btn').removeClass('btn-primary active').addClass('btn-outline-secondary');
                $(this).removeClass('btn-outline-secondary').addClass('btn-primary active');

                currentView = $(this).data('view');

                if (currentView === 'archive') {
                    currentStatusFilter = 99; // Archive filter flag
                    $('#statusPillsRow').addClass('d-none');
                } else {
                    currentStatusFilter = -1; // Active: All filings
                    $('#statusPillsRow').removeClass('d-none');
                    $('.status-filter-btn').removeClass('btn-primary active').addClass('btn-outline-secondary');
                    $('.status-filter-btn[data-status=""]').removeClass('btn-outline-secondary').addClass('btn-primary active');
                }

                GridManager.setPageIndex(1);
            });

            // Status Filter Click
            $('.status-filter-btn').on('click', function () {
                if (currentView === 'archive') return;

                $('.status-filter-btn').removeClass('btn-primary active').addClass('btn-outline-secondary');
                $(this).removeClass('btn-outline-secondary').addClass('btn-primary active');

                var selected = $(this).data('status');
                currentStatusFilter = (selected === '') ? -1 : parseInt(selected);

                GridManager.setPageIndex(1);
            });
        });

        // Archive / Unarchive Handler
        function toggleArchiveFiling(employerId, isArchive) {
            const actionText = isArchive ? "Archive" : "Unarchive";

            Swal.fire({
                title: `${actionText} Filing?`,
                text: `Are you sure you want to ${actionText.toLowerCase()} this filing?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: isArchive ? '#6c757d' : '#28a745',
                confirmButtonText: `Yes, ${actionText} it!`
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("ToggleArchive", "Filing")',
                        {
                            employerId: employerId,
                            year: $('#filingYear').val(),
                            isArchive: isArchive,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        function(res) {
                            if(res.success) {
                                toastr.success(res.message);
                                GridManager.reload();
                                location.reload();
                            } else {
                                toastr.error(res.message);
                            }
                        });
                }
            });
        }

        function finalizeFiling(id) {
            const employerId = String(id);
            Swal.fire({
                title: 'Finalize Filing?',
                text: "This will LOCK the data. No further uploads or code changes allowed. This version will be marked as Authoritative.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                confirmButtonText: 'Yes, Finalize it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("Finalize", "Filing")',
                        { employerId: employerId, year: $('#filingYear').val(), __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                        function(res) {
                            if(res.success) {
                                toastr.success(res.message);
                                GridManager.reload();
                                location.reload();
                            }
                            else { toastr.error(res.message); }
                        });
                }
            });
        }

        function unlockFiling(id) {
            const employerId = String(id);
            Swal.fire({
                title: 'ADMIN OVERRIDE: Unlock Filing?',
                text: "This will allow data changes. You should only do this if a correction is required before filing.",
                icon: 'error',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Yes, Unlock it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("Unlock", "Filing")',
                        { employerId: employerId, year: $('#filingYear').val(), __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                        function(res) {
                            if(res.success) {
                                toastr.warning(res.message);
                                GridManager.reload();
                                location.reload();
                            }
                            else { toastr.error(res.message); }
                        });
                }
            });
        }

        function showFilingTimeline(employerId, year) {
            $('#filingTimelineModalBody').html('<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>');
            var modal = new bootstrap.Modal(document.getElementById('filingTimelineModal'));
            modal.show();

            $.get('@Url.Action("Timeline", "Filing")', { employerId: employerId, year: year }, function (html) {
                $('#filingTimelineModalBody').html(html);
            }).fail(function () {
                $('#filingTimelineModalBody').html('<div class="text-center text-danger py-5">Failed to load timeline.</div>');
            });
        }

        function exportFilingCenterToExcel() {
            var year = $('#filingYear').val();
            window.location.href = '@Url.Action("ExportToExcel", "Filing")?year=' + year;
        }
    </script>
}