           <!-- Column 4: Filters -->
            <aside id="filterAsideWrapper" class="p-3 mt-0 border-start d-flex flex-column filter-panel-hidden bg-body" style="height: 75vh; transition: transform 0.3s ease-in-out, opacity 0.3s ease;">
                @await Html.PartialAsync("_FormEmployeeFilterSidebar")
            </aside>

  

        </div>
     </div>
</div>

<!-- Employee Batch Preview Modal -->
<div class="modal fade" id="employeeBatchPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header bg-lighter py-2 d-flex align-items-center">

                <!-- Left Side Title + Badge -->
                <div class="d-flex align-items-center flex-grow-1">
                    <h5 class="modal-title text-primary mb-0 d-flex align-items-center">
                        <i class='bx bxs-file-pdf me-2'></i> Batch Preview
                    </h5>
                    <span id="employeePreviewCount" class="badge bg-label-secondary ms-2"></span>

                    <!-- ✅ NEW: Fullscreen Button -->
                    <button type="button" class="btn btn-sm btn-icon btn-outline-secondary ms-3 toggle-fullscreen" data-target-modal="employeeBatchPreviewModal" title="Toggle Fullscreen">
                        <i class='bx bx-fullscreen'></i>
                    </button>
                </div>

               

                <!-- Close Button -->
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>


            <!-- Body -->
            <div class="modal-body p-0 bg-dark text-center position-relative">

                <!-- ✅ Loader -->
                <div id="employeePreviewLoader"
                     class="position-absolute top-50 start-50 translate-middle text-center fw-bold text-white"
                     style="z-index:9999; font-size:18px;display: block;">
                    <div class="spinner-border text-light" style="width: 3rem; height: 3rem;" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="text-light mt-2">Rendering PDF...</div>
                </div>


                <!-- PDF Viewer -->
                <iframe id="employeePreviewFrame"
                        class="w-100 h-100 border-0"
                        style="min-height:95vh;">
                </iframe>

            </div>

        </div>
    </div>
</div>



<div class="modal fade" id="pdfPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content h-100">

            <!-- Header -->
            <div class="modal-header bg-lighter py-2 align-items-center">

                <h5 class="modal-title text-primary me-3">
                    <i class='bx bxs-file-pdf me-2'></i> Form Preview
                </h5>

                <div class="d-flex align-items-center flex-grow-1">
                    <select id="previewEmployeeSelect" class="form-select form-select-sm w-auto" style="min-width: 250px;">
                        <option value="">Loading Employees...</option>
                    </select>
                    <span id="previewLabel" class="badge bg-label-secondary ms-2 fw-normal"></span>

                    <!-- ✅ NEW: Fullscreen Button -->
                    <button type="button" class="btn btn-sm btn-icon btn-outline-secondary ms-3 toggle-fullscreen" data-target-modal="pdfPreviewModal" title="Toggle Fullscreen">
                        <i class='bx bx-fullscreen'></i>
                    </button>
                </div>

              

                <!-- Close Button -->
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-0 bg-dark text-center position-relative">
                <div id="previewLoader" class="position-absolute top-50 start-50 translate-middle">
