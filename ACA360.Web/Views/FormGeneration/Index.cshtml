                            <label class="form-check-label fw-bold text-heading mb-0" for="selectAllEmployersList" style="font-size: 13px; cursor: pointer;">All</label>
                        </div>
                    </div>
                </div>

                <!-- Employer Cards Container -->
                <div id="employerContainer" class="p-3 d-flex flex-column gap-3 custom-scrollbar" style="overflow-y: auto; max-height: calc(100vh - 320px); min-height: 0;">
