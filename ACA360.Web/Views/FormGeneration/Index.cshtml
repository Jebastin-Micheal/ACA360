        function loadEmployees(employerIds) {
            $('#employeeListItems').html('<div class="text-center p-5"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Loading Employees...</p></div>');

            // 1. Setup filter payload (Keep your original payload logic)
            var requestData = {
                employerId: employerIds,
                year: $('#selectedYear').val(),
                PlanIDs: typeof FilterSections !== 'undefined' ? FilterSections.getValues('plan') : [],
                Statuses: typeof FilterSections !== 'undefined' ? FilterSections.getValues('status') : [],
                EnrollmentIDs: typeof FilterSections !== 'undefined' ? FilterSections.getValues('enrollment') : [],
                Flags: typeof FilterSections !== 'undefined' ? FilterSections.getValues('flag') : [],
                OtherIDs: typeof FilterSections !== 'undefined' ? FilterSections.getValues('other') : []
            };

            $.ajax({
                url: '@Url.Action("GetEmployeeList", "FormGeneration")',
                type: 'GET',
                data: requestData,
                traditional: true,
                success: function(data) {

                    if (!data || data.length === 0) {
                        $('#employeeListItems').html('<div class="text-center p-5"><i class="bx bx-user-x display-1 text-muted"></i><p class="text-muted mt-2">No employees found.</p></div>');
                      //  $('#filterSidebarAside').addClass('filters-disabled');
                        
                        return;
                    }
                    $('#filterSidebarAside').removeClass('filters-disabled');
                    // Group by Employer
                    const grouped = {};
                    data.forEach(emp => {
                        if (!grouped[emp.employerName]) { grouped[emp.employerName] = []; }
                        grouped[emp.employerName].push(emp);
                    });

                    let html = '';

                    Object.keys(grouped).forEach(employerName => {
                        let safeId = employerName.replace(/\s+/g, "_").replace(/[^a-zA-Z0-9_]/g, "");
                        let empCount = grouped[employerName].length;

                        // Employer Header (Accordion style)
                        html += `
                                <div class="mb-4 employer-group bg-white border rounded-3 shadow-sm overflow-hidden">
                                    <!-- Employer Header -->
                                    <div class="d-flex justify-content-between align-items-center p-3 bg-light border-bottom employer-toggle" style="cursor:pointer;" data-target="${safeId}">
                                        <div class="d-flex align-items-center gap-2">
                                            <h6 class="fw-bold mb-0 text-dark text-heading">${employerName}</h6>
                                            <span class="badge bg-secondary bg-opacity-25 text-dark rounded-pill px-2 py-1 text-heading" style="font-size: 11px;">${empCount} Employees</span>
                                        </div>
                                        <i class="bx bx-chevron-down fs-5 text-muted toggle-icon"></i>
                                    </div>

                                    <!-- Employee Table Wrapper -->
                                            <div class="employee-wrapper card border-0 rounded-0" id="${safeId}">
                                        <div class="table-responsive">
                                            <table class="table table-hover table-borderless align-middle mb-0">
                                                <thead class="">
                                                    <tr class="text-muted text-uppercase" style="font-size: 11px; letter-spacing: 0.5px;">
                                                        <th class="ps-3 py-3 fw-bold">Employee</th>
                                                        <th class="py-3 fw-bold">SSN</th>
                                                        <th class="py-3 fw-bold">City</th>
                                                        <th class="py-3 fw-bold">ZipCode</th>
                                                        <th class="pe-3 py-3 w-10 text-center">Select</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                `;

                        // Employee Rows
                        grouped[employerName].forEach(emp => {
                            let fInitial = emp.firstName ? emp.firstName.charAt(0).toUpperCase() : '';
                            let lInitial = emp.lastName ? emp.lastName.charAt(0).toUpperCase() : '';
                            let initials = fInitial + lInitial;
                            let ssnDisplay = emp.ssn || 'N/A';

                            // Handling empty City or Status gracefully
                            let cityDisplay = emp.city ? emp.city : '<span class="fst-italic opacity-50">N/A</span>';
                            let zipDisplay = emp.zip ? emp.zip : '<span class="fst-italic opacity-50">N/A</span>';

                            // ✅ NEW: Array of 5 different Sneat colors
                            const avatarColors = [
                                'bg-label-primary text-primary',
                                'bg-label-success text-success',
                                'bg-label-warning text-warning',
                                'bg-label-danger text-danger',
                                'bg-label-info text-info'
                            ];

                            // ✅ NEW: Pick a color based on the Employee ID so it stays consistent
                            let avatarClass = avatarColors[emp.id % avatarColors.length];

                            html += `
                <tr class="form-check-row border-bottom">
                    <td class="ps-3 py-3">
                        <div class="d-flex align-items-center gap-2">
                            <!-- ✅ NEW: Apply the dynamic avatarClass here -->
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold ${avatarClass}" style="width: 35px; height: 35px; font-size: 12px;">
                                ${initials}
                            </div>
                            <div>
                                <div class="fw-bold text-heading" style="font-size: 13px;">${emp.firstName} ${emp.lastName}</div>
                                
                            </div>
                        </div>
                    </td>
                    <td class="py-3 text-muted fw-medium" style="font-size: 12px; font-family: monospace;">${ssnDisplay}</td>
                           <td class="py-3 text-muted" style="font-size: 12px;">
            ${cityDisplay}
        </td>
        <td class="py-3 text-muted" style="font-size: 12px;">
            ${zipDisplay}
        </td>
                    <td class="pe-3 py-3 text-center">
                        <input class="form-check-input employee-batch-chk shadow-sm mt-0" style="width: 18px; height: 18px; cursor: pointer;" type="checkbox" value="${emp.id}">
                    </td>
                </tr>
            `;
                        });

                        html += `
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            `;
                    });
                    $('#employeeListItems').html(html);

                    // ✅ RESTORE EMPLOYEE CHECKBOX STATE
                    selectedEmployeeIds.forEach(id => {
                        $(`.employee-batch-chk[value="${id}"]`).prop('checked', true);
                    });

                    // Update search functionality to work with new table rows
                    updateSearchLogic();
                    updateSelectAllState();
                },
                error: function() {
                    $('#employeeListItems').html('<div class="text-center p-5"><i class="bx bx-error-alt display-1 text-danger"></i><p class="text-danger mt-2">Failed to load employees.</p></div>');
                }
            });
        }

        // Helper function to update search logic for the new table rows
      
        function updateSearchLogic() {
            
            $('#employeeSearch, #employeeSearch_Active').off('keyup').on('keyup', function() {
                let term = $(this).val().toLowerCase();

                $('.employee-batch-chk').each(function() {
                    // Find the parent table row (tr)
                    let $row = $(this).closest('tr');
                    // Get the text content of the row (Name, SSN, etc.)
                    let rowText = $row.text().toLowerCase();

                    if (rowText.includes(term)) {
                        $row.show();
                    } else {
                        $row.hide();
                    }
                });
                updateSelectAllState();
            });
        }
        function updateSelectAllState() {
            let $visibleCheckboxes = $('.employee-batch-chk:visible');
            let totalVisible = $visibleCheckboxes.length;
            let totalCheckedVisible = $visibleCheckboxes.filter(':checked').length;

            let $selectAll = $('#selectAllEmployees, #selectAllEmployees_Active');

            if (totalVisible === 0) {
                $selectAll.prop('checked', false).prop('indeterminate', false).prop('disabled', true);
            } else {
                $selectAll.prop('disabled', false);
                if (totalCheckedVisible === 0) {
                    $selectAll.prop('checked', false).prop('indeterminate', false);
                } else if (totalCheckedVisible === totalVisible) {
                    $selectAll.prop('checked', true).prop('indeterminate', false);
                } else {
                    $selectAll.prop('checked', false).prop('indeterminate', true);
                }
            }
        }
    </script>

}