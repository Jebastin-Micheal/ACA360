                    <div id="employerContainer" class="p-3 d-flex flex-column gap-3 custom-scrollbar" style="overflow-y: auto; max-height: calc(100vh - 320px); min-height: 0;">

                        @await Html.PartialAsync("_EmployerCardsPartial", Model.Employers)

                    </div>
                </div>
            </section>
            <!-- Column 3: Employees (col-md-5) -->
            <section id="employeeSidePanel" class="col-md-7 border-end bg-transparent d-flex flex-column p-0" style="height: 75vh;">

                <!-- DEFAULT EMPTY STATE (Shows when no employer is selected) -->
