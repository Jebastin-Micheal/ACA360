                                <!-- Replaced inline rgba background with bg-label-primary -->
                                <div class="rounded-3 d-flex align-items-center justify-content-center bg-label-primary" style="width: 48px; height: 48px;">
                                    <i class='bx bx-buildings text-primary' style="font-size: 28px;"></i>
                                </div>
                                <div>
                                    <div class="d-flex align-items-center justify-content-between w-100 gap-5">
                                        <!-- Replaced hardcoded color with text-heading -->
                                        <h4 class="fw-bold mb-0 text-heading">Employees</h4>
                                    </div>
                                    <p class="text-muted m-0" style="font-size: 13px;">Select employees for batch generation</p>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <div class="input-group w-50 shadow-sm rounded-3">
                                <span class="input-group-text bg-transparent border-end-0">
                                    <i class="bx bx-search text-muted"></i>
                                </span>
                                <input type="text" 
                                       class="form-control border-start-0 bg-transparent"
                                       placeholder="Search employees by name or SSN..."
                                       autocomplete="off" />
                            </div>
                            <div class="d-flex align-items-center px-3 border rounded-3 bg-transparent shadow-sm">
                                <input class="form-check-input mt-0 me-2" type="checkbox" style="cursor: pointer;">
                                <label class="form-check-label fw-bold text-heading mb-0" for="selectAllEmployees_Active" style="font-size: 14px; cursor: pointer;">Select All</label>
                            </div>
                        </div>
                    </div>

                <div class="flex-grow-1 overflow-auto p-3 custom-scrollbar d-flex flex-column justify-content-center align-items-center text-center mt-6"
                 style="min-height: 0;">

                 <!-- Replaced Icon with Modern Empty State Image -->
                 <img src="~/images/Empty_EmployeeList_Card.png" alt="No Selection" class="mb-4" style="width: 220px; opacity: 0.9; filter: drop-shadow(0px 10px 15px rgba(0,0,0,0.08));" />

                     <h5 class="fw-bold text-muted mb-0">
                            Select an Employer
                     </h5>
                     <!-- Optional: Oru chinna helper text add panniruken, nalla irukum -->
                        <p class="text-muted small mt-2" style="font-size: 13px;">Choose an employer from the list to view its employees.</p>

                </div>

                </div>

                <!-- EMPLOYEE CONTENT (Hidden by default, shown when employer is selected) -->
                <div id="employeeContentWrapper" class="d-none flex-column h-100 w-100">

                    <!-- Top Sticky Header -->
                    <div class="p-3 border-bottom z-10">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-3 d-flex align-items-center justify-content-center bg-label-primary" style="width: 48px; height: 48px;">
                                    <i class='bx bx-buildings text-primary' style="font-size: 28px;"></i>
                                </div>
                                <div>
                                    <div class="d-flex align-items-center justify-content-between w-100 gap-5">
                                        <h4 class="fw-bold mb-0 text-heading">Employees</h4>

                                        <!-- Replaced custom success classes with Sneat's bg-label-success -->
                                        <span class="badge rounded-pill bg-label-success fw-bold text-uppercase"
                                              style="font-size:10px; letter-spacing:0.5px;">
                                            Ready for generation
