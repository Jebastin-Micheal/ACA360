                                    </div>
                                    <p class="text-muted m-0" style="font-size: 13px;" id="employeePanelSubtitle">Select employees for batch generation</p>
                                </div>
                            </div>
                            <!-- NEW: Filter Icon Button (Shows only when Employees load) -->
                            <button type="button" class="btn btn-outline-primary position-relative shadow-sm" id="btnToggleFilter" title="Open Filters">
                                <i class='bx bx-filter-alt fs-5'></i>
                                <!-- Active Indicator Dot -->
                                <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle d-none" id="filterActiveIndicator"></span>
                            </button>
                        </div>

                        <div class="d-flex gap-2">
                           
                                <div class="input-group w-50 shadow-sm rounded-3">
                                    <span class="input-group-text bg-transparent border-end-0">
                                        <i class="bx bx-search text-muted"></i>
                                    </span>
                                    <input type="text" id="employeeSearch"
                                           class="form-control border-start-0 bg-transparent"
                                           placeholder="Search employees by name or SSN..."
                                           autocomplete="off" />
                                </div>
                           
                            <div class="d-flex align-items-center px-3 border rounded-3 bg-transparent shadow-sm">
                                <input class="form-check-input mt-0 me-2" type="checkbox" id="selectAllEmployees_Active" style="cursor: pointer;">
                                <label class="form-check-label fw-bold text-heading mb-0" for="selectAllEmployees_Active" style="font-size: 14px; cursor: pointer;">Select All</label>
                            </div>
