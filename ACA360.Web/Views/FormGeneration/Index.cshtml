        function checkEmployerHealth(empId) {
             // Save ID for the "View Details" button to use later
             currentRiskEmployerId = empId;

             // Show a loading swal while checking
             Swal.fire({
                 title: 'Running Health Check...',
                 text: 'Analyzing employee data for penalty risks and missing fields.',
                 allowOutsideClick: false,
                 didOpen: () => {
                     Swal.showLoading();
                 }
             });

             $.get('@Url.Action("GetRiskAnalysis", "FormGeneration")', { employerId: empId, year: $('#selectedYear').val() }, function(data) {

                 let hasIssues = false;

                 // Show/Hide Risk Widget
                 if(data.estimatedPenaltyAmount > 0|| data.atRiskEmployeeCount > 0) {
                     $('#riskCount').text(data.atRiskEmployeeCount);

                     // Format Money
                     var money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(data.estimatedPenaltyAmount);
                     $('#riskAmount').text(money);
                     $('#riskContainer').removeClass('d-none');

                     hasIssues = true;
                 } else {
                     $('#riskContainer').addClass('d-none');
                 }

                 // Show/Hide Fix Widget
                 if(data.missingPlanStartCount > 0) {
                     $('#fixCount').text(data.missingPlanStartCount);
                     $('#fixContainer').data('empid', empId).removeClass('d-none');

                     hasIssues = true;
                 } else {
                     $('#fixContainer').addClass('d-none');
                 }

                 // Fire the result SweetAlert
                 if (hasIssues) {
                     Swal.fire({
                         icon: 'warning',
                         title: 'Issues Detected',
                         text: 'We found potential penalty risks or missing data. Please review the highlighted sections.',
                         customClass: {
                             confirmButton: 'btn btn-warning'
                         },
                         buttonsStyling: false
                     });
                 } else {
                     Swal.fire({
                         icon: 'success',
                         title: 'All Healthy!',
                         text: 'No penalty risks or missing data found.',
                         timer: 2500,
                         showConfirmButton: false
                     });
                 }

             }).fail(function() {
                 Swal.fire({
                     icon: 'error',
                     title: 'Check Failed',
                     text: 'There was an error connecting to the server to run the health check.',
                     customClass: {
                         confirmButton: 'btn btn-danger'
                     },
                     buttonsStyling: false
                 });
             });
        }


                // 2. NEW: Show Risk Details Function
        function showRiskDetails() {
              if (currentRiskEmployerId === 0) {
                  //console.error("No Employer ID selected for risk details.");
                  return;
              }

              var tbody = $('#riskTableBody');
              tbody.html('<tr><td colspan="5" class="text-center"><div class="spinner-border text-primary"></div> Loading...</td></tr>');
              $('#riskDetailsModal').modal('show');

              $.get('@Url.Action("GetRiskDetails", "FormGeneration")',
                    { employerId: currentRiskEmployerId, year:  $('#selectedYear').val() },
                    function(res) {
                        console.log("Risk Details Response:", res); // DEBUG LOG

                        if (res.success) {
                            tbody.empty();

                            if (!res.data || res.data.length === 0) {
                                tbody.html('<tr><td colspan="5" class="text-center">No risks found.</td></tr>');
                                return;
                            }

                            res.data.forEach(emp => {
                                // Ensure properties exist before accessing to prevent undefined errors
                                var fName = emp.firstName || emp.FirstName || ""; // Try both casings
                                var lName = emp.lastName || emp.LastName || "";
                                var ssn = emp.ssn || emp.SSN || "---";
                                if (!canViewFullPii) ssn = maskSSNDisplay(ssn);
                                var badMonths = emp.badMonthCount || emp.BadMonthCount || 0;
                                var penalty = emp.estimatedPenalty || emp.EstimatedPenalty || 0;

                                var money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(penalty);

                                var year = $('#selectedYear').val();

                                var row = ` <tr>
                               <td><span class="fw-bold">${fName}${lName}</span></td>
                               <td>${ssn}</td>
                               <td class="text-center"><span class="badge bg-label-danger">${badMonths}</span></td>
                               <td class="text-end text-danger fw-bold">${money}</td>
                               <td class="text-center">
                               <a href="/ACA/CodeReview?employerId=${currentRiskEmployerId}&year=${year}&search=${lName}"
                                target="_blank" class="btn btn-xs btn-outline-primary">
                                <i class='bx bx-edit'></i> Fix
                               </a>
                               </td>
                                </tr> `;

                                tbody.append(row);
                            });
                        } else {
                            tbody.html(`<tr><td colspan="5" class="text-center text-danger">Error: ${res.message}</td></tr>`);
