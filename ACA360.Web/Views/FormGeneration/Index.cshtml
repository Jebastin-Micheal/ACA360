        // 2. Update Preview Selected Function
               function previewSelectedEmployees() {
            var formType = $('#formTypeSelector').val();
            var idsToPreview = [];
            const token = $('input[name="__RequestVerificationToken"]').val();
            // Check validation based on form type
            if (formType === '1094-C' || formType === '1094-B') {
                if (selectedEmployerIds.length === 0) {
                    toastr.warning("Select at least one employer.");
                    return;
                }
                $('#employeePreviewCount').text(selectedEmployerIds.length + " Employers");
            } else {
                if (selectedEmployeeIds.length === 0) {
                    toastr.warning("Select at least one employee.");
                    return;
                }
                idsToPreview = selectedEmployeeIds;
                $('#employeePreviewCount').text(idsToPreview.length + " Employees");
            }

            // SHOW MODAL FIRST
            $('#employeeBatchPreviewModal').modal('show');
            $('#employeePreviewLoader').show().css("display", "block");
            $('#employeePreviewFrame').attr('src', 'about:blank');

            if (employeePreviewUrl) {
                URL.revokeObjectURL(employeePreviewUrl);
                employeePreviewUrl = null;
            }

            // NOW start fetch
            fetch('/FormGeneration/GenerateBatchPreview', {
                method: 'POST',
                headers: {
                   'Content-Type': 'application/json',
                   'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    employerIds: selectedEmployerIds,
                    employeeIds: idsToPreview, // Empty for 1094
                    year: $('#selectedYear').val(),
                    formType: formType,
                    suppressSSN: $('#suppressSsnCheck').is(':checked') // ✅ NEW
                })
            })
            .then(res => {
                if (!res.ok) throw new Error("Failed to render preview.");
                return res.blob();
            })
            .then(blob => {
                employeePreviewUrl = URL.createObjectURL(blob);
                $('#employeePreviewFrame').attr('src', employeePreviewUrl);
            })
            .catch((err) => {
                toastr.error(err.message);
                $('#employeeBatchPreviewModal').modal('hide');
            });
        }


        
