@model ACA360.Core.Models.FormGenerationDashboardViewModel;
@using ACA360.Web.ViewComponents;
@{
    ViewData["Title"] = "Form Generation Hub";

    // Helper function to toggle sort icons
    string GetSortIcon(string col)
    {
        if (Model.SortColumn != col) return "bx-sort-alt";
        return Model.SortOrder == "Asc" ? "bx-sort-up" : "bx-sort-down";
    }
    string NextOrder = Model.SortOrder == "Asc" ? "Desc" : "Asc";
}
@await Component.InvokeAsync("Breadcrumb", new {
pageTitle = "Form Geneation Hub",
    items = new List<BreadcrumbItem>
{
    new BreadcrumbItem { Title = "Employer", Url = Url.Action("Index", "Employer"), IsActive = false },
    new BreadcrumbItem { Title = "Generation Report", Url = "", IsActive = true }
}
})


<style>
    .glass {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    .card-lift {
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
    }

        .card-lift:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.1);
        }

    .selected-form-glow {
        border: 2px solid #0d6efd;
        box-shadow: 0 0 20px rgba(13, 110, 253, 0.15);
        /* background: linear-gradient(135deg, rgba(13, 110, 253, 0.05) 0%, rgba(255, 255, 255, 0.7) 100%); */
    }

    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }

    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
/* Custom Slim Scrollbar */
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent; 
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #cdd4dc; 
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #a8b1bc; 
    }

    .form-type-text{
        font-size:12px;
    }

    /* NEW: Dynamic Filter Overlay CSS */
    #employeeSidePanel {
        transition: width 0.3s ease-in-out;
    }

    .filter-panel-hidden {
        transform: translateX(120%);
        opacity: 0;
        position: absolute !important;
        right: 0;
        top: 0;
        width: 320px;
        z-index: 990;
        pointer-events: none;
    }

    .filter-panel-overlay {
        transform: translateX(0);
        opacity: 1;
        position: absolute !important;
        right: 0;
        top: 0;
        width: 320px;
        /* z-index: 990; */
        box-shadow: -5px 0 25px rgba(0,0,0,0.15);
        pointer-events: auto;
    }

    .filter-panel-fixed {
        transform: translateX(0);
        opacity: 1;
        position: relative !important;
        /* z-index: 10; */
        box-shadow: none;
        pointer-events: auto;
    }

    /* Floating Bar Animation CSS */
    #stickyActionBar {
        /* Changed to smooth material transition instead of bouncy */
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
    }

    .action-bar-success {
        min-width: 56px !important;
        width: 56px !important;
        height: 56px !important;
        padding: 0 !important;
        border-radius: 50% !important;
        background-color: #0d6efd !important;
        border: none !important;
    }

        .action-bar-success #actionBarContent {
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.2s ease;
        }

    #successTick {
        opacity: 0;
        transform: scale(0);
        transition: all 0.4s ease 0.3s;
    }

    .action-bar-success #successTick {
        opacity: 1;
        transform: scale(1);
    }

    /* NEW: Class to slide the bar down out of the screen */
    .action-bar-slide-down {
        transform: translate(-50%, 150px) !important;
        opacity: 0 !important;
    }
</style>

<div class="h-100">
  
            <form method="get" id="filterForm" class="row g-3 align-items-center">
                <div class="col d-flex align-items-center gap-2">
                   <select id="formTypeSelector" name="SelectedFormType"
                     class="form-select form-select-sm border-light shadow-sm d-none" style="width: 160px;">
                     <option value="" selected disabled>Select Form Type</option> 
                     <option value="1094-C">1094-C (ALE)</option>
                     <option value="1095-C">1095-C (ALE)</option>
                     <option value="1094-B">1094-B (Non-ALE)</option>
                     <option value="1095-B">1095-B (Non-ALE)</option>
                     <option value="1094-C_1095-C">1094-C & 1095-C</option>
                     <option value="1094-B_1095-B">1094-B & 1095-B</option>
                   </select>
                </div>
                <input type="hidden" id="selectedYear" name="year" value="@Model.SelectedYear" />
                <input type="hidden" id="filterStatus" name="filterStatus" value="@Model.FilterStatus" />
                <input type="hidden" name="sortColumn" value="@Model.SortColumn" />
                <input type="hidden" name="sortOrder" value="@Model.SortOrder" />
            </form>
       

    <div id="riskContainer" class="row mb-4 d-none">
        <div class="col-12">
            <div class="card bg-label-danger border-start border-4 border-danger">
                <div class="card-body d-flex justify-content-between align-items-center p-3">
                    <div class="d-flex align-items-center">
                        <div class="avatar avatar-md rounded p-2 me-3">
                            <i class='bx bx-trending-down text-danger fs-3'></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-danger fw-bold">Penalty Exposure Detected</h6>
                            <small class="text-muted">
                                <span id="riskCount" class="fw-bold">0</span> employees have coverage gaps.
                                Estimated Risk: <span id="riskAmount" class="fw-bold text-danger fs-5">$0</span>
                            </small>
                        </div>
                    </div>
                    <button class="btn btn-danger btn-sm" onclick="showRiskDetails()">
                        <i class='bx bx-search-alt'></i> View Details
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="fixContainer" class="alert alert-warning d-flex align-items-center justify-content-between d-none" role="alert">
        <div>
            <i class='bx bx-wrench me-2'></i>
            <strong>Data Issue:</strong> <span id="fixCount">0</span> employees are missing "Plan Start Month". This is required for filing.
        </div>
        <div class="input-group input-group-sm" style="width: 250px;">
            <span class="input-group-text">Set To:</span>
            <select id="fixMonthSelect" class="form-select">
                <option value="01">Jan (01)</option>
                <option value="02">Feb (02)</option>
            </select>
            <button class="btn btn-primary" onclick="runAutoFix()">Fix All</button>
        </div>
    </div>


      <div class="card">
        <div class="row g-4 mt-0 mb-3 ms-0 transition-layout position-relative me-1" id="mainGenerationContent" style="overflow-x: hidden;">

