@section Scripts {
    <script src="~/js/employee-filter-module.js"></script>
    <script>
            // Global variable to store current context
        var currentRiskEmployerId = 0;
                var canViewFullPii = @(CanViewSSNorEIN ? "true" : "false");
        function maskSSNDisplay(ssn) {
        if (!ssn) return "---";
        var clean = String(ssn).replace(/\D/g, '');
        if (clean.length !== 9) return ssn;
        return "***-**-" + clean.substring(5, 9);
        }

           // --- 1. DOCUMENT READY (DOM Elements & Event Listeners) ---
        $(document).ready(function() {
            // Initialize Tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Initialize Popovers
            var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
            var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
                return new bootstrap.Popover(popoverTriggerEl);
            });


            
            // INITIALIZE FILTER SECTIONS
    FilterSections.init('plan', 'Plan', []);
    FilterSections.init('status', 'Status', [
        { value: '0', text: 'FULL-TIME' }, { value: '1', text: 'PART-TIME' }, { value: '-2', text: 'No status' }
    ]);
    FilterSections.init('enrollment', 'Enrollment', [
        { value: '1', text: 'Not Offered' }, { value: '2', text: 'Offered & Waived' },
        { value: '3', text: 'Offered & Enrolled' }, { value: '4', text: 'Union' },
        { value: '5', text: 'COBRA' }, { value: '6', text: 'Retiree' }
    ]);
    FilterSections.init('flag', 'Flags', []);
    FilterSections.init('other', 'Others', [
        { value: '1', text: 'Receiving Forms' }, { value: '0', text: 'Not Receiving Forms' }
    ]);

    loadGlobalFlags(); // Load flag dropdown data

    // 1. Reset All Filters (Auto-Applies after resetting)
    $('#btnResetAllFilters').click(function () { 
        FilterSections.resetAll(); 
        if (selectedEmployerIds.length > 0) {
            loadEmployees(selectedEmployerIds);
        }
    });

    // 2. AUTO-APPLY LOGIC: Triggers when any filter row, select all, or active chip remove is clicked
    $(document).on('click', '.fs-row, .fs-selectall, .emp-chip-remove', function () {
        // Use a small timeout (50ms) to ensure the filter module updates its internal state first
        setTimeout(function() {
            if (selectedEmployerIds.length > 0) {
                loadEmployees(selectedEmployerIds);
            }
        }, 50);
    });

    
            // Form Type Card Click Logic
        
            $(document).on('click', '.form-type-card', function() {

                // 1. Reset all cards to Default (Inactive) State
                $('.form-type-card').removeClass('selected-form-glow border-primary');
                $('.form-type-card .active-indicator').removeClass('d-flex').addClass('d-none');
                $('.form-type-card .form-title').removeClass('text-primary').addClass('text-heading');

                // Reset all icons
                $('.form-type-card .icon-container')
                    .removeClass('bg-primary bg-label-primary')
                    .addClass('bg-label-secondary');
                $('.form-type-card .icon-container i')
                    .removeClass('text-white text-primary')
                    .addClass('text-secondary');

                // 2. Activate Clicked Card
                $(this).addClass('selected-form-glow border-primary');
                $(this).find('.active-indicator').removeClass('d-none').addClass('d-flex');
                $(this).find('.form-title').removeClass('text-heading').addClass('text-primary');

                // Update active icon container
                var $iconContainer = $(this).find('.icon-container');
                $iconContainer.removeClass('bg-label-secondary bg-label-primary').addClass('bg-primary');
                $iconContainer.find('i').removeClass('text-secondary text-primary').addClass('text-white');

                // 3. Update the hidden select and trigger change for your existing logic
                var selectedType = $(this).attr('data-form-type');
                $('#formTypeSelector').val(selectedType).trigger('change');
            });

            // --- EVENT HANDLERS ---

            // 1. IFrame Load Event (Fixes the ReferenceError)
            $('#pdfFrame').on('load', function() {
                $('#previewLoader').hide();
            });

            // 2. Select All Checkbox
            $('#selectAll').change(function() {
                $('.emp-select:not(:disabled)').prop('checked', this.checked);
                updateToolbar();
            });

            // 3. Individual Checkbox
            $(document).on('change', '.emp-select', function() {
                if(!this.checked) $('#selectAll').prop('checked', false);
                updateToolbar();
            });

            /// 4. Bulk Generate Button
            $('#btnBulkGenerate').click(function() {
                var selectedIds = [];
                $('.emp-select:checked').each(function() {
                    selectedIds.push(parseInt($(this).val()));
                });

                if (selectedIds.length === 0) return;

                var formType = $('#formTypeSelector').val();
                var formTypeText = $("#formTypeSelector option:selected").text();

                if(!confirm(`You are about to generate ${formTypeText} for ${selectedIds.length} employers. \n\nThis process will run in the background. Continue?`)) {
                    return;
                }

                startBatchGeneration(selectedIds, formType);
            });

            
         $('#pdfPreviewModal').on('hidden.bs.modal', function () {

            $('#pdfFrame').attr('src', 'about:blank');

            if (previewUrl) {
                URL.revokeObjectURL(previewUrl);
                previewUrl = null;
            }

            $('#previewLoader').show();
        });

            // ✅ FULLSCREEN TOGGLE LOGIC FOR PREVIEW MODALS
            $(document).on('click', '.toggle-fullscreen', function() {
                let targetModalId = $(this).data('target-modal');
                let $dialog = $('#' + targetModalId + ' .modal-dialog');
                let $icon = $(this).find('i');

                // Toggle Bootstrap's native fullscreen class and remove modal-xl temporarily
                $dialog.toggleClass('modal-fullscreen modal-xl');

                // Change the icon visually
                if ($dialog.hasClass('modal-fullscreen')) {
                    $icon.removeClass('bx-fullscreen').addClass('bx-exit-fullscreen');
                } else {
                    $icon.removeClass('bx-exit-fullscreen').addClass('bx-fullscreen');
                }
            });

            // ✅ Reset the fullscreen state when the modal closes (So it opens normally next time)
            $('.modal').on('hidden.bs.modal', function() {
                let $dialog = $(this).find('.modal-dialog');
                let $icon = $(this).find('.toggle-fullscreen i');

                if ($dialog.hasClass('modal-fullscreen')) {
                    $dialog.removeClass('modal-fullscreen').addClass('modal-xl');
                    $icon.removeClass('bx-exit-fullscreen').addClass('bx-fullscreen');
                }
            });

            // ✅ PREVENT EMPLOYER SELECTION IF FORM TYPE IS NOT SELECTED
            $(document).on('click', '.emp-select', function(e) {
                var formType = $('#formTypeSelector').val();

                if (!formType) {
                    e.preventDefault();
                    toastr.warning("Please select a Form Type first before choosing employers.", "Action Required");
                    return false; 
                }
            });

            // Global variable to keep track of the active AJAX request
            var employerAjaxRequest = null;

            // --- 1. COMMON FUNCTION TO FETCH EMPLOYERS (AJAX) ---
            function fetchEmployers() {
                var term = $('#employerSearch').val();
                var year = $('#yearFilterDropdown').val() || $('#selectedYear').val();
                var status = $('#statusFilterDropdown').val() || $('#filterStatus').val();

                // Update hidden inputs
                $('#selectedYear').val(year);
                $('#filterStatus').val(status);

                // FUTURE PROOFING: Cancel the previous request if it's still running (prevents server overload)
                if (employerAjaxRequest != null) {
                    employerAjaxRequest.abort();
                }

                // UX IMPROVEMENT: Show a loader immediately before the request starts
                $('#employerContainer').html(`
                <div class="text-center py-5 w-100">
                    <div class="spinner-border text-primary mb-2" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="text-muted fw-semibold">Loading Employers...</p>
                </div>
            `);

                employerAjaxRequest = $.ajax({
                    url: '@Url.Action("SearchEmployers", "FormGeneration")',
                    type: 'GET',
                    data: {
                        searchTerm: term,
                        year: year,
                        filterStatus: status
                    },
                    success: function(html) {
                        $('#employerContainer').html(html);

                        // Restore employer checkbox selections
                        selectedEmployerIds.forEach(id => {
                            $(`.emp-select[value="${id}"]`).prop('checked', true);
                            $(`.emp-select[value="${id}"]`).closest(".card").removeClass("border-success border-warning").addClass("border-primary border-2");
                        });

                        // Update "Select All" checkbox state
                        let totalCardCount = $('.emp-select').length;
                        let checkedCount = $('.emp-select:checked').length;
                        let allChecked = totalCardCount > 0 && totalCardCount === checkedCount;
                        $('#selectAllEmployersList').prop('checked', allChecked);

                        // If no employers are found for the selected year
                        if (totalCardCount === 0) {
                            hideEmployeePanel(); // Reset employee side panel
                        } else if (selectedEmployerIds.length > 0) {
                            var formType = $('#formTypeSelector').val();
                            if (formType === '1094-C' || formType === '1094-B') {
                                hideEmployeeSidePanelOnly();
                            } else if (formType) {
                                showSidePanel(selectedEmployerIds);
                            }
                        } else {
                            hideEmployeePanel();
                        }

                        $('[data-bs-toggle="tooltip"]').tooltip();
                    },
                    error: function(xhr) {
                        // Ignore abort errors, show message for real errors
                        if (xhr.statusText !== 'abort') {
                            $('#employerContainer').html(`
                            <div class="text-center py-5 w-100">
                                <i class='bx bx-error-circle display-4 text-danger mb-3'></i>
                                <p class="text-danger fw-semibold">Failed to load data. Please try again.</p>
                            </div>
                        `);
                        }
                    },
                    complete: function() {
                        // Reset the request variable once done
                        employerAjaxRequest = null;
                    }
                });
            }

            // --- 2. BIND DROPDOWN CHANGES TO AJAX ---
            $('#yearFilterDropdown, #statusFilterDropdown').on('change', function() {
                fetchEmployers();
            });

            // --- 3. UPDATE SEARCH EVENT (Replace your old #employerSearch keyup logic) ---
            $('#employerSearch').off('keyup').on('keyup', function() {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(fetchEmployers, 400);
            });

            // --- 4. EMPLOYERS "SELECT ALL" LOGIC ---
            $('#selectAllEmployersList').on('change', function() {
                var isChecked = this.checked;
                var formType = $('#formTypeSelector').val();

                if (isChecked && !formType) {
                    toastr.warning("Please select a Form Type first before choosing employers.", "Action Required");
                    $(this).prop('checked', false);
                    return;
                }

                $('.emp-select').each(function() {
                    $(this).prop('checked', isChecked);
                    var empId = parseInt($(this).val());
                    var $card = $(this).closest(".card");

                    if (isChecked) {
                        if (!selectedEmployerIds.includes(empId)) {
                            selectedEmployerIds.push(empId);
                        }
                        // Add Blue Border
                        $card.removeClass("border-success border-warning").addClass("border-primary border-2");
                    } else {
                        selectedEmployerIds = selectedEmployerIds.filter(id => id !== empId);
                        // Remove Blue Border and Restore original
                        $card.removeClass("border-primary border-2");
                        if ($card.find(".badge").hasClass("bg-label-success")) {
                            $card.addClass("border-success border-2");
                        } else {
                            $card.addClass("border-warning");
                        }
                    }
                });

                // Handle Side Effects (Plans & Panel)
                if (selectedEmployerIds.length > 0) {
                    if (typeof loadGlobalPlans === 'function') {
                        loadGlobalPlans(selectedEmployerIds.join(','));
                    }
                    if (formType === '1094-C' || formType === '1094-B') {
                        hideEmployeeSidePanelOnly();
                    } else {
                        showSidePanel(selectedEmployerIds);
                    }
                } else {
                    if (typeof FilterSections !== 'undefined') {
                        FilterSections.setOptions('plan', [], false);
                    }
                    hideEmployeePanel();
                }

                updateToolbar();
            });

            // --- 5. UNCHECK "SELECT ALL" IF INDIVIDUAL BOX IS UNCHECKED ---
            $(document).on('change', '.emp-select', function() {
                let allChecked = $('.emp-select').length > 0 && $('.emp-select').length === $('.emp-select:checked').length;
                $('#selectAllEmployersList').prop('checked', allChecked);
            });

            // ==========================================
            // SLIDING FILTER PANEL LOGIC
            // ==========================================
            let isFilterPinned = false;
            let isFilterOpen = false;

            // 1. Toggle Filter from Employee Header Icon
            $('#btnToggleFilter').click(function() {
                if (!isFilterOpen) {
                    openFilterPanel();
                } else {
                    closeFilterPanel();
                }
            });

            // 2. Close Button inside Filter
            $('#btnCloseFilter').click(function() {
                closeFilterPanel();
            });

            // 3. Fix / Pin Button Logic
            $('#btnPinFilter').click(function() {
                isFilterPinned = !isFilterPinned;
                var $icon = $(this).find('i');

                if (isFilterPinned) {
                    // Change to solid Pin icon & Disable Close
                    $icon.removeClass('bx-pin').addClass('bxs-pin text-primary');
                    $('#btnCloseFilter').prop('disabled', true);

                    // Adjust Grid (Fixed State)
                    $('#filterAsideWrapper').removeClass('filter-panel-overlay').addClass('filter-panel-fixed col-md-2');
                    $('#employeeSidePanel').removeClass('col-md-7').addClass('col-md-5');
                } else {
                    // Change to outline Pin icon & Enable Close
                    $icon.removeClass('bxs-pin text-primary').addClass('bx-pin');
                    $('#btnCloseFilter').prop('disabled', false);

                    // Revert to Overlay State
                    $('#filterAsideWrapper').removeClass('filter-panel-fixed col-md-2').addClass('filter-panel-overlay');
                    $('#employeeSidePanel').removeClass('col-md-5').addClass('col-md-7');
                }
            });

            function openFilterPanel() {
                isFilterOpen = true;
                if (!isFilterPinned) {
                    $('#filterAsideWrapper').removeClass('filter-panel-hidden').addClass('filter-panel-overlay');
                }
                $('#filterActiveIndicator').addClass('d-none'); // Hide indicator when open
            }

            function closeFilterPanel() {
                if (isFilterPinned) return; // Prevent closing if it's pinned
                isFilterOpen = false;
                $('#filterAsideWrapper').removeClass('filter-panel-overlay').addClass('filter-panel-hidden');
                checkFilterIndicator(); // Check if indicator dot is needed
            }

            // 4. Indicator Logic: Checks if any filter is used when closed
            function checkFilterIndicator() {
                if (typeof FilterSections === 'undefined') return;

                let isAnyFilterActive = !FilterSections.isDefault('plan') ||
                    !FilterSections.isDefault('status') ||
                    !FilterSections.isDefault('enrollment') ||
                    !FilterSections.isDefault('flag') ||
                    !FilterSections.isDefault('other');

                if (isAnyFilterActive && !isFilterOpen) {
                    $('#filterActiveIndicator').removeClass('d-none');
                } else {
                    $('#filterActiveIndicator').addClass('d-none');
                }
            }

            // UPDATE AUTO-APPLY TO TRIGGER INDICATOR CHECK
            $(document).on('click', '.fs-row, .fs-selectall, .emp-chip-remove', function() {
                setTimeout(function() {
                    if (selectedEmployerIds.length > 0) {
                        loadEmployees(selectedEmployerIds);
                    }
                    checkFilterIndicator(); // Update dot dynamically
                }, 50);
            });

            $('#btnResetAllFilters').click(function() {
                FilterSections.resetAll();
                if (selectedEmployerIds.length > 0) {
                    loadEmployees(selectedEmployerIds);
                }
                checkFilterIndicator();
            });


        });

            function updateToolbar() {
                var empCount = $('.emp-select:checked').length;
                var employeeCount = $('.employee-batch-chk:checked').length;
                var formType = $('#formTypeSelector').val();
                var totalSelected = 0;

                if (formType === '1094-C' || formType === '1094-B') {
                    totalSelected = empCount;
                    $('#selectionCount').text(empCount + " Employers selected");
                    //$('#selectionSummaryText').html(`<b>${empCount}</b> Employers selected`);
                    $('#selectionSummaryText').html(` Employers selected`);
                  //  $('#generateBatchBtn, #stickyGenerateBtn').prop('disabled', empCount === 0);
                    $('#stickyGenerateBtn').prop('disabled', empCount === 0);

                    if (empCount > 0) {
                        $('#previewSelectedBtn').removeClass('d-none');
                    } else {
                        $('#previewSelectedBtn').addClass('d-none');
                    }
                } else {
                    totalSelected = employeeCount;
                    $('#selectionCount').text(employeeCount + " Employees selected");
                   // $('#selectionSummaryText').html(`<b>${employeeCount}</b> Employees selected`);
                $('#selectionSummaryText').html(` Employees selected`);
                   // $('#generateBatchBtn, #stickyGenerateBtn').prop('disabled', employeeCount === 0);
                    $('#stickyGenerateBtn').prop('disabled', employeeCount === 0);

                    if (employeeCount > 0) {
                        $('#previewSelectedBtn').removeClass('d-none');
                    } else {
                        $('#previewSelectedBtn').addClass('d-none');
                    }
                }

                // Update sticky footer count badge (Always visible now)
                $('#stickyGenCount').text(totalSelected);
            }


        function startBatchGeneration(ids, type) {
            $.ajax({
                url: '@Url.Action("StartBatchGeneration", "FormGeneration")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    employerIds: ids,
                    year:  $('#selectedYear').val(),
                    formType: type
                }),
                success: function(res) {
                    if(res.success) {
                        toastr.success(res.message);
                    } else {
                        toastr.error(res.message);
                    }
                },
                error: function() {
                    toastr.error("Failed to start batch process.");
                }
            });
        }

        // 1. New global variable to track context
        var currentPreviewContext = { employerId: 0, year: 0, formType: '' };

                       // 2. Updated openPreview Function
                function openPreview(employerId, employerName) {
            var formType = $('#formTypeSelector').val();

            // ✅ NEW: Validation check to stop if Form Type is not selected
            if (!formType) {
                toastr.warning("Please select a Form Type first before previewing.", "Action Required");
                return; // Stop execution here, don't open the modal
            }

            var year = $('#selectedYear').val() || $('select[name="year"]').val();

            // Save context
            currentPreviewContext = { employerId: employerId, year: year, formType: formType };

            // Reset UI
            $('#previewLabel').text(employerName + " (" + formType + ")");
            $('#pdfFrame').attr('src', 'about:blank'); // Clear previous PDF
            $('#previewLoader').show();

            var $select = $('#previewEmployeeSelect');

            // Show Modal first
            $('#pdfPreviewModal').modal('show');

            // ==========================================================
            // 1. IF STRICTLY 1094 FORM -> SKIP EMPLOYEE DROPDOWN
            // ==========================================================
            if (formType === '1094-C' || formType === '1094-B') {
                // Dropdown disable
                $select.empty().append('<option>Employer Form - No Employee Needed</option>').prop('disabled', true);

                var url = '/FormGeneration/GeneratePreview' +
                    '?employerId=' + employerId +
                    '&year=' + year +
                    '&formType=' + formType;

                $('#pdfFrame').attr('src', url);
            }
            // ==========================================================
            // 2. IF 1095 FORM OR COMBINED FORM -> LOAD EMPLOYEES
            // ==========================================================
            else {
                // Clear Dropdown and show loading
                $select.empty().append('<option>Loading employees...</option>').prop('disabled', true);

                // Fetch Employee List via AJAX
                $.ajax({
                    url: '/FormGeneration/GetEmployeeList',
                    type: 'GET',
                    data: {
                        employerId: [employerId], // Passed as array
                        year: year
                    },
                    traditional: true,
                    success: function(data) {
                        $select.empty();

                        // Handle Combined Forms (add Employer form as first option)
                        if (formType === '1094-C_1095-C') {
                            $select.append('<option value="employer_1094C">Employer Form (1094-C)</option>');
                        } else if (formType === '1094-B_1095-B') {
                            $select.append('<option value="employer_1094B">Employer Form (1094-B)</option>');
                        }

                        if (!data || data.length === 0) {
                            $select.append('<option value="">No employees found</option>');

                            // Stop loading ONLY if it's NOT a combined form
                            if (formType.indexOf('_') === -1) {
                                $('#previewLoader').hide();
                                return;
                            }
                        } else {
                            // Populate Dropdown with employees
                            data.forEach(function(emp) {
                                var last4 = emp.ssn ? emp.ssn.slice(-4) : 'xxxx';
                                var name = `${emp.firstName} ${emp.lastName} -(...${last4})`;
                                $select.append(`<option value="${emp.id}">${name}</option>`);
                            });
                        }

                        $select.prop('disabled', false);

                        // Trigger change for the first option to load the preview automatically
                        $select.find('option:first').prop('selected', true).trigger('change');
                    },
                    error: function() {
                        $select.empty().append('<option value="">Error loading employees</option>');
                        $('#previewLoader').hide();
                    }
                });
            }
        }


                // Called by the IFrame onload="..."
        function hideLoader() {
            $('#previewLoader').hide();
