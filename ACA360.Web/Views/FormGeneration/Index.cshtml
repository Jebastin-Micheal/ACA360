                    <!-- 1094-C & 1095-C (Combined) -->
                    <div class="card form-type-card p-3 border shadow-sm card-lift cursor-pointer" data-form-type="1094-C_1095-C">
                        <div class="rounded-3 d-flex align-items-center justify-content-center mb-3 icon-container bg-label-primary w-px-40 h-px-40">
                            <i class='bx bx-layer text-primary fs-5'></i>
                        </div>
                        <h6 class="fw-bold mb-1 form-title text-heading">1094-C & 1095-C</h6>
                        <small class="text-muted m-0 form-type-text">Combined Transmittal and Offer of Coverage</small>
                        <div class="active-indicator mt-2 d-none align-items-center gap-2">
                            <span class="badge badge-dot bg-primary"></span>
                            <small class="fw-bold text-primary text-uppercase" style="letter-spacing: 1px;">Active</small>
                        </div>
                    </div>

                    <!-- 1094-B & 1095-B (Combined) -->
                    <div class="card form-type-card p-3 border shadow-sm card-lift cursor-pointer" data-form-type="1094-B_1095-B">
                        <div class="rounded-3 d-flex align-items-center justify-content-center mb-3 icon-container bg-label-secondary w-px-40 h-px-40">
                            <i class='bx bx-layer text-secondary fs-5'></i>
                        </div>
                        <h6 class="fw-bold mb-1 form-title text-heading">1094-B & 1095-B</h6>
                        <small class="text-muted m-0 form-type-text">Combined Transmittal and Health Coverage</small>
                        <div class="active-indicator mt-2 d-none align-items-center gap-2">
                            <span class="badge badge-dot bg-primary"></span>
                            <small class="fw-bold text-primary text-uppercase" style="letter-spacing: 1px;">Active</small>
                        </div>
                    </div>
                </div>
            </aside>
            <!-- Column 2: Employers (col-md-3) -->
            <section class="col-md-3 border-end d-flex flex-column p-0 mt-1" style="height: 75vh;">

                <!-- Sticky Header with Filters -->
                <!-- Removed 'glass' class to prevent white background bleed in dark mode -->
                <div class="position-sticky top-0 z-10 border-bottom p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0 fw-bold text-heading">Employers</h5>
                        <!-- Replaced bg-light and text-dark with bg-label-secondary -->
                        <span class="badge bg-label-secondary px-3 py-2 rounded-pill shadow-sm">@Model.Employers.Count Total</span>
                    </div>

                    <!-- Employer Column Filters -->
                 
<div class="d-flex gap-2 mb-3">
    <select id="yearFilterDropdown" name="year" asp-items="ViewBag.Years" asp-for="SelectedYear"
            class="form-select form-select-sm shadow-sm fw-bold text-primary"
