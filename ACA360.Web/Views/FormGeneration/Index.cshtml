                            <span class="input-group-text bg-transparent border-end-0"><i class="bx bx-search text-muted"></i></span>
                            <input type="text" id="employerSearch" class="form-control border-start-0 bg-transparent" placeholder="Search Employer or EIN..." value="@Model.SearchTerm" autocomplete="off">
                        </div>
