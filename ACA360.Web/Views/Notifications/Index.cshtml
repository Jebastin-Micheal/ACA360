@model ACA360.Core.Models.NotificationListViewModel

@{
    ViewData["Title"] = "Notifications";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-12">

            <div class="card mb-4">
                <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class='bx bx-bell me-2'></i>Notifications</h5>
                    <div>
                        <form asp-action="MarkAllAsRead" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                <i class="bx bx-check-double me-1"></i> Mark all as read
                            </button>
                        </form>
                    </div>
                </div>

                <div class="card-body pb-0 pt-3">
                    <ul class="nav nav-pills" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link @(Model.ActiveFilter == "All" ? "active" : "")"
                               href="@Url.Action("Index", new { filter = "All", page = 1 })">
                                All
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Model.ActiveFilter == "Unread" ? "active" : "")"
                               href="@Url.Action("Index", new { filter = "Unread", page = 1 })">
                                Unread
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Model.ActiveFilter == "Read" ? "active" : "")"
                               href="@Url.Action("Index", new { filter = "Read", page = 1 })">
                                Read
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card">
                <div class="list-group list-group-flush">
                    @if (Model.Notifications.Any())
                    {
                        foreach (var item in Model.Notifications)
                        {
                            var bgClass = item.IsRead ? "" : "bg-label-secondary"; // Highlight unread
                            var iconClass = item.Type?.ToLower() switch
                            {
                                "success" => "bx-check-circle text-success",
                                "danger" => "bx-error text-danger",
                                "warning" => "bx-error-circle text-warning",
                                _ => "bx-info-circle text-primary"
                            };

                            <a href="javascript:void(0);"
                               class="list-group-item list-group-item-action d-flex align-items-center @bgClass notification-item"
                               data-id="@item.NotificationId"
                               data-title="@item.Title"
                               data-message="@item.Message"
                               data-date="@item.CreatedDate.ToString("MMM dd, yyyy HH:mm")"
                               data-url="@item.LinkUrl"
                               onclick="viewNotification(this)">

                                <div class="avatar me-3">
                                    <span class="avatar-initial rounded-circle bg-label-light">
                                        <i class='bx @iconClass fs-4'></i>
                                    </span>
                                </div>

                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0 fw-bold">@item.Title</h6>
                                        <small class="text-muted">@item.CreatedDate.ToString("MMM dd, HH:mm")</small>
                                    </div>
                                    <p class="mb-0 text-muted small text-truncate" style="max-width: 600px;">@item.Message</p>
                                </div>

                                @if (!item.IsRead)
                                {
                                    <span class="badge badge-dot bg-primary ms-2 status-dot"></span>
                                }
                            </a>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class='bx bx-bell-off fs-1 text-muted'></i>
                            <p class="mt-2 text-muted">No notifications found.</p>
                        </div>
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer d-flex justify-content-center border-top">
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { filter = Model.ActiveFilter, page = Model.CurrentPage - 1 })">
                                        <i class="bx bx-chevron-left"></i>
                                    </a>
                                </li>

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { filter = Model.ActiveFilter, page = i })">@i</a>
                                    </li>
                                }

                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { filter = Model.ActiveFilter, page = Model.CurrentPage + 1 })">
                                        <i class="bx bx-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="notificationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Notification Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="mb-3 text-muted small">
                                <i class="bx bx-time-five me-1"></i> <span id="modalDate"></span>
                            </div>
                            <p id="modalMessage" class="fs-6"></p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-3">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <a href="#" id="modalActionLink" class="btn btn-primary d-none">View Action <i class="bx bx-right-arrow-alt"></i></a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewNotification(element) {
            // 1. Get data from data attributes
            var id = $(element).data('id');
            var title = $(element).data('title');
            var message = $(element).data('message');
            var date = $(element).data('date');
            var url = $(element).data('url');

            // 2. Populate Modal
            $('#modalTitle').text(title);
            $('#modalMessage').text(message);
            $('#modalDate').text(date);

            // Handle Action Button
            var btnLink = $('#modalActionLink');
            if (url && url !== '#') {
                btnLink.attr('href', url);
                btnLink.removeClass('d-none');
            } else {
                btnLink.addClass('d-none');
            }

            // 3. Show Modal
            var myModal = new bootstrap.Modal(document.getElementById('notificationModal'));
            myModal.show();

            // 4. Mark as Read (Visual + Backend)
            if ($(element).hasClass('bg-label-secondary')) {
                // Visual update: Remove grey bg and dot
                $(element).removeClass('bg-label-secondary');
                $(element).find('.status-dot').remove();

                // Backend update
                $.post('/Notifications/MarkAsRead?id=' + id);

                // Optional: Update navbar badge count using your existing logic
                // updateNotificationCount();
            }
        }
    </script>
}