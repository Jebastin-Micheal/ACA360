@* ════════════════════════════════════════════════════════════════════
   _ReceiptIdModal.cshtml — Shared Receipt ID modal
   Place at: Views/Shared/_ReceiptIdModal.cshtml
   Used by:  Dashboard.cshtml AND Index.cshtml
   Driven by: wwwroot/js/vscript/dashboard-receipt-id.js
   ════════════════════════════════════════════════════════════════════ *@

<div class="modal fade" id="receiptIdModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-bottom py-3 px-4">
                <div class="d-flex align-items-center">
                    <div class="avatar avatar-sm rounded bg-label-primary me-3 d-flex align-items-center justify-content-center shadow-sm">
                        <i class="bx bx-receipt fs-4"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="receiptModalTitle">Receipt Center</h5>
                        <small class="text-muted fw-semibold" id="receiptModalSubtitle">Plan Year: —</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="row g-0 h-100" style="min-height: 550px;">

                                @* ── LEFT SIDE: LIST & METRICS (Master) ── *@
                                <div class="col-md-7 border-end d-flex flex-column bg-body" id="receiptListMasterCol">

                                    @* Header / Stats Section *@
                                    <div class="p-4 border-bottom">
                                        <div class="d-flex align-items-center justify-content-between mb-0">
                                            <div class="d-flex gap-4">
                                                <div class="metric-box">
                                                    <div class="text-heading fw-bold fs-4 mb-0" id="receiptCountLarge">0</div>
                                                    <small class="text-heading text-uppercase fw-semibold letter-spacing-px x-small">Total Filing</small>
                                                </div>
                                                <div class="metric-box border-start ps-4">
                                                    <div class="text-success fw-bold fs-4 mb-0" id="receiptSyncCount">0</div>
                                                    <small class="text-heading text-uppercase fw-semibold letter-spacing-px x-small">Recent Sync</small>
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-primary d-flex align-items-center" onclick="prepareAddReceipt()">
                                                <i class="bx bx-plus-circle me-1"></i> Add New
                                            </button>
                                        </div>
                                    </div>

                                    @* Scrollable List Area *@
                                    <div class="flex-grow-1 overflow-auto bg-body p-3" id="receiptListContainer">
                                        <div class="text-center text-heading py-5 mt-5">
                                            <div class="spinner-border text-primary mb-3"></div>
                                            <p class="fw-semibold">Loading receipt history...</p>
                                        </div>
                                    </div>
                                </div>

                                @* ── RIGHT SIDE: FORM PANEL (Detail) ── *@
                                <div class="col-md-5 d-flex flex-column bg-lighter" id="rcptFormPanel">
                                    <div class="p-4 h-100">
                                        <div class="card shadow-none bg-transparent border-0 h-100" id="rcptFormCard">
                                            <div class="card-header p-0 bg-transparent border-0 mb-4">
                                                <div class="d-flex align-items-center justify-content-between">
                                                    <h5 class="m-0 fw-bold text-heading d-flex align-items-center" id="rcptDrawerTitle">
                                                        <i class="bx bx-plus-circle me-2 fs-4 text-primary"></i>Add Receipt ID
                                                    </h5>
                                                    <button type="button" class="btn btn-sm btn-icon btn-label-secondary d-md-none" onclick="toggleRcptForm(false)">
                                                        <i class="bx bx-chevron-left"></i>
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="card-body p-0">
                                                <div class="row g-3">
                                                    <div class="col-12">
                                                        <label class="form-label text-muted text-uppercase fw-bold small mb-1">Affiliate / EIN Selection</label>
                                                        <select id="rcptEINSelect" class="form-select border-1 fw-semibold text-heading py-2">
                                                            <option value="">— Select EIN —</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-12">
                                                        <label class="form-label text-muted text-uppercase fw-bold small mb-1">Receipt ID Value</label>
                                                        <div class="input-group input-group-merge">
                                                            <span class="input-group-text"><i class="bx bx-hash"></i></span>
                                                            <input type="text" id="rcptIdInput" class="form-control fw-bold text-primary py-2"
                                                                   placeholder="e.g., REC-2025-XXXX" maxlength="100" />
                                                        </div>
                                                    </div>
                                                    <div class="col-12">
                                                        <label class="form-label text-muted text-uppercase fw-bold small mb-1">Received Date</label>
                                                        <div class="input-group input-group-merge">
                                                            <span class="input-group-text"><i class="bx bx-calendar"></i></span>
                                                            <input type="date" id="rcptDateInput" class="form-control py-2" />
                                                        </div>
                                                    </div>
                                                    <div class="col-12">
                                                        <label class="form-label text-muted text-uppercase fw-bold small mb-1">Internal Notes</label>
                                                        <textarea id="rcptNotesInput" class="form-control" rows="4"
                                                                  placeholder="Enter tracking details, filing batch info, etc..." maxlength="500"></textarea>
                                                    </div>

                                                    <div class="col-12 d-grid mt-4 pt-2">
                                                        <button type="button" class="btn btn-primary btn-lg fw-bold shadow-sm py-2" id="btnSaveReceipt" onclick="saveReceiptId()">
                                                            <i class="bx bx-save me-2"></i> <span id="btnSaveRcptLabel">Save Receipt</span>
                                                        </button>
                                                        <button type="button" class="btn btn-label-secondary mt-3" onclick="clearReceiptForm()">
                                                            <i class="bx bx-reset me-1 small"></i> Reset Form
                                                        </button>
                                                    </div>
                                                </div>
                                                <input type="hidden" id="rcptEditId" value="0" />
                                            </div>
                                        </div>

                                        @* Empty State Prompt (Visible when no item selected and not adding) *@
                                        <div id="rcptFormEmptyState" class="text-center py-5 my-5 d-none">
                                            <div class="opacity-25 mb-3">
                                                <i class="bx bx-pointer fs-1 d-block mb-1"></i>
                                                <i class="bx bx-receipt fs-1 d-block" style="margin-top:-20px"></i>
                                            </div>
                                            <h6 class="fw-bold text-heading mb-1">No Active Selection</h6>
                                            <p class="small text-muted px-5">Select a receipt from the history list to edit, or click "Add New" to record a new filing.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top bg-body py-3 px-4">
                <div class="d-flex align-items-center justify-content-between w-100">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge badge-center rounded-pill bg-label-secondary" style="width:24px; height:24px"><i class="bx bx-info-circle small"></i></span>
                        <span class="text-heading small fw-semibold" id="receiptCount">0 receipts found</span>
                    </div>
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">
                        <i class="bx bx-x me-1"></i> Close
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
