@using ACA360.Core.Models
@model List<Menu>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    
}

<ul class="menu-inner py-1 scrollable-sidenav">
    @foreach (var topLevelMenu in Model.Where(m => m.ParentMenuId == null).OrderBy(m => m.DisplayOrder))
    {
        <!-- Pass 'false' because this is NOT horizontal -->
        @await Html.PartialAsync("_RecursiveSidebarItem", (topLevelMenu, Model, currentController, false))
    }

    <li class="menu-item">
        <a href="@Url.Action("Logout", "Account")" class="menu-link">
            <i class="menu-icon icon-base bx bx-power-off"></i>
            <div data-i18n="Log Out">Log Out</div>
        </a>
    </li>
</ul>

