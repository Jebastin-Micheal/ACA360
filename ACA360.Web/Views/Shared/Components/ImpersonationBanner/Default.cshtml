@model ACA360.Core.Models.EffectiveContext

@if (Model.IsImpersonating)
{
    <style>
        .imp-banner {
            background: linear-gradient(90deg,#7c3f00 0%,#9a5000 100%);
            color: #ffe9c7;
            box-shadow: 0 2px 6px rgba(0,0,0,.18);
            position: relative;
            z-index: 1030;
        }

        .imp-banner-in {
            max-width: 1560px;
            margin: 0 auto;
            padding: 10px 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
            font-size: 13.5px;
        }

        .imp-banner .eye {
            font-size: 20px;
            line-height: 1;
            opacity: .9;
        }

        .imp-banner .who {
            font-weight: 700;
        }

        .imp-banner .ro {
            background: #ffe9c7;
            color: #7c3f00;
            border-radius: 999px;
            padding: 2px 10px;
            font-size: 10.5px;
            letter-spacing: .08em;
            text-transform: uppercase;
            font-weight: 800;
        }

        .imp-banner .note {
            opacity: .85;
        }

        .imp-banner form {
            margin-left: auto;
        }

        .imp-banner button {
            background: #ffe9c7;
            color: #7c3f00;
            border: 0;
            border-radius: 6px;
            padding: 6px 14px;
            font-weight: 700;
            cursor: pointer;
            font: inherit;
        }

            .imp-banner button:hover {
                background: #fff;
            }

        @@media (max-width:720px) {
            .imp-banner form {
                margin-left: 0;
                width: 100%;
            }
        }
    </style>

    <div class="imp-banner">
        <div class="imp-banner-in">
            <i class="bx bx-show eye"></i>
            <span class="ro">Read only</span>
            <span class="who">@Model.BannerText</span>
            <span class="note">Changes are disabled and this session is recorded against your account.</span>

            <form asp-controller="ViewAs" asp-action="End" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit"><i class="bx bx-arrow-back me-1"></i> Return to my view</button>
            </form>
        </div>
    </div>
}