    </div>

    <script>
            $(document).ready(function () {
                checkMaintenanceBadge();
            });

            function checkMaintenanceBadge() {

            $.get("/System/CheckMode", function (res) {

                    const isMaintenance = res.maintenanceMode === true;

                    if (isMaintenance) {
                        $("#maintenanceBadge").removeClass("d-none").addClass("bg-danger");
                    } else {
                        $("#maintenanceBadge").addClass("d-none");
                    }
                }).fail(function() {
                    console.error("Failed to fetch maintenance status.");
                });
            }
        </script>
    @RenderSection("Scripts", required: false)
    <script>
        $(document).ready(function() {
            // Start polling
            loadNotifications(); // Load immediately
            setInterval(loadNotifications, 15000); // Then every 15s
        });

        function loadNotifications() {
            $.get('/Notifications/GetNewNotifications', function(data) {
                // 1. Update the "New" Count Badge
                var count = data ? data.length : 0;
                $('#notification-count').text(count + " New");

                if (count > 0) {
                    $('#notification-indicator').show(); // Show Red Dot
                } else {
                    $('#notification-indicator').hide(); // Hide Red Dot
                }

                // 2. Clear and Re-populate the List
                var listContainer = $('#notification-list');
                listContainer.empty(); // Clear old items

                if (count === 0) {
                    listContainer.append(`
                        <li class="list-group-item text-center text-muted small py-4">
                            No new notifications
                        </li>
                    `);
                    return;
                }

                // 3. Render Items
                data.forEach(function(n) {
                    // Determine Icon/Color based on type
                    var iconClass = 'bx-info-circle';
                    var bgClass = 'bg-label-primary';

                    if(n.type === 'success') { iconClass = 'bx-check-circle'; bgClass = 'bg-label-success'; }
                    else if(n.type === 'danger') { iconClass = 'bx-error'; bgClass = 'bg-label-danger'; }
                    else if(n.type === 'warning') { iconClass = 'bx-alarm-exclamation'; bgClass = 'bg-label-warning'; }

                    var timeAgo = timeSince(new Date(n.createdDate));

                    var html = `
                    <li class="list-group-item list-group-item-action dropdown-notifications-item">
                        <div class="d-flex">
                            <div class="flex-shrink-0 me-3">
                                <div class="avatar">
                                    <span class="avatar-initial rounded-circle ${bgClass}"><i class='bx ${iconClass}'></i></span>
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="small mb-0">${n.title}</h6>
                                <small class="mb-1 d-block text-body">${n.message}</small>
                                <small class="text-muted">${timeAgo}</small>
                            </div>
                            <div class="flex-shrink-0 dropdown-notifications-actions">
                                <a href="javascript:void(0)" class="dropdown-notifications-read" onclick="markAsRead(${n.notificationId})"><span class="badge badge-dot"></span></a>
                                <a href="javascript:void(0)" class="dropdown-notifications-archive" onclick="markAsRead(${n.notificationId})"><span class="icon-base bx bx-x"></span></a>
                            </div>
                        </div>
                    </li>`;

                    listContainer.append(html);

                    // TRIGGER TOASTR
                showToast(n);
                });
            });
        }
            // 2. Unified Click Handler
        function handleNotificationClick(e, id, url) {
            // If it's a link, allow default behavior, but fire async mark-read
            // If it's void, prevent default
            if(!url || url === 'null') {
                e.preventDefault();
            }

            // Fire and forget (server marks read)
            $.post('/Notifications/MarkAsRead?id=' + id);

            // If we have a URL and we prevented default (or want to force it), navigate
            if(url && url !== 'null' && url !== '') {
                window.location.href = url;
            }
        }

        // 3. Corrected Toastr Logic
        function showToast(n) {
            var options = {
                "closeButton": true,
                "progressBar": true,
                "timeOut": "10000",
                "onclick": function() {
                    // Handle Toastr Click
                    handleNotificationClick(event, n.notificationId, n.linkUrl);
                }
            };

            if (n.type === 'success') toastr.success(n.message, n.title, options);
            else if (n.type === 'danger') toastr.error(n.message, n.title, options);
            else toastr.info(n.message, n.title, options);
        }
        // Helper: "10 minutes ago"
        function timeSince(date) {
            var seconds = Math.floor((new Date() - date) / 1000);
            var interval = seconds / 31536000;
            if (interval > 1) return Math.floor(interval) + " years ago";
            interval = seconds / 2592000;
            if (interval > 1) return Math.floor(interval) + " months ago";
            interval = seconds / 86400;
            if (interval > 1) return Math.floor(interval) + " days ago";
            interval = seconds / 3600;
            if (interval > 1) return Math.floor(interval) + " hours ago";
            interval = seconds / 60;
            if (interval > 1) return Math.floor(interval) + " minutes ago";
            return Math.floor(seconds) + " seconds ago";
        }

                //helper for loader
                function triggerFileDownload(url) {
            var iframe = document.createElement('iframe');
            iframe.style.display = 'none';
            iframe.src = url;
            document.body.appendChild(iframe);
            setTimeout(function () { iframe.remove(); }, 15000);
        }

        function markAsRead(id) {
            $.post('/Notifications/MarkAsRead?id=' + id, function() {
                loadNotifications(); // Reload list
            });
        }
    </script>
   
    <script>
        window.addEventListener("load", function () {

            const menuEl = document.querySelector('#layout-menu');
            const activeItem = document.querySelector('.menu-item.active');

            if (!menuEl || !menuEl.menuInstance || !activeItem) return;

            const menu = menuEl.menuInstance;
            const items = Array.from(menu._inner.children).filter(x => x.classList.contains('menu-item'));

            const visibleCount = 4;
            const activeIndex = items.indexOf(activeItem);

            if (activeIndex === -1) return;


            let startIndex = Math.abs(menu._innerPosition) > 0
                ? Math.round(Math.abs(menu._innerPosition) / activeItem.getBoundingClientRect().width)
                : 0;

            let endIndex = startIndex + visibleCount - 1;


            if (activeIndex >= endIndex) {
                startIndex = activeIndex - (visibleCount - 1);
            }


            if (activeIndex < startIndex) {
                startIndex = activeIndex;
            }


            let offset = 0;
            for (let i = 0; i < startIndex; i++) {
                offset += items[i].getBoundingClientRect().width;
            }


            menu._innerPosition = -offset;
            menu.update();
        });
    </script>

    <div class="modal fade" id="notesModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
