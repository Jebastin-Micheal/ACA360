                <img src="~/images/Loader/Wave1.png" class="wavelayout wave1" alt="">
                <img src="~/images/Loader/Wave2.png" class="wavelayout wave2" alt="">
                <img src="~/images/Loader/Wave3.png" class="wavelayout wave3" alt="">
            </div>

