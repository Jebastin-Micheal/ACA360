        #page-loader svg {
            will-change: transform;
        }

        #page-loader.active {
            display: flex !important;
        }
    </style>
    @* in <head>, after the site stylesheet *@
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    
