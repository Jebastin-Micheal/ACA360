                        </div>
                        @if (User.Identity?.IsAuthenticated == true
                                            && ViewContext.RouteData.Values["Controller"]?.ToString() == "Employer"
                                            && ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard")
                        {
                            @await Component.InvokeAsync("ImpersonationBanner")
