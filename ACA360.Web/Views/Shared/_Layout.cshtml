        <script src="~/js/aca360-tour.js" asp-append-version="true" defer
                data-role="@layoutCtx.ActorRole"
                data-home-url="@Url.Action("Index", "Dashboard")"
                data-status-url="@Url.Action("Status", "Tour")"
                data-seen-url="@Url.Action("Seen", "Tour")"></script>
    }
    <script>
        window.shouldShowCustomizer = @isSuperAdmin
    </script>
    @await Html.PartialAsync("Components/_Styles")
