    <script>
            $(document).ready(function () {
                checkMaintenanceBadge();
            });

            function checkMaintenanceBadge() {

            $.get("/System/CheckMode", function (res) {

                    const isMaintenance = res.maintenanceMode === true;

                    if (isMaintenance) {
                        $("#maintenanceBadge").removeClass("d-none").addClass("bg-danger");
                    } else {
                        $("#maintenanceBadge").addClass("d-none");
                    }
                }).fail(function() {
                    console.error("Failed to fetch maintenance status.");
                });
            }
        </script>
    @RenderSection("Scripts", required: false)
    <script>
        // Session ended (logout elsewhere or idle timeout): leave the page, don't keep showing data.
        $(document).ajaxError(function (event, xhr) {
            if (xhr.status === 401) {
                window.location.href = '/Account/Login?ReturnUrl=' + encodeURIComponent(location.pathname + location.search);
            }
        });

        $(document).ready(function() {
            // Start polling
            loadNotifications(); // Load immediately
            setInterval(loadNotifications, 15000); // Then every 15s
        });

        // The bell (script 070): unread count and the latest notifications. Reading no longer
        // marks them read; opening one does (or the dot / "mark all"). New ones also pop up once.
        var notifSeenKey = 'aca360.notif.lastToast';
        function notifEsc(v) { return $('<div>').text(v == null ? '' : String(v)).html(); }
        function notifToken() { return $('#notification-bell-token input[name="__RequestVerificationToken"]').val() || ''; }

        function loadNotifications() {
            $.get('/Notifications/GetNewNotifications', function (data) {
                var unread = (data && data.unread) || 0;
                var items = (data && data.items) || [];
                $('#notification-count').text(unread + ' New');
                $('#notification-indicator').toggle(unread > 0);

                var listContainer = $('#notification-list').empty();
                if (items.length === 0) {
                    listContainer.append('<li class="list-group-item text-center text-body opacity-75 small py-4">No notifications yet</li>');
                    return;
                }

                var lastToast = 0;
                try { lastToast = parseInt(sessionStorage.getItem(notifSeenKey) || '0', 10) || 0; } catch (e) { }
                var firstLoad = lastToast === 0;
                var newest = lastToast;

                items.forEach(function (n) {
                    var iconClass = 'bx-info-circle', bgClass = 'bg-label-primary';
                    if (n.type === 'success') { iconClass = 'bx-check-circle'; bgClass = 'bg-label-success'; }
                    else if (n.type === 'danger') { iconClass = 'bx-error'; bgClass = 'bg-label-danger'; }
                    else if (n.type === 'warning') { iconClass = 'bx-alarm-exclamation'; bgClass = 'bg-label-warning'; }

                    listContainer.append(
                        '<li class="list-group-item list-group-item-action dropdown-notifications-item' + (n.isRead ? ' marked-as-read' : '') + '" data-notification-id="' + n.notificationId + '">' +
                        '<a class="d-flex text-reset text-decoration-none" href="' + notifEsc(n.openUrl) + '">' +
                        '<div class="flex-shrink-0 me-3"><div class="avatar"><span class="avatar-initial rounded-circle ' + bgClass + '"><i class="bx ' + iconClass + '"></i></span></div></div>' +
                        '<div class="flex-grow-1 min-w-0">' +
                        '<h6 class="small mb-0' + (n.isRead ? '' : ' fw-bold') + '">' + notifEsc(n.title) + '</h6>' +
                        '<small class="mb-1 d-block text-body text-break">' + notifEsc(n.message) + '</small>' +
                        '<small class="text-body opacity-75">' + notifEsc(timeSince(new Date(n.createdDate))) + '</small>' +
                        '</div></a>' +
                        (n.isRead ? '' : '<div class="flex-shrink-0 dropdown-notifications-actions"><a href="javascript:void(0)" class="dropdown-notifications-read" title="Mark as read" onclick="markAsRead(' + n.notificationId + ')"><span class="badge badge-dot"></span></a></div>') +
                        '</li>');

                    if (!n.isRead && n.notificationId > lastToast) {
                        if (!firstLoad) showToast(n);
                        newest = Math.max(newest, n.notificationId);
                    }
                });
                if (firstLoad) newest = Math.max.apply(null, items.map(function (n) { return n.notificationId; }));
                try { sessionStorage.setItem(notifSeenKey, String(newest)); } catch (e) { }
            });
        }

        function showToast(n) {
            if (typeof toastr === 'undefined') return;
            var options = {
                closeButton: true, progressBar: true, timeOut: 10000, escapeHtml: true,
                onclick: function () { window.location.href = n.openUrl; }
            };
            if (n.type === 'success') toastr.success(n.message, n.title, options);
            else if (n.type === 'danger') toastr.error(n.message, n.title, options);
            else if (n.type === 'warning') toastr.warning(n.message, n.title, options);
            else toastr.info(n.message, n.title, options);
        }

        $(document).on('click', '.dropdown-notifications-all', function () {
            $.ajax({ url: '/Notifications/MarkAllAsRead', type: 'POST', data: { __RequestVerificationToken: notifToken() } })
                .always(loadNotifications);
        });
        // Helper: "10 minutes ago"
        function timeSince(date) {
            var seconds = Math.floor((new Date() - date) / 1000);
            var interval = seconds / 31536000;
            if (interval > 1) return Math.floor(interval) + " years ago";
            interval = seconds / 2592000;
            if (interval > 1) return Math.floor(interval) + " months ago";
            interval = seconds / 86400;
            if (interval > 1) return Math.floor(interval) + " days ago";
            interval = seconds / 3600;
            if (interval > 1) return Math.floor(interval) + " hours ago";
            interval = seconds / 60;
            if (interval > 1) return Math.floor(interval) + " minutes ago";
            return Math.floor(seconds) + " seconds ago";
        }

                //helper for loader
                function triggerFileDownload(url) {
            var iframe = document.createElement('iframe');
            iframe.style.display = 'none';
            iframe.src = url;
            document.body.appendChild(iframe);
            setTimeout(function () { iframe.remove(); }, 15000);
        }

        function markAsRead(id) {
            $.ajax({ url: '/Notifications/MarkAsRead', type: 'POST', data: { id: id, __RequestVerificationToken: notifToken() } })
                .always(loadNotifications);
        }
    </script>
   
    <script>
        window.addEventListener("load", function () {

            const menuEl = document.querySelector('#layout-menu');
            const activeItem = document.querySelector('.menu-item.active');

            if (!menuEl || !menuEl.menuInstance || !activeItem) return;

            const menu = menuEl.menuInstance;
            const items = Array.from(menu._inner.children).filter(x => x.classList.contains('menu-item'));

            const visibleCount = 4;
            const activeIndex = items.indexOf(activeItem);

            if (activeIndex === -1) return;


            let startIndex = Math.abs(menu._innerPosition) > 0
                ? Math.round(Math.abs(menu._innerPosition) / activeItem.getBoundingClientRect().width)
                : 0;

            let endIndex = startIndex + visibleCount - 1;


            if (activeIndex >= endIndex) {
                startIndex = activeIndex - (visibleCount - 1);
            }


            if (activeIndex < startIndex) {
                startIndex = activeIndex;
            }


            let offset = 0;
            for (let i = 0; i < startIndex; i++) {
                offset += items[i].getBoundingClientRect().width;
            }


            menu._innerPosition = -offset;
            menu.update();
        });
    </script>

