    <!-- AM Report / Data Analyst Report modal trigger -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('click', function (e) {
            // The ^= operator matches any href that STARTS with the specified string, ignoring query params
            var link = e.target.closest('a[href^="/AMReport"], a[href^="/DataAnalystReport"]');
            if (!link) return;
            e.preventDefault();
            // Check if the href contains the path, rather than matching exactly
            if (link.getAttribute('href').includes('/AMReport')) {
                openAmReportModal();
            } else {
                openDaReportModal();
            }
        });

        function openAmReportModal() {
            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('amReportModal'));
            Promise.all([
                fetch('/AMReport/GetAccountManagers').then(res => res.json()),
                fetch('/AMReport/GetFilingYears').then(res => res.json())
            ]).then(([managers, years]) => {
                var ddl = document.getElementById('ddlAcctManager');
                ddl.innerHTML = '<option value="">Select Account Manager</option>';
                managers.forEach(am => {
                    var opt = document.createElement('option');
                    opt.value = am.staffId; opt.text = am.staffName;
                    ddl.appendChild(opt);
                });

                var ddlYear = document.getElementById('ddlAmFilingYear');
                if (ddlYear) {
                    ddlYear.innerHTML = '';
                    years.forEach(y => {
                        var opt = document.createElement('option');
                        opt.value = y; opt.text = y;
                        if (y == '@Context.Session.GetString("SelectedFilingYear")') opt.selected = true;
                        ddlYear.appendChild(opt);
                    });
                }

                // reset any old validation state when modal opens
                ddl.classList.remove('is-invalid');
                var amErr = document.getElementById('amError');
                if (amErr) amErr.style.display = 'none';

                modal.show();
            });
        }

        function openDaReportModal() {
            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('daReportModal'));
            Promise.all([
                fetch('/DataAnalystReport/GetDataAnalysts').then(res => res.json()),
                fetch('/DataAnalystReport/GetFilingYears').then(res => res.json())
            ]).then(([analysts, years]) => {
                var ddl = document.getElementById('ddlDataAnalyst');
                ddl.innerHTML = '<option value="">Select Data Analyst</option>';
                analysts.forEach(da => {
                    var opt = document.createElement('option');
                    opt.value = da.staffId; opt.text = da.staffName;
                    ddl.appendChild(opt);
                });

                var ddlYear = document.getElementById('ddlDaFilingYear');
                if (ddlYear) {
                    ddlYear.innerHTML = '';
                    years.forEach(y => {
                        var opt = document.createElement('option');
                        opt.value = y; opt.text = y;
                        if (y == '@Context.Session.GetString("SelectedFilingYear")') opt.selected = true;
                        ddlYear.appendChild(opt);
                    });
                }

                ddl.classList.remove('is-invalid');
                var daErr = document.getElementById('daError');
                if (daErr) daErr.style.display = 'none';

                modal.show();
            });
        }

        // clear red border the moment user picks a value
        document.addEventListener('change', function (e) {
            if (e.target.id === 'ddlAcctManager' && e.target.value) {
                e.target.classList.remove('is-invalid');
                var amErr = document.getElementById('amError');
                if (amErr) amErr.style.display = 'none';
            }
            if (e.target.id === 'ddlDataAnalyst' && e.target.value) {
                e.target.classList.remove('is-invalid');
                var daErr = document.getElementById('daError');
                if (daErr) daErr.style.display = 'none';
            }
        });

        document.addEventListener('click', function (e) {
            if (e.target.id === 'getAmReportBtn') {
                var ddl = document.getElementById('ddlAcctManager');
                var id = ddl.value;
                var year = document.getElementById('ddlAmFilingYear').value;

                if (!id) {
                    ddl.classList.add('is-invalid');
                    var amErr = document.getElementById('amError');
                    if (amErr) amErr.style.display = 'block';
                    return;
                }
                ddl.classList.remove('is-invalid');
                var amErr2 = document.getElementById('amError');
                if (amErr2) amErr2.style.display = 'none';

                var name = ddl.options[ddl.selectedIndex].text;
                fetch('/AMReport/HasReportData?acctManagerId=' + id + '&filingYear=' + year)
                    .then(res => res.json())
                    .then(result => {
                        if (result.hasData) {
                            bootstrap.Modal.getInstance(document.getElementById('amReportModal'))?.hide();
                            triggerFileDownload('/AMReport/Download?acctManagerId=' + id + '&acctManagerName=' + name.replace(/ /g, '_') + '&filingYear=' + year);
                        } else {
                            Swal.fire({ icon: 'info', title: 'No Records Found', text: 'No employers are currently assigned to "' + name + '" for ' + year + '.' });
                        }
                    });
            }

            if (e.target.id === 'getDaReportBtn') {
                var ddl = document.getElementById('ddlDataAnalyst');
                var id = ddl.value;
                var year = document.getElementById('ddlDaFilingYear').value;

                if (!id) {
                    ddl.classList.add('is-invalid');
                    var daErr = document.getElementById('daError');
                    if (daErr) daErr.style.display = 'block';
                    return;
                }
                ddl.classList.remove('is-invalid');
                var daErr2 = document.getElementById('daError');
                if (daErr2) daErr2.style.display = 'none';

                var name = ddl.options[ddl.selectedIndex].text;
                fetch('/DataAnalystReport/HasReportData?dataAnalystId=' + id + '&filingYear=' + year)
                    .then(res => res.json())
                    .then(result => {
                        if (result.hasData) {
                            bootstrap.Modal.getInstance(document.getElementById('daReportModal'))?.hide();
                            triggerFileDownload('/DataAnalystReport/Download?dataAnalystId=' + id + '&dataAnalystName=' + name.replace(/ /g, '_') + '&filingYear=' + year);
                        } else {
                            Swal.fire({ icon: 'info', title: 'No Records Found', text: 'No employers are currently assigned to "' + name + '" for ' + year + '.' });
                        }
                    });
            }
        });
    </script>

</body>
