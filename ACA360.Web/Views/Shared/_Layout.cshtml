@using ACA360.Core.Constants
@using ACA360.Core.Models;
@using ACA360.Core.Extensions;
@using Newtonsoft.Json;
@using System.Security.Claims;
@inject IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    var FilingYear = session?.GetObject<List<FilingYearModel>>("FilingYear") ?? new();
    var selectedEmployer = session?.GetString("SelectedEmployerName") ?? "";
    var selectedFilingYear = Context.Session.GetString("SelectedFilingYear") ?? "";
//     var showMenus = (!string.IsNullOrEmpty(selectedEmployer) && !string.IsNullOrEmpty(selectedFilingYear))
// || User.IsInRole(UserRoles.DataAnalyst) || User.IsInRole(UserRoles.SuperAdmin); 
    var showMenus = (!string.IsNullOrEmpty(selectedEmployer) && !string.IsNullOrEmpty(selectedFilingYear))
    || User.IsInRole(UserRoles.DataAnalyst);
    var navigationLike = Context.Request.Cookies["NavigationLike"] ?? "topnav";
    var isSideNav = navigationLike == "sidenav";
    var htmlClass = isSideNav
        ? "layout-navbar-fixed layout-compact layout-menu-fixed"
        : "layout-compact layout-menu-fixed";
    var dataTemplate = isSideNav ? "vertical-menu-template" : "horizontal-menu-template";
    var semiDarkMenuAttr = isSideNav ? "data-semidark-menu=\"true\"" : "";
    var isSuperAdmin = User.IsInRole(UserRoles.SuperAdmin).ToString().ToLower();
}
