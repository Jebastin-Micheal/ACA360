        @* <div class="loader d-flex flex-column align-items-center justify-content-center text-center">
           <img src="~/images/Loader/sample.png" alt="Loader" class="mb-2">
           <span class="fw-bold fs-5 text-primary">ACA</span>
       </div> *@
