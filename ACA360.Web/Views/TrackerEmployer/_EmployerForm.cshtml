@using ACA360.Web.Helpers
@using ACA360.Core.Constants

@model ACA360.Core.Models.Tracker.TrackerEmployerItem
<form id="frmMain" class="browser-default-validation" autocomplete="off">
    <div class="modal-header border-bottom py-3 bg-label-dark frmMain-header">
        <div class="d-flex align-items-center">
            <div class="avatar avatar-md me-3">
                <span class="avatar-initial rounded-circle bg-dark shadow-sm">
                    <i class="bx bx-buildings fs-3"></i>
                </span>
            </div>
            <div>
                <h5 class="modal-title fw-bold mb-0">Employer Overview</h5>                
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body py-4" style="max-height: 70vh; overflow-y: auto; overflow-x: hidden;">
        <div class="col-12">
            <div class="card">
                <div class="card-body">

                    <input type="hidden" asp-for="EmployerId" />
                    <input type="hidden" asp-for="Filingyear" />
                    <div class="d-flex align-items-center mb-4">
                        <span class="badge badge-center rounded-pill bg-label-primary me-2"><i class="bx bx-info-circle"></i></span>
                        <h6 class="text-uppercase fw-bold mb-0 small">Account Identity</h6>
                        <hr class="flex-grow-1 ms-3 opacity-25" />
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" asp-for="EmployerName">Employer Name <span class="text-danger">*</span></label>
                            <input asp-for="EmployerName" class="form-control" placeholder="Acme Corp" maxlength="75" oninput="this.value=this.value.replace(/[^A-Za-z0-9 &().'\/-]/g,'').replace(/^\s+/,'').replace(/\s{2,}/g,' ')" onblur="this.value=this.value.trim()" required />
                        </div>
                        @* FIRM *@
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" asp-for="FirmId">Firm Name</label>
                            <div class="field-with-actions">
                                <select asp-for="FirmId" asp-items="ViewBag.Firms" class="form-select select2"><option value="">— Select Firm —</option></select>
                                <button type="button" class="btn btn-label-primary btn-sm btn-act" title="Add Firm" onclick="openAddFirm()"><i class="bx bx-plus"></i></button>
                                <button type="button" class="btn btn-label-secondary btn-sm btn-act" title="Edit / Delete Firm" onclick="openEditFirm()"><i class="bx bx-edit"></i></button>
                            </div>
                        </div>

                        @* BROKER *@
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" asp-for="BrokerId">Broker Name</label>
                            <div class="field-with-actions">
                                <select asp-for="BrokerId" asp-items="ViewBag.Brokers" class="form-select select2"><option value="">— Select Broker —</option></select>
                                <button type="button" class="btn btn-label-primary btn-act btn-sm" title="Add Broker" onclick="openAddBroker()"><i class="bx bx-plus"></i></button>
                                <button type="button" class="btn btn-label-secondary btn-act btn-sm" title="Edit / Delete Broker" onclick="openEditBroker()"><i class="bx bx-edit"></i></button>
                            </div>
                        </div>
                        @{
                            bool showFullDirectly = Model.EmployerId == 0 || CanViewSSNorEIN;
                        }

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">EIN</label>
                            <div class="input-group">
                                <input type="text" id="txtEIN" class="form-control ein-input"
                                       value="@(showFullDirectly? Model.EIN: DataMasker.MaskEIN(Model.EIN))"
                                       data-display-real="@(CanViewSSNorEIN? Model.EIN: DataMasker.MaskEIN(Model.EIN))"
                                       placeholder="XX-XXXXXXX" maxlength="10"
                                       @(showFullDirectly ? "" : "readonly") />
                                <span class="input-group-text cursor-pointer" id="btnToggleEIN" title="Show/Hide EIN"
                                      style="@(showFullDirectly ? "display:none" : "")">
                                    <i class="bx bx-hide" id="iconEIN"></i>
                                </span>
                            </div>
                            <input type="hidden" name="EIN" id="hdnTrackerEIN" value="@Model.EIN" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold" asp-for="IndustryId">Industry </label>
                            <select asp-for="IndustryId" asp-items="ViewBag.Industries" class="form-select select2">
                                <option value="">Select Industry...</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" asp-for="PlanYear">Plan Start Date</label>
                            <input asp-for="PlanYear" class="form-control" placeholder="MM/DD" maxlength="5" oninput="validatePlanYear(this)" />
                        </div>
                    </div>

                    <div class="d-flex align-items-center mb-4">
                        <span class="badge badge-center rounded-pill bg-label-success me-2"><i class="bx bx-map-pin"></i></span>
                        <h6 class="text-uppercase fw-bold mb-0 small">Location & Contact</h6>
                        <hr class="flex-grow-1 ms-3 opacity-25" />
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="row">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold" asp-for="Address">Address1</label>
                                <input asp-for="Address"
                                       id="Address"
                                       name="Address"
                                       class="form-control"
                                       placeholder="123 Main St" maxlength="150" oninput="this.value=this.value.replace(/[^A-Za-z0-9 #&'(),.\/-]/g,'').replace(/^\s+/,'').replace(/\s{2,}/g,' ')" onblur="this.value=this.value.trim()" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold" asp-for="Address2">Address2</label>
                                <input asp-for="Address2"
                                       id="Address2"
                                       name="Address2"
                                       class="form-control"
                                       placeholder="Suite/Apt" maxlength="150" oninput="this.value=this.value.replace(/[^A-Za-z0-9 #&'(),.\/-]/g,'').replace(/^\s+/,'').replace(/\s{2,}/g,' ')" onblur="this.value=this.value.trim()" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" asp-for="City">City</label>
                            <input asp-for="City" class="form-control" placeholder="City" maxlength="50" oninput="this.value=this.value.replace(/[^A-Za-z .'-]/g,'').replace(/^\s+/,'').replace(/\s{2,}/g,' ')" onblur="this.value=this.value.trim()" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" asp-for="State">State</label>
                            <select asp-for="State" asp-items="ViewBag.States" class="form-select select2">
                                <option value="">Select State</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" asp-for="Zip">Zip</label>
                            <input type="number" asp-for="Zip" class="form-control" placeholder="Zip" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold" asp-for="Email">Email Address </label>
                            <input type="email" asp-for="Email" class="form-control" maxlength="254" oninput="this.value=this.value.replace(/\s/g,'')" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" asp-for="Phone">Phone </label>
                            <input type="text" asp-for="Phone" class="form-control" placeholder="(XXX) XXX-XXXX" maxlength="12" oninput="this.value=this.value.replace(/\D/g,'').slice(0,10).replace(/^(\d{3})(\d)/,'$1-$2').replace(/^(\d{3}-\d{3})(\d)/,'$1-$2')" />
                        </div>
                    </div>


                    <div class="d-flex align-items-center mb-4">
                        <span class="badge badge-center rounded-pill bg-label-primary me-2"><i class="bx bx-user"></i></span>
                        <h6 class="text-uppercase fw-bold mb-0 small">Primary Contact</h6>
                        <hr class="flex-grow-1 ms-3 opacity-25" />
                    </div>

                    @if (Model.EmployerId == 0)
                    {
                        @* CREATE: one contact only — no dropdown, no add-more, no modal *@
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold" asp-for="ACAContactName">Name</label>
                                <input asp-for="ACAContactName" class="form-control" placeholder="Full name" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold" asp-for="ACAContactPhone">Phone</label>
                                <input asp-for="ACAContactPhone" class="form-control" placeholder="(XXX) XXX-XXXX" maxlength="12" oninput="this.value=this.value.replace(/\D/g,'').slice(0,10).replace(/^(\d{3})(\d)/,'$1-$2').replace(/^(\d{3}-\d{3})(\d)/,'$1-$2')" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold" asp-for="ACAContactEmail">Email Address</label>
                                <input type="email" asp-for="ACAContactEmail" class="form-control" maxlength="254" oninput="this.value=this.value.replace(/\s/g,'')" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold" asp-for="ConnectUser">Connect User</label>
                                <input asp-for="ConnectUser" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold" asp-for="ACARole">ACA Role</label>
                                <select asp-for="ACARole" class="form-select">
                                    <option value="">— Select —</option>
                                    <option value="No Access">No Access</option>
                                    <option value="Read Only">Read Only</option>
                                    <option value="Broker-Full Access">Broker-Full Access</option>
                                    <option value="Editor">Editor</option>
                                    <option value="Admin">Admin</option>
                                </select>
                            </div>
                          
                        </div>
                    }
                    else
                    {
                        @* EDIT: existing employer — full dropdown + add/edit modal + detail fields *@
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold" asp-for="ACAContactId">Contact</label>
                                <div class="field-with-actions">
                                    <select asp-for="ACAContactId" asp-items="ViewBag.Contacts" class="form-select select2"><option value="">— Select Contact —</option></select>
                                    <button type="button" class="btn btn-label-primary btn-act btn-sm" title="Add Contact" onclick="openAddContact()"><i class="bx bx-plus"></i></button>
                                    <button type="button" class="btn btn-label-secondary btn-act btn-sm" title="Edit / Delete Contact" onclick="openEditContact()"><i class="bx bx-edit"></i></button>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold" asp-for="ACAContactPhone">Phone</label>
                                <input asp-for="ACAContactPhone" class="form-control" maxlength="12" oninput="this.value=this.value.replace(/\D/g,'').slice(0,10).replace(/^(\d{3})(\d)/,'$1-$2').replace(/^(\d{3}-\d{3})(\d)/,'$1-$2')" readonly />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold" asp-for="ACAContactEmail">Email</label>
                                <input type="email" asp-for="ACAContactEmail" class="form-control" maxlength="254" oninput="this.value=this.value.replace(/\s/g,'')" readonly />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold" asp-for="ConnectUser">Connect User</label>
                                <input asp-for="ConnectUser" class="form-control" readonly />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold" asp-for="ACARole">ACA Role</label>

                                <select asp-for="ACARole" class="form-select bg-lighter"
                                        style="pointer-events:none" tabindex="-1" aria-readonly="true">
                                    <option value="">— Select —</option>
                                    <option value="No Access">No Access</option>
                                    <option value="Read Only">Read Only</option>
                                    <option value="Broker-Full Access">Broker-Full Access</option>
                                    <option value="Editor">Editor</option>
                                    <option value="Admin">Admin</option>
                                </select>
                            </div>
                            
                        </div>
                    }
                    <div class="d-flex align-items-center mb-4">
                        <span class="badge badge-center rounded-pill bg-label-warning me-2"><i class="bx bx-user-voice"></i></span>
                        <h6 class="text-uppercase fw-bold mb-0 small">Team & Data Specifications</h6>
                        <hr class="flex-grow-1 ms-3 opacity-25" />
                    </div>
                    <div class="row g-3 mb-4">


                        <div class="col-md-3">
                            <label class="form-label fw-semibold" asp-for="AcctManagerId">Account Manager
                                @if (Model.EmployerId > 0)
                                {
                                    <a href="javascript:void(0)" class="ms-1" title="View Account Manager history" onclick="openAssignmentHistory('AM')"><i class="bx bx-history"></i></a>
                                }
                            </label>
                            <select asp-for="AcctManagerId" asp-items="ViewBag.AcctManagers" class="form-select select2">
                                <option value="">Select Account Manager...</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold" asp-for="SalesRepId">Sales Representative </label>
                            <select asp-for="SalesRepId" asp-items="ViewBag.SalesReps" class="form-select select2">
                                <option value="">Select Sales Representative...</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold" asp-for="DataAnalystId">Data Analyst
                                @if (Model.EmployerId > 0)
                                {
                                    <a href="javascript:void(0)" class="ms-1" title="View Data Analyst history" onclick="openAssignmentHistory('DA')"><i class="bx bx-history"></i></a>
                                }
                            </label>
                            <select asp-for="DataAnalystId" asp-items="ViewBag.DataAnalysts" class="form-select select2">
                                <option value="">Select Data Analyst...</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold" asp-for="Vendor">Vendor</label>
                            <input asp-for="Vendor" class="form-control" placeholder="Employer Vendor" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold" asp-for="DataTypeId">Data Type</label>
                            <select asp-for="DataTypeId" asp-items="ViewBag.DataTypes" class="form-select select2">
                                <option value="">Select Data Type...</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold" asp-for="FundingType">Funding Type</label>
                            <select asp-for="FundingType" class="form-select">
                                <option value="">Select Funding Type...</option>
                                <option>Self-Funded</option>
                                <option>Fully-Insured</option>
                                <option>Mixed: Self-Funded & Fully-Insured</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold" asp-for="FormType">Form Type</label>
                            <select asp-for="FormType" class="form-select">
                                <option value="">Select Form Type...</option>
                                <option>1095-C</option>
                                <option>1095-B</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold" asp-for="DataFrequency">Data Frequency</label>
                            <select asp-for="DataFrequency" asp-items="ViewBag.DataFrequencies" class="form-select">
                                <option value="">Select Data Frequency...</option>
                            </select>
                        </div>

                    </div>
                    <div class="d-flex align-items-center mb-4">
                        <span class="badge badge-center rounded-pill bg-label-info me-2"><i class="bx bx-dollar"></i></span>
                        <h6 class="text-uppercase fw-bold mb-0 small">Pricing & Counts</h6>
                        <hr class="flex-grow-1 ms-3 opacity-25" />
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">
                                Number of Forms Proposed
                            </label>
                            <input type="number" asp-for="FormsProposed" class="form-control" min="0" onkeydown="return event.key !== '-' && event.key !== '+' && event.key !== 'e';" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Number Of 1095Cs</label>
                            <input type="number" min="0" asp-for="NumberOf1095Cs" class="form-control" min="0" onkeydown="return event.key !== '-' && event.key !== '+' && event.key !== 'e';" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">20% Over Proposed Form Count</label>
                            <input type="number" asp-for="OverProposedFormCount" class="form-control" min="0" onkeydown="return event.key !== '-' && event.key !== '+' && event.key !== 'e';" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">20% Over Proposed Form Count Price</label>
                            <div class="input-group input-group-merge">
                                <span class="input-group-text">$</span>
                                <input type="number" asp-for="OverProposedFormPrice" class="form-control" min="0" onkeydown="return event.key !== '-' && event.key !== '+' && event.key !== 'e';" />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center mb-4">
                        <span class="badge badge-center rounded-pill bg-label-secondary me-2"><i class="bx bx-cog"></i></span>
                        <h6 class="text-uppercase fw-bold mb-0 small">Account Configuration</h6>
                        <hr class="flex-grow-1 ms-3 opacity-25" />
                    </div>
                    <div class="row g-3 mb-2">
                        <div class="col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" asp-for="IsPriority"><label class="form-check-label small" asp-for="IsPriority">Priority</label></div></div>
                        <div class="col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" asp-for="ConditionalOffer"><label class="form-check-label small" asp-for="ConditionalOffer">Conditional Offer</label></div></div>
                        <div class="col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" asp-for="SFTP"><label class="form-check-label small" asp-for="SFTP">SFTP Access</label></div></div>
                        <div class="col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" asp-for="AnnualPO"><label class="form-check-label small" asp-for="AnnualPO">Annual PO Required</label></div></div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" asp-for="AnnualCOI"><label class="form-check-label small" asp-for="AnnualCOI">Annual COI</label></div></div>
                        <div class="col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" asp-for="NoAutoRenewal"><label class="form-check-label small" asp-for="NoAutoRenewal">No Auto Renewal</label></div></div>
                    </div>
                    @* ══════════════════════════════════════════════════════════════
                       PORTAL LOGIN  (no MFA)
                       Reuses the section-band pattern, Sneat badge chips and the
                       input-group-merge eye toggle. Only one credential block ever
                       renders per request, so IDs are safely reused across branches.
                       ══════════════════════════════════════════════════════════════ *@
                    <div class="d-flex align-items-center mb-4 mt-4">
                        <span class="badge badge-center rounded-pill bg-label-primary me-2"><i class="bx bx-lock-alt"></i></span>
                        <h6 class="text-uppercase fw-bold mb-0 small">Portal Login</h6>
                        <hr class="flex-grow-1 ms-3 opacity-25" />
                    </div>

                    @if (Model.EmployerId != 0)
                    {
                        <input type="hidden" asp-for="HasPortalLogin" />
                    }

                    @if (Model.EmployerId != 0 && Model.HasPortalLogin)
                    {
                        @* EDIT — a login already exists: username is read-only, password change is opt-in *@
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold" asp-for="PortalUserName">User Name</label>
                                <input asp-for="PortalUserName" class="form-control" readonly />
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" id="chkChangePortalPassword" asp-for="ChangePortalPassword">
                                    <label class="form-check-label small" for="chkChangePortalPassword">Change Password</label>
                                </div>
                            </div>
                            <div class="col-12 d-none" id="changePortalPwdFields">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" asp-for="PortalPassword">
                                            Password <span class="text-danger">*</span>
                                            <a href="javascript:;" id="genPortalPass" class="ms-2 small">Generate Random Password</a>
                                        </label>
                                        <div class="input-group input-group-merge">
                                            <input asp-for="PortalPassword" type="password" class="form-control" autocomplete="new-password" />
                                            <span class="input-group-text cursor-pointer" onclick="togglePortalPassword(this)"><i class="bx bx-hide"></i></span>
                                        </div>
                                        <div class="d-flex flex-wrap gap-1 mt-2">
                                            <span class="badge bg-label-secondary" id="prLenRule"><i class="bx bx-x-circle"></i> Min 8 chars</span>
                                            <span class="badge bg-label-secondary" id="prUpperRule"><i class="bx bx-x-circle"></i> 1 uppercase</span>
                                            <span class="badge bg-label-secondary" id="prDigitRule"><i class="bx bx-x-circle"></i> 1 number</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Confirm Password <span class="text-danger">*</span></label>
                                        <div class="input-group input-group-merge">
                                            <input type="password" class="form-control" id="PortalConfirmPassword" autocomplete="new-password" />
                                            <span class="input-group-text cursor-pointer" onclick="togglePortalPassword(this)"><i class="bx bx-hide"></i></span>
                                        </div>
                                        <small class="text-danger d-none mt-1" id="portalPwdMatch">Passwords do not match.</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @* CREATE (or EDIT with no existing login) — offer to create a portal login *@
                        <div class="row g-3 mb-2">
                            <div class="col-md-12">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="chkNoPortalLogin">
                                    <label class="form-check-label small" for="chkNoPortalLogin">Don't create a portal login</label>
                                </div>
                            </div>
                        </div>
                        <div class="row g-3 mb-4" id="portalLoginFields">
                            <div class="col-md-12">
                                <label class="form-label fw-semibold" asp-for="PortalUserName">User Name <span class="text-danger">*</span></label>
                                <input asp-for="PortalUserName" class="form-control" placeholder="name@company.com" autocomplete="off" />
                                <small class="text-muted">Use the employer's email address as the username.</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold" asp-for="PortalPassword">
                                    Password <span class="text-danger">*</span>
                                    <a href="javascript:;" id="genPortalPass" class="ms-2 small">Generate Random Password</a>
                                </label>
                                <div class="input-group input-group-merge">
                                    <input asp-for="PortalPassword" type="password" class="form-control" autocomplete="new-password" />
                                    <span class="input-group-text cursor-pointer" onclick="togglePortalPassword(this)"><i class="bx bx-hide"></i></span>
                                </div>
                                <div class="d-flex flex-wrap gap-1 mt-2">
                                    <span class="badge bg-label-secondary" id="prLenRule"><i class="bx bx-x-circle"></i> Min 8 chars</span>
                                    <span class="badge bg-label-secondary" id="prUpperRule"><i class="bx bx-x-circle"></i> 1 uppercase</span>
                                    <span class="badge bg-label-secondary" id="prDigitRule"><i class="bx bx-x-circle"></i> 1 number</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Confirm Password <span class="text-danger">*</span></label>
                                <div class="input-group input-group-merge">
                                    <input type="password" class="form-control" id="PortalConfirmPassword" autocomplete="new-password" />
                                    <span class="input-group-text cursor-pointer" onclick="togglePortalPassword(this)"><i class="bx bx-hide"></i></span>
                                </div>
                                <small class="text-danger d-none mt-1" id="portalPwdMatch">Passwords do not match.</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
