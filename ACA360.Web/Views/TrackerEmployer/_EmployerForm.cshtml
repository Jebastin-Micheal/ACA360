<script>
    (function () {
        // ── Firm → Broker Cascade ──────────────────────────────────────
        var $firm   = $('#FirmId');
        var $broker = $('#BrokerId');

        var preselectedBrokerId = $broker.val();

        $firm.on('change', function () {
            loadBrokersByFirm($(this).val(), null);
        });

        function loadBrokersByFirm(firmId, selectedBrokerId) {
            $broker.html('<option value="">-- Select Broker --</option>').prop('disabled', true);

            if (!firmId || firmId === '0') return;

            $.get('/TrackerEmployer/GetBrokersForFirm', { firmId: firmId })
                .done(function (data) {
                    if (!data || data.length === 0) {
                        $broker.html('<option value="">-- No brokers found --</option>');
                        return;
                    }
                    $.each(data, function (i, b) {
                        var isSelected = (selectedBrokerId && b.id == selectedBrokerId) ? 'selected' : '';
                        $broker.append(`<option value="${b.id}" ${isSelected}>${b.name}</option>`);
                    });
                    $broker.prop('disabled', false);
                    if ($.validator && $.validator.unobtrusive) {
                        $.validator.unobtrusive.parse('#frmMain');
                    }
                })
                .fail(function () {
                    $broker.html('<option value="">-- Error loading brokers --</option>');
                });
        }

        if ($firm.val() && $firm.val() !== '0') {
            loadBrokersByFirm($firm.val(), preselectedBrokerId);
        }

        // ── EIN Mask / Reveal Toggle ───────────────────────────────────
        var revealed = false;
        var $txt     = $('#txtEIN');
        var $hidden  = $('#hdnTrackerEIN');
        var $icon    = $('#iconEIN');

        function maskEIN(ein) {
            if (!ein) return '';
            var clean = ein.replace(/\D/g, '');
            if (clean.length !== 9) return ein;
            return '**-***' + clean.substr(5, 4);
        }

        // Prevent blur firing when clicking the eye button
        $('#btnToggleEIN').on('mousedown', function (e) {
            e.preventDefault();
        });

           $('#btnToggleEIN').on('click', function () {
        revealed = !revealed;
        if (revealed) {
                    $txt.val($txt.data('display-real')).removeAttr('readonly');
        } else {
            $hidden.val($txt.val());
            $txt.val(maskEIN($txt.val())).attr('readonly', true);  // lock it
        }
        $icon.toggleClass('bx-hide', !revealed)
             .toggleClass('bx-show',  revealed);
        $txt.focus();
    });

            // Sync hidden field while user types
    $txt.on('input', function () {

        if (revealed || !$(this).prop('readonly')) {
            $hidden.val($(this).val());
        }
    });

        // Only mask when focus truly leaves the input-group
        $txt.on('blur', function () {
            setTimeout(function () {
                if (revealed && !$('#btnToggleEIN').is(':focus')) {
                    revealed = false;
                    $hidden.val($txt.val());
                    $txt.val(maskEIN($txt.val()));
                    $icon.removeClass('bx-show').addClass('bx-hide');
                }
            }, 150);
        });
        // ── Firm / Broker Add-Edit Modals ──────────────────────────────
        function token() { return $('input[name="__RequestVerificationToken"]').first().val() || ''; }

        // lift the modal shells out of the (nested) employer modal so they overlay the whole viewport
        ['firmFormModal', 'brokerFormModal'].forEach(function (id) {
            $('body > #' + id).remove();      // drop any stale copy from a previous open
            $('#' + id).appendTo('body');     // lift this shell out to <body>
        });

        function loadForm(url, modalId, contentId) {
            $.get(url).done(function (resp) {
                if (typeof resp === 'object' && resp.success === false)
                    return Swal.fire('Error', resp.message || 'Could not load form.', 'error');
                $('#' + contentId).html(resp);
                $('#' + contentId + ' [id^="btnSave"]').removeAttr('onclick');     // drop dead saveFirm()/saveBroker()
                $('#' + contentId + ' .select2').each(function () {
                    $(this).select2({ dropdownParent: $('#' + modalId) });          // stacked-modal fix
                });
                bootstrap.Modal.getOrCreateInstance(document.getElementById(modalId)).show();
            }).fail(function () { Swal.fire('Error', 'Could not load form.', 'error'); });
        }

        function savePartner($btn, formSel, url, onSaved) {
            var $modal = $btn.closest('.modal');
            var $form  = $modal.find(formSel);
            if (!$form.length) return;
            if ($form[0] && !$form[0].checkValidity()) { $form[0].reportValidity(); return; }
            if ($btn.data('saving')) return;                          // block re-entry
            $btn.data('saving', true).prop('disabled', true);

            var $sn = $form.find('#hdnStateName');                    // firm: sync State name
            if ($sn.length) $sn.val($form.find('#StateId option:selected').text());

            var data = $form.serialize() + '&__RequestVerificationToken=' + encodeURIComponent(token());
            $.ajax({ url: url, method: 'POST', data: data })
                .done(function (res) {
                    if (!res || res.success === false)
                        return Swal.fire('Error', (res && res.message) || 'Save failed.', 'error');
                    onSaved(res);
                    bootstrap.Modal.getInstance($modal[0]).hide();
                    Swal.fire({ toast: true, position: 'top-end', timer: 1800, showConfirmButton: false, icon: 'success', title: 'Saved' });
                })
                .fail(function (xhr) {
                    Swal.fire('Error', xhr.status === 400 ? 'Validation / anti-forgery failed.' : 'Save failed.', 'error');
                })
                .always(function () { $btn.data('saving', false).prop('disabled', false); });
        }

        // remove any handlers left over from a previous open, then bind exactly once
        $(document)
            .off('click', '#firmFormContent #btnSaveFirm')
            .off('click', '#brokerFormContent #btnSaveBroker')
            .off('hidden.bs.modal', '#firmFormModal, #brokerFormModal');

        $(document).on('click', '#firmFormContent #btnSaveFirm', function () {
            savePartner($(this), '#frmFirm', '/Partner/SaveFirm', function (res) {
                var $opt = $firm.find('option[value="' + res.id + '"]');
                if ($opt.length) $opt.text(res.name);                                // edit
                else $firm.append(new Option(res.name, res.id, true, true));         // add
                $firm.val(res.id).trigger('change');   // cascade reloads brokers for the (new) firm
            });
        });

        $(document).on('click', '#brokerFormContent #btnSaveBroker', function () {
            savePartner($(this), '#frmBroker', '/Partner/SaveBroker', function (res) {
                var $opt = $broker.find('option[value="' + res.id + '"]');
                if ($opt.length) $opt.text(res.name);                                // edit
                else $broker.prop('disabled', false).append(new Option(res.name, res.id, true, true));  // add
                $broker.val(res.id).trigger('change');
            });
        });

        // clear form + destroy select2 on close, and keep body scroll-locked while the employer modal is still open
        $(document).on('hidden.bs.modal', '#firmFormModal, #brokerFormModal', function () {
            var $content = $(this).find('.modal-content');
            $content.find('.select2').each(function () {
                if ($(this).data('select2')) $(this).select2('destroy');
            });
            $content.empty();
            if ($('.modal.show').length) document.body.classList.add('modal-open');
        });
            window.getInitialNote = function () {
        var text = $('#noteAddText').val().trim();
        if (!text) return null;
        return { category: 'Employer Creation', noteText: text };
    };
        // exposed for the inline onclick on the +/edit buttons
        window.openAddFirm    = function () { loadForm('/Partner/FirmForm?id=0', 'firmFormModal', 'firmFormContent'); };
        window.openEditFirm   = function () { var id = $firm.val();  if (!id) return Swal.fire('Select a firm', 'Choose a firm to edit first.', 'info');  loadForm('/Partner/FirmForm?id=' + id, 'firmFormModal', 'firmFormContent'); };
        window.openAddBroker  = function () { var f = $firm.val();   if (!f)  return Swal.fire('Select a firm first', 'Brokers belong to a firm.', 'info'); loadForm('/Partner/BrokerForm?id=0&parentFirmId=' + f, 'brokerFormModal', 'brokerFormContent'); };
        window.openEditBroker = function () { var id = $broker.val();if (!id) return Swal.fire('Select a broker', 'Choose a broker to edit first.', 'info'); loadForm('/Partner/BrokerForm?id=' + id, 'brokerFormModal', 'brokerFormContent'); };
             // ── Populate ACA contact detail fields when the dropdown changes ──
    // Fires on manual selection AND after saveNewContact() does .trigger('change')
    $(document).on('change', '#ACAContactId', function () {
        var id = $(this).val();
        if (!id) {
            $('#ACAContactPhone, #ACAContactEmail, #ConnectUser').val('');
            $('#ACARole').val('');
            return;
        }
        $.getJSON('/TrackerEmployer/GetContactById', { id: id }, function (c) {
            if (!c || c.success === false) return;
            $('#ACAContactPhone').val(c.phone || '');
            $('#ACAContactEmail').val(c.email || '');
            $('#ConnectUser').val(c.acaUsername || '');
            $('#ACARole').val(c.acaRoles || '');
            // if ACARole is a select2, refresh it:
            if ($('#ACARole').hasClass('select2')) $('#ACARole').trigger('change.select2');
        });
    });
    })();

        function validatePlanYear(input) {
        let v = input.value.replace(/\D/g, '');

        // Month validation (01 to 12)
        if (v.length >= 2) {
            let month = parseInt(v.substring(0, 2), 10);
            if (month < 1) month = 1;
            if (month > 12) month = 12;
            v = String(month).padStart(2, '0') + v.substring(2);
        }

        // Day validation (01 to 31)
        if (v.length >= 4) {
            let day = parseInt(v.substring(2, 4), 10);
            if (day < 1) day = 1;
            if (day > 31) day = 31;
            v = v.substring(0, 2) + String(day).padStart(2, '0');
        }

        // Auto '/' placement
        if (v.length > 2) {
            v = v.substring(0, 2) + '/' + v.substring(2, 4);
        }

        input.value = v;


    }
</script>
@* ══════════════════════════════════════════════════════════════════════
   PORTAL LOGIN — self-contained (kept separate from the UserAccounts form)
   No MFA. Live strength chips, show/hide, generate, confirm-match.
   ══════════════════════════════════════════════════════════════════════ *@
<script>
    (function () {
        // Local password policy (self-contained — no shared dependency).
        var PR_MIN = 8, PR_UPPER = true, PR_DIGIT = true;

        function portalActive() {
            // Credentials are in play only when a credential block is rendered
            // and the user hasn't opted out / opted in appropriately.
            if (document.getElementById('changePortalPwdFields')) {
                // EDIT with existing login: only when "Change Password" is on
                return $('#chkChangePortalPassword').is(':checked');
            }
            if (document.getElementById('portalLoginFields')) {
                // CREATE / EDIT-without-login: on unless the user opts out
                return !$('#chkNoPortalLogin').is(':checked');
            }
            return false;
        }

        function setChip(id, ok) {
            var el = document.getElementById(id);
            if (!el) return;
            var icon = el.querySelector('i');
            el.classList.toggle('bg-label-success', ok);
            el.classList.toggle('bg-label-secondary', !ok);
            if (icon) icon.className = ok ? 'bx bx-check-circle' : 'bx bx-x-circle';
        }

        function validateStrength() {
            var v = $('#PortalPassword').val() || '';
            var lenOk = v.length >= PR_MIN;
            var upOk = !PR_UPPER || /[A-Z]/.test(v);
            var dgOk = !PR_DIGIT || /[0-9]/.test(v);
            setChip('prLenRule', lenOk);
            setChip('prUpperRule', upOk);
            setChip('prDigitRule', dgOk);
            return lenOk && upOk && dgOk;
        }

        function validateMatch() {
            var p = $('#PortalPassword').val() || '';
            var c = $('#PortalConfirmPassword').val() || '';
            var ok = (p === c);
            $('#portalPwdMatch').toggleClass('d-none', ok || c.length === 0);
            return ok;
        }

        // Generate a policy-compliant random password.
        function generatePortalPassword() {
            var lower = 'abcdefghijklmnopqrstuvwxyz',
                upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
                digits = '0123456789',
                symbols = '!#$%^&*_+';
            var req = [];
            if (PR_UPPER) req.push(upper[Math.floor(Math.random() * upper.length)]);
            if (PR_DIGIT) req.push(digits[Math.floor(Math.random() * digits.length)]);
            req.push(lower[Math.floor(Math.random() * lower.length)]);
            var all = lower + (PR_UPPER ? upper : '') + (PR_DIGIT ? digits : '') + symbols;
            var target = Math.max(PR_MIN, 12);
            while (req.length < target) req.push(all[Math.floor(Math.random() * all.length)]);
            for (var i = req.length - 1; i > 0; i--) {
                var j = Math.floor(Math.random() * (i + 1));
                var t = req[i]; req[i] = req[j]; req[j] = t;
            }
            return req.join('');
        }

        // Show/hide toggle — mirrors the EIN field's input-group-merge pattern.
        window.togglePortalPassword = function (span) {
            var input = span.parentElement.querySelector('input');
            var icon = span.querySelector('i');
            if (!input) return;
            var show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            if (icon) icon.className = show ? 'bx bx-show' : 'bx bx-hide';
        };

        // Prefill the username from the employer email on the create block.
        $('#Email').on('change blur', function () {
            var $u = $('#PortalUserName');
            if ($u.length && !$u.prop('readonly') && !$u.val()) $u.val($(this).val());
        });

        // "Don't create a portal login" — collapse & disable the credential fields.
        $(document).on('change', '#chkNoPortalLogin', function () {
            var off = $(this).is(':checked');
            $('#portalLoginFields').toggleClass('d-none', off)
                .find('input').prop('disabled', off);
        });

        // "Change Password" (edit) — reveal & enable the password fields.
        $(document).on('change', '#chkChangePortalPassword', function () {
            var on = $(this).is(':checked');
            $('#changePortalPwdFields').toggleClass('d-none', !on)
                .find('input').prop('disabled', !on).val('');
            validateStrength(); validateMatch();
        });

        $(document).on('input', '#PortalPassword', function () { validateStrength(); validateMatch(); });
        $(document).on('input', '#PortalConfirmPassword', validateMatch);
        $(document).on('click', '#genPortalPass', function (e) {
            e.preventDefault();
            var pwd = generatePortalPassword();
            $('#PortalPassword').val(pwd);
            $('#PortalConfirmPassword').val(pwd);
            validateStrength(); validateMatch();
        });

        // Initial state: in edit-with-login, the change-password inputs stay
        // disabled (so nothing posts) until the user opts in.
        $(function () {
            if (document.getElementById('changePortalPwdFields')) {
                $('#changePortalPwdFields').find('input').prop('disabled', true);
            }
            validateStrength();
        });

        // Gate the employer save on portal-login rules, then hand off to the
        // existing global saveMain() — Index.cshtml stays untouched.
        window.saveEmployerWithPortal = function () {
            if (portalActive()) {
                var user = ($('#PortalUserName').val() || '').trim();
                if (!user) {
                    Swal.fire('User Name required', 'Enter a portal login user name, or tick "Don\'t create a portal login".', 'warning');
                    $('#PortalUserName').addClass('border-danger').focus();
                    return;
                }
                if (!validateStrength()) {
                    Swal.fire('Weak Password', 'Password must meet the requirements shown below the field.', 'warning');
                    $('#PortalPassword').addClass('border-danger').focus();
                    return;
                }
                if (!validateMatch()) {
                    Swal.fire('Passwords do not match', 'The password and confirmation must be identical.', 'warning');
                    $('#PortalConfirmPassword').addClass('border-danger').focus();
                    return;
                }
                // Reflect the user's create/opt-out choice into the posted model.
                $('#CreatePortalLogin').remove();
                $('#frmMain').append('<input type="hidden" id="CreatePortalLogin" name="CreatePortalLogin" value="true" />');
            } else {
                $('#CreatePortalLogin').remove();
                $('#frmMain').append('<input type="hidden" id="CreatePortalLogin" name="CreatePortalLogin" value="false" />');
            }
            $('#PortalPassword, #PortalConfirmPassword, #PortalUserName').removeClass('border-danger');
            saveMain();
        };
    })();
</script>

