@model ACA360.Core.Models.Tracker.TrackerEmployerItem
@using ACA360.Web.Helpers
@using ACA360.Web.ViewComponents
@await Component.InvokeAsync("Breadcrumb", new
    {
    pageTitle = "Employer Tracking Dashboard",
        items = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "Home", Url = "/", IsActive = false },
        new BreadcrumbItem { Title = "Employer",         Url = "/TrackerEmployer", IsActive = false },
        new BreadcrumbItem { Title = "Dashboard", Url = "", IsActive = true }
    }
    })

@{
    ViewData["Title"] = Model.EmployerName;

    var nameParts = (Model.EmployerName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initialsArray = nameParts.Take(2).Select(w => w[0]).ToArray();
    var initials = initialsArray.Length > 0
        ? new string(initialsArray).ToUpper()
        : "?";

    var amText = ViewBag.AcctManagers != null && Model.AcctManagerId.HasValue
        ? ((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.AcctManagers)
            .FirstOrDefault(x => x.Value == Model.AcctManagerId.ToString())?.Text : null;

    var srText = ViewBag.SalesReps != null && Model.SalesRepId.HasValue
        ? ((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.SalesReps)
            .FirstOrDefault(x => x.Value == Model.SalesRepId.ToString())?.Text : null;

    var daText = ViewBag.DataAnalysts != null && Model.DataAnalystId.HasValue
        ? ((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.DataAnalysts)
            .FirstOrDefault(x => x.Value == Model.DataAnalystId.ToString())?.Text : null;

    var brokerText = Model.BrokerName;
    var brokerContactText = Model.BrokerContactName;
}

@* CSS Dependencies *@
<link rel="stylesheet" href="~/assets/vendor/libs/select2/select2.css" />
<link rel="stylesheet" href="~/assets/vendor/libs/animate-css/animate.css" />
<link rel="stylesheet" href="~/assets/vendor/libs/cards-actions/spinkit.css" />
<link rel="stylesheet" href="~/css/tracker-dashboard.css?v=@DateTime.Now.Ticks" />

<input type="hidden" id="hdnEmployerId" value="@Model.EmployerId" />

<div id="dashboard-viewport" class="transition-all">

    @* ════ PAGE HEADER ════ *@
    <div class="card shadow-none border mb-2 dash-header-card">
        <div class="card-body p-1">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 position-relative">
                <div class="d-flex align-items-center gap-2">
                    <a href="/TrackerEmployer/Index" class="btn btn-icon btn-sm btn-label-secondary border-0 me-1" title="Back to Employers">
                        <i class="bx bx-arrow-back fs-5"></i>
                    </a>
                    <div class="avatar avatar-sm ms-1">
                        <span class="avatar-initial rounded-circle bg-primary fw-bold dash-avatar-shadow">@initials</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap ms-1">
                        <h6 class="mb-0 fw-bold text-heading dash-employer-name">@Model.EmployerName</h6>
                        @if (!string.IsNullOrEmpty(Model.EIN))
                        {
                            <span class="badge bg-label-secondary rounded-pill border shadow-sm dash-meta-badge font-monospace">@(CanViewSSNorEIN? Model.EIN: DataMasker.MaskEIN(Model.EIN))</span>
                        }
                        @if (!string.IsNullOrEmpty(ViewBag.SessionFilingYear?.ToString()))
                        {
                            <span class="badge bg-label-info rounded-pill border shadow-sm dash-meta-badge">Filing Year: @ViewBag.SessionFilingYear</span>
                        }
                    </div>
                </div>
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <a href="/TrackerEmployer/ExportEmployerExcel/@Model.EmployerId" class="btn btn-sm btn-icon btn-label-success shadow-sm" title="Export to Excel" onclick="monitorDownload()">
                        <i class="bx bx-export"></i>
                    </a>
                    <button type="button" class="btn btn-sm btn-icon btn-primary shadow-sm" id="btnFullScreen" onclick="toggleFullScreen()" title="Full Screen Mode">
                        <i class="bx bx-fullscreen" id="fsIcon"></i>
                    </button>
                </div>
                <span class="d-flex align-items-center gap-1"
                      data-bs-toggle="tooltip" data-bs-placement="bottom"
                      title="Double-click any field to unlock and edit it directly on the dashboard"
                      style="position:absolute; left:50%; transform:translateX(-50%); pointer-events:auto; cursor:default">
                    <i class="bx bx-info-circle text-primary" style="font-size:1rem"></i>
                    <span class="text-muted d-none d-md-inline" style="font-size:.72rem; white-space:nowrap">Double-click a field to edit</span>
                </span>
            </div>
        </div>
    </div>

    @* ════ DASHBOARD MAIN LAYOUT ════ *@
    <div id="dashTopRow">

        @* ════ LEFT COLUMN: EMPLOYER DETAILS ════ *@
        <div id="employerCol" class="transition-all">
            <div class="card panel-scroll pe-1 dash-vertical-panel d-flex flex-column">
                <form id="frmDashboard" class="flex-grow-1 d-flex flex-column">
                    <input type="hidden" asp-for="EmployerId" />
                    <input type="hidden" asp-for="Filingyear" />

                    @* ── TABBED EMPLOYER CARD ── *@
                    <div class="card shadow-none border mb-0 flex-grow-1 d-flex flex-column dash-card-rounded">

                        <div class="emp-tab-nav">
                            <div class="d-flex align-items-center gap-0">
                                <button class="nav-link active" type="button" data-tab="pane-empdetail">
                                    <i class="bx bx-buildings"></i>Employer Details
                                </button>
                                <button class="nav-link" type="button" data-tab="pane-affiliates">
                                    <i class="bx bx-link-alt"></i>Affiliates
                                </button>
                                <button class="nav-link" type="button" data-tab="pane-broker">
                                    <i class="bx bx-briefcase-alt-2"></i>Broker
                                </button>
                                <button class="nav-link" type="button" data-tab="pane-other">
                                    <i class="bx bx-cog"></i>Other Details
                                </button>
                            </div>
                            <div class="d-flex align-items-center gap-1 pe-2 flex-shrink-0">
                                <button type="button" class="btn btn-sm btn-success btn-save-sm" id="btnSave" onclick="saveDashboard()">
                                    <i class="bx bx-save me-1"></i>Save
                                </button>
                            </div>
                        </div>

                        @* ─── TAB 1: EMPLOYER DETAILS ─── *@
                        <div class="tab-pane-emp flex-grow-1" id="pane-empdetail">
                            <div class="card-body py-2 px-3">
                                <div class="row g-3">

                                    @* PRIMARY IDENTITY *@
                                    <div class="col-md-12">
                                        <div class="card shadow-sm border-0 border-start border-primary border-3">
                                            <div class="card-header d-flex align-items-center bg-label-primary py-2 px-3">
                                                <i class="bx bx-id-card me-2 fs-4"></i>
                                                <h6 class="m-0 text-uppercase fw-bold small">Primary Identity</h6>
                                            </div>
                                            <div class="card-body p-3">
                                                <div class="row g-3">
                                                    <div class="col-md-7">
                                                        <span class="field-label">Legal Employer Name</span>
                                                        <input asp-for="EmployerName" class="form-control edit-f" required readonly maxlength="75" oninput="this.value=this.value.replace(/[^A-Za-z0-9 &().'\/-]/g,'').replace(/^\s+/,'').replace(/\s{2,}/g,' ')" onblur="this.value=this.value.trim()" />
                                                    </div>
                                                    <div class="col-md-3">
                                                        <span class="field-label">EIN</span>
                                                        <input type="text"
                                                               id="txtEIN"
                                                               name="EIN"
                                                               class="form-control edit-f ein-input @(CanViewSSNorEIN ? "" : "ein-mask-field")"
                                                               data-real="@Model.EIN"
                                                               data-can-reveal="@(CanViewSSNorEIN ? "true" : "false")"
                                                               value="@(CanViewSSNorEIN? Model.EIN: DataMasker.MaskEIN(Model.EIN))"
                                                               placeholder="XX-XXXXXXX"     
                                                               maxlength="10" oninput="this.value=this.value.replace(/\D/g,'').slice(0,9).replace(/^(\d{2})(\d)/,'$1-$2')"
                                                               readonly
                                                               autocomplete="off" />

                                                    </div>
                                                    <div class="col-md-2">
                                                        <span class="field-label" title="Plan Start Date">Plan Start Date</span>
                                                        <input asp-for="PlanYear" class="form-control edit-f" readonly />
                                                    </div>
                                                    <div class="col-md-12 mt-2">
                                                        <span class="field-label">Firm</span>
                                                        <div class="field-with-actions edit-f">
                                                            <select asp-for="FirmId" asp-items="ViewBag.Firms" class="form-select edit-f">
                                                                <option value="">— Select Firm —</option>
                                                            </select>
                                                            <button type="button" class="btn btn-label-info btn-act" title="Firm Details" onclick="viewFirmInfo()"><i class="bx bx-info-circle"></i></button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    @* LOCATION *@
                                    <div class="col-md-6">
                                        <div class="card h-100 shadow-sm border-0 border-top border-info border-3">
                                            <div class="card-header d-flex align-items-center bg-label-info py-2 px-3">
                                                <i class="bx bx-map me-2 fs-4"></i>
                                                <h6 class="m-0 text-uppercase fw-bold small">Location</h6>
                                            </div>
                                            <div class="card-body p-3">
                                                <div class="mb-3">
                                                    <span class="field-label" title="Full Street Address">Street Address</span>
                                                    <input asp-for="Address" class="form-control form-control-sm edit-f" maxlength="150" oninput="this.value=this.value.replace(/[^A-Za-z0-9 #&'(),.\/-]/g,'').replace(/^\s+/,'').replace(/\s{2,}/g,' ')" onblur="this.value=this.value.trim()" readonly />
                                                </div>
                                                <div class="mb-3">
                                                    <span class="field-label">Address 2</span>
                                                    <input asp-for="Address2" class="form-control form-control-sm edit-f" maxlength="150" oninput="this.value=this.value.replace(/[^A-Za-z0-9 #&'(),.\/-]/g,'').replace(/^\s+/,'').replace(/\s{2,}/g,' ')" onblur="this.value=this.value.trim()" readonly placeholder="Suite/Apt" />
                                                </div>
                                                <div class="row g-2">
                                                    <div class="col-md-6">
                                                        <span class="field-label">City</span>
                                                        <input asp-for="City" class="form-control form-control-sm edit-f" maxlength="50" oninput="this.value=this.value.replace(/[^A-Za-z .'-]/g,'').replace(/^\s+/,'').replace(/\s{2,}/g,' ')" onblur="this.value=this.value.trim()" readonly />
                                                    </div>
                                                    <div class="col-md-3">
                                                        <span class="field-label">State</span>
                                                        <select id="State" name="State" class="form-select form-select-sm edit-f">
                                                            <option value="">—</option>
                                                            @if (ViewBag.StatesACA != null)
                                                            {
                                                                foreach (var s in (SelectList)ViewBag.StatesACA)
                                                                {
                                                                    <option value="@s.Value" selected="@(Model.State == s.Value)">@s.Text</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <span class="field-label">Zip</span>
                                                        <input asp-for="Zip" class="form-control form-control-sm edit-f" maxlength="10" inputmode="numeric" oninput="this.value=this.value.replace(/\D/g,'').slice(0,9).replace(/^(\d{5})(\d)/,'$1-$2')" readonly />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    @* PRIMARY CONTACT *@
                                    <div class="col-md-6">
                                        <div class="card h-100 shadow-sm border-0 border-top border-success border-3">
                                            <div class="card-header d-flex align-items-center bg-label-success py-2 px-3">
                                                <i class="bx bx-user me-2 fs-4"></i>
                                                <h6 class="m-0 text-uppercase fw-bold small">Primary Contact</h6>
                                            </div>
                                            <div class="card-body p-3">
                                                <div class="mb-3">
                                                    <span class="field-label">Contact Name</span>
                                                    <div class="field-with-actions edit-f">
                                                        <select asp-for="ACAContactId" asp-items="ViewBag.Contacts" class="form-select form-select-sm edit-f"><option value="">— Select —</option></select>
                                                        <button type="button" class="btn btn-label-primary btn-act" title="Add Contact" onclick="openAddContact()"><i class="bx bx-plus"></i></button>
                                                        <button type="button" class="btn btn-label-secondary btn-act" title="Open Contact" onclick="openContactLink()"><i class="bx bx-link-external"></i></button>
                                                    </div>
                                                </div>
                                                <div class="row g-2 mb-3">
                                                    <div class="col-md-6">
                                                        <span class="field-label">Phone</span>
                                                        <input type="text" id="Phone" name="Phone" value="" class="form-control form-control-smedit-f" maxlength="12" oninput="this.value=this.value.replace(/\D/g,'').slice(0,10).replace(/^(\d{3})(\d)/,'$1-$2').replace(/^(\d{3}-\d{3})(\d)/,'$1-$2')" readonly />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <span class="field-label">Connect User</span>
                                                        <input type="text" id="ConnectUser" name="ConnectUser" value="" class="form-control form-control-sm edit-f" readonly />
                                                    </div>
                                                </div>
                                                <div class="mb-0">
                                                    <span class="field-label">Email Address</span>
                                                    <input type="text" id="Email" name="Email" value="" class="form-control form-control-sm edit-f" maxlength="254" oninput="this.value=this.value.replace(/\s/g,'')" readonly />
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    @* BILLING INFORMATION *@
                                    <div class="col-md-12 mt-4">
                                        <div class="card shadow-sm border-0 border-top border-warning border-3">
                                            <div class="card-header d-flex align-items-center bg-label-warning py-2 px-3">
                                                <i class="bx bx-credit-card me-2 fs-4"></i>
                                                <h6 class="m-0 text-uppercase fw-bold small">Billing Information</h6>
                                            </div>
                                            <div class="card-body p-3">
                                                <div class="row g-3">
                                                    <div class="col-md-3">
                                                        <span class="field-label" title="Billing Department Contact">Billing Name</span>
                                                        <div class="field-with-actions edit-f">
                                                            <select asp-for="BillingContactId" asp-items="ViewBag.BillingContacts" class="form-select form-select-sm edit-f"><option value="">— Select —</option></select>
                                                            <button type="button" class="btn btn-label-success btn-act" title="Add Billing Contact" onclick="openAddBillingContact()"><i class="bx bx-plus"></i></button>
                                                            <button type="button" class="btn btn-label-secondary btn-act" title="Open Contact" onclick="openBillingContactLink()"><i class="bx bx-link-external"></i></button>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <span class="field-label">Phone Number</span>
                                                        <input asp-for="BillingPhone" class="form-control form-control-sm" maxlength="12" oninput="this.value=this.value.replace(/\D/g,'').slice(0,10).replace(/^(\d{3})(\d)/,'$1-$2').replace(/^(\d{3}-\d{3})(\d)/,'$1-$2')" readonly />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <span class="field-label">Email Address</span>
                                                        <input asp-for="BillingEmail" class="form-control form-control-sm" placeholder="Billing email" readonly />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    @* FORMS & FUNDING *@
                                    <div class="col-md-12">
                                        <div class="card shadow-sm border-0 border-top border-primary border-3">
                                            <div class="card-header d-flex align-items-center bg-label-primary py-2 px-3">
                                                <i class="bx bx-file me-2 fs-4"></i>
                                                <h6 class="m-0 text-uppercase fw-bold small">Forms &amp; Funding</h6>
                                            </div>
                                            <div class="card-body p-3">
                                                <div class="row g-2 mb-1">
                                                    <div class="col-md-3">
                                                        <span class="field-label">Form Type</span>
                                                        <select asp-for="FormType" asp-items="ViewBag.FormTypes" class="form-select form-select-sm edit-f">
                                                            <option value="">— Select Form Type —</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <span class="field-label">Number of 1095Cs</span>
                                                        <input asp-for="NumberOf1095Cs" class="form-control form-control-sm edit-f" placeholder="0" readonly />
                                                    </div>
                                                    <div class="col-md-3">
                                                        <span class="field-label">Waiting Period</span>
                                                        <input asp-for="WaitingPeriod" class="form-control form-control-sm edit-f" placeholder="NDF 0; NDF 60" readonly />
                                                    </div>
                                                    <div class="col-md-3">
                                                        <span class="field-label">Banding Type</span>
                                                        <select asp-for="BandingType" asp-items="ViewBag.BandingTypes" class="form-select form-select-sm edit-f">
                                                            <option value="">— Select Banding —</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="row g-2">
                                                    <div class="col-md-3">
                                                        <span class="field-label">Funding Type</span>
                                                        <select asp-for="FundingType" asp-items="ViewBag.FundingTypes" class="form-select form-select-sm edit-f">
                                                            <option value="">— Select FundingType—</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <span class="field-label">Number of Forms Proposed</span>
                                                        <input asp-for="FormsProposed" class="form-control form-control-sm edit-f" readonly />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @* ACCOUNT CONFIGURATION FLAGS *@
                                <div class="mt-2">
                                    <div class="card shadow-sm border-0 border-top border-secondary border-3" style="border-top-color:#6610f2!important">
                                        <div class="card-header d-flex align-items-center py-2 px-3" style="background-color:rgba(102,16,242,.1)">
                                            <i class="bx bx-check-shield me-2 fs-4"></i>
                                            <h6 class="m-0 text-uppercase fw-bold small">Account Configuration</h6>
                                        </div>
                                        <div class="card-body p-3">
                                            <div class="compact-flag-grid shadow-none">
                                                @foreach (var item in new[] {
                                                                                                new { Id = "IsPriority", Lbl = "Priority" },
                                                                                                new { Id = "ConditionalOffer", Lbl = "Cond. Offer" },
                                                                                                new { Id = "SFTP", Lbl = "SFTP" },
                                                                                                new { Id = "AnnualPO", Lbl = "Annual PO" },
                                                                                                new { Id = "AnnualCOI", Lbl = "Annual COI" },
                                                                                                new { Id = "NoAutoRenewal", Lbl = "No Auto-Renew" },
                                                                                                new { Id = "HasSpecialMailing", Lbl = "Spec. Mail" },
                                                                                                new { Id = "SpecialPaymentDates", Lbl = "Spec. Pay" }
                                                                                                })
                                                {
                                                    <label class="flag-cell" for="@item.Id">
                                                        <span class="flag-label-text">@item.Lbl</span>
                                                        <div class="flag-control-wrap">
                                                            @{
                                                                var isChecked = Model.GetType().GetProperty(item.Id)?.GetValue(Model, null) as bool? == true;
                                                            }
                                                            <div class="edit-f">
                                                                <div class="form-check form-switch m-0">
                                                                    <input class="form-check-input" type="checkbox" id="@item.Id" name="@item.Id" value="true"
                                                                           @(isChecked ? "checked" : "")>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </label>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* ─── TAB 2: AFFILIATES ─── *@
                        <div class="tab-pane-emp d-none flex-grow-1 d-flex flex-column" id="pane-affiliates">
                            <div class="card-body pb-2 px-2 flex-grow-1 d-flex flex-column">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2 px-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="subsec-head mb-0">
                                            <span class="subsec-dot bg-primary"></span>
                                            Employer Family
                                        </div>
                                        <span class="badge bg-label-primary rounded-pill" id="affiliateCount" style="font-size:.75rem">0</span>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-sm btn-primary" onclick="openAddAffiliate(0)">
                                            <i class="bx bx-plus me-1"></i>Add Affiliate
                                        </button>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2 px-1 mb-2 x-small text-muted">
                                    <i class="bx bx-info-circle text-info"></i>
                                    Click <strong>View</strong> to see full details or <strong>Copy</strong> to copy the row for Excel.
                                    <span class="ms-auto">
                                        <span class="aff-type-dot aff-type-dot-primary"></span> Primary &nbsp;
                                        <span class="aff-type-dot aff-type-dot-affiliate"></span> Affiliate
                                    </span>
                                </div>
                                <div class="aff-table-wrap rounded border flex-grow-1" style="overflow-x:hidden;">
                                    <table class="table table-sm aff-table aff-table-no-hover mb-0" id="affiliateTable">
                                        <thead class="table-light" style="position:sticky;top:0;z-index:2">
                                            <tr>
                                                <th class="ps-2" style="width:30px"></th>
                                                <th>Employer Name</th>
                                                <th style="width:110px">EIN</th>
                                                <th style="width:60px">State</th>
                                                <th class="text-end pe-3" style="width:140px">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody id="affiliateTableBody">
                                            <tr>
                                                <td colspan="5" class="text-center text-muted py-4 x-small">
                                                    <div class="spinner-border spinner-border-sm text-primary mb-1"></div>
                                                    <div>Loading family members…</div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div id="affCopyToast" class="aff-copy-toast">
                                    <i class="bx bx-check me-1"></i><span id="affCopyMsg">Copied!</span>
                                </div>
                            </div>
                        </div>

                        @* ─── TAB 3: BROKER ─── *@
                        <div class="tab-pane-emp d-none flex-grow-1" id="pane-broker">
                            <div class="card-body">
                                <div class="subsec-head"><span class="subsec-dot bg-info"></span>Broker Information</div>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <span class="field-label">Broker</span>
                                        <div class="field-with-actions edit-f">
                                            <div class="field-grow">
                                                <select asp-for="BrokerId" asp-items="ViewBag.Brokers" class="form-select form-select-sm edit-f">
                                                    <option value="">— Select —</option>
                                                </select>
                                            </div>
                                            <button type="button" class="btn btn-label-info btn-act" title="Broker Info" onclick="viewBrokerInfo()">
                                                <i class="bx bx-info-circle"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <span class="field-label">Broker Contact</span>
                                        <div class="field-with-actions edit-f">
                                            <div class="field-grow">
                                                <select asp-for="BrokerContactId" asp-items="ViewBag.BrokerContacts" class="form-select form-select-sm edit-f">
                                                    <option value="">— Select —</option>
