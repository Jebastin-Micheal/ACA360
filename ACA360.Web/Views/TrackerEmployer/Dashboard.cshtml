@section Scripts {

    <script>
        var _contacts = @Html.Raw(Json.Serialize(ViewBag.ContactsJson ?? new List<object>()));
        var _billingContacts = @Html.Raw(Json.Serialize(ViewBag.BillingContactsJson ?? new List<object>()));
        var _brokerContacts = @Html.Raw(Json.Serialize(ViewBag.BrokerContactsJson ?? new List<object>()));
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/vscript/tracker_dashboard-ux-pack.js"></script>
    <script src="~/js/vscript/dashboard-receipt-id.js"></script>
    <script src="~/js/ein-mask.js"></script>

    <script>
                /* ═══════════════════════════════════════════════════════════
                   TAB SWITCHING
                ═══════════════════════════════════════════════════════════ */
                document.querySelectorAll('.emp-tab-nav .nav-link').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        document.querySelectorAll('.emp-tab-nav .nav-link').forEach(function (b) { b.classList.remove('active'); });
                        document.querySelectorAll('.tab-pane-emp').forEach(function (p) { p.classList.add('d-none'); });
                        btn.classList.add('active');
                        var t = document.getElementById(btn.getAttribute('data-tab'));
                        if (t) t.classList.remove('d-none');
                    });
                });

                /* ═══════════════════════════════════════════════════════════
                   INLINE FIELD EDITING
                   - All inputs/selects look like normal form controls always
                   - LOCKED on load: inputs have [readonly], selects have .sel-locked
                   - Double-click any field → unlocks ONLY that field
                   - One Save button always visible
                ═══════════════════════════════════════════════════════════ */

                var _savedFieldValues = {};
                var canViewFullEIN = @(CanViewSSNorEIN ? "true" : "false");
                        $(function () {
             // Init Bootstrap tooltips
             document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
                 new bootstrap.Tooltip(el);
             });

             // Lock all selects on page load
             $('#frmDashboard select.edit-f').addClass('sel-locked');
             _captureFieldSnapshot();
        });
                $(function () {
                    // Lock all selects on page load
                    $('#frmDashboard select.edit-f').addClass('sel-locked');
                    _captureFieldSnapshot();
                });

                function _captureFieldSnapshot() {
                    _savedFieldValues = {};
                    $('#frmDashboard input.edit-f:not(.ein-mask-field), #frmDashboard select.edit-f').each(function () {
                        var key = this.name || this.id;
                        if (!key) return;
                        _savedFieldValues[key] = $(this).is(':checkbox') ? this.checked : $(this).val();
                    });
                    $('#frmDashboard .form-check-input').each(function () {
                        var key = this.name || this.id;
                        if (key) _savedFieldValues[key] = this.checked;
                    });
                }

                var _editStarted = false;
                function startEdit() {
                    if (_editStarted) return;
                    _editStarted = true;
                    document.body.classList.add('ws-edit');
                    $.einMaskEditStart();
                }

                function cancelEdit() {
                    $('#frmDashboard input.edit-f:not(.ein-mask-field)').each(function () {
                        var key = this.name || this.id;
                        if (key && _savedFieldValues[key] !== undefined) $(this).val(_savedFieldValues[key]);
                        $(this).attr('readonly', true);
                    });
                    $('#frmDashboard select.edit-f').each(function () {
                        var key = this.name || this.id;
                        if (key && _savedFieldValues[key] !== undefined) $(this).val(_savedFieldValues[key]);
                        $(this).addClass('sel-locked').removeClass('sel-active');
                        $(this).closest('.field-with-actions').removeClass('fwa-active');
                    });
                    $('#frmDashboard .form-check-input').each(function () {
                        var key = this.name || this.id;
                        if (key && _savedFieldValues[key] !== undefined) this.checked = _savedFieldValues[key];
                    });
                    document.body.classList.remove('ws-edit');
                    _editStarted = false;
                    $('#frmDashboard').einMaskRestore();
                }

                /* ── DOUBLE-CLICK TO UNLOCK — per field ── */

                // TEXT INPUT: double-click → remove readonly on that field only
                $(document).on('dblclick', '#frmDashboard input.edit-f[readonly]:not(.ein-mask-field)', function () {
                    $(this).removeAttr('readonly').focus().select();
                    startEdit();
                });

                // SELECT: block dropdown opening on single-click while locked
                // (dblclick still fires because pointer-events is NOT none in CSS)
                $(document).on('mousedown', '#frmDashboard select.edit-f.sel-locked', function (e) {
                    e.preventDefault();
                });

                // SELECT: double-click → remove sel-locked, becomes normal active dropdown
                $(document).on('dblclick', '#frmDashboard select.edit-f.sel-locked', function () {
                    $(this).removeClass('sel-locked').addClass('sel-active');
                    var $fwa = $(this).closest('.field-with-actions');
                    if ($fwa.length) $fwa.addClass('fwa-active');
                    $(this).focus();
                    startEdit();
                });

                // CHECKBOX: any change → mark edit started
                $(document).on('change', '#frmDashboard .form-check-input', function () {
                    startEdit();
                });

                // FIELD LABEL: double-click on label → activate the sibling field
                $(document).on('dblclick', '#frmDashboard .field-label', function () {
                    var $parent = $(this).parent();
                    var $inp = $parent.find('input.edit-f[readonly]:not(.ein-mask-field)').first();
                    var $sel = $parent.find('select.edit-f.sel-locked').first();
                    if ($inp.length) {
                        $inp.removeAttr('readonly').focus().select();
                        startEdit();
                    } else if ($sel.length) {
                        $sel.removeClass('sel-locked').addClass('sel-active');
                        var $fwa = $sel.closest('.field-with-actions');
                        if ($fwa.length) $fwa.addClass('fwa-active');
                        $sel.focus();
                        startEdit();
                    }
                });

