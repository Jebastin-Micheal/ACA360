                /* ═══════════════════════════════════════════════════════════
                   SEARCHABLE CATEGORY DROPDOWN
                ═══════════════════════════════════════════════════════════ */
                var _catCtx = {
                    filter: {
                        input: function () { return document.getElementById('filterCatInput'); },
                        drop: function () { return document.getElementById('filterCatDrop'); },
                        hidden: function () { return document.getElementById('noteFilterCategory'); },
                        noResult: function () { return document.getElementById('filterCatNoResults'); }
                    },
                    modal: {
                        input: function () { return document.getElementById('modalCatInput'); },
                        drop: function () { return document.getElementById('modalCatDrop'); },
                        hidden: function () { return document.getElementById('noteCategory'); },
                        noResult: function () { return document.getElementById('modalCatNoResults'); }
                    }
                };

                function openCatDrop(ctx) {
                    var other = ctx === 'filter' ? 'modal' : 'filter';
                    closeCatDrop(other);
                    var c = _catCtx[ctx];
                    var inp = c.input(); var drop = c.drop();
                    drop.classList.add('open');
                    inp.removeAttribute('readonly');
                    inp.select();
                    drop.style.width = inp.offsetParent ? inp.offsetParent.offsetWidth + 'px' : '100%';
                }

                function closeCatDrop(ctx) {
                    var c = _catCtx[ctx];
                    var drop = c.drop(); var inp = c.input();
                    drop.classList.remove('open');
                    var hidden = c.hidden();
                    if (hidden.value) inp.value = hidden.value;
                    else { inp.value = ''; inp.placeholder = ctx === 'filter' ? 'Filter by category…' : 'Search or select category…'; }
                    searchCat(ctx, '');
                    if (ctx === 'filter') inp.setAttribute('readonly', '');
                }

                function searchCat(ctx, query) {
                    var c = _catCtx[ctx]; if (!c) return;
                    var drop = c.drop(); var noRes = c.noResult();
                    var q = (query || '').toLowerCase().trim();
                    var opts = drop.querySelectorAll('.cat-option');
                    var labels = drop.querySelectorAll('.cat-group-label');
                    var anyVisible = false;
                    opts.forEach(function (opt) {
                        var match = opt.textContent.toLowerCase().indexOf(q) !== -1;
                        opt.classList.toggle('hidden', !match);
                        if (match) anyVisible = true;
                    });
                    labels.forEach(function (lbl) {
                        var next = lbl.nextElementSibling; var hasVisible = false;
                        while (next && !next.classList.contains('cat-group-label') && !next.classList.contains('cat-no-results')) {
                            if (!next.classList.contains('hidden')) { hasVisible = true; break; }
                            next = next.nextElementSibling;
                        }
                        lbl.style.display = hasVisible ? '' : 'none';
                    });
                    if (noRes) noRes.style.display = anyVisible ? 'none' : 'block';
                }

                function selectCat(ctx, label, val) {
                    var c = _catCtx[ctx];
                    c.input().value = label || 'All Categories';
                    c.hidden().value = val;
                    c.drop().classList.remove('open');
                    if (ctx === 'filter') applyNoteFilters();
                }

                document.addEventListener('click', function (e) {
                    ['filter', 'modal'].forEach(function (ctx) {
                        var wrap = document.getElementById(ctx === 'filter' ? 'filterCatWrap' : 'modalCatWrap');
                        if (wrap && !wrap.contains(e.target)) closeCatDrop(ctx);
                    });
                });

                function resetCatWidget(ctx) {
                    var c = _catCtx[ctx];
                    c.hidden().value = '';
                    var inp = c.input();
                    inp.value = '';
                    inp.placeholder = ctx === 'filter' ? 'Filter by category…' : 'Search or select category…';
                    if (ctx === 'filter') inp.setAttribute('readonly', '');
                    c.drop().querySelectorAll('.cat-option').forEach(function (o) { o.classList.remove('selected', 'hidden'); });
                    c.drop().querySelectorAll('.cat-group-label').forEach(function (l) { l.style.display = ''; });
                    if (c.noResult()) c.noResult().style.display = 'none';
                }

                function setCatWidget(ctx, val) {
                    if (!val) { resetCatWidget(ctx); return; }
                    var c = _catCtx[ctx];
                    c.hidden().value = val;
                    c.input().value = val;
                    c.drop().querySelectorAll('.cat-option').forEach(function (o) { o.classList.toggle('selected', o.getAttribute('data-val') === val); });
                }

                /* ═══════════════════════════════════════════════════════════
                   FULLSCREEN
                ═══════════════════════════════════════════════════════════ */
                function toggleFullScreen() {
                    var icon = document.getElementById('fsIcon');
                    if (!document.fullscreenElement) {
                        var elem = document.documentElement;
                        if (elem.requestFullscreen) elem.requestFullscreen();
                        else if (elem.webkitRequestFullscreen) elem.webkitRequestFullscreen();
                        document.body.classList.add('dashboard-fs-active');
                        if (icon) icon.classList.replace('bx-fullscreen', 'bx-exit-fullscreen');
                    } else {
                        if (document.exitFullscreen) document.exitFullscreen();
                    }
                }

                document.addEventListener('fullscreenchange', function () {
                    var icon = document.getElementById('fsIcon');
                    if (!document.fullscreenElement) {
                        document.body.classList.remove('dashboard-fs-active');
                        if (icon) icon.classList.replace('bx-exit-fullscreen', 'bx-fullscreen');
                    }
                });

