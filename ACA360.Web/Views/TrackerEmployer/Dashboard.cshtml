                $(document).off('click', '.process-history-btn').on('click', '.process-history-btn', function (e) {
            e.preventDefault();

            var $btn = $(this);
            var categoryId = $btn.data('category'); // UI elements indicator variables: 1, 2, or 3
            var serviceId = $('#activeSvcSel').val(); // Dropdown master unique ID string selector link

            if (!serviceId || serviceId === "") {
                serviceId = $('input[name="EmployerServiceId"]').val();
            }

            if (!serviceId || serviceId <= 0) {
                Swal.fire('Warning', 'Please select an active tracking service first.', 'warning');
                return;
            }

            // ── LIVE INTERFACE ACTIVE PROCESS TEXT SNAPSHOT ──
            var currentActiveUIValue = "";
            if (categoryId === 1) {
                currentActiveUIValue = $('#ProcessStep1095').val(); // Live selected text from 1095 dropdown
            } else if (categoryId === 2) {
                currentActiveUIValue = $('#FTETrackingStep').val(); // Live selected text from FTE dropdown
            } else if (categoryId === 3) {
                currentActiveUIValue = $('#StateFilingStep').val(); // Live selected text from State filing dropdown
            }

            var sectionTitle = "Process History View";
            if (categoryId === 1) sectionTitle = "1095 Process Step History";
            else if (categoryId === 2) sectionTitle = "FTE Tracking Step History";
            else if (categoryId === 3) sectionTitle = "State Filing Step History";

            $('#historyModalTitleHtml').html('<i class="bx bx-history text-primary me-2 fs-4"></i>' + sectionTitle);

            $('#historyTableBody').empty();
            $('#historyPopupLoader').show();
            $('#processHistoryModal').modal('show');

            // AJAX Endpoint call execution mapping dynamic parameters context handles
            $.get('/TrackerEmployer/GetProcessHistory', { employerServiceId: serviceId, categoryId: categoryId })
                .done(function (res) {
                    $('#historyPopupLoader').hide();

                            if (res && res.length > 0) {
            var rowsHtml = '';
            var activeAlreadyMarked = false;

            $.each(res, function (i, item) {
                var rawDate = new Date(item.createdDate);
                var formattedDate = rawDate.toISOString().split('T')[0];

                var nextFollowUp = "—";
                if (item.nextFollowUpDate) {
                    nextFollowUp = new Date(item.nextFollowUpDate).toISOString().split('T')[0];
                }

                // ── COMPARE STEP TO INJECT ACTIVE BADGE — ONLY FIRST (LATEST) MATCH ──
                var activeBadgeHtml = '';
                if (!activeAlreadyMarked && currentActiveUIValue && item.processName === currentActiveUIValue) {
                    activeBadgeHtml = '<span class="badge bg-label-success rounded-pill ms-2 fw-bold animate__animated animate__pulse animate__infinite" style="font-size: 0.62rem; padding: 0.25em 0.5em;">Active</span>';
                    activeAlreadyMarked = true;
