                        function saveSvcPanel() {
                    var form = document.getElementById('frmSvcPanel');
                    if (!form) return;

                    var activeSvcId = parseInt(document.getElementById('activeSvcSel').value) || 0;
                    if (activeSvcId <= 0) {
                        Swal.fire('Warning', 'Please select a service first.', 'warning');
                        return;
                    }

                    var fd2 = new FormData(form);

                    fd2.set('EmployerServiceId', activeSvcId);
                    fd2.set('Status', document.getElementById('svcStatusSel').value);

                    ['MedcomCOBRA', 'Required131', 'WillNotSignSA', 'CDHPClient'].forEach(function (f) {
                        if (!fd2.has(f)) fd2.set(f, 'false');
                    });

                    var payload = {};
                    fd2.forEach(function (v, k) { payload[k] = v; });

                    $.post('/TrackerEmployer/SaveService', payload)
                        .done(function (r) {
                            if (r.success) {
                                Swal.fire({ icon: 'success', title: 'Saved!', timer: 800, showConfirmButton: false });
