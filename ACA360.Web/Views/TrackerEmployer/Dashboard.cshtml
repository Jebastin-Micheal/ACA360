                function saveDashboard() {
                    var form = $('#frmDashboard');
                    $.validator.unobtrusive.parse(form);
                    if (!form.valid()) { Swal.fire('Validation', 'Please check required fields.', 'warning'); return; }

                    Swal.fire({ title: 'Saving...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

                    var employerId = $('#hdnEmployerId').val();
                    form.einMaskPrepare();

                    $.post('/TrackerEmployer/Save', form.serialize())
                        .done(function (r) {
                            form.einMaskRestore();
                            if (r.success) {
                                $.getJSON('/TrackerEmployer/GetDashboardJson', { id: employerId })
                                    .done(function (data) {
                                        // Update EIN hidden real value if returned
                                        if (data.ein) $('#txtEIN').data('real', data.ein);

                                        Swal.fire({ icon: 'success', title: 'Saved!', timer: 900, showConfirmButton: false })
                                            .then(function () {
                                                $('#frmDashboard input.edit-f:not(.ein-mask-field)').attr('readonly', true);
                                                $('#frmDashboard select.edit-f').addClass('sel-locked').removeClass('sel-active');
                                                $('#frmDashboard .field-with-actions').removeClass('fwa-active');
                                                document.body.classList.remove('ws-edit');
                                                _editStarted = false;
                                                _captureFieldSnapshot();
                                                $('#frmDashboard').einMaskRestore();
                                            });
                                    })
                                    .fail(function () {
                                        Swal.fire({ icon: 'success', title: 'Saved!', timer: 900, showConfirmButton: false })
                                            .then(cancelEdit);
                                    });
                            } else {
                                Swal.fire('Error', r.message || 'Save failed.', 'error');
                            }
                        })
                        .fail(function () {
                            form.einMaskRestore();
                            Swal.fire('Error', 'An unexpected error occurred while saving.', 'error');
                        });
                }

