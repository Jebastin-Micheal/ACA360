                function renderGrid(data) {
                    var tbody = document.getElementById('svcTableBody');
                    if (!data || !data.length) {
                        tbody.innerHTML = '<tr><td colspan="20" class="text-center text-muted py-3 small">No services assigned.</td></tr>';
                        return;
                    }
                    var sc = { Sold: 'bg-label-primary', Active: 'bg-label-success', Pending: 'bg-label-warning', Opportunity: 'bg-label-secondary', Lost: 'bg-label-danger' };
                    var rows = '';
                    data.forEach(function (s, i) {
                        var stCls = sc[s.status] || 'bg-label-secondary';
                        var s1 = s.processStep1095 === 'Mailed' ? 'bg-label-success' : (s.processStep1095 ? 'bg-label-warning' : 'bg-label-secondary');
                        var sf = s.fteTrackingStep === 'Complete' ? 'bg-label-success' : (s.fteTrackingStep ? 'bg-label-warning' : 'bg-label-secondary');
                        var ss = s.stateFilingStep === 'Complete' ? 'bg-label-success' : (s.stateFilingStep ? 'bg-label-warning' : 'bg-label-secondary');
                        rows += '<tr id="gRow' + i + '" onclick="selectGridRow(this,' + i + ')">'
                            + '<td class="fw-semibold" style="color:var(--bs-primary)">' + esc(s.serviceName || '—') + '</td>'
                            + '<td><span class="badge ' + stCls + ' rounded-pill">' + esc(s.status || '—') + '</span></td>'
                            + '<td>' + esc(s.potentialPenalty || '—') + '</td>'
                            + '<td>' + esc(s.safeHarbor || '—') + '</td>'
                            + '<td>' + fmtD(s.proposalSentDate) + '</td>'
                            + '<td>' + fmtD(s.proposalSignedDate) + '</td>'
                            + '<td>' + fmtD(s.contractSentDate) + '</td>'
                            + '<td>' + fmtD(s.contractSignedDate) + '</td>'
                            + '<td><span class="badge ' + s1 + ' rounded-pill">' + esc(s.processStep1095 || '—') + '</span></td>'
                            + '<td>' + fmtD(s.lastUpdated1095) + '</td>'
                            + '<td>' + fmtD(s.nextFollowUp1095) + '</td>'
                            + '<td>' + esc(s.actualEmployeesTracked || '—') + '</td>'
                            + '<td><span class="badge ' + sf + ' rounded-pill">' + esc(s.fteTrackingStep || '—') + '</span></td>'
                            + '<td>' + fmtD(s.lastUpdatedFTE) + '</td>'
                            + '<td>' + fmtD(s.nextFollowUpFTE) + '</td>'
                            + '<td><span class="badge ' + ss + ' rounded-pill">' + esc(s.stateFilingStep || '—') + '</span></td>'
                            + '<td>' + fmtD(s.lastUpdatedState) + '</td>'
                            + '<td class="' + (s.NextFollowUpState ? 'text-danger fw-semibold' : 'text-muted') + '">' + fmtD(s.NextFollowUpState) + '</td>'
                            + '<td>' + esc(s.pricing || '—') + '</td>'
                            + '<td>' + esc(s.initialBill || '—') + '</td>'
