    <script>
        (function () {
            'use strict';
            var STORAGE_KEY_R1 = 'aca360_col_r1';
            var STORAGE_KEY_R2 = 'aca360_col_r2';

            function initResizer(resizerId, leftColId, rightColId, storageKey) {
                var resizer = document.getElementById(resizerId);
                var leftCol = document.getElementById(leftColId);
                var rightCol = document.getElementById(rightColId);
                if (!resizer || !leftCol || !rightCol) return;
                var saved = localStorage.getItem(storageKey);
                if (saved) { var pct = parseFloat(saved); if (!isNaN(pct) && pct > 5 && pct < 85) leftCol.style.flex = '0 0 ' + pct + '%'; }
                var startX, startLeftW, containerW;
                resizer.addEventListener('mousedown', function (e) {
                    e.preventDefault();
                    resizer.classList.add('dragging');
                    document.body.classList.add('col-resizing');
                    startX = e.clientX;
                    var container = document.getElementById('dashTopRow');
                    containerW = container.getBoundingClientRect().width;
                    startLeftW = leftCol.getBoundingClientRect().width;
                    function onMove(ev) {
                        var dx = ev.clientX - startX;
                        var newLeftPct = ((startLeftW + dx) / containerW) * 100;
                        var minPct = (parseInt(leftCol.style.minWidth || 180) / containerW) * 100;
                        var maxPct = 100 - (parseInt(rightCol.style.minWidth || 180) / containerW) * 100 - 1;
                        newLeftPct = Math.max(minPct, Math.min(maxPct, newLeftPct));
                        leftCol.style.flex = '0 0 ' + newLeftPct.toFixed(2) + '%';
                        localStorage.setItem(storageKey, newLeftPct.toFixed(2));
                    }
                    function onUp() {
                        resizer.classList.remove('dragging');
                        document.body.classList.remove('col-resizing');
                        document.removeEventListener('mousemove', onMove);
                        document.removeEventListener('mouseup', onUp);
                    }
                    document.addEventListener('mousemove', onMove);
                    document.addEventListener('mouseup', onUp);
                });
                resizer.addEventListener('dblclick', function () {
                    var defaults = { resizer1: 41.6, resizer2: 66.6 };
                    leftCol.style.flex = '0 0 ' + (defaults[resizerId] || 41.6) + '%';
                    localStorage.removeItem(storageKey);
                });
            }

            document.addEventListener('DOMContentLoaded', function () {
                initResizer('resizer1', 'employerCol', 'notesCol', STORAGE_KEY_R1);
                initResizer('resizer2', 'notesCol', 'serviceCol', STORAGE_KEY_R2);
            });
        })();
    </script>

    <script>
        (function () {
            //var NOTES_COLLAPSED_KEY = 'aca360_notes_collapsed';
            var _savedNotesPct = null;

            function toggleNotesPanel(forceExpand) {
                var notesCol = document.getElementById('notesCol');
                var resizer2 = document.getElementById('resizer2');
                var icon1 = document.getElementById('rIcon1');
                var isCollapsed = notesCol.classList.contains('notes-collapsed');
                if (forceExpand && !isCollapsed) return;
                if (isCollapsed || forceExpand) {
                    var hc = document.getElementById('notesPanelChevron');
                    if (hc) hc.classList.replace('bx-chevron-right', 'bx-chevron-left');
                    notesCol.classList.remove('notes-collapsed');
                    document.body.classList.remove('notes-is-collapsed');
                    var pct = _savedNotesPct || 25;
                    notesCol.style.flex = '0 0 ' + pct + '%';
                    if (resizer2) resizer2.style.pointerEvents = '';
                    if (icon1) { icon1.classList.remove('bx-chevron-right'); icon1.classList.add('bx-chevron-left'); }

                } else {
                    var hc = document.getElementById('notesPanelChevron');
                    if (hc) hc.classList.replace('bx-chevron-left', 'bx-chevron-right');
                    var containerW = document.getElementById('dashTopRow').getBoundingClientRect().width;
                    var currentW = notesCol.getBoundingClientRect().width;
                    _savedNotesPct = (currentW / containerW) * 100;
                    notesCol.classList.add('notes-collapsed');
                    document.body.classList.add('notes-is-collapsed');
                    if (resizer2) resizer2.style.pointerEvents = 'none';
                    if (icon1) { icon1.classList.remove('bx-chevron-left'); icon1.classList.add('bx-chevron-right'); }

                }
            }

            document.addEventListener('DOMContentLoaded', function () {
                    setTimeout(function () { toggleNotesPanel(false); }, 50);
            });

            window.toggleNotesPanel = toggleNotesPanel;
        })();

        function toggleServiceGrid() {
            var body = document.getElementById('svcGridBody');
            var icon = document.getElementById('svcGridChevron');
            var isOpen = body.style.display !== 'none';
            if (isOpen) { $(body).slideUp(200); icon.classList.replace('bx-chevron-down', 'bx-chevron-up'); }
            else { $(body).slideDown(200); icon.classList.replace('bx-chevron-up', 'bx-chevron-down'); }
        }

        function monitorDownload() {
            Swal.fire({ title: 'Downloading...', icon: 'success', timer: 1500, timerProgressBar: true, showConfirmButton: false, toast: true, position: 'top-end' });
        }
