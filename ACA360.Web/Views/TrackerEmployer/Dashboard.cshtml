@* Add/Edit Affiliate *@
<div class="modal fade" id="addAffiliateModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold fs-6">
                    <i class="bx bx-link-alt text-primary me-2"></i><span id="affModalTitle">Add Affiliate</span>
                </h5>
                <button type="button" class="btn btn-sm btn-label-primary ms-auto me-3" onclick="copyPrimaryToAffiliate()">
                    <i class="bx bx-copy-alt me-1"></i>Copy from Primary
                </button>
                <button type="button" class="btn-close ms-0" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <input type="hidden" id="affEditId" value="0" />
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-semibold small">Affiliate Name <span class="text-danger">*</span></label>
                                    <input type="text" id="affName" class="form-control" placeholder="Full legal employer name" maxlength="75" oninput="this.value=this.value.replace(/[^A-Za-z .'-]/g,'').replace(/^\s+/,'').replace(/\s{2,}/g,' ')" onblur="this.value=this.value.trim()" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">EIN</label>
                                    <input type="text" id="affEIN" class="form-control ein-mask-field mask-ein" data-real="" placeholder="XX-XXXXXXX" readonly autocomplete="off" maxlength="10" oninput="this.value=this.value.replace(/\D/g,'').slice(0,9).replace(/^(\d{2})(\d)/,'$1-$2')" />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label fw-semibold small">Street Address</label>
                                    <input type="text" id="affAddress" class="form-control" placeholder="Street address" maxlength="150" oninput="this.value=this.value.replace(/[^A-Za-z0-9 #&'(),.\/-]/g,'').replace(/^\s+/,'').replace(/\s{2,}/g,' ')" onblur="this.value=this.value.trim()" />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label fw-semibold small">Address 2</label>
                                    <input type="text" id="affAddress2" class="form-control" placeholder="Suite, unit, etc." maxlength="150" oninput="this.value=this.value.replace(/[^A-Za-z0-9 #&'(),.\/-]/g,'').replace(/^\s+/,'').replace(/\s{2,}/g,' ')" onblur="this.value=this.value.trim()" />
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label fw-semibold small">City</label>
                                    <input type="text" id="affCity" class="form-control" placeholder="City" maxlength="50" oninput="this.value=this.value.replace(/[^A-Za-z .'-]/g,'').replace(/^\s+/,'').replace(/\s{2,}/g,' ')" onblur="this.value=this.value.trim()" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">State</label>
                                    <select id="affState" class="form-select">
                                        <option value="">— Select —</option>
                                        @if (ViewBag.StatesACA != null)
                                        {
                                            foreach (var s in (SelectList)ViewBag.StatesACA)
                                            {
                                                <option value="@s.Value">@s.Text</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold small">Zip</label>
                                    <input type="text" id="affZip" class="form-control" placeholder="Zip" maxlength="10" inputmode="numeric" oninput="this.value=this.value.replace(/\D/g,'').slice(0,9).replace(/^(\d{5})(\d)/,'$1-$2')" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Phone</label>
                                    <input type="text" id="affPhone" class="form-control" placeholder="(XXX) XXX-XXXX" maxlength="12" oninput="this.value=this.value.replace(/\D/g,'').slice(0,10).replace(/^(\d{3})(\d)/,'$1-$2').replace(/^(\d{3}-\d{3})(\d)/,'$1-$2')" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Email Address</label>
                                    <input type="email" id="affEmail" class="form-control" placeholder="Email address" maxlength="254" oninput="this.value=this.value.replace(/\s/g,'')" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-4">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveAffiliate()">
                    <i class="bx bx-save me-1"></i>Save Affiliate
                </button>
            </div>
        </div>
    </div>
</div>

