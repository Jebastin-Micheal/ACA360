                    listEl.innerHTML = '<div class="text-center text-muted py-4 x-small"><div class="spinner-border spinner-border-sm text-primary mb-1"></div><div>Loading notes…</div></div>';
                    $.getJSON('/TrackerEmployer/GetNotes', { employerId: empId }, function (data) {
                        allNotes = data || [];
                        applyNoteFilters();
                    }).fail(function () {
                        listEl.innerHTML = '<div class="text-center text-danger py-3 x-small">Error loading notes.</div>';
                    });
                }

                function applyNoteFilters() {
                    var selectedCat = document.getElementById('noteFilterCategory').value;
                    var searchQuery = (document.getElementById('noteSearchBox')?.value || '').toLowerCase().trim();
                    var filteredNotes = allNotes.filter(function (n) {
                        var matchesCat = !selectedCat || n.category === selectedCat;
                        var matchesSearch = !searchQuery || (n.noteText || '').toLowerCase().includes(searchQuery) || (n.createdByName || '').toLowerCase().includes(searchQuery);
                        return matchesCat && matchesSearch;
                    });
                    document.getElementById('noteCount').textContent = filteredNotes.length;
                    var statusEl = document.getElementById('noteFilterStatus');
                    statusEl.textContent = (selectedCat || searchQuery) ? filteredNotes.length + ' of ' + allNotes.length : '';
                    renderNotes(filteredNotes);
                }

                function clearNoteFilters() {
                    resetCatWidget('filter');
                    var searchBox = document.getElementById('noteSearchBox');
                    if (searchBox) searchBox.value = '';
                    applyNoteFilters();
                }

                var NOTE_TRUNCATE_CHARS = 150;
                var NOTE_TRUNCATE_LINES = 3;
                var _expandedNotes = {};

                function renderNotes(notes) {
                    var el = document.getElementById('notesList');
                    if (!notes || !notes.length) {
                        el.innerHTML = '<div class="text-center text-muted py-5"><i class="bx bx-note d-block mb-2 mx-auto opacity-25" style="font-size:3rem"></i><p class="small mb-0">No entries matched filters.</p></div>';
                        return;
                    }
                    var currentUsername = el.getAttribute('data-current-user') || 'System';
                    notes.sort(function (a, b) { return new Date(b.createdDate) - new Date(a.createdDate); });
                    el.innerHTML = notes.map(function (n) {
                        var nid = n.employerNoteId;
                        var creatorRaw = (n.createdByName || '').toString().trim();
                        var creator = (creatorRaw === '0' || !creatorRaw) ? currentUsername : creatorRaw;
                        var d = new Date(n.createdDate);
                        var formattedDate = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                        var badgeClass = BADGE_CLS[n.category] || 'bg-label-secondary';
                        var noteText = n.noteText || '';
                        var noteContent = esc(noteText);
                        var isLong = noteText.length > NOTE_TRUNCATE_CHARS || noteText.split('\n').length > NOTE_TRUNCATE_LINES;
                        var isExpanded = _expandedNotes[nid] === true;
                        var state = (!isLong || isExpanded) ? 'expanded' : 'collapsed';
                        return '<div class="note-card transition-all" id="nc_' + nid + '">'
                            + '<div class="note-body-compact text-dark" id="nw_' + nid + '" data-state="' + state + '">' + noteContent + '</div>'
                            + '<div class="note-footer-compact"><div class="note-meta-inline">'
                            + '<span class="fw-bold text-heading">' + esc(creator) + '</span>'
                            + '<span class="badge ' + badgeClass + ' border-0 py-0" style="font-size:0.6rem;height:15px;line-height:15px">' + esc(n.category || 'General') + '</span>'
                            + '<span>' + formattedDate + '</span></div>'
                            + '<div class="d-flex gap-2">'
                            + (isLong ? '<button type="button" class="btn btn-sm p-0 text-muted btn-compact me-2" onclick="toggleNoteText(' + nid + ')" id="nt_' + nid + '"><span class="nt-label">' + (state === 'collapsed' ? 'Show more' : 'Show less') + '</span></button>' : '')
                            + '<button type="button" class="btn btn-sm p-0 text-primary btn-compact" onclick="openEditNote(' + nid + ')" title="Edit"><i class="bx bx-pencil"></i></button>'
                            + '<button type="button" class="btn btn-sm p-0 text-danger btn-compact" onclick="deleteNote(' + nid + ')" title="Delete"><i class="bx bx-trash"></i></button>'
                            + '</div></div></div>';
                    }).join('');
                }

                function toggleNoteText(id) {
                    var wrap = document.getElementById('nw_' + id);
                    var btn = document.getElementById('nt_' + id);
                    if (!wrap || !btn) return;
                    var expanding = wrap.getAttribute('data-state') === 'collapsed';
                    if (expanding) {
                        wrap.style.maxHeight = wrap.scrollHeight + 'px';
                        wrap.setAttribute('data-state', 'expanded');
                        btn.querySelector('.nt-label').textContent = 'Show less';
                        setTimeout(function () { if (wrap.getAttribute('data-state') === 'expanded') wrap.style.maxHeight = ''; }, 350);
                        _expandedNotes[id] = true;
                    } else {
                        wrap.style.maxHeight = wrap.scrollHeight + 'px';
                        wrap.offsetHeight;
                        wrap.style.maxHeight = '';
                        wrap.setAttribute('data-state', 'collapsed');
                        btn.querySelector('.nt-label').textContent = 'Show more';
                        _expandedNotes[id] = false;
                    }
                }

                function toggleNoteForm(show) {
                    var form = $('#inlineNoteContainer');
                    if (show) { form.slideDown(200); $('#noteText').focus(); }
                    else {
                        if ($('#noteText').val().trim().length > 0) {
                            Swal.fire({ title: 'Discard changes?', icon: 'warning', showCancelButton: true, confirmButtonText: 'Yes, discard' })
                                .then(function (result) { if (result.isConfirmed) form.slideUp(200, resetNoteForm); });
                        } else { form.slideUp(200, resetNoteForm); }
                    }
                }

                function resetNoteForm() {
                    $('#noteEditId').val('0');
                    $('#noteText').val('');
                    $('#noteCharCount').text('0 chars');
                    resetCatWidget('modal');
                }

                function openAddNote() { resetNoteForm(); toggleNoteForm(true); }

                function openEditNote(id) {
                    var n = allNotes.find(function (x) { return x.employerNoteId === id; });
                    if (!n) return;
                    $('#noteEditId').val(id);
                    setCatWidget('modal', n.category || '');
                    $('#noteText').val(n.noteText || '');
                    $('#noteCharCount').text((n.noteText || '').length + ' chars');
                    toggleNoteForm(true);
                    $('html, body').animate({ scrollTop: $("#inlineNoteContainer").offset().top - 150 }, 300);
                }

                function saveNote() {
                    var cat = document.getElementById('noteCategory').value;
                    var txt = document.getElementById('noteText').value.trim();
                    if (!cat) { Swal.fire('Required', 'Please select a category.', 'warning'); return; }
                    if (!txt) { Swal.fire('Required', 'Please enter note text.', 'warning'); return; }
                    $.post('/TrackerEmployer/SaveNote', {
                        EmployerNoteId: document.getElementById('noteEditId').value,
                        EmployerId: document.getElementById('hdnEmployerId').value,
                        Category: cat, NoteText: txt
                    }).done(function (r) {
                        if (r.success) {
                            $('#inlineNoteContainer').slideUp(200, resetNoteForm);
                            Swal.fire({ icon: 'success', title: 'Note Saved!', timer: 800, showConfirmButton: false });
                            loadNotes();
                        } else Swal.fire('Error', r.message || 'Save failed', 'error');
                    });
                }

                function deleteNote(id) {
                    Swal.fire({ title: 'Delete this note?', icon: 'warning', showCancelButton: true, confirmButtonText: 'Delete', confirmButtonColor: '#d33' })
                        .then(function (r) {
                            if (r.isConfirmed) {
                                $.post('/TrackerEmployer/DeleteNote', { id: id, employerId: parseInt(document.getElementById('hdnEmployerId').value, 10) })
                                    .done(function (res) {
                                        if (res.success) { Swal.fire({ icon: 'success', title: 'Deleted', timer: 700, showConfirmButton: false }); loadNotes(); }
                                    });
