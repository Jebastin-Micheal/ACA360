@using ACA360.Core.Extensions
@model ACA360.Web.Models.PlanListViewModel
<div class="plan-table-container ui-table-responsive">
    <table class="table table-bordered mb-0 ui-table">
        <thead>
            <tr class="align-middle">
                <th>#</th>
                <th>
                    @await Html.PartialAsync("_SortableHeader", new
                                        {
                        Title = "Plan Name",
                                        Column = 0,
                                        SortColumn = Model.SortColumn,
                                        SortOrder = Model.SortOrder
                                        })
                </th>
                <th>
                    <div class="d-flex align-items-center">
                        <span class="me-1">Funding Type</span>

                    </div>
                </th>
                <th>
                    <div class="d-flex align-items-center">
                        <span class="me-1">Plan Type</span>

                    </div>
                </th>
                <th>
                    <div class="d-flex align-items-center">
                        <span class="me-1">Waiting Period</span>

                    </div>
                </th>
                <th>
                    <div class="d-flex align-items-center">
                        <span class="me-1">Banding Type</span>

                    </div>
                </th>
                <th class="text-center">Action</th>
            </tr>
        </thead>
            <tbody>
                @if (Model.Plans != null && Model.Plans.Count > 0)
                {
                    foreach (var Plan in Model.Plans)
                    {

                        <tr>
                            <td>
                                @Plan.RowNum
                            </td>
                            <td>
                                <a href="#" class="edit-plan-btn text-uppercase" data-id="@Plan.ide" title="@(Plan.Name ?? "N/A")">
                                     @(Plan.Name ?? "N/A")
                                </a>
                            </td>

                            <td class="text-uppercase">@(Plan.FundingType ?? "N/A")</td>
                            <td class="text-uppercase">@(Plan.MedicalPlan ?? "N/A")</td>
                            <td class="text-uppercase">@(Plan.EligibleFirstOfMonth ?? "N/A")</td>
                            <td class="text-uppercase">@(Plan.BandingType ?? "N/A")</td>

                            <td class="text-center">                                

                                @if (User.HasPermission("Plan", "Edit"))
                                {
                                    <button type="button" class="btn p-1 me-1 edit-plan-btn" data-id="@Plan.ide" title="Edit">
                                    <i class="icon-base bx bx-edit bg-info icon-sm fs-4 text-secondary"></i>
                                    </button>
                                }

                            <button class="btn btn-sm ps-1"
                                    onclick="openNotes('Plan', @EncryptionService.Decrypt(Plan.ide))">
                                <i class="bx bx-message-square-dots icon-sm fs-4 text-success" title="Notes"></i>
                            </button>
                            <a href="javascript:;" class="btn btn-icon dropdown-toggle hide-arrow action-dots-btn" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="icon-base bx bx-dots-vertical-rounded icon-md"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end m-0" style="">
                                <a href="javascript:;" class="dropdown-item" data-id="@Plan.ide">
                                    <i class="bx bx-trash bg-danger me-1"></i> Delete
                                </a>
                            </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-danger">No plans found.</td>
                    </tr>
                }
            </tbody>
        </table>
</div>

@await Html.PartialAsync("_GridPagination", Model.Metadata)

<script>
    if(typeof PerfectScrollbar !== 'undefined') {
        const container = document.querySelector('#scrollable-tbody-container');
        if(container) { new PerfectScrollbar(container, { wheelSpeed: 1 }); }
    }
</script>