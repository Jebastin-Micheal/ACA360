@using ACA360.Core.Extensions
@model ACA360.Web.Models.PlanListViewModel



<div class="row">
    <div id="employerListScrollWrapper" class="card-body p-0 flex-grow-1 overflow-auto">
        <div class="table-responsive text-nowrap ui-table-responsive">
            <table class="table table-bordered table-hover am-table mb-0 ui-table">
                <thead>
                    <tr>
                        <th>
                            <div class="d-flex align-items-center justify-content-between gap-2">
                                @await Html.PartialAsync("_SortableHeader", new
                                                                {
                                    Title = "Name",
                                                                Column = 0,
                                                                SortColumn = Model.SortColumn,
                                                                SortOrder = Model.SortOrder
                                                                })
                                @* Collapse the list to a vertical rail (shown in split/compare view). *@
                                <button type="button" id="listToggleBtn" class="cmp-icon-btn cmp-list-toggle" title="Hide the list">
                                    <i class="bx bx-chevrons-left"></i>
                                </button>
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Plans != null && Model.Plans.Count > 0)
                    {
                        foreach (var item in Model.Plans)
                        {
                            <tr>
                                <td class="plan-active p-3">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="cursor-pointer d-flex align-items-center plan-item" data-id="@item.ide">
                                            <div class="avatar-wrapper me-3">
                                                <div class="avatar avatar-sm">
                                                    <span class="avatar-initial rounded-circle bg-label-primary">
                                                        <i class="bx bx-spreadsheet"></i>
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="d-flex flex-column">
                                                <span class="text-primary" title="@item.Name">
                                                    @item.Name
                                                </span>
                                                <small class="text-muted">Type: @(item.MedicalPlan ?? "N/A")</small>
                                            </div>
                                        </div>

                                        <div class="dropdown">
                                            <button type="button" class="btn btn-sm btn-icon dropdown-toggle hide-arrow action-dots-btn" data-bs-toggle="dropdown">
                                                <i class="bx bx-dots-vertical-rounded"></i>
                                            </button>
                                            <div class="dropdown-menu dropdown-menu-end m-0">
                                                <a href="javascript:void(0);" class="dropdown-item delete-plan-btn text-danger" data-id="@item.ide">
                                                    <i class="bx bx-trash me-1"></i> Delete 
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>

                        }
                    }
                    else
                    {
                        <tr><td class="text-center p-3">No plans found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @await Html.PartialAsync("_GridPagination", Model.Metadata)

</div>