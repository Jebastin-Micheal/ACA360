@{
    ViewData["Title"] = "ACA Export Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sessionFilingYear = Context.Session.GetString("SelectedFilingYear") ?? "";
}



<style>
    /* Sneat-style Card Adjustments */
    .card {
        box-shadow: 0 0.25rem 1.125rem rgba(75, 70, 92, 0.1);
        border: none;
        border-radius: 0.5rem;
    }

    .card-header {
        background-color: transparent;
        border-bottom: 1px solid #ebe9f1;
        padding: 1.5rem;
    }

    /* Custom Blue Header for Data Grids */
    .aca-header-blue th {
        background-color: #5F61E6 !important; /* Sneat Primary Purple/Blue */
        color: white !important;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 1px;
        text-align: center;
        vertical-align: middle;
    }

    /* Tabs Styling (Pills) */
    .nav-pills .nav-link {
        font-weight: 500;
        border-radius: 0.375rem;
        padding: 0.7rem 1.2rem;
    }

        .nav-pills .nav-link.active {
            background-color: #5F61E6;
            color: white;
            box-shadow: 0 2px 4px 0 rgba(105, 108, 255, 0.4);
        }

    /* Compact Table */
    .table-compact td {
        font-size: 0.85rem;
        padding: 6px 10px;
        white-space: nowrap;
        vertical-align: middle;
    }

    /* Section Titles */
    .divider-text {
        font-weight: 600;
        color: #566a7f;
        text-transform: uppercase;
        font-size: 0.8rem;
        margin: 20px 0 10px 0;
        border-bottom: 1px solid #d9dee3;
        padding-bottom: 5px;
    }
</style>

<section>
    <div class="row">

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bx bx-filter-alt me-2"></i>Export Filter</h5>
                <small class="text-muted">Select criteria to load report</small>
            </div>
            <div class="card-body mt-3">
                <div class="row align-items-end">
                    <div class="col-md-3 mb-3 mb-md-0">
                        <label class="form-label" for="Filing_Year">Filing Year</label>
                        <div class="input-group input-group-merge">
                            <span class="input-group-text"><i class="bx bx-calendar"></i></span>
                            <select id="Filing_Year" class="form-select">
                                @foreach (var year in ViewBag.FilingYear as List<ACA360.Core.Models.FilingYearModel> ?? new List<ACA360.Core.Models.FilingYearModel>())
                                {
                                    <option value="@year.FilingYear" selected="@(year.FilingYear.ToString() == sessionFilingYear ? "selected" : null)">@year.FilingYear</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3 mb-md-0">
                        <label class="form-label" for="Employer_TaxId">Employer Tax ID</label>
                        <div class="input-group input-group-merge">
                            <span class="input-group-text"><i class="bx bx-id-card"></i></span>
                            <input type="text" id="Employer_TaxId" class="form-control ein-input" placeholder="XX-XXXXXXX" value="">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-check mt-4">
                            <input class="form-check-input" type="checkbox" id="chkRedactSSN" checked>
                            <label class="form-check-label" for="chkRedactSSN">Redact SSN</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <button type="button" class="btn btn-primary w-100" id="btn_filter">
                            <i class="bx bx-search me-1"></i> Load Data
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div id="report_container" style="display:none;">

            <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="pills-employer-tab" data-bs-toggle="pill" data-bs-target="#pills-employer" type="button" role="tab">
                        <i class='bx bxs-business me-1'></i> Employer (1094-C)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pills-employee-tab" data-bs-toggle="pill" data-bs-target="#pills-employee" type="button" role="tab">
                        <i class='bx bxs-user-detail me-1'></i> Employees (1095-C)
                    </button>
                </li>
            </ul>

            <div class="tab-content p-0 bg-transparent shadow-none">

                <div class="tab-pane fade show active" id="pills-employer" role="tabpanel">
                    <div class="card">
                        <div class="card-body" id="employer_content">

                            <div class="divider-text">Basic Information</div>
                            <div class="table-responsive text-nowrap">
                                <table class="table table-bordered table-sm" id="tbl_EmployerBasic">
                                    <thead class="aca-header-blue">
                                        <tr>
                                            <th>EIN</th>
                                            <th>Business Name</th>
                                            <th>Address</th>
                                            <th>ALE Member</th>
                                            <th>Contact</th>
                                            <th>Phone</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>

                            <div class="divider-text mt-4">Part III - Monthly Breakdown</div>
                            <div class="table-responsive text-nowrap">
                                <table class="table table-bordered table-sm table-compact text-center w-100" id="tbl_EmployerMonthly">
                                    <thead class="aca-header-blue">
                                        <tr>
                                            <th>Month</th>
                                            <th>(a) Min Cov</th>
                                            <th>(b) FT Count</th>
                                            <th>(c) Total Count</th>
                                            <th>(d) Agg Group</th>
                                            <th>(e) Relief</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>

                            <div id="div_GovEntity" style="display:none;">
                                <div class="divider-text mt-4">Governmental Entity</div>
                                <div class="table-responsive text-nowrap">
                                    <table class="table table-bordered table-sm" id="tbl_GovEntity">
                                        <thead class="aca-header-blue">
                                            <tr>
                                                <th>Gov EIN</th>
                                                <th>Name</th>
                                                <th>Address</th>
                                                <th>Contact</th>
                                                <th>Phone</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                        <div id="employer_no_data" class="card-body text-center p-5" style="display:none;">
                            <i class='bx bx-data display-4 text-muted mb-3'></i>
                            <h5 class="text-muted">No Employer Data Available</h5>
                            <p>The 1094-C record for this Tax ID could not be found.</p>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="pills-employee" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped table-compact w-100" id="tbl_ExportReport">
                                    <thead class="aca-header-blue">
                                        <tr>
                                            <th rowspan="2">SSN</th>
                                            <th rowspan="2">First Name</th>
                                            <th rowspan="2">Last Name</th>
                                            <th rowspan="2">Suffix</th>
                                            <th rowspan="2">Address</th>
                                            <th rowspan="2">City</th>
                                            <th rowspan="2">State</th>
                                            <th rowspan="2">Zip</th>
                                            <th rowspan="2">Plan Start</th>
                                            <th rowspan="2">Corrected</th>

                                            <th colspan="13">Line 14 - Offer of Coverage</th>
                                            <th colspan="13">Line 15 - Employee Share Amount</th>
                                            <th colspan="13">Line 16 - Section 4980H Safe Harbor</th>
                                            <th colspan="13">Covered Individuals (Self-Insured)</th>
                                        </tr>
                                        <tr>
                                            <th>All 12</th>
                                            <th>Jan</th>
                                            <th>Feb</th>
                                            <th>Mar</th>
                                            <th>Apr</th>
                                            <th>May</th>
                                            <th>Jun</th>
                                            <th>Jul</th>
                                            <th>Aug</th>
                                            <th>Sep</th>
                                            <th>Oct</th>
                                            <th>Nov</th>
                                            <th>Dec</th>
                                            <th>All 12</th>
                                            <th>Jan</th>
                                            <th>Feb</th>
                                            <th>Mar</th>
                                            <th>Apr</th>
                                            <th>May</th>
                                            <th>Jun</th>
                                            <th>Jul</th>
                                            <th>Aug</th>
                                            <th>Sep</th>
                                            <th>Oct</th>
                                            <th>Nov</th>
                                            <th>Dec</th>
                                            <th>All 12</th>
                                            <th>Jan</th>
                                            <th>Feb</th>
                                            <th>Mar</th>
                                            <th>Apr</th>
                                            <th>May</th>
                                            <th>Jun</th>
                                            <th>Jul</th>
                                            <th>Aug</th>
                                            <th>Sep</th>
                                            <th>Oct</th>
                                            <th>Nov</th>
                                            <th>Dec</th>
                                            <th>Annual</th>
                                            <th>Jan</th>
                                            <th>Feb</th>
                                            <th>Mar</th>
                                            <th>Apr</th>
                                            <th>May</th>
                                            <th>Jun</th>
                                            <th>Jul</th>
                                            <th>Aug</th>
                                            <th>Sep</th>
                                            <th>Oct</th>
                                            <th>Nov</th>
                                            <th>Dec</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script src="@(Url.Content("~/assets/vendor/libs/jquery/jquery.js"))"></script>

<script>
    $(document).ready(function () {

        var currentEmployerInfo = null;
          var redactSSN = true;
        function maskSSNDisplay(ssn) {
            if (!ssn) return "";
            var clean = String(ssn).replace(/\D/g, '');
            if (clean.length !== 9) return ssn;
            return "***-**-" + clean.substring(5, 9);
        }
        // --- Initialize Employee Table (Client Side for full Export) ---
        var table = $('#tbl_ExportReport').DataTable({
            // serverSide: false => Loads ALL data to browser. Allows exporting everything.
            serverSide: false,
            processing: true,
            scrollX: true,
            scrollY: 400,
            scrollCollapse: true,
            deferLoading: 0, // Wait for user trigger
            pageLength: 10,

            // Layout & Export Buttons
            dom: '<"card-header d-flex border-bottom justify-content-between py-3"<"head-label"><"dt-action-buttons text-end"B>><"d-flex justify-content-between align-items-center mx-0 row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>t<"d-flex justify-content-between mx-0 row"<"col-sm-12 col-md-6"i><"col-sm-12 col-md-6"p>>',



            buttons: [
                {
                    extend: 'collection',
                    className: 'btn btn-label-secondary dropdown-toggle me-2',
                    text: '<i class="bx bx-export me-1"></i>Export',
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            text: '<i class="bx bxs-file-export me-1"></i>Excel',
                            className: 'buttons-excel',
                            exportOptions: { columns: function (idx, data, node) { return true;} }, // Export HIDDEN columns too
                            messageTop: function() { return getEmployerHeader(); }
                        },
                        {
                            extend: 'csvHtml5',
                            text: '<i class="bx bxs-file-txt me-1"></i>CSV',
                            className: 'buttons-csv',
                           exportOptions: { columns: function (idx, data, node) { return true;} }
                        },
                        {
                            extend: 'copyHtml5',
                            text: '<i class="bx bxs-copy me-1"></i>Copy',
                            className: 'buttons-copy',
                            exportOptions: { columns: function (idx, data, node) { return true;} }
                        }
                    ]
                },
                {
                    extend: 'colvis',
                className: 'buttons-colvis',
                text: '<span class="colvis-counter">Columns</span>',
                collectionLayout: 'fixed four-column',
                postfixButtons: [{ extend: 'colvisRestore', text: 'Restore' }]
                }
            ],

            ajax: {
                url: '@Url.Action("ExportFileReport_GETDATA", "eFileReport")',
                type: 'POST',
                data: function (d) {
                    d.FilingYear = $("#Filing_Year").val();
                    d.EmployerTaxId = $("#Employer_TaxId").val();
                    // Force controller to return ALL records for client-side processing
                    d.length = -1;
                },
                dataSrc: function (json) {
                    $('#report_container').fadeIn();
                    // Handle Employer Data (Check both camelCase and PascalCase)
                    var empData = json.employerInfo || json.employerData;
                    currentEmployerInfo = empData;

                    if (empData) {
                        $('#employer_content').show();
                        $('#employer_no_data').hide();
                        RenderEmployerData(empData);
                    } else {
                        $('#employer_content').hide();
                        $('#employer_no_data').show();
                    }

                    return json.data;
                }
            },
             columns: [
                // Identity
               {
                    data: "employee_SSN",
                    defaultContent: "",
                    render: function (data, type, row) {

        // Use original value for sorting/filtering
        if (type === 'sort' || type === 'type' || type === 'filter') {
            return data || "";
        }

        // Only mask for display
        return redactSSN ? maskSSNDisplay(data) : (data || "");
    }
                },
                { data: "first_Name", defaultContent: "" },
                { data: "last_Name", defaultContent: "" },
                { data: "suffix", defaultContent: "" },
                {
                    data: null,
                    defaultContent: "",
                    render: function(data) {
                        var addr1 = data.employee_AddressLine1Txt || data.Employee_AddressLine1Txt || '';
                        var addr2 = data.employee_AddressLine2Txt || data.Employee_AddressLine2Txt || '';
                        return addr1 + ' ' + addr2;
                    }
                },
                { data: "employee_CityNm", defaultContent: "" },
                { data: "employee_USStateCd", defaultContent: "" },
                { data: "employee_USZIPCd", defaultContent: "" },
                { data: "planStartMonth", defaultContent: "" },
                { data: "correctedInd", defaultContent: "" },

                // Line 14
                { data: "annualOfferOfCoverageCd", defaultContent: "" },
                { data: "janOfferCd", defaultContent: "" }, { data: "febOfferCd", defaultContent: "" }, { data: "marOfferCd", defaultContent: "" }, { data: "aprOfferCd", defaultContent: "" },
                { data: "mayOfferCd", defaultContent: "" }, { data: "junOfferCd", defaultContent: "" }, { data: "julOfferCd", defaultContent: "" }, { data: "augOfferCd", defaultContent: "" },
                { data: "sepOfferCd", defaultContent: "" }, { data: "octOfferCd", defaultContent: "" }, { data: "novOfferCd", defaultContent: "" }, { data: "decOfferCd", defaultContent: "" },

                // Line 15
                { data: "annualShrLowestCostMthlyPremAmt", defaultContent: "" },
                { data: "januaryAmt", defaultContent: "" }, { data: "februaryAmt", defaultContent: "" }, { data: "marchAmt", defaultContent: "" }, { data: "aprilAmt", defaultContent: "" },
                { data: "mayAmt", defaultContent: "" }, { data: "juneAmt", defaultContent: "" }, { data: "julyAmt", defaultContent: "" }, { data: "augustAmt", defaultContent: "" },
                { data: "septemberAmt", defaultContent: "" }, { data: "octoberAmt", defaultContent: "" }, { data: "novemberAmt", defaultContent: "" }, { data: "decemberAmt", defaultContent: "" },

                // Line 16
                { data: "annualSafeHarborCd", defaultContent: "" },
                { data: "janSafeHarborCd", defaultContent: "" }, { data: "febSafeHarborCd", defaultContent: "" }, { data: "marSafeHarborCd", defaultContent: "" }, { data: "aprSafeHarborCd", defaultContent: "" },
                { data: "maySafeHarborCd", defaultContent: "" }, { data: "juneSafeHarborCd", defaultContent: "" }, { data: "julSafeHarborCd", defaultContent: "" }, { data: "augSafeHarborCd", defaultContent: "" },
                { data: "sepSafeHarborCd", defaultContent: "" }, { data: "octSafeHarborCd", defaultContent: "" }, { data: "novSafeHarborCd", defaultContent: "" }, { data: "decSafeHarborCd", defaultContent: "" },

                // Covered Individuals
                { data: "dependent_CoveredIndividualAnnualInd", defaultContent: "" },
                { data: "dependent_JanuaryInd", defaultContent: "" }, { data: "dependent_FebruaryInd", defaultContent: "" }, { data: "dependent_MarchInd", defaultContent: "" }, { data: "dependent_AprilInd", defaultContent: "" },
                { data: "dependent_MayInd", defaultContent: "" }, { data: "dependent_JuneInd", defaultContent: "" }, { data: "dependent_JulyInd", defaultContent: "" }, { data: "dependent_AugustInd", defaultContent: "" },
                { data: "dependent_SeptemberInd", defaultContent: "" }, { data: "dependent_OctoberInd", defaultContent: "" }, { data: "dependent_NovemberInd", defaultContent: "" }, { data: "dependent_DecemberInd", defaultContent: "" }
            ]
        });

        $('#btn_filter').click(function () {
            if ($("#Employer_TaxId").val() == "") {
                alert("Please enter a Tax ID");
                return;
            }
            // Trigger ajax reload. Since serverSide is false, this loads ALL data for export.
            table.ajax.reload();
        });
        $('#chkRedactSSN').on('change', function () {
            redactSSN = $(this).is(':checked');
            table.rows().invalidate('data').draw(false);
        });
        function getEmployerHeader() {
            if(currentEmployerInfo) {
                var name = getVal(currentEmployerInfo, 'businessNameLine1Txt', 'BusinessNameLine1Txt');
                var ein = getVal(currentEmployerInfo, 'employerEIN', 'EmployerEIN');
                return 'Employer: ' + name + ' (EIN: ' + ein + ')';
            }
            return '';
        }

        function getVal(obj, key1, key2) {
            return obj[key1] || obj[key2] || "";
        }

        function RenderEmployerData(emp) {
            var ein = getVal(emp, 'employerEIN', 'EmployerEIN');
            var name1 = getVal(emp, 'businessNameLine1Txt', 'BusinessNameLine1Txt');
            var name2 = getVal(emp, 'businessNameLine2Txt', 'BusinessNameLine2Txt');
            var addr1 = getVal(emp, 'addressLine1Txt', 'AddressLine1Txt');
            var city = getVal(emp, 'cityNm', 'CityNm');
            var state = getVal(emp, 'usStateCd', 'USStateCd');
            var zip = getVal(emp, 'uszipCd', 'USZIPCd');
            var addressFull = `${addr1} ${city} ${state} ${zip}`;
            var fn = getVal(emp, 'personFirstNm', 'PersonFirstNm');
            var ln = getVal(emp, 'personLastNm', 'PersonLastNm');
            var fullName = `${fn} ${ln}`;
            var phone = getVal(emp, 'contactPhoneNum', 'ContactPhoneNum');
            var dge = getVal(emp, 'aggregatedGroupMemberInd', 'AggregatedGroupMemberInd');

            // Basic Info
            var basicHtml = `<tr>
                <td class="fw-bold">${ein}</td>
                <td>${name1} <br><small class="text-muted">${name2}</small></td>
                <td>${addressFull.trim() === '' ? '-' : addressFull}</td>
                <td>${dge === '1' ? '<span class="badge bg-label-success">Yes</span>' : '<span class="badge bg-label-secondary">No</span>'}</td>
                <td>${fullName.trim() === '' ? '-' : fullName}</td>
                <td>${phone}</td>
            </tr>`;
            $('#tbl_EmployerBasic tbody').html(basicHtml);

            // Monthly
            var months = ["All 12 Months", "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            var prefixes = ["yearly", "jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"];
            var PascalPrefixes = ["Yearly", "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            var monthlyHtml = "";

            for (var i = 0; i < months.length; i++) {
                var p = prefixes[i];
                var P = PascalPrefixes[i];

                var minCov = emp[p + "_MinEssentialCvrOffrInd"] || emp[P + "_MinEssentialCvrOffrInd"] || '-';
                var fte = emp[p + "_ALEMemberFTECnt"] || emp[P + "_ALEMemberFTECnt"] || '';
                var total = emp[p + "_TotalEmployeeCnt"] || emp[P + "_TotalEmployeeCnt"] || '';
                var agg = emp[p + "_AggregatedGroupInd"] || emp[P + "_AggregatedGroupInd"] || '';
                var relief = emp[p + "_ALESect4980HTrnstReliefCd"] || emp[P + "_ALESect4980HTrnstReliefCd"] || '';

                monthlyHtml += `<tr>
                    <td class="fw-bold text-primary">${months[i]}</td>
                    <td>${minCov}</td>
                    <td>${fte}</td>
                    <td>${total}</td>
                    <td>${agg}</td>
                    <td>${relief}</td>
                </tr>`;
            }
            $('#tbl_EmployerMonthly tbody').html(monthlyHtml);

            // Initialize Table for Monthly Grid (To enable Copy/Export on it too)
            if ($.fn.DataTable.isDataTable('#tbl_EmployerMonthly')) {
                $('#tbl_EmployerMonthly').DataTable().destroy();
            }
            $('#tbl_EmployerMonthly').DataTable({
                paging: false, searching: false, info: false, ordering: false,
                dom: 'Bt',
                buttons: [ { extend: 'copyHtml5', text: 'Copy Table', className: 'btn btn-xs btn-label-secondary' } ]
            });

            // Gov Entity
            var govEin = getVal(emp, 'govEntity_EmployerEIN', 'GovEntity_EmployerEIN');
            if(govEin) {
                 var govName = getVal(emp, 'govEntity_BusinessNameLine1Txt', 'GovEntity_BusinessNameLine1Txt');
                 var govAddr = getVal(emp, 'govEntity_AddressLine1Txt', 'GovEntity_AddressLine1Txt');
                 var govCity = getVal(emp, 'govEntity_CityNm', 'GovEntity_CityNm');
                 var govContact = getVal(emp, 'govEntity_PersonFirstNm', 'GovEntity_PersonFirstNm');
                 var govPhone = getVal(emp, 'govEntity_ContactPhoneNum', 'GovEntity_ContactPhoneNum');

                 var govHtml = `<tr>
                    <td>${govEin}</td>
                    <td>${govName}</td>
                    <td>${govAddr} ${govCity}</td>
                    <td>${govContact}</td>
                    <td>${govPhone}</td>
                </tr>`;
                $('#tbl_GovEntity tbody').html(govHtml);
                $('#div_GovEntity').show();
            } else {
                $('#div_GovEntity').hide();
            }
        }
    });
</script>