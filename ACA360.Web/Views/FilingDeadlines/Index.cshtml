@model List<ACA360.Core.Models.FilingDeadline>
@{
    ViewData["Title"] = "Filing Deadlines";
    var today = DateTime.Today;
    var years = Model.Select(d => d.FilingYear).Distinct().OrderByDescending(y => y).ToList();
    var toCheck = Model.Count(d => d.NeedsCheck);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-1">Filing Deadlines</h4>
        <small class="text-body opacity-75">The dates the dashboards count down to and the Calendar shows, by tax year.</small>
    </div>
    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#deadlineModal" data-deadline="">
        <i class="bx bx-plus me-1"></i>Add a deadline
    </button>
</div>

@if (TempData["Success"] is string ok) { <div class="alert alert-success" role="status">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger" role="alert">@err</div> }
@if (toCheck > 0)
{
    <div class="alert alert-warning" role="status">
        <i class="bx bx-error me-1"></i>@toCheck date@(toCheck == 1 ? " was" : "s were") filled in for you and @(toCheck == 1 ? "is" : "are") marked
        <span class="badge bg-label-warning">Check</span>. Confirm each one against the state's current rules, then save it.
    </div>
}

@foreach (var year in years)
{
    <div class="card mb-4">
        <div class="card-header"><h6 class="mb-0">Tax year @year <small class="text-body opacity-75">(filed in @(year + 1))</small></h6></div>
        <div class="table-responsive position-relative">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Due</th><th>Where</th><th>What</th><th>Notes</th><th class="text-end"><span class="visually-hidden">Actions</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Where(d => d.FilingYear == year).OrderBy(d => d.DueDate))
                    {
                        var left = d.DaysLeft(today);
                        <tr class="@(left < 0 ? "opacity-50" : "")">
                            <td class="text-nowrap">
                                <strong>@d.DueDate.ToString("ddd, MMM d, yyyy")</strong>
                                <div class="small">@(left < 0 ? "passed" : left == 0 ? "today" : $"in {left} day{(left == 1 ? "" : "s")}")</div>
                            </td>
                            <td><span class="badge @(d.Jurisdiction == "IRS" ? "bg-label-primary" : "bg-label-info")">@d.Jurisdiction</span></td>
                            <td>
                                @d.Title <span class="small text-body opacity-75">(@d.Kind)</span>
                                @if (d.NeedsCheck) { <span class="badge bg-label-warning ms-1">Check</span> }
                            </td>
                            <td class="small">@d.Notes</td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#deadlineModal"
                                        data-deadline='@System.Text.Json.JsonSerializer.Serialize(new { d.FilingDeadlineId, d.FilingYear, d.Jurisdiction, d.Kind, d.Title, DueDate = d.DueDate.ToString("yyyy-MM-dd"), d.Notes })'>
                                    @(d.NeedsCheck ? "Check" : "Edit")
                                </button>
                                <form method="post" asp-action="Delete" class="d-inline" onsubmit="return confirm('Remove this deadline?');">
                                    <input type="hidden" name="id" value="@d.FilingDeadlineId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Remove @d.Title"><i class="bx bx-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
@if (!years.Any())
{
    <div class="card"><div class="card-body text-center py-5">No deadlines yet. Add the first one.</div></div>
}

<div class="modal fade" id="deadlineModal" tabindex="-1" aria-labelledby="deadlineModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" method="post" asp-action="Save">
            <div class="modal-header">
                <h5 class="modal-title" id="deadlineModalTitle">Deadline</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="FilingDeadlineId" id="dlId" value="0" />
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label" for="dlYear">Tax year</label>
                        <input class="form-control" type="number" name="FilingYear" id="dlYear" min="2015" max="2100" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="dlDue">Due date</label>
                        <input class="form-control" type="date" name="DueDate" id="dlDue" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="dlWhere">Where</label>
                        <input class="form-control" name="Jurisdiction" id="dlWhere" maxlength="10" placeholder="IRS, CA, NJ…" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="dlKind">Kind</label>
                        <select class="form-select" name="Kind" id="dlKind">
                            @foreach (var k in ACA360.Core.Models.FilingDeadline.Kinds) { <option>@k</option> }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="dlTitle">What is due</label>
                        <input class="form-control" name="Title" id="dlTitle" maxlength="200" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="dlNotes">Notes</label>
                        <input class="form-control" name="Notes" id="dlNotes" maxlength="500" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('deadlineModal').addEventListener('show.bs.modal', function (e) {
            const raw = e.relatedTarget && e.relatedTarget.getAttribute('data-deadline');
            const d = raw ? JSON.parse(raw) : { FilingDeadlineId: 0, FilingYear: @(DateTime.Today.Month >= 4 ? DateTime.Today.Year : DateTime.Today.Year - 1), Jurisdiction: 'IRS', Kind: 'Furnish', Title: '', DueDate: '', Notes: '' };
            document.getElementById('deadlineModalTitle').textContent = d.FilingDeadlineId ? 'Edit deadline' : 'Add a deadline';
            document.getElementById('dlId').value = d.FilingDeadlineId;
            document.getElementById('dlYear').value = d.FilingYear;
            document.getElementById('dlDue').value = d.DueDate;
            document.getElementById('dlWhere').value = d.Jurisdiction;
            document.getElementById('dlKind').value = d.Kind;
            document.getElementById('dlTitle').value = d.Title;
            document.getElementById('dlNotes').value = d.Notes || '';
        });
    </script>
}
