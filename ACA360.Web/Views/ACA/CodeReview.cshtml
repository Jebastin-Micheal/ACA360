@{
    ViewData["Title"] = "Smart Code Review";
}

<style>
    .code-cell {
        min-width: 80px;
        text-align: center;
        padding: 8px !important;
        border-right: 1px solid #eee;
        transition: all 0.2s;
        font-size: 0.75rem;
        position: relative;
    }

        .code-cell:hover {
            transform: scale(1.05);
            z-index: 10;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            border-radius: 6px;
        }

    /* The 3-Line Stack Design */
    .code-stack {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .line-14 {
        font-weight: 800;
        font-size: 0.85rem;
    }

    .line-15 {
        color: #888;
        font-size: 0.7rem;
    }

    .line-16 {
        font-weight: 600;
        font-size: 0.75rem;
        color: #555;
    }

    /* Status Colors */
    .status-safe {
        background-color: #e8fadf !important;
        border-left: 3px solid #71dd37;
    }

    .status-risk {
        background-color: #fff2f2 !important;
        border-left: 3px solid #ff3e1d;
    }

    .status-neutral {
        background-color: #f5f5f9 !important;
        border-left: 3px solid #8592a3;
    }

    .emp-info-cell {
        min-width: 200px;
        font-weight: 500;
        border-right: 2px solid #d9dee3 !important;
    }

    .ssn-sub {
        font-size: 0.75rem;
        color: #a1acb8;
        display: block;
    }

    /* Hide the default ugly buttons and style our custom ones */
    .dt-buttons {
        display: none;
    }

    .audit-item {
        border-left: 3px solid #d9dee3;
        padding-left: 12px;
        margin-bottom: 14px;
    }

    .audit-system {
        border-color: #8592a3;
    }

    .audit-manual {
        border-color: #696cff;
    }

    .audit-autofix {
        border-color: #71dd37;
    }

    .audit-meta {
        font-size: 0.75rem;
        color: #8592a3;
    }

</style>
<div class="row mb-4 g-3">
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 border-start border-4 border-primary">
            <div class="card-body px-4 py-3">
                <small class="text-muted text-uppercase fw-bold">Total Employees</small>
                <h3 class="mb-0 mt-1" id="statTotal">0</h3>
                <small class="text-success fw-semibold">
                    <i class="bx bx-up-arrow-alt"></i> Active
                </small>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card h-100 border-start border-4 border-success">
            <div class="card-body px-4 py-3">
                <small class="text-muted text-uppercase fw-bold">Compliance Score</small>
                <h3 class="mb-0 mt-1 text-success" id="statScore">0%</h3>
                <div class="progress mt-2" style="height: 6px;">
                    <div class="progress-bar bg-success" id="statProgress" role="progressbar" style="width: 0%"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card h-100 border-start border-4 border-danger">
            <div class="card-body px-4 py-3">
                <div class="d-flex justify-content-between">
                    <div>
                        <small class="text-muted text-uppercase fw-bold">At Risk Cases</small>
                        <h3 class="mb-0 mt-1 text-danger" id="statRisk">0</h3>
                    </div>
                    <div class="avatar avatar-sm bg-label-danger rounded p-1">
                        <i class="bx bx-error fs-4"></i>
                    </div>
                </div>
                <small class="text-muted">Potential penalty exposure</small>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card h-100 bg-label-secondary">
            <div class="card-body px-4 py-3 d-flex flex-column justify-content-center gap-2">
                <button class="btn btn-sm btn-white shadow-sm text-danger fw-bold text-start" onclick="filterGrid('risk')">
                    <i class='bx bx-filter-alt me-2'></i> Show Risks Only
                </button>
                <button class="btn btn-sm btn-white shadow-sm text-primary fw-bold text-start" onclick="filterGrid('locked')">
                    <i class='bx bx-lock-alt me-2'></i> Show Locked (Manual)
                </button>
                <button class="btn btn-sm btn-outline-secondary text-start" onclick="filterGrid('all')">
                    <i class='bx bx-reset me-2'></i> Reset Filters
                </button>
            </div>
        </div>
    </div>
</div>
<div class="card mb-3">
    <div class="alert alert-info d-flex align-items-center mb-3">
        <i class="bx bx-info-circle fs-4 me-2"></i>
        <div>
            <strong>How to use this page:</strong>
            <ul class="mb-0 ps-3">
                <li>
                    <strong>Click anywhere on a row</strong> to manually edit and lock employee codes.
                </li>
                <li>
                    <strong>Click the <i class="bx bx-info-circle text-danger"></i> icon</strong>
                    to view penalty risk details and apply auto-fix.
                </li>
            </ul>
        </div>
    </div>

    <div class="card-header border-bottom py-3 d-flex justify-content-between align-items-center position-sticky top-0 z-index-1">
        <div class="d-flex align-items-center gap-3">
            <div>
                <h4 class="mb-1 text-primary fw-bold">@ViewBag.EmployerName</h4>
                <span class="badge bg-label-secondary">Tax Year @ViewBag.Year</span>
            </div>
        </div>

        <div class="d-flex gap-2">
            <input type="text" id="customSearch" class="form-control form-control-sm" placeholder="Search Employee..." style="width: 200px;">

            <div class="btn-group" role="group">
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="triggerExport('copy')">
                    <i class='bx bx-copy'></i> Copy
                </button>
                <button type="button" class="btn btn-sm btn-outline-success" onclick="triggerExport('excel')">
                    <i class='bx bx-spreadsheet'></i> Excel
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="triggerExport('pdf')">
                    <i class='bx bxs-file-pdf'></i> PDF
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="triggerExport('print')">
                    <i class='bx bx-printer'></i> Print
                </button>
            </div>

            <a href="javascript:void(0)" class="btn btn-sm btn-primary ms-2" onclick="history.back();">
                Back to Dashboard
            </a>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive text-nowrap" style="height: 75vh;">
            <table id="smartCodeTable" class="table table-hover mb-0 w-100">
                <thead class="bg-light sticky-top" style="top: 0; z-index: 2;">
                    <tr>
                        <th class="ps-4" style="min-width: 200px;">Employee</th>
                        <th>ALL</th>
                        @foreach (var m in new[] { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" })
                        {
                            <th class="text-center text-uppercase small text-muted" style="min-width: 80px;">@m</th>
                        }
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

</div>
<div class="modal fade" id="editCodeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Manual Override: <span id="modalEmpName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="alert alert-warning">
                                <i class='bx bx-lock-alt'></i> Saving changes here will <strong>LOCK</strong> this record.
                                Future automatic calculations will <strong>ignore</strong> this employee to preserve your edits.
                            </div>
                            <form id="editCodeForm" class="perfectscroller">
                                <input type="hidden" id="editEmpId" name="EmployeeId" />
                                <input type="hidden" name="FilingYear" value="@ViewBag.Year" />

                                <div class="table-responsive">
                                    <table class="table table-bordered text-center">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Line</th>
                                                <th>Jan</th>
                                                <th>Feb</th>
                                                <th>Mar</th>
                                                <th>Apr</th>
                                                <th>May</th>
                                                <th>Jun</th>
                                                <th>Jul</th>
                                                <th>Aug</th>
                                                <th>Sep</th>
                                                <th>Oct</th>
                                                <th>Nov</th>
                                                <th>Dec</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td class="fw-bold">14</td>
                                                @foreach (var m in new[] { "JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC" })
                                                {
                                                    <td class="p-2">
                                                        <select class="form-select form-select-sm text-center select2-aca" name="@(m)_COC" style="width: 100%;">
                                                            <option value=""></option>
                                                            @foreach (var code in ViewBag.Line14Codes)
                                                            {
                                                                <option value="@code">@code</option>
                                                            }
                                                        </select>
                                                    </td>
                                                }
                                            </tr>
                                            <tr>
                                                <td class="fw-bold">15</td>
                                                @foreach (var m in new[] { "JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC" })
                                                {
                                                    <td class="p-2 align-middle" style="min-width: 100px;">
                                                        <div class="input-group input-group-sm flex-nowrap">
                                                            <span class="input-group-text bg-light px-2 text-muted">$</span>
                                                            <input type="number" step="0.01" class="form-control text-center px-1" name="@(m)_LCMP" min="0" onkeydown="return event.key !== '-' && event.key !== '+' && event.key !== 'e';">
                                                        </div>
                                                    </td>

                                                }

                                            </tr>
                                            <tr>
                                                <td class="fw-bold">16</td>
                                                @foreach (var m in new[] { "JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC" })
                                                {
                                                    <td class="p-2">
                                                        <select class="form-select form-select-sm text-center select2-aca" name="@(m)_SHC" style="width: 100%;">
                                                            <option value=""></option>
                                                            @foreach (var code in ViewBag.Line16Codes)
                                                            {
                                                                <option value="@code">@code</option>
                                                            }
                                                        </select>

                                                    </td>
                                                }
                                            </tr>
                                            <tr>
                                                <td class="fw-bold">Action</td>
                                                @foreach (var m in new[] { "JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC" })
                                                {
                                                    <th class="text-center align-middle" style="min-width: 95px;">
                                                        <div class="d-flex justify-content-center gap-12">
                                                            <i class='bx bx-chevrons-left cursor-pointer text-primary fs-5'
                                                               onclick="propagateMonth('@m', 'left')"
                                                               data-bs-toggle="tooltip" title="Apply all 3 lines to prior months"></i>

                                                            <i class='bx bx-chevrons-right cursor-pointer text-primary fs-5'
                                                               onclick="propagateMonth('@m', 'right')"
                                                               data-bs-toggle="tooltip" title="Apply all 3 lines to future months"></i>
                                                        </div>
                                                    </th>
                                                }
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-3">
                <div class="form-check me-auto mx-4">
                    <input type="checkbox" class="form-check-input" id="chk_auto_code" checked />
                    <label class="form-check-label">Disable Automatic Coding</label>
                </div>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveManualCodes()">Update Codes</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="riskDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bx bx-error-circle me-2"></i>
                    ⚠ Penalty Risk Detail
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="mb-3 text-heading">
                                <strong>Employee:</strong>
                                <span id="riskEmpName"></span>
                                <input type="hidden" id="riskEmpId" name="EmployeeId" />
                            </div>

                            <div class="alert alert-danger">
                                <strong>IRS Rule Impacted:</strong>
                                <div id="riskReason"></div>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="card border-danger h-100">
                                        <div class="card-body">
                                            <small class="text-muted">Estimated Annual Penalty :</small>
                                            <h4 class="text-danger mt-1" id="riskPenalty">$0</h4>
                                            <small class="text-muted">IRC §4980H(b)</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card border-success h-100">
                                        <div class="card-body">
                                            <small class="text-muted">Recommended Fix</small>
                                            <div class="fw-semibold mt-1" id="riskFix"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <hr />

                            <div>
                                <span class="text-heading">IRS 226J Defense Language:</span>
                                <div class="bg-light p-3 rounded mt-2 small text-heading" id="riskDefense"></div>
                            </div>
                            <hr />

                            <div>
                                <span class="text-heading">Risk Months:</span>
                                <div class="d-flex flex-wrap gap-1 mt-1" id="riskMonthList">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
           
            <div class="modal-footer py-3">
                <div class="form-check me-auto mx-4">
                    <input type="checkbox" class="form-check-input" id="chk_auto_code" checked />
                    <label class="form-check-label">Disable Automatic Coding</label>
                </div>
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Close
                </button>

                @*  <button class="btn btn-warning" onclick="openManualEditFromRisk()">
                    ✏ Manual Override
                </button> *@

                <button class="btn btn-success" id="fixNowBtn">
                    ⚡ Auto-Fix (Safe Harbor)
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="auditTimelineModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">

                    Audit History
                </h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="col-12">
                    <div class="card">
                       <div class="card-body" id="auditTimelineBody">
                         <!-- Timeline injected here -->
                       </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    <script>
        var dataTable;
        // Global storage for raw data to fix filtering issues
        var rawGridData = [];
        const MONTH_KEYS = [
            { label: "Jan", key: "jaN" },
            { label: "Feb", key: "feB" },
            { label: "Mar", key: "maR" },
            { label: "Apr", key: "apR" },
            { label: "May", key: "maY" },
            { label: "Jun", key: "juN" },
            { label: "Jul", key: "juL" },
            { label: "Aug", key: "auG" },
            { label: "Sep", key: "seP" },
            { label: "Oct", key: "ocT" },
            { label: "Nov", key: "noV" },
            { label: "Dec", key: "deC" }
        ];

        $(document).ready(function() {
            dataTable = $('#smartCodeTable').DataTable({
            ajax: {
            url: '@Url.Action("GetCodeReviewData", "ACA")',
            data: { employerId: @ViewBag.EmployerId, year: @ViewBag.Year },
            dataSrc: function(json) {

                const normalize = (val) => (val === null || val === undefined) ? '' : String(val).trim();

                json.data.forEach(row => {
                    let isSame = true;

                    const firstCOC = normalize(row[`${MONTH_KEYS[0].key}_COC`]);
                    const firstLCMP = normalize(row[`${MONTH_KEYS[0].key}_LCMP`]);
                    const firstSHC = normalize(row[`${MONTH_KEYS[0].key}_SHC`]);

                    for(let i = 1; i < MONTH_KEYS.length; i++) {
                        const currentCOC = normalize(row[`${MONTH_KEYS[i].key}_COC`]);
                        const currentLCMP = normalize(row[`${MONTH_KEYS[i].key}_LCMP`]);
                        const currentSHC = normalize(row[`${MONTH_KEYS[i].key}_SHC`]);

                        if (currentCOC !== firstCOC || currentLCMP !== firstLCMP || currentSHC !== firstSHC) {
                            isSame = false;
                            break;
                        }
                    }

                    // ----------------------------------------------------
                    // 🚨 NEW LOGIC: EXCEPTION HANDLING FOR THE "ALL" COLUMN
                    // ----------------------------------------------------

                    // 1. If it is 1H and Line 15/16 are empty, DO NOT show 'ALL' (force show 12 months)
                    if (isSame && firstCOC === '1H' && firstLCMP === '' && firstSHC === '') {
                        isSame = false;
                    }
                    // 2. If the entire row is completely blank, DO NOT show 'ALL'
                    else if (isSame && firstCOC === '' && firstLCMP === '' && firstSHC === '') {
                        isSame = false;
                    }

                    // Assign the final decision to the row
                    row.isAllSame = isSame;

                    // Populate the ALL column data only if it passed the rules above
                    if (isSame) {
                        row.all_COC = firstCOC;
                        row.all_LCMP = firstLCMP;
                        row.all_SHC = firstSHC;
                    }
                });

                rawGridData = json.data;
                calculateStats(rawGridData);

                return json.data;
            }
        },
                dom: 'Brt<"row p-3"<"col-sm-6"i><"col-sm-6"p>>',
                pageLength: 20,
                ordering: false,

                // Initialize Tooltips
                        drawCallback: function () {
            document
                .querySelectorAll('[data-bs-toggle="tooltip"]')
                .forEach(el => {
                    if (!bootstrap.Tooltip.getInstance(el)) {
                        new bootstrap.Tooltip(el);
                    }
                });
        },

                buttons: [
                    { extend: 'copy', className: 'd-none' },
                    {
                        extend: 'excel',
                        className: 'd-none',
                        title: 'ACA_1095C_Codes_@ViewBag.EmployerName',
                        exportOptions: {
                            format: {
                                body: function (data, row, column, node) {
                                    if (column === 0) return $(node).text().replace('---', '').trim();
                                    if (column > 0) return $(node).find('.code-stack').text().replace(/\s+/g, ' ').trim();
                                    return data;
                                }
                            }
                        }
                    },
                    { extend: 'pdf', className: 'd-none', orientation: 'landscape', pageSize: 'LEGAL' },
                    { extend: 'print', className: 'd-none', autoPrint: true }
                ],
                                columns: [
            {
                data: null,
                className: "emp-info-cell ps-4 align-middle",
                render: function(d) {
                    return `
                        <div class="d-flex flex-column">
                            <span class="text-heading fw-semibold">
                                ${d.firstName} ${d.lastName}
                                ${d.isLocked ? "<i class='bx bxs-lock-alt text-warning ms-1'></i>" : ""}
                            </span>
                            <span class="ssn-sub">${d.ssn || '---'}</span>
                            <button
                                class="btn btn-link btn-sm p-0 text-primary fw-semibold align-self-start"
                                onclick="event.stopPropagation(); showAuditTimeline('${d.employeeId}')">
                                <i class="bx bx-history me-1"></i> View Audit
                            </button>
                            ${renderPenaltySummary(d)}
                        </div>`;
                }
            },
            // ALL column: Show if isAllSame is TRUE, otherwise show empty
            {
                data: null,
                render: (d) => d.isAllSame ? renderMonthCell(d.all_COC, d.all_LCMP, d.all_SHC, d) : renderEmpty()
            },
            // Month columns: Show if isAllSame is FALSE, otherwise show empty
            { data: null, render: (d) => d.isAllSame ? renderEmpty() : renderMonthCell(d.jaN_COC, d.jaN_LCMP, d.jaN_SHC, d) },
            { data: null, render: (d) => d.isAllSame ? renderEmpty() : renderMonthCell(d.feB_COC, d.feB_LCMP, d.feB_SHC, d) },
            { data: null, render: (d) => d.isAllSame ? renderEmpty() : renderMonthCell(d.maR_COC, d.maR_LCMP, d.maR_SHC, d) },
            { data: null, render: (d) => d.isAllSame ? renderEmpty() : renderMonthCell(d.apR_COC, d.apR_LCMP, d.apR_SHC, d) },
            { data: null, render: (d) => d.isAllSame ? renderEmpty() : renderMonthCell(d.maY_COC, d.maY_LCMP, d.maY_SHC, d) },
            { data: null, render: (d) => d.isAllSame ? renderEmpty() : renderMonthCell(d.juN_COC, d.juN_LCMP, d.juN_SHC, d) },
            { data: null, render: (d) => d.isAllSame ? renderEmpty() : renderMonthCell(d.juL_COC, d.juL_LCMP, d.juL_SHC, d) },
            { data: null, render: (d) => d.isAllSame ? renderEmpty() : renderMonthCell(d.auG_COC, d.auG_LCMP, d.auG_SHC, d) },
            { data: null, render: (d) => d.isAllSame ? renderEmpty() : renderMonthCell(d.seP_COC, d.seP_LCMP, d.seP_SHC, d) },
            { data: null, render: (d) => d.isAllSame ? renderEmpty() : renderMonthCell(d.ocT_COC, d.ocT_LCMP, d.ocT_SHC, d) },
            { data: null, render: (d) => d.isAllSame ? renderEmpty() : renderMonthCell(d.noV_COC, d.noV_LCMP, d.noV_SHC, d) },
            { data: null, render: (d) => d.isAllSame ? renderEmpty() : renderMonthCell(d.deC_COC, d.deC_LCMP, d.deC_SHC, d) }
        ]
            });

            // Search Logic
            $('#customSearch').on('keyup', function() {
                dataTable.search(this.value).draw();
            });

            // Click Handler for Edit
