                // --- MASTER PROPAGATION FUNCTION ---
        function propagateMonth(startMonth, direction) {
            var months = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
            var startIndex = months.indexOf(startMonth);

            if (startIndex === -1) return;

            // 1. Get the source values from the exact month the user clicked
            var sourceCoc = $(`[name="${startMonth}_COC"]`).val();
            var sourceLcmp = $(`[name="${startMonth}_LCMP"]`).val();
            var sourceShc = $(`[name="${startMonth}_SHC"]`).val();

            // 2. Clear the 'ALL' column fields since the months will now have fragmented values
            $('#modal_ALL_COC').val('').trigger('change.select2');
            $('#modal_ALL_LCMP').val('');
            $('#modal_ALL_SHC').val('').trigger('change.select2');

            // 3. Helper function to apply the source values to a target month
            function applyToMonth(m) {
                $(`[name="${m}_COC"]`).val(sourceCoc).trigger('change.select2');
                $(`[name="${m}_LCMP"]`).val(sourceLcmp);
                $(`[name="${m}_SHC"]`).val(sourceShc).trigger('change.select2');
            }

            // 4. Loop and apply based on direction
            if (direction === 'left') {
                // Apply to everything BEFORE and INCLUDING the current month
                for (var i = 0; i <= startIndex; i++) {
                    applyToMonth(months[i]);
                }
            } else if (direction === 'right') {
                // Apply to everything AFTER and INCLUDING the current month
                for (var i = startIndex; i < months.length; i++) {
                    applyToMonth(months[i]);
                }
            }
        }
