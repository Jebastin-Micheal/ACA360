            // 🔥 NEW: Month breakdown
            $('#riskMonthList').html(
                riskMonths.length
                    ? riskMonths.map(m => `<span class="badge bg-danger">${m}</span>`).join('')
                    : '<span class="badge bg-success">No risk months detected</span>'
            );
            // <div class="d-flex flex-wrap gap-1 mt-1">
            //             ${penaltyMonths.map(m =>
            //                 `<span class="badge bg-danger">${m}</span>`
            //             ).join('')}
            //         </div>
            $('#riskDetailModal').modal('show');
        }
        function getPenaltyMonths(row) {
            const months = [];

            MONTH_KEYS.forEach(m => {
                const c14 = row[m.key + "_COC"];
                const c16 = row[m.key + "_SHC"];

                // IRS Rule: 1H + NO Line 16 protection
                if (c14 === '1H' && (!c16 || c16 === '')) {
                    months.push(m.label);
                }
            });

            return months;
        }

        function renderPenaltySummary(row) {
            const penaltyMonths = getPenaltyMonths(row);

            if (penaltyMonths.length === 0) {
                return `<span class="badge bg-label-success">No penalty months</span>`;
            }

            const amount = penaltyMonths.length * 360; // 4980H(b) est.

            return `
                <div class="mt-1">
                    <span class="badge bg-label-danger mb-1">
                        ⚠ ${penaltyMonths.length} Penalty Month(s)
                    </span>
