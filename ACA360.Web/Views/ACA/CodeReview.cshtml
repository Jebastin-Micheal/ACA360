        // ------------------------------------------
        // CORE LOGIC FUNCTIONS
        // ------------------------------------------

        function getReasonText(c14, c16) {

            // Normalize
            c14 = c14 || '';
            c16 = c16 || '';

            /* ----------------------------
               LINE 14 = NO OFFER (1H)
            -----------------------------*/
            if (c14 === '1H') {
                if (c16 === '2A')
                    return "Employee not employed during the month";

                if (c16 === '2B')
                    return "Part-time employee (not full-time for ACA)";

                if (c16 === '2D')
                    return "Waiting period / initial measurement period";

                return "Full-time employee with no offer of coverage (Penalty Risk)";
            }

            /* ----------------------------
               QUALIFYING OFFER
            -----------------------------*/
            if (c14 === '1A') {
                return "Qualifying offer: Affordable minimum value coverage to employee, spouse & dependents";
            }

            /* ----------------------------
               FULL FAMILY OFFER
            -----------------------------*/
            if (c14 === '1E') {
                if (c16 === '2C')
                    return "Employee enrolled in employer-sponsored coverage";

                if (c16)
                    return "Coverage offered to employee, spouse & dependents (Safe Harbor applied)";

                return "Coverage offered to employee, spouse & dependents";
            }

            /* ----------------------------
               PARTIAL OFFERS
            -----------------------------*/
            if (c14 === '1D')
                return "Coverage offered to employee and spouse (no dependents)";

            if (c14 === '1C')
                return "Coverage offered to employee and dependents (no spouse)";

            if (c14 === '1B')
                return "Coverage offered to employee only";

            /* ----------------------------
               SAFE HARBOR EXPLANATIONS
            -----------------------------*/
            if (c16 === '2C')
                return "Employee enrolled in coverage for the month";

            if (c16 === '2F')
                return "W-2 wages safe harbor applied";

            if (c16 === '2G')
                return "Federal Poverty Line safe harbor applied";

            if (c16 === '2H')
                return "Rate of Pay safe harbor applied";

            /* ----------------------------
               FALLBACK
            -----------------------------*/
            return "System calculated ACA compliance code";
        }
        function renderEmpty() {
            return `<div class="code-cell status-neutral d-flex align-items-center justify-content-center">
                        <span class="text-muted" style="opacity: 0.5;">-</span>
                    </div>`;
        }

                function renderMonthCell(code14, premium, code16, row) {

            code14 = code14 || '';
            code16 = code16 || '';
            if (!code14 && !code16) return renderEmpty();
            const isRisk = (code14 === '1H' && (!code16 || code16 === ''));
            const isLocked = row && (row.isLocked === true || row.isLocked === 1);

            let cssClass = "status-neutral";
            if (['1A','1E'].includes(code14)) cssClass = "status-safe";
            else if (code16 === '2C') cssClass = "status-safe";
            else if (isRisk) cssClass = "status-risk";

            const reason = getReasonText(code14, code16);

            // Safely parse the premium to avoid the .toFixed() TypeError
            const parsedPremium = parseFloat(premium);
            const isValidPremium = !isNaN(parsedPremium) && parsedPremium > 0;

            const costDisplay =
                (code14 !== '1A' && isValidPremium)
                    ? `<span class="line-15">$${parsedPremium.toFixed(2)}</span>`
                    : `<span class="line-15" style="opacity:0;">-</span>`;

            /* 🔒 LOCK ICON (manual override) */
            const lockIcon = isLocked
                ? `<span class="cell-icon lock-icon"
                          data-bs-toggle="tooltip"
                          title="Manually overridden & locked">
                       <i class="bx bxs-lock-alt text-warning"></i>
                   </span>`
                : '';

            /* ⚠ RISK ICON (penalty exposure) */
            const riskIcon = isRisk
                ? `<span class="cell-icon risk-icon"
                          data-action="risk"
                          title="View compliance risk details">
                       <i class="bx bx-error-circle text-danger"></i>
                   </span>`
                : '';

            return `
                <div class="code-cell ${cssClass}"
                     data-bs-toggle="tooltip"
                     data-bs-html="true"
                     title="<b>${reason}</b><br>L14: ${code14 || '-'}<br>L16: ${code16 || '-'}">

                    ${lockIcon}
                    ${riskIcon}

                    <div class="code-stack">
                        <span class="line-14">${code14 || '-'}</span>
                        ${costDisplay}
                        <span class="line-16">${code16 || '-'}</span>
                    </div>
                </div>
            `;
        }




        // ------------------------------------------
        // FIX FOR ISSUE 1: Analytics Logic
        // ------------------------------------------
        function calculateStats(data) {
            if(!data) return;

            var total = data.length;
            var riskCount = 0;
            var safeCount = 0;
            var lockedCount = 0;

            data.forEach(row => {
                if (row.isLocked) lockedCount++;

                var hasRisk = false;
                var months = ["jaN", "feB", "maR", "apR", "maY", "juN", "juL", "auG", "seP", "ocT", "noV", "deC"];

                months.forEach(m => {
                    var c14 = row[m + "_COC"];
                    var c16 = row[m + "_SHC"];
                    // Risk Definition: 1H AND NOT (2A or 2B)
                    if (c14 === '1H' && (!c16 || c16 === '')) {
                        hasRisk = true;
                    }
                });

                if (hasRisk) riskCount++;
                else safeCount++;
            });

            // Update UI Elements
            $('#statTotal').text(total);
            $('#statRisk').text(riskCount);

            var score = total > 0 ? Math.round((safeCount / total) * 100) : 0;
            $('#statScore').text(score + "%");
            $('#statProgress').css('width', score + "%");
        }

        // ------------------------------------------
        // FIX FOR ISSUE 2: Smart Filter Functions
        // ------------------------------------------
        window.filterGrid = function(mode) {
            // Reset any existing custom filters
            $.fn.dataTable.ext.search = [];

            if (mode === 'all') {
                dataTable.search('').draw();
                return;
            }

            // Add Custom Search Logic using RAW data lookup
            $.fn.dataTable.ext.search.push(
                function(settings, searchData, index, rowData, counter) {
                    // 'index' matches the index in our 'rawGridData' array because we aren't using server-side processing (yet)
                    // BUT to be safe, we access the data object associated with the row.
                    var data = dataTable.row(index).data();

                    if (!data) return false;

                    if (mode === 'locked') {
                        return data.isLocked === true || data.isLocked === 1;
                    }

                    if (mode === 'risk') {
                        var hasRisk = false;
                        var months = ["jaN", "feB", "maR", "apR", "maY", "juN", "juL", "auG", "seP", "ocT", "noV", "deC"];
                        months.forEach(m => {
                            var c14 = data[m + "_COC"];
                            var c16 = data[m + "_SHC"];
                            if (c14 === '1H' && c16 !== '2A' && c16 !== '2B') hasRisk = true;
                        });
                        return hasRisk;
                    }
                    return true;
                }
            );

            dataTable.draw(); // Re-draw the grid with the filter applied
        };

