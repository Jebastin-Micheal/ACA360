@using ACA360.Core.ViewModels
@model PartnerListViewModel<ACA360.Core.Models.Tracker.BrokerItem>

<div class="table-responsive ui-table-responsive">
    <table class="table table-hover mb-0 align-middle ui-table">
        <thead>
            <tr>
                <th>Broker Name</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="fw-bold">@item.BrokerName</div>
                            <small class="text-muted">
                                <i class="typcn bx bx-envelope"></i> @(item.Email ?? "N/A")
                            </small>
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-icon" onclick="openBrokerModal(@item.BrokerId)">
                                <i class="icon-base bx bx-edit bg-info icon-sm fs-4 text-secondary"></i>
                            </button>
                            <a href="javascript:;" class="btn btn-icon dropdown-toggle hide-arrow action-dots-btn" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="icon-base bx bx-dots-vertical-rounded icon-md"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end m-0" style="">
                                <a href="javascript:;" class="dropdown-item" onclick="deleteBroker(@item.BrokerId)">
                                    <i class="icon-base bx bx-trash bg-danger icon-md me-1"></i>Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="2" class="text-center p-4 text-muted">No brokers found for this firm.</td></tr>
            }
        </tbody>
    </table>
</div>

@{
    var startRecord = Model.TotalItems == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    var endRecord = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems);
}

<div class="d-flex justify-content-between align-items-center mt-3 flex-nowrap" style="font-size: 0.75rem;">
    @if (Model.TotalItems > 0)
    {
    @* 1. Left side: Entries Summary (Always Shows) *@
    <div class="col-auto text-muted text-nowrap me-1">
        Showing @startRecord to @endRecord of @Model.TotalItems entries
    </div>
    }
    @* 2. Right side: Full Pagination (Only shows if more than 1 page) *@
    @if (Model.TotalPages > 1)
    {
        <div class="col-auto">
            <nav aria-label="pagination">
                <ul class="pagination pagination-sm mb-0 flex-nowrap">

                    @* First Page Button *@
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <button type="button" class="page-link grid-page-link px-1" onclick="changeBrokerPage(1)" @(Model.CurrentPage == 1 ? "disabled" : "")>First</button>
                    </li>

                    @* Previous Page Button *@
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <button type="button" class="page-link grid-page-link px-1" onclick="changeBrokerPage(@(Model.CurrentPage - 1))" @(Model.CurrentPage == 1 ? "disabled" : "")>
                            <i class="bx bx-chevron-left"></i>
                        </button>
                    </li>

                    @{
                        int totalPages = Model.TotalPages;
                        int currentPage = Model.CurrentPage;
                        int displayRange = 3;

                        // 1. Calculate the dynamic starting page to center active index
                        int startPage = Math.Max(1, currentPage - 1);
                        int endPage = Math.Min(totalPages, startPage + displayRange - 1);

                        // 2. Adjust if we are near the final pages
                        if (endPage - startPage + 1 < displayRange)
                        {
                            startPage = Math.Max(1, endPage - displayRange + 1);
                        }

                        // 3. Render numbered page elements
                        for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <button type="button" class="page-link grid-page-link px-2" onclick="changeBrokerPage(@i)">@i</button>
                            </li>
                        }
                    }

                    @* Next Page Button *@
                    <li class="page-item @(Model.CurrentPage == totalPages ? "disabled" : "")">
                        <button type="button" class="page-link grid-page-link px-1" onclick="changeBrokerPage(@(Model.CurrentPage + 1))" @(Model.CurrentPage == totalPages ? "disabled" : "")>
                            <i class="bx bx-chevron-right"></i>
                        </button>
                    </li>

                    @* Last Page Button *@
                    <li class="page-item @(Model.CurrentPage == totalPages ? "disabled" : "")">
                        <button type="button" class="page-link grid-page-link px-1" onclick="changeBrokerPage(@totalPages)" @(Model.CurrentPage == totalPages ? "disabled" : "")>Last</button>
                    </li>

                </ul>
            </nav>
        </div>
    }
</div>