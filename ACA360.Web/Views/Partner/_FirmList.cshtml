@using ACA360.Core.ViewModels
@model PartnerListViewModel<ACA360.Core.Models.Tracker.FirmItem>

<div class="table-responsive ui-table-responsive">
    <table class="table table-hover mb-0 align-middle ui-table">
        <thead>
            <tr>
                <th class="col-1">#</th>
                <th class="col-7">Firm Name</th>
                <th class="col-4 text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Any())
            {
                int i = 1;
                foreach (var item in Model.Items)
                {
                    <tr id="tr_firm_@item.FirmId"
                        class="cursor-pointer transition-base"
                        data-firm-id="@item.FirmId" data-firm-name="@item.FirmName">
                        
                        <td class="text-center">
                            <span class="text-muted small">@(((Model.CurrentPage - 1) * Model.PageSize) + i)</span>
                            
                            <i id="icon_check_@item.FirmId" class="typcn bx bx-check text-success firm-check-icon d-none fw-bold ms-1"></i>
                        </td>

                        <td onclick="selectFirm(@item.FirmId, '@item.FirmName')" class="col-7 cursor-pointer">
                            <div class="fw-bold text-primary">@item.FirmName</div>
                            @{
                                var firmLoc = string.Join(", ", new[] { item.City, item.State }.Where(s => !string.IsNullOrWhiteSpace(s)));
                                if (string.IsNullOrWhiteSpace(firmLoc)) { firmLoc = "N/A"; }
                            }
                            <small class="text-muted" style="font-size: 0.75rem;">@firmLoc</small>
                        </td>
                        
                        <td class="text-end">
                            <button class="btn btn-sm btn-icon" onclick="event.stopPropagation(); openFirmModal(@item.FirmId)">
                                <i class="icon-base bx bx-edit icon-sm fs-4 text-secondary bg-info"></i>
                            </button>                           
                            <button class="btn btn-xs btn-success text-white ms-1" onclick="selectFirm(@item.FirmId, '@item.FirmName')">
                                Brokers <i class="typcn bx bx-show"></i>
                                <span class="badge bg-primary ms-1">@item.BrokerCount</span>
                            </button>
                            <a href="javascript:;" class="btn btn-icon dropdown-toggle hide-arrow action-dots-btn" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="icon-base bx bx-dots-vertical-rounded icon-md"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end m-0">
                                <a href="javascript:;" class="dropdown-item" onclick="event.stopPropagation(); deleteFirm(@item.FirmId)">
                                    <i class="icon-base bx bx-trash bg-danger icon-md me-1"></i>Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                    i++;
                }
            }
            else
            {
                <tr><td colspan="3" class="text-center p-4">No firms found.</td></tr>
            }
        </tbody>
    </table>
</div>

@{
    var startRecord = Model.TotalItems == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    var endRecord = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems);
}
@if (Model.TotalItems > 0)
{
   

<div class="d-flex justify-content-between align-items-center mt-3 flex-nowrap" style="font-size: 0.75rem;">

    @* 1. This part will NOW ALWAYS SHOW, even for 1 page *@
    <div class="col-auto text-muted text-nowrap me-1">
        Showing @startRecord to @endRecord of @Model.TotalItems entries
    </div>

    @* 2. This part ONLY shows the [First][1][2][Last] buttons if needed *@
    @if (Model.TotalPages > 1)
    {
        <div class="col-auto">
            <nav aria-label="pagination">
                <ul class="pagination pagination-sm mb-0 flex-nowrap">
                    
                    @* First Button *@
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <button type="button" class="page-link grid-page-link px-1" onclick="changeFirmPage(1)" @(Model.CurrentPage == 1 ? "disabled" : "")>First</button>
                    </li>

                    @* Previous Button *@
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <button type="button" class="page-link grid-page-link px-1" onclick="changeFirmPage(@(Model.CurrentPage - 1))" @(Model.CurrentPage == 1 ? "disabled" : "")>
                            <i class="bx bx-chevron-left"></i>
                        </button>
                    </li>

                    @{
                        int totalPages = Model.TotalPages;
                        int currentPage = Model.CurrentPage;
                        int displayRange = 3;

                        // 1. Determine Start Page (try to center current page)
                        int startPage = Math.Max(1, currentPage - 1);
                        int endPage = Math.Min(totalPages, startPage + displayRange - 1);

                        // 2. Adjust Start if we hit the end (e.g. Total 10, Current 10 -> Show 8, 9, 10)
                        if (endPage - startPage + 1 < displayRange)
                        {
                            startPage = Math.Max(1, endPage - displayRange + 1);
                        }

                        // 3. Render ONLY numbers
                        for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <button type="button" class="page-link grid-page-link px-2" onclick="changeFirmPage(@i)">@i</button>
                            </li>
                        }
                    }

                    @* Next Button *@
                    <li class="page-item @(Model.CurrentPage == totalPages ? "disabled" : "")">
                        <button type="button" class="page-link grid-page-link px-1" onclick="changeFirmPage(@(Model.CurrentPage + 1))" @(Model.CurrentPage == totalPages ? "disabled" : "")>
                            <i class="bx bx-chevron-right"></i>
                        </button>
                    </li>

                    @* Last Button *@
                    <li class="page-item @(Model.CurrentPage == totalPages ? "disabled" : "")">
                        <button type="button" class="page-link grid-page-link px-1" onclick="changeFirmPage(@totalPages)" @(Model.CurrentPage == totalPages ? "disabled" : "")>Last</button>
                    </li>

                </ul>
            </nav>
        </div>
    }
</div>
}