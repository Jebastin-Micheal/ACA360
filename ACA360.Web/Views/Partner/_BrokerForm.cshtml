@model ACA360.Core.Models.Tracker.BrokerItem

<form id="frmBroker" class="browser-default-validation">
    <div class="modal-header border-bottom py-3 bg-label-primary">
        <div class="d-flex align-items-center">
            <div class="avatar avatar-md me-3">
                <span class="avatar-initial rounded-circle bg-primary shadow-sm">
                    <i class="bx bx-user-check fs-3"></i>
                </span>
            </div>
            <div>
                <h5 class="modal-title fw-bold mb-0">Broker Profile</h5>              
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body py-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <input type="hidden" asp-for="BrokerId" />
                    <input type="hidden" asp-for="FirmId" />

                    <div class="d-flex align-items-center mb-4">
                        <span class="badge badge-center rounded-pill bg-label-primary me-2"><i class="bx bx-info-circle"></i></span>
                        <h6 class="text-uppercase fw-bold mb-0 small">Identity & Contact</h6>
                        <hr class="flex-grow-1 ms-3 opacity-25" />
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label class="form-label fw-semibold" asp-for="BrokerName">Name<span class="text-danger">*</span></label>
                            <input asp-for="BrokerName" class="form-control" placeholder="Broker Name" data-val="true" data-val-required="Name is required" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" asp-for="Email">Email Address</label>
                            <div class="input-group input-group-merge">
                                <span class="input-group-text"><i class="bx bx-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="Email" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" asp-for="Phone">Phone Number</label>
                            <div class="input-group input-group-merge">
                                <span class="input-group-text"><i class="bx bx-phone"></i></span>
                                <input asp-for="Phone" class="form-control mask-us-phone" placeholder="(XXX) XXX-XXXX" />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center mb-4">
                        <span class="badge badge-center rounded-pill bg-label-success me-2"><i class="bx bx-map-pin"></i></span>
                        <h6 class="text-uppercase fw-bold mb-0 small">Office Location</h6>
                        <hr class="flex-grow-1 ms-3 opacity-25" />
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label class="form-label fw-semibold" asp-for="Address">Address</label>
                            <input asp-for="Address" class="form-control" placeholder="Address" />
                        </div>
                        <div class="col-md-5">
                            <input asp-for="City" class="form-control" placeholder="City" />
                        </div>
                        <div class="col-md-4">
                            <select asp-for="StateId" class="form-select select2" asp-items="ViewBag.States">
                                <option value="">State</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <input asp-for="Zip" class="form-control" placeholder="Zip" maxlength="10" />
                        </div>
                    </div>

                    <div class="d-flex align-items-center mb-4">
                        <span class="badge badge-center rounded-pill bg-label-warning me-2"><i class="bx bx-shield-quarter"></i></span>
                        <h6 class="text-uppercase fw-bold mb-0 small">System & Roles</h6>
                        <hr class="flex-grow-1 ms-3 opacity-25" />
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" asp-for="ConnectUser">Connect User</label>
                            <div class="input-group input-group-merge">
                                <span class="input-group-text"><i class="bx bx-link-external"></i></span>
                                <input asp-for="ConnectUser" class="form-control" placeholder="Username" />
                            </div>
                        </div>
                        @* <div class="col-md-6">
                <label class="form-label fw-semibold" asp-for="ACARoles">ACA Assigned Role</label>
                <select asp-for="ACARoles" class="form-select select2">
                    <option value="">Select Role</option>
                    <option value="Admin">Administrator</option>
                    <option value="Agent">Agent</option>
                </select>
            </div> *@

                        <div class="col-12 mt-4">
                            <div class="p-3 rounded border border-dashed d-flex align-items-center justify-content-between bg-lighter">
                                <div class="d-flex align-items-center">
                                    <div class="badge bg-label-primary p-2 me-3 rounded">
                                        <i class="bx bx-power-off fs-4"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold">Active Status</h6>

                                    </div>
                                </div>
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" style="width: 2.6em; height: 1.3em;">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer border-top bg-lighter p-3 py-3">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="btnSaveBroker" onclick="saveBroker()" class="btn btn-primary px-5 shadow-sm">

            <i class="bx bx-save me-1"></i> Save Changes
        </button>
    </div>
</form>