@using ACA360.Web.ViewComponents
@{
    ViewData["Title"] = "Firm Management";
    ViewBag.ShowFilterButton = false;
    ViewBag.ShowViewModeToggle = false;
}

@await Component.InvokeAsync("Breadcrumb", new {
pageTitle = "Firm Management",
    items = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "Home", Url = "/", IsActive = false },
        new BreadcrumbItem { Title = "Employer", Url = "", IsActive = false },
        new BreadcrumbItem { Title = "Firm Management", Url = "", IsActive = true }
    }
})

<div class="card mb-6">
    <div class="row g-4 mt-2 mb-4 px-3">

        <!-- FIRM COLUMN -->
        <div class="col-xl-7">
            <div class="card h-100 mb-3">
                <div class="card-header border-bottom">
                    <h5 class="card-title mb-0">List of Firms</h5>
                </div>

                <div class="card-body">

                    <div id="FirmListContainerWrapper">

                        @await Html.PartialAsync("_GridToolbarCommon", new
                                                {
                            IsEmployerPage = false,
                                                Prefix = "firm",
                                                CustomButtons = @"<button class=""btn create-new btn-primary"" type=""button"" onclick=""openFirmModal(0)"">
                                                <span class=""d-flex align-items-center gap-2"">
                                                <i class=""icon-base bx bx-plus icon-sm""></i>
                                                <span class=""d-none d-sm-inline-block"">Add Firm</span>
                                                </span>
                                                </button>"
                                                })

                        <div id="firmGridContainer" class="px-1"></div>
                    </div>

                </div>
            </div>
        </div>

        <!-- BROKER COLUMN -->
        <div class="col-xl-5">
            <div class="card h-100">
                <div class="card-header border-bottom">
                    <h5 class="mb-0 fw-bold text-muted" id="lblBrokerHeader">List of Brokers</h5>
                </div>

                <div class="card-body">

                    <div id="BrokerListContainerWrapper" style="position:relative;">

                        <div id="broker-loader" class="loader" style="display:none;">
                            <div class="spinner"></div>
                        </div>

                        @await Html.PartialAsync("_GridToolbarCommon", new
                                                {
                            IsEmployerPage = false,
                                                Prefix = "broker",
                                                CustomButtons = @"<button class=""btn create-new btn-primary"" type=""button"" onclick=""openBrokerModal(0)"" id=""btnAddBroker"" disabled>
                                                <span class=""d-flex align-items-center gap-2"">
                                                <i class=""icon-base bx bx-user-plus icon-sm""></i>
                                                <span class=""d-none d-sm-inline-block"">Add Broker</span>
                                                </span>
                                                </button>"
                                                })

                        <div id="brokerGridContainer" class="px-1">
                            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted mt-5 pb-5">
                                <i class="bx bx-subdirectory-right fs-1 mb-2"></i>
                                <p>Select a Firm to view Brokers</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>


<div class="modal fade" id="firmModal" tabindex="-1" data-bs-backdrop="static"><div class="modal-dialog modal-dialog-centered"><div class="modal-content" id="firmModalContent"></div></div></div>
<div class="modal fade" id="brokerModal" tabindex="-1" data-bs-backdrop="static"><div class="modal-dialog modal-dialog-centered"><div class="modal-content" id="brokerModalContent"></div></div></div>

<input type="hidden" id="hdnSelectedFirmId" value="0" />
<input type="hidden" id="hdnSelectedFirmName" value="" />

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // --- GLOBAL STATE ---
        let firmState = { page: 1, pageSize: 10, search: '', sortCol: 'FirmName', sortOrder: 'ASC' };
        let brokerState = { page: 1, pageSize: 10, search: '', sortCol: 'BrokerName', sortOrder: 'ASC' };
        let pendingFirmSelect = null;
        $(document).ready(function () {
            loadFirms();
            bindToolbarEvents();
        });

        function bindToolbarEvents() {

            $('.grid-search-input').on('keyup', function () {
                var prefix = $(this).data('prefix');
                var val = $(this).val();
                toggleClearBtn(prefix);

                if (prefix === 'firm') {
                    firmState.search = val;
                    firmState.page = 1;
                    loadFirms();
                } else if (prefix === 'broker') {
                    brokerState.search = val;
                    brokerState.page = 1;
                    loadBrokers();
                }
            });

            $('[id^="clearSearchBtn_"]').on('click', function () {
                var prefix = $(this).data('prefix');
                $('#mainGridSearch_' + prefix).val('').focus();
                $(this).addClass('d-none');

                if (prefix === 'firm') {
                    firmState.search = '';
                    firmState.page = 1;
                    loadFirms();
                } else if (prefix === 'broker') {
                    brokerState.search = '';
                    brokerState.page = 1;
                    loadBrokers();
                }
            });

            $('.grid-refresh-btn').on('click', function () {
                var prefix = $(this).data('prefix');

                if (prefix === 'firm') {
                    $('#mainGridSearch_firm').val('');
                    $('#clearSearchBtn_firm').addClass('d-none');
                    $('.grid-pagesize-select[data-prefix="firm"]').val(10);
                    firmState.search = '';
                    firmState.page = 1;
                    firmState.pageSize = 10;
                    loadFirms();
                } else if (prefix === 'broker') {
                    $('#mainGridSearch_broker').val('');
                    $('#clearSearchBtn_broker').addClass('d-none');
                    $('.grid-pagesize-select[data-prefix="broker"]').val(10);
                    brokerState.search = '';
                    brokerState.page = 1;
                    brokerState.pageSize = 10;
                    loadBrokers();
                }
            });

            $('.grid-pagesize-select').on('change', function () {
                var prefix = $(this).data('prefix');
                var size = parseInt($(this).val());

                if (prefix === 'firm') {
                    firmState.pageSize = size;
                    firmState.page = 1;
                    loadFirms();
                } else if (prefix === 'broker') {
                    brokerState.pageSize = size;
                    brokerState.page = 1;
                    loadBrokers();
                }
            });

            $(document).on('click', '#firmGridContainer .grid-page-link', function (e) {
                e.preventDefault();
                var page = $(this).data('page');
                if (page && !$(this).closest('.page-item').hasClass('disabled')) {
                    changeFirmPage(page);
                }
            });

            $(document).on('click', '#brokerGridContainer .grid-page-link', function (e) {
                e.preventDefault();
                var page = $(this).data('page');
                if (page && !$(this).closest('.page-item').hasClass('disabled')) {
                    changeBrokerPage(page);
                }
            });
        }

        function toggleClearBtn(prefix) {
            var val = $('#mainGridSearch_' + prefix).val();
            val ? $('#clearSearchBtn_' + prefix).removeClass('d-none') : $('#clearSearchBtn_' + prefix).addClass('d-none');
        }

        // ==========================
        // 1. FIRM LOGIC (LEFT SIDE)
        // ==========================
        function loadFirms() {
            $.get('/Partner/GetFirmGrid', {
                search: firmState.search,
                sortCol: firmState.sortCol,
                sortOrder: firmState.sortOrder,
                page: firmState.page,
                pageSize: firmState.pageSize
            }).done(function (html) {
                $('#firmGridContainer').html(html);

               // Prefer a just-saved firm (edit/add); otherwise show the FIRST firm in the current view
                // (initial load, pagination, sort, search, page-size).
                let $target = null;
                if (pendingFirmSelect && pendingFirmSelect.id) {
                    $target = $('#firmGridContainer tbody tr[data-firm-id="' + pendingFirmSelect.id + '"]').first();
                }
                if (!$target || !$target.length) {
                    $target = $('#firmGridContainer tbody tr[data-firm-id]').first();
                }
                pendingFirmSelect = null;

                if ($target.length) {
                    selectFirm($target.data('firm-id'), $target.data('firm-name'));
                }
                 else {
                    // Default: auto-select the first firm and load its brokers
                    const $firstFirm = $('#firmGridContainer tbody tr[data-firm-id]').first();
                    if ($firstFirm.length) {
                        selectFirm($firstFirm.data('firm-id'), $firstFirm.data('firm-name'));
                    }
                    // No firms in the current view -> clear the broker side
                    $('#hdnSelectedFirmId').val(0);
                    $('#hdnSelectedFirmName').val('');
                    $('#lblBrokerHeader').addClass('text-muted').text('List of Brokers');
                    $('#btnAddBroker').prop('disabled', true);
                    loadBrokers();
                }   
            }).fail(function (xhr) {
                console.error("loadFirms failed:", xhr.status, xhr.responseText);
                $('#firmGridContainer').html('<div class="alert alert-danger m-3">Error loading firms.</div>');
            });
        }

        function selectFirm(firmId, firmName) {
            $('#firmGridContainer tr').removeClass('table-active border-start border-2 border-primary');
            $('.firm-check-icon').addClass('d-none');

            $(`#tr_firm_${firmId}`).addClass('table-active border-start border-2 border-primary');
            $(`#icon_check_${firmId}`).removeClass('d-none');

            $('#hdnSelectedFirmId').val(firmId);
            $('#hdnSelectedFirmName').val(firmName);

            $('#lblBrokerHeader').removeClass('text-muted').text(`List of Brokers — ${firmName}`);

            $('#btnAddBroker').prop('disabled', false);

            brokerState.page = 1;
            brokerState.search = '';
            $('#mainGridSearch_broker').val('');
            loadBrokers();
        }

        function changeFirmPage(p) { firmState.page = p; loadFirms(); }

        // ==========================
        // 2. BROKER LOGIC (RIGHT SIDE)
        // ==========================
        function loadBrokers() {
            const firmId = $('#hdnSelectedFirmId').val();

            if (!firmId || firmId == 0) {
                $('#brokerGridContainer').html('<div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted mt-5"><i class="bx bx-left-arrow-alt fs-1"></i><p>Select a Firm to view Brokers</p></div>');
                return;
            }

            $('#broker-loader').show();

            $.get('/Partner/GetBrokerGrid', {
                search: brokerState.search,
                firmId: firmId,
                sortCol: brokerState.sortCol,
                sortOrder: brokerState.sortOrder,
                page: brokerState.page,
                pageSize: brokerState.pageSize
            }).done(function (html) {
                $('#brokerGridContainer').html(html);
            }).fail(function () {
                $('#brokerGridContainer').html('<div class="alert alert-danger m-3">Error loading brokers.</div>');
            }).always(function () {
                $('#broker-loader').hide();
            });
        }

        function changeBrokerPage(p) {
            brokerState.page = p;
            loadBrokers();
        }

        function openBrokerModal(id) {
            const firmId = $('#hdnSelectedFirmId').val();

            $.get('/Partner/BrokerForm/' + id + '?parentFirmId=' + firmId)
             .done(function (html) {
                $('#brokerModalContent').html(html);
                new bootstrap.Modal(document.getElementById('brokerModal')).show();
            });
        }

        function saveBroker() {
            var form = $('#frmBroker');
            var btn = $('#btnSaveBroker');

            $.validator.unobtrusive.parse(form);

            btn.prop('disabled', true);
            btn.html('<i class="bx bx-loader bx-spin me-1"></i> Saving...');

            if (!form.valid()) {
                form.find('.border-danger').removeClass('border-danger');
                var errors = form.find('.input-validation-error');
                errors.addClass('border-danger');
                errors.siblings('.input-group-text').addClass('border-danger');
                var firstErr = errors.first();
                if (firstErr.length) firstErr.focus();
                btn.prop('disabled', false);
                btn.html('<i class="bx bx-save me-1"></i> Save Changes');
                return;
            }

            $.post('/Partner/SaveBroker', form.serialize())
                .done(function (res) {
                    if (res.success) {
                        var modalEl = document.getElementById('brokerModal');
                        bootstrap.Modal.getInstance(modalEl).hide();
                        loadBrokers();
                        Swal.fire({ icon: 'success', title: 'Saved!', text: 'Broker saved successfully.', timer: 1500, showConfirmButton: false });
                    } else {
                        Swal.fire('Error', res.message, 'error');
                        btn.prop('disabled', false);
                        btn.html('<i class="bx bx-save me-1"></i> Save Changes');
                    }
                })
                .fail(function (xhr) {
                    Swal.fire('Error', 'Server Error: ' + xhr.status, 'error');
                    btn.prop('disabled', false);
                    btn.html('<i class="bx bx-save me-1"></i> Save Changes');
                });
        }

        function deleteBroker(id) {
            Swal.fire({
                title: 'Delete Broker?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Partner/DeleteBroker', { id: id })
                        .done(function (res) {
                            if (res.success) {
                                Swal.fire('Deleted!', 'Broker has been deleted.', 'success');
                                loadBrokers();
                            } else {
                                Swal.fire('Failed', res.message, 'error');
                            }
                        })
                        .fail(function () {
                            Swal.fire('Error', 'Could not delete broker.', 'error');
                        });
                }
            });
        }

        // ==========================
        // 3. FIRM MODAL OPERATIONS
        // ==========================
        function openFirmModal(id) {
            $.get('/Partner/FirmForm/' + id).done(function (html) {
                $('#firmModalContent').html(html);
                var myModal = new bootstrap.Modal(document.getElementById('firmModal'));
                myModal.show();
                $.validator.unobtrusive.parse("#frmFirm");
            });
        }

        function saveFirm() {
            var form = $('#frmFirm');
            var btn = $('#btnSaveFirm');

            $.validator.unobtrusive.parse(form);

            btn.prop('disabled', true);
            btn.html('<i class="bx bx-loader bx-spin me-1"></i> Saving...');

            const stateVal = $('#StateId').val();
            let stateText = "";
            if (stateVal && stateVal !== "") {
                stateText = $('#StateId option:selected').text().trim();
            }
            $('#hdnStateName').val(stateText);

            if (!form.valid()) {
                form.find('.border-danger').removeClass('border-danger');
                var errors = form.find('.input-validation-error');
                errors.addClass('border-danger');
                errors.siblings('.input-group-text').addClass('border-danger');
                var firstErr = errors.first();
                if (firstErr.length) firstErr.focus();
                btn.prop('disabled', false);
                btn.html('<i class="bx bx-save me-1"></i> Save Firm');
                return false;
            }

            $.ajax({
                url: '/Partner/SaveFirm',
                type: 'POST',
                data: form.serialize(),
                success: function (res) {
                    if (res.success) {
                        bootstrap.Modal.getInstance(document.getElementById('firmModal')).hide();
                         pendingFirmSelect = { id: res.id, name: res.name }; // keep the saved firm selected after reload
                        loadFirms();
                        Swal.fire('Saved!', 'Firm saved successfully.', 'success');
                    } else {
                        Swal.fire('Error', res.message, 'error');
                        btn.prop('disabled', false);
                        btn.html('<i class="bx bx-save me-1"></i> Save Firm');
                    }
                },
                error: function (xhr) {
                    Swal.fire('Error', 'Server issue. Check console.', 'error');
                    btn.prop('disabled', false);
                    btn.html('<i class="bx bx-save me-1"></i> Save Firm');
                }
            });
        }

        function deleteFirm(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.showLoading();
                    $.post('/Partner/DeleteFirm', { id: id })
                        .done(function (res) {
                            if (res.success) {
                                Swal.fire('Deleted!', 'The firm has been deleted.', 'success');
                                loadFirms();
                            } else {
                                Swal.fire('Failed!', res.message, 'error');
                            }
                        })
                        .fail(function () {
                            Swal.fire('Error!', 'Could not connect to server.', 'error');
                        });
                }
            });
        }
    </script>
}