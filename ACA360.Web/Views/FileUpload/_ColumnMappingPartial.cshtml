@model ACA360.Web.Controllers.FileUploadController.ColumnMappingViewModel
@{
    var needs = Model.Sheets.Sum(s => s.Missing.Count);
}

<form id="columnMappingForm" data-file-id="@Model.FileLogId">
    @Html.AntiForgeryToken()
    <p class="mb-2">
        <strong class="text-break text-heading">@Model.FileName</strong>
        <span class="text-body opacity-75">· @Model.EmployerName (@Model.Ein)</span>
    </p>

    @if (!Model.HeadersRead)
    {
        <div class="alert alert-warning mb-0" role="alert">The file's headers could not be read, so nothing can be mapped. Check that it is an .xlsx workbook.</div>
    }
    else
    {
        if (needs == 0)
        {
            <div class="alert alert-success" role="status">Every required column is found now. Save to check the file again.</div>
        }
        else
        {
            <p class="small text-body opacity-75">
                Pick the header this employer uses for each missing column. The choice is kept for this employer, so their next files are read the same way.
            </p>
        }

        var i = 0;
        foreach (var sheet in Model.Sheets.Where(s => s.SheetMissing || s.Missing.Count > 0))
        {
            <h6 class="mt-3 mb-2">@sheet.Sheet sheet</h6>
            @if (sheet.SheetMissing)
            {
                <div class="alert alert-danger py-2" role="alert">The file has no '@sheet.Sheet' sheet. A sheet cannot be mapped; rename it in the file and upload it again.</div>
                continue;
            }
            <div class="table-responsive position-relative">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light"><tr><th>Template column</th><th>The file's header</th></tr></thead>
                    <tbody>
                        @foreach (var need in sheet.Missing)
                        {
                            var selectId = $"map_{i}";
                            <tr>
                                <td>
                                    <label for="@selectId" class="fw-semibold mb-0">@need.TemplateHeader</label>
                                    @if (!string.IsNullOrEmpty(need.AlternateNames))
                                    {
                                        <div class="small text-body opacity-75 text-break">also accepted: @need.AlternateNames</div>
                                    }
                                </td>
                                <td>
                                    <input type="hidden" name="maps[@i].Sheet" value="@sheet.Sheet" />
                                    <input type="hidden" name="maps[@i].Target" value="@need.TargetColumnName" />
                                    <select id="@selectId" name="maps[@i].Header" class="form-select form-select-sm" data-map-select>
                                        <option value="">Not in this file</option>
                                        @foreach (var h in sheet.UnusedHeaders)
                                        {
                                            <option value="@h">@h</option>
                                        }
                                    </select>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
            @if (sheet.UnusedHeaders.Count == 0)
            {
                <p class="small text-danger mt-1">This sheet has no unused headers to choose from.</p>
            }
        }
    }

    @if (Model.Saved.Count > 0)
    {
        <h6 class="mt-4 mb-2">Kept for this employer</h6>
        <ul class="list-group list-group-flush small">
            @foreach (var m in Model.Saved)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center px-0" data-saved-map="@m.EmployerColumnMapId">
                    <span><strong>@m.SourceHeader</strong> → @(m.TemplateHeader ?? m.TargetColumnName) <span class="text-body opacity-75">(@m.SheetName)</span></span>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-delete-map="@m.EmployerColumnMapId" title="Stop using this mapping">Remove</button>
                </li>
            }
        </ul>
    }
    <div class="small mt-2" data-map-status aria-live="polite"></div>
</form>
