@using ACA360.Core.Models
@using System.Text.Json

<div class="modal fade import-analysis" id="analysisModal" tabindex="-1" aria-labelledby="analysisTitle" aria-hidden="true"
     data-summary-url="@Url.Action("Analyze", "FileUpload")"
     data-rows-url="@Url.Action("GetAnalysisRows", "FileUpload")"
     data-export-url="@Url.Action("ExportAnalysisExcel", "FileUpload")"
     data-changes-url="@Url.Action("AnalysisChanges", "FileUpload")"
     data-import-url="@Url.Action("ImportData", "FileUpload")">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header ia-header">
                <div>
                    <h5 class="modal-title" id="analysisTitle"><i class="bx bx-data me-2" aria-hidden="true"></i>Import Analysis</h5>
                    <small id="analysisFileName"></small>
                </div>
                <div class="d-flex align-items-center ms-auto me-12">
                   <button type="button" id="analysisDownload" class="btn btn-success btn-sm ia-download" disabled
                            title="Download all five sheets and chart summaries, including rows outside the current page or filters">
                        <i class="bx bx-download" aria-hidden="true"></i><span id="analysisDownloadText">Download Excel</span>
                    </button>

                    <!-- Close Button -->
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close analysis"></button>
                </div>
            </div>
            <div class="modal-body ia-body">
                @Html.AntiForgeryToken()
                <div id="analysisError" class="alert alert-danger d-none" role="alert">
                    <span></span> <button type="button" class="btn btn-sm btn-outline-danger" id="analysisRetry">Retry</button>
                </div>
                <div class="ia-overview" aria-label="File analysis summary">
                    <section class="ia-panel ia-quality">
                        <h6>File quality</h6>
                        <div class="ia-donut-wrap">
                            <!-- Inner content removed for ApexCharts -->
                            <div id="impactChart" aria-label="Validation summary is loading"></div>
                        </div>
                        <div class="ia-chart-legend">
                            <span class="text-heading"><i class="ia-dot ia-dot-clean"></i>Clean</span>
                            <span class="text-heading"><i class="ia-dot ia-dot-warning"></i>Warnings</span>
                            <span class="text-heading"><i class="ia-dot ia-dot-error"></i>Errors</span>
                            <span class="text-heading"><i class="ia-dot ia-dot-info"></i>Info</span>
                        </div>
                    </section>
                    <section class="ia-panel">
                        <h6>Validation summary</h6>
                        <table class="table table-sm ia-summary"><thead><tr><th>Category</th><th>Count</th><th>Action</th></tr></thead><tbody id="analysisValidationBody"><tr><td colspan="3">Loading summary…</td></tr></tbody></table>
                    </section>
                    <section class="ia-panel ia-impact">
                        <h6>Database impact preview <small id="analysisModeLabel">Merge</small></h6>
                        <div class="table-responsive">
                            <table class="table table-sm ia-summary">
                                <thead>
                                    <tr>
                                        <th><i class="bx bx-layer me-1 text-secondary"></i>Entity</th>
                                        <th><i class="bx bx-plus-circle me-1 text-success"></i>New</th>
                                        <th><i class="bx bx-edit-alt me-1 text-info"></i>Update</th>
                                        <th><i class="bx bx-minus-circle me-1 text-secondary"></i>No change</th>
                                        <th><i class="bx bx-trash me-1 text-danger"></i>Remove</th>
                                        <th><i class="bx bx-block me-1 text-warning"></i>Excluded</th>
                                        <th><i class="bx bx-upload me-1 text-primary"></i>Upload</th>
                                    </tr>
                                </thead>
                                <tbody id="analysisEntityBody">
                                    <tr><td colspan="7">Loading summary…</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </section>
                </div>
                <section class="ia-panel ia-grid-panel" aria-label="Uploaded sheet values">
                    <div class="ia-grid-top">
                        <ul class="nav nav-pills ia-sheet-tabs mb-0 gap-0" role="tablist" aria-label="ACA Entities">
                            <li class="nav-item">
                                <button class="nav-link py-2 px-3 active" id="ia-tab-Employer" type="button" role="tab"
                                        aria-controls="analysisGridPanel" aria-selected="true" tabindex="0" data-entity="Employer">
                                    <i class="bx bx-building me-1"></i> Employer
                                    <span class="ia-tab-count ms-1" data-count="Employer">—</span>
                                </button>
                            </li>

                            <li class="nav-item">
                                <button class="nav-link py-2 px-3" id="ia-tab-Plan" type="button" role="tab"
                                        aria-controls="analysisGridPanel" aria-selected="false" tabindex="-1" data-entity="Plan">
                                    <i class="bx bx-clipboard me-1"></i> Plan
                                    <span class="ia-tab-count ms-1" data-count="Plan">—</span>
                                </button>
                            </li>

                            <li class="nav-item">
                                <button class="nav-link py-2 px-3" id="ia-tab-Premium" type="button" role="tab"
                                        aria-controls="analysisGridPanel" aria-selected="false" tabindex="-1" data-entity="Premium">
                                    <i class="bx bx-money me-1"></i> Premium
                                    <span class="ia-tab-count ms-1" data-count="Premium">—</span>
                                </button>
                            </li>

                            <li class="nav-item">
                                <button class="nav-link py-2 px-3" id="ia-tab-Employee" type="button" role="tab"
                                        aria-controls="analysisGridPanel" aria-selected="false" tabindex="-1" data-entity="Employee">
                                    <i class="bx bx-user me-1"></i> Employee
                                    <span class="ia-tab-count ms-1" data-count="Employee">—</span>
                                </button>
                            </li>

                            <li class="nav-item">
                                <button class="nav-link py-2 px-3" id="ia-tab-Dependent" type="button" role="tab"
                                        aria-controls="analysisGridPanel" aria-selected="false" tabindex="-1" data-entity="Dependent">
                                    <i class="bx bx-group me-1"></i> Dependents
                                    <span class="ia-tab-count ms-1" data-count="Dependent">—</span>
                                </button>
                            </li>

                            <li class="nav-item">
                                <button class="nav-link py-2 px-3" id="ia-tab-Changes" type="button" role="tab"
                                        aria-controls="analysisChangesPanel" aria-selected="false" tabindex="-1" data-entity="Changes"
                                        title="The file compared with what the system holds now">
                                    <i class="bx bx-git-compare me-1"></i> What changed
                                </button>
                            </li>
                        </ul>
                        <div class="ia-filters">
                            <label>Change <select id="analysisImpactFilter" class="form-select form-select-sm"><option value="All">All changes</option><option value="INSERT">New</option><option value="UPDATE">Updated</option><option value="NOCHANGE">No change</option><option value="REMOVE">Removed on import</option><option value="EXCLUDED">Excluded</option></select></label>
                            <label>Validation <select id="analysisValidationFilter" class="form-select form-select-sm"><option value="All">All validation</option><option>Clean</option><option>Warning</option><option>Error</option><option>Information</option></select></label>
                        </div>
                    </div>
                    <div class="ia-grid-legend"><span class="ia-tag ia-insert">New</span><span class="ia-tag ia-update">Updated</span><span class="ia-tag ia-remove">Removed on import</span><span class="ia-tag ia-warning">Warning</span><span class="ia-tag ia-error">Error</span><span class="ia-grid-hint">Source values follow workbook column order. Select a row’s Details button to review issues.</span></div>
                    <div id="analysisGridError" class="alert alert-danger d-none" role="alert"><span></span> <button type="button" class="btn btn-sm btn-outline-danger" id="analysisGridRetry">Retry rows</button></div>
                    <div id="analysisGridPanel" role="tabpanel" aria-labelledby="ia-tab-Employer">
                        <table id="analysisGrid" class="table table-bordered table-hover" style="width:100%"><caption class="visually-hidden">Employer upload values</caption></table>
                    </div>
                    <div id="analysisChangesPanel" class="d-none pt-2" role="tabpanel" aria-labelledby="ia-tab-Changes" aria-live="polite"></div>
                    <p class="ia-count-note">Counts represent uploaded rows. Several rows may belong to one employee. Removed rows come from the existing database and appear only in Overwrite mode.</p>
                </section>
            </div>
            <div class="modal-footer ia-footer py-3">
                <div class="ia-mode-options" role="group" aria-label="Choose import mode">
                    <label class="ia-mode-card">
                        <input type="radio" name="importMode" value="Merge" checked />
                        <span>
                            <strong>Update / Merge</strong>
                            <small>Add and merge uploaded records.</small>
                        </span>
                        <i class="bx bx-git-merge text-primary ms-auto fs-5"></i>
                    </label>
                    <label class="ia-mode-card ia-mode-overwrite">
                        <input type="radio" name="importMode" value="Overwrite" />
                        <span>
                            <strong class="text-danger">Overwrite / Replace</strong>
                            <small class="text-danger">Delete and reload records in the overwrite scope.</small>
                        </span>
                        <i class="bx bx-trash text-danger ms-auto fs-5"></i>
                    </label>
                </div>
                <div class="ia-footer-actions"><span id="analysisImportStatus" role="status">Loading analysis…</span><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="analysisConfirm" disabled>Confirm &amp; Import</button></div>
                <div id="analysisRemovalNotice" class="ia-removal-notice d-none" role="status"></div>
            </div>
        </div>
    </div>
</div>
<script id="analysisSheetCatalog" type="application/json">@Html.Raw(JsonSerializer.Serialize(ImportAnalysisCatalog.Sheets, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }))</script>
