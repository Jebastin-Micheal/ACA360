@model ACA360.Core.Models.UploadedFileLog

@{
    ViewData["Title"] = "Delete File";
}

<h2>@ViewData["Title"]</h2>

<h3 class="text-danger">Are you sure you want to delete this file?</h3>
<div>
    <h4>@Model.OriginalFileName</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            File Name
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OriginalFileName)
        </dd>
        <dt class="col-sm-2">
            Upload Date
        </dt>
        <dd class="col-sm-10">
            @Model.UploadedAt.ToString("F")
        </dd>
        <dt class="col-sm-2">
            Status
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.WorkflowStatus)
        </dd>
    </dl>

    <form asp-action="Delete">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="FileLogId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>