// ASSIGNMENT ACTIONS (delegated — survive AJAX reloads)
// ══════════════════════════════════════════════════════════════════════════════

// Manager assign dropdown
document.addEventListener('change', function (e) {
    if (!e.target.classList.contains('assign-select')) return;
    const fileId = parseInt(e.target.dataset.fileid);
    const userId = e.target.value;
    const name   = e.target.options[e.target.selectedIndex]?.text;
    const sel    = e.target;
    sel.disabled = true;

    if (!userId) { unassignFile(fileId, sel); return; }

    $.post('/FileUpload/AssignFile', {
        fileLogId: fileId, targetUserId: userId,
        __RequestVerificationToken: getToken()
    })
    .done(function (res) {
        if (res.success) {
            showToast('success', res.message || 'File assigned.');
            updateAssignedCell(fileId, name, false);
        } else {
            showToast('danger', res.message || 'Assignment failed.');
            sel.value = '';
        }
    })
    .fail(function () { showToast('danger', 'Server error. Assignment not saved.'); sel.value = ''; })
    .always(function () { sel.disabled = false; });
});

// DA Accept
document.addEventListener('click', async function (e) {
    const btn = e.target.closest('.btn-accept');
    if (!btn) return;
    const fileId = parseInt(btn.dataset.fileid);
    const ok = await showConfirm('Accept File',
        'You will be assigned this file and processing will begin immediately.',
        'Accept & Start', 'btn-primary');
    if (!ok) return;
    setRowBusy(fileId, true);
    $.post('/FileUpload/AcceptFile', {
        fileLogId: fileId, __RequestVerificationToken: getToken()
    })
    .done(function (res) {
        if (res.success) { showToast('success', 'File accepted. Processing started.'); loadFileData(currentState.page, true); }
        else             { showToast('danger', res.message); setRowBusy(fileId, false); }
    })
    .fail(function ()  { showToast('danger', 'Server error.'); setRowBusy(fileId, false); });
});

// Release / force unassign
document.addEventListener('click', async function (e) {
    const btn = e.target.closest('.btn-release');
    if (!btn) return;
    const fileId = parseInt(btn.dataset.fileid);
    const ok = await showConfirm('Release File',
        'This file will be returned to the unassigned pool.',
        'Release', 'btn-warning');
    if (!ok) return;
    unassignFile(fileId);
});

function unassignFile(fileId) {
    setRowBusy(fileId, true);
    $.post('/FileUpload/UnassignFile', {
        fileLogId: fileId, __RequestVerificationToken: getToken()
    })
    .done(function (res) {
        if (res.success) {
            showToast('info', 'File returned to unassigned pool.');
            updateAssignedCell(fileId, null, false);
            loadFileData(currentState.page, true);
        } else {
            showToast('danger', res.message);
            setRowBusy(fileId, false);
        }
    })
    .fail(function () { showToast('danger', 'Server error.'); setRowBusy(fileId, false); });
}

