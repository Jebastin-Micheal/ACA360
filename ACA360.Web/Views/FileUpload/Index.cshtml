// ══════════════════════════════════════════════════════════════════════════════
// TOAST NOTIFICATION SYSTEM
// ══════════════════════════════════════════════════════════════════════════════
function showToast(type, message, duration = 4500) {
    const icons = { success:'bx-check-circle', danger:'bx-error-circle',
                    warning:'bx-error',         info:'bx-info-circle' };
    const bgMap = { success:'#198754', danger:'#dc3545', warning:'#ffc107', info:'#0dcaf0' };
    const txMap = { success:'#fff',    danger:'#fff',    warning:'#000',     info:'#000' };
    const id    = 'toast_' + Date.now();
    const html  = `
        <div id="${id}"
             class="d-flex align-items-center gap-2 px-3 py-2 rounded shadow"
             style="background:${bgMap[type]||bgMap.info};color:${txMap[type]||'#fff'};
                    animation:slideInRight .25s ease;min-width:260px;">
            <i class="bx ${icons[type]||'bx-bell'} fs-5 flex-shrink-0"></i>
            <span class="small flex-grow-1">${message}</span>
            <button onclick="document.getElementById('${id}').remove()"
                    class="btn-close ${type==='warning'||type==='info' ? '' : 'btn-close-white'}
                           btn-close-sm ms-1 flex-shrink-0"></button>
        </div>`;
    document.getElementById('toastContainer').insertAdjacentHTML('beforeend', html);
    setTimeout(() => document.getElementById(id)?.remove(), duration);
}

// ── Confirmation modal (returns Promise<bool>) ─────────────────────────────
function showConfirm(title, message, confirmLabel = 'Confirm', confirmClass = 'btn-primary') {
    return new Promise(resolve => {
        const id  = 'cfm_' + Date.now();
        document.body.insertAdjacentHTML('beforeend', `
            <div class="modal fade" id="${id}" tabindex="-1" data-bs-backdrop="static">
                <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
                    <div class="modal-content">
                        <div class="modal-header border-0 pb-0">
                            <h6 class="modal-title fw-bold">${title}</h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body pt-2 text-muted small">
                                <div class="col-12">
                    <div class="card">
                        <div class="card-body">${message}</div></div></div></div>
                        <div class="modal-footer border-0 pt-0 gap-2 py-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary mt-2"
                                    data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-sm ${confirmClass} mt-2"
                                    id="${id}_ok">${confirmLabel}</button>
                        </div>
                    </div>
                </div>
            </div>`);
        const el  = document.getElementById(id);
        const bsm = new bootstrap.Modal(el);
        bsm.show();
        document.getElementById(id + '_ok').onclick = () => { bsm.hide(); resolve(true); };
        el.addEventListener('hidden.bs.modal', () => { el.remove(); resolve(false); }, { once: true });
    });
}

// ── Anti-forgery token ─────────────────────────────────────────────────────
function getToken() {
    return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
}

// ── Row busy state ─────────────────────────────────────────────────────────
function setRowBusy(fileId, busy) {
    const row  = document.querySelector(`tr[data-fileid="${fileId}"]`);
    if (!row) return;
    const cell = row.querySelector('td:last-child');
    if (!cell) return;
    if (busy) {
        cell.dataset.saved = cell.innerHTML;
        cell.innerHTML = `<div class="d-flex justify-content-end pe-2">
            <span class="spinner-border spinner-border-sm text-primary"></span></div>`;
    } else if (cell.dataset.saved) {
        cell.innerHTML = cell.dataset.saved;
    }
}

// ── Assigned cell inline update ────────────────────────────────────────────
function updateAssignedCell(fileId, name, isMe) {
    const row  = document.querySelector(`tr[data-fileid="${fileId}"]`);
    if (!row) return;
    const cell = row.querySelectorAll('td')[2];
    if (!cell || !cell.classList.contains('assigned-cell')) return;
    if (!name) {
        cell.innerHTML = `<span class="text-muted small">
            <i class="bx bx-user-x me-1"></i>Unassigned</span>`;
        return;
    }
    const init = name.charAt(0).toUpperCase();
    cell.innerHTML = `
        <div class="d-flex align-items-center gap-2">
            <span class="avatar avatar-xs flex-shrink-0">
                <span class="avatar-initial rounded-circle
                             bg-label-${isMe?'primary':'secondary'} small fw-semibold">
                    ${init}
                </span>
            </span>
            <div class="lh-sm overflow-hidden">
                <div class="small fw-semibold ${isMe?'text-primary':'text-body'} text-truncate"
                     style="max-width:95px;">${isMe ? 'You' : name}</div>
                ${isMe ? '<span class="badge bg-label-primary" style="font-size:.6rem;">Mine</span>' : ''}
            </div>
        </div>`;
}

