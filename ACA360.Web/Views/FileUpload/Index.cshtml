// ── Bulk actions (idea #20) ────────────────────────────────────────────────
// Each picked file goes through the same action its own button uses, one after another.
BulkSelect.init({ root: '#fileTableContainer', bar: '[data-bulk-bar]' });
$('[data-bulk-bar]').on('bulk:changed', function () {
    $(this).find('[data-archive-label]').text(currentState.viewMode === 'Archived' ? 'Unarchive' : 'Archive');
});
$(document).on('click', '[data-files-bulk]', async function () {
    const action = this.dataset.filesBulk;
    const picked = BulkSelect.selected();
    const $progress = $('[data-bulk-progress]');
    let items = picked, verb = 'done', worker = null;

    if (action === 'assign') {
        items = picked.filter(cb => cb.dataset.assign === '1');
        if (!items.length) { showToast('warning', 'None of the selected files can be assigned now.'); return; }
        const pick = await pickAnalyst('');
        if (!pick) return;
        verb = 'assigned to ' + pick.name;
        worker = cb => $.post('/FileUpload/AssignFile', { fileLogId: cb.value, targetUserId: pick.id, __RequestVerificationToken: getToken() });
    } else if (action === 'hold' || action === 'release') {
        items = picked.filter(cb => cb.dataset.hold === action);
        if (!items.length) { showToast('warning', action === 'hold' ? 'None of the selected files can be put on hold.' : 'None of the selected files is on hold.'); return; }
        verb = action === 'hold' ? 'put on hold' : 'released';
        worker = cb => $.post('/FileUpload/ToggleHold', { fileLogId: cb.value, __RequestVerificationToken: getToken() });
    } else if (action === 'archive') {
        verb = currentState.viewMode === 'Archived' ? 'unarchived' : 'archived';
        worker = cb => $.post('/FileUpload/ToggleArchive', { fileLogId: cb.value, __RequestVerificationToken: getToken() });
    } else if (action === 'report') {
        items = picked.filter(cb => cb.dataset.report === '1');
        if (!items.length) { showToast('warning', 'None of the selected files has a validation report.'); return; }
        verb = 'downloaded';
        worker = async cb => { await downloadValidationReport('/FileUpload/DownloadReport?fileLogId=' + cb.value, 'ValidationReport_' + cb.value + '.xlsx'); return { success: true }; };
    }
    if (!worker) return;
    if (items.length < picked.length && action !== 'report')
        $progress.text((picked.length - items.length) + ' of the selected files are left out: that action does not apply to them.');

    $('[data-files-bulk]').prop('disabled', true);
    const result = await BulkSelect.runEach(items, worker, (done, total) => $progress.text('Working… ' + done + ' of ' + total));
    $('[data-files-bulk]').prop('disabled', false);
    $progress.text('');
    // showToast writes HTML; names and server messages are text.
    showToast(result.failed ? 'warning' : 'success', $('<div>').text(BulkSelect.summary(result, verb) + '.').html());
    if (action !== 'report') loadFileData(currentState.page, true);
});

// ── Column mapping (script 073) ───────────────────────────────────────────
function openColumnMapping(fileId) {
    const $body = $('#columnMappingBody');
    $body.html('<div class="text-center py-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading</span></div></div>');
    bootstrap.Modal.getOrCreateInstance(document.getElementById('columnMappingModal')).show();
    $.get('/FileUpload/ColumnMapping', { id: fileId })
        .done(html => $body.html(html))
        .fail(xhr => $body.html($('<div class="alert alert-danger" role="alert"></div>').text((xhr.responseJSON && xhr.responseJSON.message) || 'The mapping could not be loaded.')));
}
$(document).on('click', '#columnMappingSave', function () {
    const $form = $('#columnMappingForm'); if (!$form.length) return;
    const $btn = $(this).prop('disabled', true);
    $.post('/FileUpload/SaveColumnMapping?id=' + $form.data('file-id'), $form.serialize())
        .done(r => {
            bootstrap.Modal.getOrCreateInstance(document.getElementById('columnMappingModal')).hide();
            showToast('success', r.message);
            loadFileData(currentState.page, true);
        })
        .fail(xhr => $form.find('[data-map-status]').addClass('text-danger').text((xhr.responseJSON && xhr.responseJSON.message) || 'Not saved.'))
        .always(() => $btn.prop('disabled', false));
});
$(document).on('click', '[data-delete-map]', function () {
    const $form = $('#columnMappingForm'), mapId = $(this).data('delete-map');
    $.post('/FileUpload/DeleteColumnMapping', { id: $form.data('file-id'), mapId: mapId, __RequestVerificationToken: $form.find('input[name="__RequestVerificationToken"]').val() })
        .done(() => $form.find('[data-saved-map="' + mapId + '"]').remove())
        .fail(() => $form.find('[data-map-status]').addClass('text-danger').text('The mapping could not be removed.'));
});

