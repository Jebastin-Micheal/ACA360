function runAnalysis(fileId) {
    currentFileId = fileId;
    $('#analysisContent').addClass('d-none');
    $('#analysisLoading').show();
    new bootstrap.Modal(document.getElementById('analysisModal')).show();
    $.get('/FileUpload/Analyze/' + fileId, function (res) {
        if (res.success) { renderAnalysis(res.data); }
        else {
            showToast('danger', 'Analysis failed: ' + res.message);
            bootstrap.Modal.getInstance(document.getElementById('analysisModal'))?.hide();
        }
    });
}

let impactChartInstance = null;
        let currentAnalysisData = null;
function renderAnalysis(data) {
            currentAnalysisData = data; // Save the data for the confirm step

            $('#analysisLoading').hide();
            $('#analysisContent').removeClass('d-none');

    const blocked  = data.errorRows || 0;
    const valBody  = $('#analysisValidationBody').empty();
    valBody.append(`<tr><td class="text-start ps-3"><i class="bx bxs-check-circle text-success me-2"></i>Clean</td><td class="fw-bold">${data.cleanRows}</td><td class="text-success small">Ready</td></tr>`);
    if (data.warningRows > 0)
        valBody.append(`<tr><td class="text-start ps-3"><i class="bx bxs-error text-warning me-2"></i>Warnings</td><td class="fw-bold">${data.warningRows}</td><td class="text-success small">Ready</td></tr>`);
    if (blocked > 0)
        valBody.append(`<tr class="table-danger"><td class="text-start ps-3 text-danger"><i class="bx bxs-x-circle me-2"></i>Errors</td><td class="fw-bold text-danger">${blocked}</td><td class="text-danger small fw-bold">HELD</td></tr>`);

    const ctx = document.getElementById('impactChart').getContext('2d');
    if (impactChartInstance) impactChartInstance.destroy();
    impactChartInstance = new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels:   ['Clean', 'Warnings', 'Errors'],
            datasets: [{ data: [data.cleanRows, data.warningRows, blocked],
                         backgroundColor: ['#71dd37','#ffab00','#ff3e1d'], borderWidth: 0 }]
        },
        options: { responsive: true, maintainAspectRatio: false,
                   plugins: { legend: { position: 'bottom', labels: { boxWidth: 10 } } } }
    });

    const entityBody = $('#analysisEntityBody').empty();
    if (data.entityStats?.length > 0) {
        const icons = { Employer:'bx-building', Employee:'bx-user', Plan:'bx-id-card',
                        Premium:'bx-dollar', Dependent:'bx-face' };
        data.entityStats.forEach(item => {
            const ic = icons[item.entityType] || 'bx-cube';
            entityBody.append(`
                <tr>
                    <td class="ps-3 fw-semibold"><i class="bx ${ic} me-2 text-primary"></i>${item.entityType}</td>
                    <td class="text-center">${item.inserts>0?`<span class="badge bg-label-success">+${item.inserts}</span>`:'<span class="text-muted">-</span>'}</td>
                    <td class="text-center">${item.updates>0?`<span class="badge bg-label-warning">${item.updates}</span>`:'<span class="text-muted">-</span>'}</td>
                    <td class="text-center text-muted">${item.skips}</td>
                    <td class="text-center fw-bold">${item.total}</td>
                </tr>`);
        });
    } else {
        entityBody.append('<tr><td colspan="5" class="text-center py-3 text-muted">No database changes detected.</td></tr>');
    }
}

        async function confirmImport() {
                    
            const data = currentAnalysisData;
                    // alert(JSON.stringify(currentAnalysisData));
                    //                         alert(data.planYear);
                    // return;
            const mode = $('input[name="importMode"]:checked').val();
            
            if (!data) return;

            // 1. YEAR WARNING
            const currentYear = new Date().getFullYear();
            // Assuming a valid year is > 2000. Adjust as needed for your business logic.
            if (data.planYear > 2000 && data.planYear !== currentYear) {
                const proceedYear = await showConfirm(
                    'Confirm Filing Year',
                    `Are you sure you want to load data to a previous year (${data.planYear})? You must select Yes before the data will upload.`,
                    'Yes',
                    'btn-primary'
                );
                if (!proceedYear) return; // User clicked Cancel
            }

            // 2. RECORD COUNT WARNING
            if (data.errorRows > 0) {
                const proceedCount = await showConfirm(
                    'Upload Warning',
                    `<div class="d-flex align-items-center gap-3">
                        <i class="bx bx-error text-warning" style="font-size: 2.5rem;"></i>
                        <span><strong>${data.errorRows} records will not upload</strong> (only ${data.cleanRows} records will upload). Are you sure you would like to continue?</span>
                     </div>`,
                    'Yes',
                    'btn-warning'
                );
                if (!proceedCount) return; // User clicked Cancel
            }

            // 3. OVERWRITE WARNING (Your existing logic)
            if (mode === 'Overwrite') {
                const ok = await showConfirm(
                    'Overwrite Mode',
                    '<strong>This will DELETE existing data</strong> for this Employer/Year before importing. Are you sure?',
                    'Yes, Overwrite',
                    'btn-danger'
                );
                if (ok) executeImport(mode);
            } else {
                executeImport(mode);
            }
        }

function executeImport(mode) {
    bootstrap.Modal.getInstance(document.getElementById('analysisModal'))?.hide();
    showPageLoader(true);
    $.post('/FileUpload/ImportData', {
        FileLogId: currentFileId, ImportMode: mode, __RequestVerificationToken: getToken()
    })
                .done(function (res) {
                showPageLoader(false);
                if (res.success) {
                    // The import now runs in the background. The row drops to an "Importing"
                    // spinner and the existing 10-second poller flips it to Complete, at which
                    // point the Receipt button appears and shows the summary that used to be
                    // returned here.
                    showToast('info', res.message || 'Import started.');
                    $('#analysisModal').modal('hide');
                    loadFileData(1);
                } else {
                    showToast('danger', res.message || 'Import failed.');
                }
            })
            .fail(function () { showPageLoader(false); showToast('danger', 'Could not start the import - server error.'); });
}

function viewImportReceipt(fileId) {
    showPageLoader(true);
    $.get('/FileUpload/GetImportStatus/' + fileId)
     .done(function (res) { showPageLoader(false); if (res.success) showReceipt(res.data); else showToast('danger', res.message); })
     .fail(function ()    { showPageLoader(false); showToast('danger', 'Failed to load receipt.'); });
}

function showReceipt(data) {
            if (!data) return;
            const fmt = new Intl.NumberFormat('en-US', { style:'currency', currency:'USD' });
    $('#receiptContentArea').html(`
        <div class="row g-3 mb-4 text-start">
            <div class="col-6 col-md-4"><div class="p-3 border rounded bg-light h-100"><div class="d-flex align-items-center mb-2"><span class="badge bg-label-primary p-2 me-2"><i class="bx bx-user"></i></span><small class="text-uppercase text-muted fw-bold">Employees</small></div><h4 class="mb-0 text-primary">${data.totalEmployees}</h4><small class="text-muted">Active</small></div></div>
            <div class="col-6 col-md-4"><div class="p-3 border rounded bg-light h-100"><div class="d-flex align-items-center mb-2"><span class="badge bg-label-info p-2 me-2"><i class="bx bx-face"></i></span><small class="text-uppercase text-muted fw-bold">Dependents</small></div><h4 class="mb-0 text-info">${data.dependentRows||0}</h4><small class="text-muted">Covered</small></div></div>
            <div class="col-6 col-md-4"><div class="p-3 border rounded bg-light h-100"><div class="d-flex align-items-center mb-2"><span class="badge bg-label-success p-2 me-2"><i class="bx bx-check-shield"></i></span><small class="text-uppercase text-muted fw-bold">Enrollments</small></div><h4 class="mb-0 text-success">${data.enrollmentRows}</h4><small class="text-muted">Coverage</small></div></div>
            <div class="col-6 col-md-4"><div class="p-3 border rounded bg-light h-100"><div class="d-flex align-items-center mb-2"><span class="badge bg-label-warning p-2 me-2"><i class="bx bx-file"></i></span><small class="text-uppercase text-muted fw-bold">Plans</small></div><h4 class="mb-0 text-warning">${data.planCount}</h4></div></div>
            <div class="col-6 col-md-4"><div class="p-3 border rounded bg-light h-100"><div class="d-flex align-items-center mb-2"><span class="badge bg-label-secondary p-2 me-2"><i class="bx bx-purchase-tag"></i></span><small class="text-uppercase text-muted fw-bold">Premiums</small></div><h4 class="mb-0 text-secondary">${data.premiumRows||0}</h4></div></div>
            <div class="col-6 col-md-4"><div class="p-3 border rounded bg-light h-100"><div class="d-flex align-items-center mb-2"><span class="badge bg-label-success p-2 me-2"><i class="bx bx-dollar"></i></span><small class="text-uppercase text-muted fw-bold">Payroll</small></div><h5 class="mb-0 text-success text-truncate" title="${fmt.format(data.totalPayrollImported||0)}">${fmt.format(data.totalPayrollImported||0)}</h5></div></div>
        </div>`);
            // Check if the warning box should be shown (Your existing logic)
            const msg = $('#rcpt_Message').removeClass('alert-success alert-warning alert-danger');
            msg.find('span').text(data.validationMessage || 'Import complete.');
            msg.addClass(data.isImportComplete ? 'alert-success' : 'alert-warning');
            if (data.enrollmentRows < (data.totalEmployees * 0.5)) {
                msg.removeClass('alert-success').addClass('alert-warning');
                msg.find('span').html(`<strong>Warning:</strong> Only ${data.enrollmentRows} employees have coverage records. Check your mapping.`);
            }

            // NEW: Inject a container for the detailed upload log
            $('#receiptContentArea').append(`
                <hr class="my-4" />
                <h5 class="text-start mb-3"><i class="bx bx-list-ul me-2"></i>Detailed Upload Results</h5>
                <div class="detailed-log-container p-0" id="receiptDetailedLogs">
                    <div class="p-3 text-center text-muted">
                        <span class="spinner-border spinner-border-sm me-2"></span>Loading detailed results...
                    </div>
                </div>
            `);

            new bootstrap.Modal(document.getElementById('receiptModal')).show();

            // Fetch the detailed logs and color code them
            $.get('/FileUpload/GetProcessingLogs/' + currentFileId)
                .done(function (html) {
                    // Because GetProcessingLogs returns the full modal HTML (from _ProcessingLogsPartial),
                    // we will extract just the list items from it.
                    const logItems = $(html).find('.list-group-item');

                    if (logItems.length === 0) {
                        $('#receiptDetailedLogs').html(`
                            <div class="p-3 log-item-success fw-bold">
                                <i class="bx bx-check-circle me-2"></i>Done! All records processed successfully without errors.
                            </div>
                        `);
                        return;
                    }

                    let logHtml = '<div class="list-group list-group-flush">';
                    logHtml += `<div class="list-group-item bg-light text-muted small">Starting Validation Process...</div>`;

                    logItems.each(function() {
                        const item = $(this);
                        const text = item.text().trim();

                        // Determine if this is an error or a success/warning based on your existing classes
                        const isError = item.hasClass('list-group-item-danger') || text.toLowerCase().includes('error') || text.toLowerCase().includes('incorrect');

                        const cssClass = isError ? 'log-item-error' : 'log-item-success';
                        const icon = isError ? 'bx-x-circle' : 'bx-check-circle';

                        logHtml += `
                            <div class="list-group-item px-3 py-2 ${cssClass} fw-semibold" style="font-size: 0.85rem;">
                                <i class="bx ${icon} me-2"></i>${text}
                            </div>
                        `;
                    });

                    logHtml += `<div class="list-group-item bg-light text-muted small fw-bold">Done!</div>`;
                    logHtml += '</div>';

                    $('#receiptDetailedLogs').html(logHtml);
                })
                .fail(function () {
                    $('#receiptDetailedLogs').html('<div class="p-3 text-danger">Failed to load detailed logs.</div>');
                });
}
</script>
}