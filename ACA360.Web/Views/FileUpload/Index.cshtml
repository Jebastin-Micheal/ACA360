function toggleArchive(id) {
    $.post('/FileUpload/ToggleArchive', {
        fileLogId: id, __RequestVerificationToken: getToken()
    })
    .done(function (res) {
        if (res.success) { showToast('success', 'Archive status updated.'); loadFileData(currentState.page); }
        else             { showToast('danger', 'Archive failed: ' + res.message); }
    })
    .fail(function () { showToast('danger', 'Server error — archive not saved.'); });
}

function restoreFile(id) {
    showConfirm('Restore File', 'Move this file back to Active?', 'Restore', 'btn-success')
    .then(ok => {
        if (!ok) return;
        $.post('/FileUpload/RestoreFile', { fileLogId: id, __RequestVerificationToken: getToken() })
         .done(function () { showToast('success', 'File restored.'); loadFileData(currentState.page); })
         .fail(function () { showToast('danger', 'Restore failed.'); });
    });
}

function hardDelete(id) {
    showConfirm('Permanent Delete',
        '<strong>This cannot be undone.</strong> The file and all associated data will be permanently removed.',
        'Delete Forever', 'btn-danger')
    .then(ok => {
        if (!ok) return;
        $.post('/FileUpload/PermanentDelete', { fileLogId: id, __RequestVerificationToken: getToken() })
         .done(function () { showToast('success', 'File permanently deleted.'); loadFileData(currentState.page); })
         .fail(function () { showToast('danger', 'Delete failed.'); });
    });
}

