// ══════════════════════════════════════════════════════════════════════════════
// TOAST NOTIFICATION SYSTEM
// ══════════════════════════════════════════════════════════════════════════════
function showToast(type, message, duration = 4500) {
    const icons = { success:'bx-check-circle', danger:'bx-error-circle',
                    warning:'bx-error',         info:'bx-info-circle' };
    const bgMap = { success:'#198754', danger:'#dc3545', warning:'#ffc107', info:'#0dcaf0' };
    const txMap = { success:'#fff',    danger:'#fff',    warning:'#000',     info:'#000' };
    const id    = 'toast_' + Date.now();
    const html  = `
        <div id="${id}"
             class="d-flex align-items-center gap-2 px-3 py-2 rounded shadow"
             style="background:${bgMap[type]||bgMap.info};color:${txMap[type]||'#fff'};
                    animation:slideInRight .25s ease;min-width:260px;">
            <i class="bx ${icons[type]||'bx-bell'} fs-5 flex-shrink-0"></i>
            <span class="small flex-grow-1">${message}</span>
            <button onclick="document.getElementById('${id}').remove()"
                    class="btn-close ${type==='warning'||type==='info' ? '' : 'btn-close-white'}
                           btn-close-sm ms-1 flex-shrink-0"></button>
        </div>`;
    document.getElementById('toastContainer').insertAdjacentHTML('beforeend', html);
    setTimeout(() => document.getElementById(id)?.remove(), duration);
}

// ── Confirmation modal (returns Promise<bool>) ─────────────────────────────
function showConfirm(title, message, confirmLabel = 'Confirm', confirmClass = 'btn-primary') {
    return new Promise(resolve => {
        const id  = 'cfm_' + Date.now();
        document.body.insertAdjacentHTML('beforeend', `
            <div class="modal fade" id="${id}" tabindex="-1" data-bs-backdrop="static">
                <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
                    <div class="modal-content">
                        <div class="modal-header border-0 pb-0">
                            <h6 class="modal-title fw-bold">${title}</h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body pt-2 text-muted small">
                                <div class="col-12">
                    <div class="card">
                        <div class="card-body">${message}</div></div></div></div>
                        <div class="modal-footer border-0 pt-0 gap-2 py-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary mt-2"
                                    data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-sm ${confirmClass} mt-2"
                                    id="${id}_ok">${confirmLabel}</button>
                        </div>
                    </div>
                </div>
            </div>`);
        const el  = document.getElementById(id);
        const bsm = new bootstrap.Modal(el);
        bsm.show();
        document.getElementById(id + '_ok').onclick = () => { bsm.hide(); resolve(true); };
        el.addEventListener('hidden.bs.modal', () => { el.remove(); resolve(false); }, { once: true });
    });
}

// ── Modal with a reason box (returns Promise<string|null>; null = cancelled) ──
function showReasonPrompt(title, message, confirmLabel, confirmClass, placeholder) {
    return new Promise(resolve => {
        const id = 'rsn_' + Date.now();
        document.body.insertAdjacentHTML('beforeend', `
            <div class="modal fade" id="${id}" tabindex="-1" data-bs-backdrop="static">
                <div class="modal-dialog modal-dialog-centered" style="max-width:460px;">
                    <div class="modal-content">
                        <div class="modal-header border-0 pb-0">
                            <h6 class="modal-title fw-bold"></h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body pt-2">
                            <div class="col-12"><div class="card"><div class="card-body">
                                <p class="text-muted small mb-2 js-msg"></p>
                                <textarea class="form-control form-control-sm" rows="3" maxlength="500"></textarea>
                            </div></div></div>
                        </div>
                        <div class="modal-footer border-0 pt-0 gap-2 py-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-sm ${confirmClass} js-ok"></button>
                        </div>
                    </div>
                </div>
            </div>`);
        const el = document.getElementById(id);
        el.querySelector('.modal-title').textContent = title;
        el.querySelector('.js-msg').textContent = message;
        el.querySelector('textarea').placeholder = placeholder || 'Reason (optional)';
        el.querySelector('.js-ok').textContent = confirmLabel;
        const bsm = new bootstrap.Modal(el);
        let result = null;
        el.querySelector('.js-ok').onclick = () => { result = el.querySelector('textarea').value.trim(); bsm.hide(); };
        el.addEventListener('shown.bs.modal', () => el.querySelector('textarea').focus(), { once: true });
        el.addEventListener('hidden.bs.modal', () => { el.remove(); resolve(result); }, { once: true });
        bsm.show();
    });
}

// ── Analyst picker for reassigning (returns Promise<{id,name}|null>) ────────
const DATA_ANALYSTS = @Json.Serialize(((List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.DataAnalysts ?? new()).Select(a => new { id = a.Value, name = a.Text }));
function pickAnalyst(currentId) {
    return new Promise(resolve => {
        const id = 'pick_' + Date.now();
        document.body.insertAdjacentHTML('beforeend', `
            <div class="modal fade" id="${id}" tabindex="-1" data-bs-backdrop="static">
                <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
                    <div class="modal-content">
                        <div class="modal-header border-0 pb-0">
                            <h6 class="modal-title fw-bold">Reassign analyst</h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body pt-2">
                            <div class="col-12"><div class="card"><div class="card-body">
                                <p class="text-muted small mb-2">The file moves to the analyst you choose. Its data and progress are kept.</p>
                                <select class="form-select form-select-sm"></select>
                            </div></div></div>
                        </div>
                        <div class="modal-footer border-0 pt-0 gap-2 py-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-sm btn-primary js-ok">Reassign</button>
                        </div>
                    </div>
                </div>
            </div>`);
        const el = document.getElementById(id);
        const sel = el.querySelector('select');
        // The current assignee may not be a Data Analyst (e.g. an admin who uploaded it);
        // then nothing is preselected rather than silently showing the first analyst.
        if (!DATA_ANALYSTS.some(a => String(a.id) === String(currentId))) {
            const ph = new Option('Choose an analyst…', '', true, true);
            ph.disabled = true;
            sel.add(ph);
        }
        DATA_ANALYSTS.forEach(a => {
            const o = new Option(a.name, a.id, false, String(a.id) === String(currentId));
            sel.add(o);
        });
        const bsm = new bootstrap.Modal(el);
        let result = null;
        el.querySelector('.js-ok').onclick = () => {
            if (!sel.value) { sel.focus(); return; }                           // nothing chosen yet
            if (String(sel.value) === String(currentId)) { bsm.hide(); return; } // no change
            result = { id: sel.value, name: sel.options[sel.selectedIndex].text };
            bsm.hide();
        };
        el.addEventListener('hidden.bs.modal', () => { el.remove(); resolve(result); }, { once: true });
        bsm.show();
    });
}

// ── Anti-forgery token ─────────────────────────────────────────────────────
function getToken() {
    return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
}

// ── Row busy state ─────────────────────────────────────────────────────────
function setRowBusy(fileId, busy) {
    const row  = document.querySelector(`tr[data-fileid="${fileId}"]`);
    if (!row) return;
    const cell = row.querySelector('td:last-child');
    if (!cell) return;
    if (busy) {
        cell.dataset.saved = cell.innerHTML;
        cell.innerHTML = `<div class="d-flex justify-content-end pe-2">
            <span class="spinner-border spinner-border-sm text-primary"></span></div>`;
    } else if (cell.dataset.saved) {
        cell.innerHTML = cell.dataset.saved;
    }
}

// ── Assigned cell inline update ────────────────────────────────────────────
function updateAssignedCell(fileId, name, isMe) {
    const row  = document.querySelector(`tr[data-fileid="${fileId}"]`);
    if (!row) return;
    const cell = row.querySelectorAll('td')[2];
    if (!cell || !cell.classList.contains('assigned-cell')) return;
    if (!name) {
        cell.innerHTML = `<span class="text-muted small">
            <i class="bx bx-user-x me-1"></i>Unassigned</span>`;
        return;
    }
    const init = name.charAt(0).toUpperCase();
    cell.innerHTML = `
        <div class="d-flex align-items-center gap-2">
            <span class="avatar avatar-xs flex-shrink-0">
                <span class="avatar-initial rounded-circle
                             bg-label-${isMe?'primary':'secondary'} small fw-semibold">
                    ${init}
                </span>
            </span>
            <div class="lh-sm overflow-hidden">
                <div class="small fw-semibold ${isMe?'text-primary':'text-body'} text-truncate"
                     style="max-width:95px;">${isMe ? 'You' : name}</div>
                ${isMe ? '<span class="badge bg-label-primary" style="font-size:.6rem;">Mine</span>' : ''}
            </div>
        </div>`;
}

// ══════════════════════════════════════════════════════════════════════════════
// ASSIGNMENT ACTIONS (delegated — survive AJAX reloads)
// ══════════════════════════════════════════════════════════════════════════════

// Manager assign dropdown
document.addEventListener('change', function (e) {
    if (!e.target.classList.contains('assign-select')) return;
    const fileId = parseInt(e.target.dataset.fileid);
    const userId = e.target.value;
    const name   = e.target.options[e.target.selectedIndex]?.text;
    const sel    = e.target;
    sel.disabled = true;

    if (!userId) { unassignFile(fileId, sel); return; }

    $.post('/FileUpload/AssignFile', {
        fileLogId: fileId, targetUserId: userId,
        __RequestVerificationToken: getToken()
    })
    .done(function (res) {
        if (res.success) {
            showToast('success', res.message || 'File assigned.');
            updateAssignedCell(fileId, name, false);
            // Assigning starts validation in the background: reload so the row shows
            // "Validating" and the poller picks it up.
            loadFileData(currentState.page, true, { flashIds: [fileId] });
        } else {
            showToast('danger', res.message || 'Assignment failed.');
            sel.value = '';
        }
    })
    .fail(function () { showToast('danger', 'Server error. Assignment not saved.'); sel.value = ''; })
    .always(function () { sel.disabled = false; });
});

// DA Accept
document.addEventListener('click', async function (e) {
    const btn = e.target.closest('.btn-accept');
    if (!btn) return;
    const fileId = parseInt(btn.dataset.fileid);
    const ok = await showConfirm('Accept File',
        'You will be assigned this file and processing will begin immediately.',
        'Accept & Start', 'btn-primary');
    if (!ok) return;
    setRowBusy(fileId, true);
    $.post('/FileUpload/AcceptFile', {
        fileLogId: fileId, __RequestVerificationToken: getToken()
    })
    .done(function (res) {
        if (res.success) { showToast('success', 'File accepted. Processing started.'); loadFileData(currentState.page, true); }
        else             { showToast('danger', res.message); setRowBusy(fileId, false); }
    })
    .fail(function ()  { showToast('danger', 'Server error.'); setRowBusy(fileId, false); });
});

// Release / force unassign
document.addEventListener('click', async function (e) {
    const btn = e.target.closest('.btn-release');
    if (!btn) return;
    const fileId = parseInt(btn.dataset.fileid);
    const ok = await showConfirm('Release File',
        'This file will be returned to the unassigned pool.',
        'Release', 'btn-warning');
    if (!ok) return;
    unassignFile(fileId);
});

// Reassign (⋮ menu)
document.addEventListener('click', async function (e) {
    const btn = e.target.closest('.btn-reassign');
    if (!btn) return;
    const fileId = parseInt(btn.dataset.fileid);
    const pick = await pickAnalyst(btn.dataset.current);
    if (!pick) return;
    setRowBusy(fileId, true);
    $.post('/FileUpload/AssignFile', {
        fileLogId: fileId, targetUserId: pick.id, __RequestVerificationToken: getToken()
    })
    .done(function (res) {
        if (res.success) { showToast('success', 'Reassigned to ' + pick.name + '.'); loadFileData(currentState.page, true, { flashIds: [fileId] }); }
        else             { showToast('danger', res.message || 'Reassignment failed.'); setRowBusy(fileId, false); }
    })
    .fail(function () { showToast('danger', 'Server error. Reassignment not saved.'); setRowBusy(fileId, false); });
});

// Put on hold / release hold. These buttons existed but nothing handled them.
document.addEventListener('click', async function (e) {
    const btn = e.target.closest('.btn-toggle-hold');
    if (!btn) return;
    const fileId = parseInt(btn.dataset.fileid);
    const releasing = btn.dataset.isOnHold === 'true';
    let reason = '';
    if (releasing) {
        if (!await showConfirm('Release hold', 'The file goes back to the queue and needs an analyst again.', 'Release hold', 'btn-primary')) return;
    } else {
        reason = await showReasonPrompt('Put file on hold', 'Processing stops until someone releases the hold.', 'Put on hold', 'btn-warning', 'Why is it on hold? (optional)');
        if (reason === null) return;
    }
    setRowBusy(fileId, true);
    $.post('/FileUpload/ToggleHold', { fileLogId: fileId, reason: reason, __RequestVerificationToken: getToken() })
    .done(function (res) {
        if (res.success) { showToast('info', res.isOnHold ? 'File put on hold.' : 'Hold released.'); loadFileData(currentState.page, true, { flashIds: [fileId] }); }
        else             { showToast('danger', res.message || 'Could not change the hold.'); setRowBusy(fileId, false); }
    })
    .fail(function () { showToast('danger', 'Server error.'); setRowBusy(fileId, false); });
});

// Reject (⋮ menu). Also existed with no handler.
document.addEventListener('click', async function (e) {
    const btn = e.target.closest('.btn-reject-da');
    if (!btn) return;
    const fileId = parseInt(btn.dataset.fileid);
    const reason = await showReasonPrompt('Reject file', 'A rejected file cannot be imported. The uploader will need to send a corrected file.', 'Reject file', 'btn-danger', 'Reason for rejecting (shown in the timeline)');
    if (reason === null) return;
    setRowBusy(fileId, true);
    $.post('/FileUpload/RejectFile', { fileLogId: fileId, reason: reason, __RequestVerificationToken: getToken() })
    .done(function (res) {
        if (res.success) { showToast('info', 'File rejected.'); loadFileData(currentState.page, true, { flashIds: [fileId] }); }
        else             { showToast('danger', res.message || 'Could not reject the file.'); setRowBusy(fileId, false); }
    })
    .fail(function () { showToast('danger', 'Server error.'); setRowBusy(fileId, false); });
});

function unassignFile(fileId) {
    setRowBusy(fileId, true);
    $.post('/FileUpload/UnassignFile', {
        fileLogId: fileId, __RequestVerificationToken: getToken()
    })
    .done(function (res) {
        if (res.success) {
            showToast('info', 'File returned to unassigned pool.');
            updateAssignedCell(fileId, null, false);
            loadFileData(currentState.page, true);
        } else {
            showToast('danger', res.message);
            setRowBusy(fileId, false);
        }
    })
    .fail(function () { showToast('danger', 'Server error.'); setRowBusy(fileId, false); });
}

