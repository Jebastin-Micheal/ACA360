@* ─────────────────────────────────────────────────────────────────────────────
   @section Scripts — FULL REPLACEMENT
   ──────────────────────────────────────────────────────────────────────────── 
*@

@section Scripts {
<script src="~/js/local-time.js" asp-append-version="true"></script>
<script src="~/js/import-analysis.js" asp-append-version="true"></script>
<script src="~/js/bulk-select.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<style>
@@keyframes slideInRight {
    from { transform: translateX(110%); opacity: 0; }
    to   { transform: translateX(0);   opacity: 1; }
}
</style>

<script>
// ══════════════════════════════════════════════════════════════════════════════
// GLOBAL STATE
// ══════════════════════════════════════════════════════════════════════════════
var currentFileId = 0;
var currentState  = { page: 1, viewMode: 'Active' };

// ══════════════════════════════════════════════════════════════════════════════
// AREA 4 — FILTER BAR & METRIC CARDS
// ══════════════════════════════════════════════════════════════════════════════

$(document).ready(function () {

    // ── Date range picker ──────────────────────────────────────────────────
    flatpickr('#dateRangePicker', {
        mode: 'range',
        dateFormat: 'Y-m-d',
        onChange: function (dates) {
            if (dates.length === 2) loadFileData(1);
        },
        onReady: function () {
            // Clear button inside the date input
            $('#dateRangePicker').after(
                '<span class="date-clear-btn" title="Clear date filter" ' +
                'style="cursor:pointer;position:absolute;right:32px;top:50%;' +
                'transform:translateY(-50%);color:var(--bs-secondary-color);' +
                'display:none;font-size:16px;">&#x2715;</span>'
            );
        },
        onChange: function (dates, str) {
            if (dates.length === 2) {
                $('#dateRangePicker').next('.date-clear-btn').show();
                loadFileData(1);
            }
        }
    });

    // Clear date filter
    $(document).on('click', '.date-clear-btn', function () {
        $('#dateRangePicker')[0]._flatpickr.clear();
        $(this).hide();
        loadFileData(1);
    });

    // ── Status filter chips ────────────────────────────────────────────────
    $(document).on('click', '.filter-chip', function () {
        applyQuickFilter($(this).data('filter'));
    });

    // ── My Files toggle ────────────────────────────────────────────────────
    $('#myFilesToggle').on('change', function () { loadFileData(1); });

    // ── Search with debounce ───────────────────────────────────────────────
    let debounceTimer;
    $('#searchInput').on('input', function () {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => loadFileData(1), 450);
    });

    // Clear search with Escape
    $('#searchInput').on('keydown', function (e) {
        if (e.key === 'Escape') { $(this).val(''); loadFileData(1); }
    });

    // ── Pagination ─────────────────────────────────────────────────────────
    $(document).on('click', '.page-link-btn', function () {
        var page = parseInt($(this).data('page'));
        if (!$(this).parent().hasClass('disabled')) loadFileData(page);
    });

    // ── Metric card clicks → quick filter ─────────────────────────────────
    // (Cards already have onclick="applyQuickFilter(...)" in markup — no extra wiring needed)

    // ── AREA 2: Start polling if any file is in processing state ──────────
    startStatusPoller();

    // Called by the upload modal when an upload is accepted. Refreshes the list in
    // place instead of reloading the page, so filters and scroll position survive.
    window.onFileUploaded = function () {
        // A brand-new file is always "working": make sure the current chip can show it.
        const f = $('#currentFilter').val();
        if (f !== 'All' && f !== 'Processing') applyQuickFilter('All');
        if (currentState.viewMode !== 'Active') switchView('Active');
        else loadFileData(1, true);
        showToast('success', 'File uploaded. It is being checked now; this list updates by itself.');
    };
});

// ── View mode tabs ─────────────────────────────────────────────────────────
function switchView(mode) {
    currentState.viewMode = mode;
    currentState.page     = 1;
    $('.nav-link').removeClass('active');
    $('#tab-' + mode).addClass('active');
    loadFileData(1);
}

// ── Filter chips ────────────────────────────────────────────────────────────
function applyQuickFilter(status) {
    $('.filter-chip').each(function () {
        $(this).removeClass('active btn-label-' + $(this).data('color')).addClass('btn-outline-secondary');
    });

    $('#currentFilter').val(status);

    const btn = $(`.filter-chip[data-filter='${status}']`);
    btn.removeClass('btn-outline-secondary').addClass('active btn-label-' + (btn.data('color') || 'primary'));

    loadFileData(1);
}

// ══════════════════════════════════════════════════════════════════════════════
// CORE DATA LOADER
// ══════════════════════════════════════════════════════════════════════════════
// options.flashIds: rows to briefly highlight after the reload (files that just changed state).
function loadFileData(page, silent = false, options = {}) {
    currentState.page = page || 1;
    if (!silent) showPageLoader(true);

    // A background refresh must not move the page under the user: remember which
    // employer group is open and where they are scrolled, and put both back.
    const openKeys = $('#filesAccordion .accordion-collapse.show').closest('.accordion-item')
        .map(function () { return $(this).data('group-key'); }).get();
    const scrollY = window.scrollY;

    $.get('/FileUpload/GetPaginatedData', {
        searchTerm:  $('#searchInput').val(),
        pageSize:    50,
        pageNumber:  currentState.page,
        filter:      $('#currentFilter').val() || 'All',
        showMyFiles: $('#myFilesToggle').is(':checked'),
        dateRange:   $('#dateRangePicker').val(),
        viewMode:    currentState.viewMode,
        sortColumn:  'UploadedAt',
        sortOrder:   'DESC'
    })
    .done(function (html) {
        $('#fileTableContainer').html(html);
        if (silent) {
            restoreOpenGroups(openKeys);
            window.scrollTo(0, scrollY);
        }
        (options.flashIds || []).forEach(function (id) {
            $('tr[data-fileid="' + id + '"]').addClass('row-flash');
        });
        refreshSummaryCards();
        markRefreshed();
        showPageLoader(false);
        // After refresh, restart poller in case processing state changed
        startStatusPoller();
    })
    .fail(function () {
        showPageLoader(false);
        if (!silent) showToast('danger', 'Failed to load file list. Please refresh.');
    });
}

// The partial opens the first group by default; reopen the user's group instead if it is still listed.
function restoreOpenGroups(keys) {
    if (!keys.length) return;
    const $items = $('#filesAccordion .accordion-item').filter(function () {
        return keys.indexOf($(this).data('group-key')) !== -1;
    });
    if (!$items.length) return;
    $('#filesAccordion .accordion-item').each(function () {
        const open = $items.is(this);
        $(this).toggleClass('active', open)
            .find('.accordion-collapse').first().toggleClass('show', open);
        $(this).find('.accordion-button').first().toggleClass('collapsed', !open).attr('aria-expanded', open);
    });
}

// "Updated 5s ago" next to the status chips, so a quiet page visibly isn't stale.
var _lastRefresh = Date.now();
function markRefreshed() { _lastRefresh = Date.now(); renderRefreshAge(); }
function renderRefreshAge() {
    const el = document.getElementById('liveUpdated');
    if (!el) return;
    const s = Math.round((Date.now() - _lastRefresh) / 1000);
    const age = s < 5 ? 'just now' : s < 60 ? s + 's ago' : Math.floor(s / 60) + ' min ago';
    el.querySelector('.js-age').textContent = age;
    el.classList.toggle('is-live', _pollerRunning);
}
setInterval(renderRefreshAge, 1000);

// The grid partial carries the card counts for the same rows it was drawn from.
function refreshSummaryCards() {
    const data = document.getElementById('statusCountsData');
    if (!data) return;
    $('#cardTotal').text(data.dataset.total);
    $('#cardAction').text(data.dataset.action);
    $('#cardProcessing').text(data.dataset.processing);
    $('#cardCompleted').text(data.dataset.completed);
}

function showPageLoader(show) {
    const loader = document.getElementById('loader');
    if (loader) loader.style.display = show ? 'flex' : 'none';
}

// ══════════════════════════════════════════════════════════════════════════════
// AREA 2 — STATUS AUTO-REFRESH POLLER
// Checks every 5 s whether any visible file is still processing.
// While a file works, only its status cell is updated (label, % bar, step text).
// When one finishes, the grid is reloaded silently — keeping the open group and
// scroll position — and the finished rows are briefly highlighted.
// ══════════════════════════════════════════════════════════════════════════════
var _pollerTimer   = null;
var _pollerRunning = false;
const POLL_MS      = 5000;

function startStatusPoller() {
    stopStatusPoller(); // clear any existing timer first

    // Count files currently showing a working spinner
    var processingRows = $('tr[data-fileid]').filter(function () {
        return $(this).find('.spinner-border').length > 0
            || $(this).find('.bx-spin').length > 0;
    });

    if (processingRows.length === 0) { renderRefreshAge(); return; } // nothing to poll

    _pollerRunning = true;
    _pollerTimer   = setInterval(pollProcessingFiles, POLL_MS);
    pollProcessingFiles(); // show real progress straight away, not after the first interval
    renderRefreshAge();
}

function stopStatusPoller() {
    if (_pollerTimer) { clearInterval(_pollerTimer); _pollerTimer = null; }
    _pollerRunning = false;
}

async function pollProcessingFiles() {
    // Collect IDs of rows still showing working state
    var ids = [];
    $('tr[data-fileid]').each(function () {
        var row = $(this);
        if (row.find('.spinner-border').length > 0 || row.find('.bx-spin').length > 0) {
            ids.push(parseInt(row.data('fileid')));
        }
    });

    if (ids.length === 0) {
        stopStatusPoller();
        return;
    }

    try {
        const resp = await fetch('/FileUpload/PollStatus?ids=' + ids.join(','),
                                 { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        if (resp.status === 401) {
            // Session ended: same handling as the layout's AJAX calls.
            window.location.href = '/Account/Login?ReturnUrl=' + encodeURIComponent(location.pathname + location.search);
            return;
        }
        if (!resp.ok) {
            // Do not fail silently. A broken poller looks exactly like a system
            // with nothing to report, which is how the tbl_UploadedFileLog typo
            // survived unnoticed.
            console.error('PollStatus failed:', resp.status, await resp.text());
            stopStatusPoller();
            return;
        }
        const results = await resp.json(); // array of { fileLogId, label, color, icon, isWorking, progress* }
        markRefreshed();
        if (!results.length) { stopStatusPoller(); return; } // rows no longer visible to this user

        // Finished files need a reload so their buttons are right (they can't safely
        // be rebuilt client-side); the reload keeps the user's place.
        const finished = results.filter(r => !r.isWorking).map(r => r.fileLogId);
        results.filter(r => r.isWorking).forEach(function (item) {
            updateStatusBadge(item.fileLogId, item.label, item.color, item.icon, item);
        });

        if (finished.length) {
            stopStatusPoller();
            loadFileData(currentState.page, true, { flashIds: finished });
        }
    } catch (err) {
        // Silent — polling errors should never surface as toasts
        console.warn('Status poll failed:', err);
    }
}

        function updateStatusBadge(fileLogId, label, color, icon, item) {
            var row = $('tr[data-fileid="' + fileLogId + '"]');
            if (!row.length) return;

            // Status badge is in the second <td>
            var statusCell = row.find('td').eq(1);
            var badge      = statusCell.find('.badge').first();
            if (!badge.length) return;

            // "Importing" on its own says nothing about how long is left. When the import
            // is running, sp_ProcessEmployerData reports which employer it is on, so show
            // that instead of an indeterminate spinner.
            var text = label;
            if (item && item.progressTotal > 0) {
                text = label + ' \u2014 ' + item.progressDone + ' of ' + item.progressTotal;
            }

            // Keep the spinner — just update the label if it changed
            badge.attr('class', 'badge bg-label-' + color);
            badge.html('<i class="bx ' + icon + ' bx-spin me-1"></i>' + text);

            // The full step text ("Calculated ATLANTIC COASTAL SERVICES LLC (2 of 3)",
            // "Reading Employee: 1,200 of 4,800 rows") goes under the bar and on the tooltip.
            var step = (item && item.progressStep) || '';
            if (step) badge.attr('title', step);
            statusCell.find('.js-work-step').text(step).attr('title', step);

            // A real percentage when the job reports one, otherwise a full striped bar.
            var pct = item && item.progressPercent != null ? Number(item.progressPercent) : null;
            statusCell.find('.js-work-bar').css('width', pct == null ? '100%' : Math.max(3, Math.min(100, pct)) + '%');
        }

