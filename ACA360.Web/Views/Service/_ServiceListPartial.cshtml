@using ACA360.Core.ViewModels
@model ServiceListViewModel
@{
    var metadata = Model?.Metadata;
    int countIndex = metadata != null ? ((metadata.CurrentPage - 1) * metadata.PageSize) + 1 : 1;
}
<div class="service-table-container ui-table-responsive">
    <table class="table table-bordered table-hover mb-0 ui-table">
        <thead>
            <tr class="align-middle">
                <th style="width: 60px;">#</th>
                <th class="cursor-pointer" onclick="sortGrid('ServiceName')">
                    Service Name @(Model.SortColumn == "ServiceName" ? (Model.SortOrder == "ASC" ? "▲" : "▼") : "")
                </th>
                <th>Description</th>
                <th class="cursor-pointer" style="width: 150px;" onclick="sortGrid('IsActive')">
                    Status @(Model.SortColumn == "IsActive" ? (Model.SortOrder == "ASC" ? "▲" : "▼") : "")
                </th>
                <th class="text-center" style="width: 120px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Services != null && Model.Services.Any())
            {
                foreach (var item in Model.Services)
                {
                    <tr>
                        <td class="text-muted">@(countIndex++)</td>
                        <td class="cursor-pointer text-primary" onclick="openModal(@item.ServiceId)">@item.ServiceName</td>
                        <td>@item.Description</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-label-success rounded-pill">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-label-secondary rounded-pill">Inactive</span>
                            }
                        </td>
                        <td class="text-center">
                            <button class="btn p-1 me-1" onclick="openModal(@item.ServiceId)" title="Edit Service">
                                <i class="icon-base bx bx-edit bg-info icon-sm fs-4 text-secondary"></i>
                            </button>
                            <a href="javascript:;" class="btn btn-icon dropdown-toggle hide-arrow action-dots-btn" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="icon-base bx bx-dots-vertical-rounded icon-md"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end m-0">
                                <a href="javascript:;" class="dropdown-item" onclick="deleteService(@item.ServiceId)">
                                    <i class="icon-base bx bx-trash bg-danger icon-md me-1"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-danger">No services found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@* Reuse the same common pagination partial used by Role / SalesRep *@
@await Html.PartialAsync("_GridPagination", Model.Metadata)
