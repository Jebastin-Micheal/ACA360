@model IEnumerable<ACA360.Core.Models.IrsDashboardItemDto>
@using ACA360.Web.ViewComponents

@{
    ViewData["Title"] = "IRS E-Filing Center";
}
@await Component.InvokeAsync("Breadcrumb", new {
pageTitle = "IRS AIR Filing Center",
    items = new List<BreadcrumbItem>
{
    new BreadcrumbItem { Title = "Employer", Url = Url.Action("Index", "Employer"), IsActive = false },
    new BreadcrumbItem { Title = "IRS AIR Filing Center", Url = "", IsActive = true }
}
})
<div class="card">
    <div class="card-header border-bottom py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 text-danger">
            <i class='bx bxs-bank me-2'></i> IRS AIR Filing Center
        </h5>

        <form method="get" class="d-flex align-items-center">
            <label class="me-2 fw-semibold">Tax Year:</label>
            <select name="year" asp-items="ViewBag.Years"
                    class="form-select form-select-sm" style="width: 100px;"
                    onchange="this.form.submit()">
            </select>
        </form>
    </div>

    <div class="table-responsive text-nowrap ui-table-responsive">
        <table class="table table-hover align-middle ui-table">
            <thead>
                <tr>
                    <th>Employer</th>
                    <th>Form Type</th>
                    <th>Filing Finalized</th>
                    <th>XML Status</th>
                    <th>Files</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center py-5 text-muted">No finalized filings found.</td></tr>
                }

                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex flex-column">
                                <span class="fw-bold text-heading">@item.EmployerName</span>
                                <small class="text-muted">EIN: @(CanViewSSNorEIN? item.EmployerEIN: DataMasker.MaskEIN(item.EmployerEIN))</small>
                            </div>
                        </td>

                        <td>
                            @if (item.FormType.Contains("1094B"))
                            {
                                <span class="badge bg-label-info">1094-B / 1095-B</span>
                            }
                            else
                            {
                                <span class="badge bg-label-primary">1094-C / 1095-C</span>
                            }
                        </td>

                        <td>
                            <span class="text-muted small">@item.FinalizedDate?.ToString("MMM dd, yyyy")</span>
                        </td>

                        <td>
                            @if (item.HasXml)
                            {
                                string badgeClass = item.StatusId switch
                                {
                                    0 => "bg-label-primary",
                                    1 => "bg-label-info",
                                    2 => "bg-success",
                                    4 => "bg-danger",
                                    _ => "bg-secondary"
                                };
                                string statusText = item.StatusId switch
                                {
                                    0 => "Ready to Transmit",
                                    1 => "Transmitted",
                                    2 => "Accepted",
                                    4 => "Rejected",
                                    _ => "Unknown"
                                };
                                <span class="badge @badgeClass">@statusText</span>
                                <div class="small text-muted mt-1">@item.RecordCount Records</div>
                            }
                            else
                            {
                                <span class="badge bg-label-warning">Pending Generation</span>
                            }
                        </td>

                        <td>
                            @if (item.HasXml)
                            {
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-secondary" title="Download Manifest"
                                            onclick="downloadFile(@item.SubmissionId, 'manifest', this)">
                                        <i class='bx bx-code-alt'></i> Manifest
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary" title="Download Data"
                                            onclick="downloadFile(@item.SubmissionId, 'form', this)">
                                        <i class='bx bx-data'></i> Form
                                    </button>
                                </div>

                            }
                        </td>

                        <td class="text-end">
                            @if (!item.HasXml)
                            {
                                <button class="btn btn-sm btn-primary" onclick="generateXml(@item.EmployerId)">
                                    <i class='bx bxs-file-xml me-1'></i> Generate XML
                                </button>
                            }
                            else
                            {
                                <div class="dropdown">
                                    <button class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                        <i class="bx bx-dots-vertical-rounded"></i>
                                    </button>
                                    <div class="dropdown-menu">
                                        @if (item.StatusId == 0)
                                        {
                                            <a class="dropdown-item" href="javascript:void(0);" onclick="markTransmitted(@item.SubmissionId)">
                                                <i class="bx bx-send me-2"></i> Mark as Transmitted
                                            </a>
                                        }

                                        @if (item.StatusId == 1)
                                        {
                                            <a class="dropdown-item text-primary" href="javascript:void(0);" onclick="uploadAck(@item.SubmissionId)">
                                                <i class="bx bx-upload me-2"></i> Upload IRS Ack
                                            </a>
                                        }

                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" href="javascript:void(0);" onclick="generateXml(@item.EmployerId)">
                                            <i class="bx bx-refresh me-2"></i> Regenerate XML
                                        </a>
                                        @if (item.StatusId == 3 || item.StatusId == 4)
                                        {
                                            <div class="dropdown-divider"></div>
                                            <a class="dropdown-item text-danger" href="@Url.Action("CorrectionDetails", "Irs", new { id = item.SubmissionId })">
                                                <i class="bx bx-wrench me-2"></i> Fix & Correct
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div class="modal fade" id="ackUploadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload IRS Acknowledgement</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <form id="ackForm" enctype="multipart/form-data">
                                <input type="hidden" id="ackSubmissionId" name="id" />

                                <div class="alert alert-info">
                                    Please upload the <strong>XML Acknowledgement file</strong> received from the IRS AIR system.
                                    The system will parse it to update the status.
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">IRS XML File</label>
                                    <input type="file" name="file" class="form-control" accept=".xml" required />
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-3">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitAck()">Process File</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        function generateXml(id) {
            var btn = $(event.target).closest('button');
            btn.prop('disabled', true).html('<i class="bx bx-loader-alt bx-spin"></i> Processing...');

            $.post('@Url.Action("GenerateXml", "Irs")',
                   { employerId: id, year: @ViewBag.SelectedYear, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                   function(res) {
                       if(res.success) {
                           toastr.success(res.message);
                           setTimeout(() => location.reload(), 1500);
                       } else {
                           toastr.error(res.message);
                           btn.prop('disabled', false).html('<i class="bx bxs-file-xml me-1"></i> Generate XML');
                       }
                   });
        }

                function markTransmitted(id) {
            Swal.fire({
                title: 'Mark as Transmitted?',
                text: "Mark this batch as uploaded to the IRS AIR system?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, mark it',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then(function (result) {
                if (result.isConfirmed) {
                    $.post('@Url.Action("MarkTransmitted", "Irs")', { id: id }, function (res) {
                        if (res.success) {
                            toastr.success("Marked as Transmitted.");
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            toastr.error(res.message || "Failed to update status.");
                        }
                    });
                }
            });
        }

                // --- ACK UPLOAD LOGIC ---
        function uploadAck(id) {
            // 1. Reset Form
            $('#ackForm')[0].reset();
            $('#ackSubmissionId').val(id);

            // 2. Show Modal
            $('#ackUploadModal').modal('show');
        }

        function submitAck() {
            var formData = new FormData($('#ackForm')[0]);

            // Add Anti-Forgery Token if needed
            // formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());

            $.ajax({
                url: '@Url.Action("UploadAck", "Irs")',
                type: 'POST',
                data: formData,
                contentType: false, // Critical for file upload
                processData: false, // Critical for file upload
                success: function(res) {
                    if(res.success) {
                        $('#ackUploadModal').modal('hide');
                        toastr.success(res.message);
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        toastr.error(res.message);
                    }
                },
                error: function() {
                    toastr.error("Upload failed.");
                }
            });
        }


                function downloadFile(id, type, btnEl) {
            var btn = $(btnEl);
            var originalHtml = btn.html();
            btn.prop('disabled', true).html('<i class="bx bx-loader-alt bx-spin"></i>');

            fetch('@Url.Action("DownloadFile", "Irs")?id=' + id + '&type=' + type)
                .then(function (res) {
                    if (!res.ok) throw new Error('Download failed');
                    var disposition = res.headers.get('Content-Disposition');
                    var fileName = type + '.xml';
                    if (disposition) {
                        var match = disposition.match(/filename\*?=(?:UTF-8''|")?([^;"]+)/i);
                        if (match) fileName = decodeURIComponent(match[1].replace(/"/g, ''));
                    }
                    return res.blob().then(function (blob) { return { blob: blob, fileName: fileName }; });
                })
                .then(function (r) {
                    var url = window.URL.createObjectURL(r.blob);
                    var a = document.createElement('a');
                    a.href = url;
                    a.download = r.fileName;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    window.URL.revokeObjectURL(url);
                })
                .catch(function () {
                    toastr.error('File download failed.');
                })
                .finally(function () {
                    btn.prop('disabled', false).html(originalHtml);
                });
        }
    </script>
}