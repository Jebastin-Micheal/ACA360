@{
    ViewData["Title"] = "EmployerReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div>    
    <script src="@(Url.Content("~/assets/vendor/libs/jquery/jquery.js"))"></script>

   
</div>

<style>
    th {
        background: #061387 !important;
        color: white !important;
    }
</style>



<section>
    <div class="row">
        <div class="card">
            <div class="stick-top course-content-fixed mb-6 block_Employer_Report">
                <div class="accordion-item mb-0 active">
                    <div class="accordion-header" id="headingOne">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="h5 card-header text-center m-0 text-nowrap flex-grow-1">Custom Filter</div>
                            <button type="button" class="accordion accordion-button" data-bs-toggle="collapse" data-bs-target="#chapterOne" aria-expanded="true" aria-controls="chapterOne">
                            </button>
                        </div>
                    </div>
                    <div id="chapterOne" class="card-body accordion-collapse collapse show" data-bs-parent="#courseContent" >
                        <div class="row">
                            <div class="col-md-4">
                                <label class="form-label" for="Filing_Year">Filing Year</label>
                                <select id="Filing_Year" class="form-select select2" name="Filing_Year">
                                    <option value="">Select Filing Year</option>
                                    @foreach (var year in ViewBag.FilingYear)
                                    {
                                        <option value="@year.FilingYear">@year.FilingYear</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="emp_search">Employer Name</label>
                                <select id="Employer_Id" class="form-select select2" disabled>
                                    <option value="">Select Employer</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="city_search">City</label>
                                <select id="city_search" class="select2 form-select form-select-lg">
                                    <option value="">Select City</option>
                                    <option value="IMMOKALEE">IMMOKALEE</option>
                                    <option value="MENIFEE">MENIFEE</option>
                                    <option value="DUDLEY">DUDLEY</option>
                                    <option value="CONROE">CONROE</option>
                                </select>
                            </div>
                        </div>
                        <div class="row mt-5">
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" id="correct_check" type="checkbox">
                                    <label for="correct_check" class="form-check-label">Is Corrected</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" id="author_check" type="checkbox">
                                    <label for="author_check" class="form-check-label">Is Authoritative</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" id="callcenter_check" type="checkbox">
                                    <label for="callcenter_check" class="form-check-label">Enable CallCenter</label>
                                </div>
                            </div>

                        </div>
                        <div class="row mt-5">
                            <div class="col-md-2 p-t-20">
                                <button type="button" class="btn btn-secondary" id="btn_filter">Filter</button>
                                <button type="button" class="btn btn-primary" id="btn_reset">Reset </button>
                            </div>
                        </div>

                        <hr />
                    </div>
                </div>

