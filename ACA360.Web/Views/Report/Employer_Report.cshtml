               t.columns(2).search($("#Employer_Id").val());
               t.columns(3).search($("#city_search").val());
               t.columns(4).search(correct_check);
               t.columns(5).search(author_check);
               t.columns(6).search(callcenter_check);
               t.draw();
                    //$('.select2').select2();
            });
                   $('#btn_reset').click(function () {
                // Reset Select2 dropdowns and UI
                $("#Filing_Year").val("").trigger('change');

                // Reset Employer dropdown: clear value, disable, and optionally clear options
                $("#Employer_Id").val("").trigger('change');         // Clear value
                $("#Employer_Id").prop("disabled", true);            // Disable
                $("#Employer_Id").html('<option value="">Select Employer</option>'); // Optional: reset options

                // Reset other form fields
                $("#city_search").val("");
                $('#correct_check').prop('checked', false);
                $('#author_check').prop('checked', false);
                $('#callcenter_check').prop('checked', false);

                // DataTable filters
                t.columns(1).search("Select All");
                t.columns(2).search("Select All");
                t.columns(3).search("Select All");

                correct_check = "No";
                author_check = "No";
                callcenter_check = "No";

                t.columns(4).search(correct_check);
                t.columns(5).search(author_check);
                t.columns(6).search(callcenter_check);

                t.draw();
            });


            $('#Filing_Year').on('change', function () {
                            var filingYear = $(this).val();

                            // Reset and disable Employer dropdown if no year selected
                            if (!filingYear) {
                                $('#Employer_Id').html('<option value="">Select Employer</option>').prop('disabled', true);
                                return;
                            }

                            // Enable Employer dropdown
                            $('#Employer_Id').prop('disabled', false);

                            // Call the controller action with selected filingYear
                            $.ajax({
                                url: '@Url.Action("SearchEmployers", "Employer")',
                                type: 'GET',
                                    data: { term: '',pageSize : 10000,filingYear: filingYear },
                                success: function (data) {
                                    var options = '<option value="">Select Employer</option>';
                                    $.each(data, function (i, employer) {
                                            options += '<option value="' + employer.name + '">' + employer.name + '</option>';
                                    });
                                    $('#Employer_Id').html(options);
                                },
                                error: function () {
                                    alert('Failed to load employers.');
                                }
                            });
            });


        });



        function OnAjaxBegin() {
            //$.blockUI({ message: '<h4>Loading...</h4>' });
                loader_deform();
        }

        function OnAjaxSuccess() {
            //$.unblockUI();
              $('div.block_Employer_Report').unblock();
        }

