                          ,initComplete: function () {
              const table = $('#tbl_EmployerReport').DataTable();

              // Inject custom export + column + row count UI
              $('.custom-export-btn').html(`
                <div class="btn-group">
                  <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                      <i class="bx bx-export me-1"></i> Export
                    </button>
                    <ul class="dropdown-menu">
                      <li><a class="dropdown-item export-btn" data-type="print" href="#">Print</a></li>
                      <li><a class="dropdown-item export-btn" data-type="excel" href="#">Excel</a></li>
                      <li><a class="dropdown-item export-btn" data-type="csv" href="#">CSV</a></li>
                      <li><a class="dropdown-item export-btn" data-type="pdf" href="#">PDF</a></li>
                      <li><a class="dropdown-item export-btn" data-type="copy" href="#">Copy</a></li>
                    </ul>
                  </div>
                </div>

                <div class="btn-group ms-2">
                  <button class="btn btn-outline-secondary colvis-btn">
                    <span class="colvis-counter">Columns</span>
                  </button>
                </div>
              `);

              // Bind export actions
              $('.export-btn').on('click', function (e) {
                e.preventDefault();
                const type = $(this).data('type');
                table.button(`.buttons-${type}`).trigger();
              });

              // Trigger ColVis
              $('.colvis-btn').on('click', function () {
                table.button('.buttons-colvis').trigger();
              });

              // Update column counter dynamically
              function updateColvisCounter() {
                const total = table.columns().count();
                const visible = table.columns(':visible').count();
                $('.colvis-counter').text(`Columns (${visible} of ${total})`);
              }

              updateColvisCounter();
              table.on('column-visibility.dt', updateColvisCounter);
            }
                  , ajax: {
                      url: '@Url.Action("EmployerReport_GETDATA", "Report")',
                      type: 'POST',
                      data: function (d) {
                         d.Report_Type = "Employer_Report";
                         //console.log("Data received:", d);
                      },
                      beforeSend: function () { OnAjaxBegin(); },
                      complete: function () { OnAjaxSuccess(); }
                  },
                  "columns": itemArray

            });
             var correct_check = "";
             $('#correct_check').on('change', function () {
              correct_check = $(this).is(':checked') ? "Yes" : "No";
             });

              var author_check = "";
              $('#author_check').on('change', function () {
                author_check = $(this).is(':checked') ? "Yes" : "No";
              });

