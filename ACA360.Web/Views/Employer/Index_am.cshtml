        function loadEmployerList(pageIndex) {
            // Show loader while fetching data
            $("#loader").show();
              var searchTerm = $('#employerSearch').val();
             var pageSize = $(".drpPageSize").val();
             // Get the sort column and order from the table's data attributes
    var $table = $('#employerTable');
    var sortColumn = $table.data('sort-column');
    var sortOrder = $table.data('sort-order');
            // Make AJAX call to get employer list based on the page index and other parameters
            $.ajax({
                url: '@Url.Action("EmployerListPartial", "Employer")',
                data: {
                    pageIndex: pageIndex,
                    page_Size: pageSize,
                    search: searchTerm,         // Keep search value from the model
                    sortColumn: sortColumn,
                    sortOrder: sortOrder    // Keep sorting order value
                },
                success: function (data) {
                    // Update the content of the employer list container
                        $("#employerListContainer").html(data);
    
                    // Hide the loader after content is updated
                    $("#loader").hide();
                },
                error: function () {
                    // Hide the loader in case of an error
                    $("#loader").hide();
                }
            });
        }

        // Initial load when the page is ready
        // loadEmployerList(1);
       // Click to toggle sort order for Name only


        // Attach click event to pagination links
        $(document).on("click", ".page-link", function (event) {
            event.preventDefault();  // Prevent default link behavior
            var pageIndex = $(this).data("pageindex"); // Get page index from the clicked link
            loadEmployerList(pageIndex); // Load employer list for the selected page
        });
        $(document).on("change", ".drpPageSize", function (event) {
            event.preventDefault();
            var pageIndex = 1; // Start at first page
            loadEmployerList(pageIndex);
        });
         $(document).on('click', '#nameColumnHeader', function () {
             alert("sorting");
        var $icon = $(this).find('i');
        var currentOrder = $(this).attr('data-sort-order');
        var newOrder = currentOrder === 'asc' ? 'desc' : 'asc';

        // Toggle class
        if (newOrder === 'asc') {
            $icon.removeClass('bi-arrow-down-short').addClass('bi-arrow-up-short');
        } else {
            $icon.removeClass('bi-arrow-up-short').addClass('bi-arrow-down-short');
        }

        $(this).attr('data-sort-order', newOrder);
        $('#employerTable').attr('data-sort-order', newOrder);
    $('#employerTable').attr('data-sort-column', 0); // <-- update sort column here
        loadEmployerList(1);
    });
         $(document).on('keyup', '#employerSearch', function () {
        let searchTerm = $(this).val();
      
        if (searchTerm.length >= 3 || searchTerm.length === 0) {
            // Show the loader while fetching search results
            $("#loader").show();

            $.ajax({
                url: '@Url.Action("EmployerListPartial", "Employer")',
                type: 'GET',
                data: { search :searchTerm }, // Pass the search term and page size
                success: function (data) {

                    // Update the content of the employer list container with search results
                  /*   $("#employerListContainer").empty();  */// Clear existing employer list content
                       $("#employerListContainer").html(data);
                     // Restore the search input value after partial replaces it
                $('#employerSearch').val(searchTerm);
                },
                complete: function () {
                    // Hide the loader after content is updated
                    $("#loader").hide();
                }
            });
        } 
        else {

              $("#loader").show();
       
        }
    });


      // 1. Form Generate Button Click -> Open Preview Modal
    $(document).on('click', '.form-gen-btn', function(e) {
        e.preventDefault();

        var $btn = $(this);
        var employerId = $btn.data('employer-id');
        var year = $btn.data('year');
        var formType = $btn.data('form-type');

        if (!employerId || !year) {
            toastr.error("Unable to get Employer ID or Filing Year.", "Error");
            return;
        }

        // Close the dropdown menu
        var $dropdownMenu = $btn.closest('.dropdown-menu');
        if ($dropdownMenu.length) {
            $dropdownMenu.removeClass('show');
        }

        // Set Label Info
        $('#employerPreviewLabel').text(formType + " Preview");

        // Show Modal and Loader, Hide Iframe temporarily
        $('#employerPdfPreviewModal').modal('show');
        $('#employerPreviewLoader').show();
        $('#employerPdfFrame').attr('src', 'about:blank').hide();

        // Build the Preview URL using GET
        // 1094 forms don't need selectedEmployeeId and suppressSSN is naturally false
        var url = '/FormGeneration/GeneratePreview?' +
            'employerId=' + employerId +
            '&year=' + year +
            '&formType=' + encodeURIComponent(formType) +
            '&selectedEmployeeId=' +
            '&suppressSSN=false';

        // Set the Iframe source to trigger PDF generation
        $('#employerPdfFrame').attr('src', url);
    });

    // 2. Hide Loader when PDF finishes loading in the Iframe
    $('#employerPdfFrame').on('load', function() {
        var src = $(this).attr('src');
        if (src && src !== 'about:blank') {
            $('#employerPreviewLoader').hide();
            $(this).show();
        }
    });

    // 3. Clear Iframe on Modal Close (Free memory)
    $('#employerPdfPreviewModal').on('hidden.bs.modal', function() {
        $('#employerPdfFrame').attr('src', 'about:blank').hide();
        $('#employerPreviewLoader').show();
    });

    // 4. FULLSCREEN TOGGLE LOGIC
    $(document).on('click', '.toggle-fullscreen', function() {
        let targetModalId = $(this).data('target-modal');
        let $dialog = $('#' + targetModalId + ' .modal-dialog');
        let $icon = $(this).find('i');

        // Toggle Bootstrap fullscreen classes
        $dialog.toggleClass('modal-fullscreen modal-xl');

        // Toggle Fullscreen Icon
        if ($dialog.hasClass('modal-fullscreen')) {
            $icon.removeClass('bx-fullscreen').addClass('bx-exit-fullscreen');
        } else {
            $icon.removeClass('bx-exit-fullscreen').addClass('bx-fullscreen');
        }
    });

    // 5. Reset Fullscreen state when modal closes
    $('.modal').on('hidden.bs.modal', function() {
        let $dialog = $(this).find('.modal-dialog');
        let $icon = $(this).find('.toggle-fullscreen i');

        if ($dialog.hasClass('modal-fullscreen')) {
            $dialog.removeClass('modal-fullscreen').addClass('modal-xl');
            $icon.removeClass('bx-exit-fullscreen').addClass('bx-fullscreen');
        }
    });


      });


