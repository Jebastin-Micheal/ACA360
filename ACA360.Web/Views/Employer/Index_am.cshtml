           document.addEventListener('DOMContentLoaded', function () {
              
        const toggleSwitch = document.getElementById('toggleEmployerListSwitch');
        if (toggleSwitch) {
            toggleSwitch.checked = false;
           // console.log('Initial toggle switch state:', toggleSwitch.checked); // Should log false
        }
    });
       
       

       $(document).on('change', '#toggleEmployerListSwitch', function () {
        const list = $('#employerListContainer');
        const details = $('#employerDetailsContainer');

        if (this.checked) {
            // Hide list
            list.addClass('hide-employer-list');
            list.removeClass('col-md-3');
            details.removeClass('col-md-9').addClass('full-width-details');
            
        } else {
            // Show list
            list.removeClass('hide-employer-list');
            list.removeClass('d-none'); // just in case
            list.addClass('col-md-3');
            details.removeClass('full-width-details').addClass('col-md-9');
        }
    });

