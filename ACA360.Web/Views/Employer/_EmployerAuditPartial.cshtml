@using Newtonsoft.Json
@model ACA360.Web.Models.AuditLogViewModel

<table class="table table-bordered">
    <thead class="table-secondary">
        <tr>
            <th>User</th>
            <th>Operation</th>
            <th>Old Value</th>
            <th>New Value</th>
            <th>Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var entry in Model.Entries)
        {
            var oldValues = JsonConvert.DeserializeObject<Dictionary<string, object>>(entry.OldValue ?? "{}");
            var newValues = JsonConvert.DeserializeObject<Dictionary<string, object>>(entry.NewValue ?? "{}");

            <tr>
                <td>@entry.UserName</td>
                <td>@entry.Operation</td>

                <td>
                    @if (oldValues?.Any() == true)
                    {
                        foreach (var item in oldValues)
                        {
                            <div><strong>@item.Key:</strong> @item.Value</div>
                        }
                    }
                </td>

                <td>
                    @if (newValues?.Any() == true)
                    {
                        foreach (var item in newValues)
                        {
                            <div><strong>@item.Key:</strong> @item.Value</div>
                        }
                    }
                </td>

                <td>@entry.Date?.ToString("g")</td>
            </tr>
        }
    </tbody>
</table>
