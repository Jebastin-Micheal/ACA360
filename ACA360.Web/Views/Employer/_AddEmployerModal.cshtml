                    </div>
                    <div class="tab-pane fade" id="tab-service-modal">
                        @await Html.PartialAsync("_AddEmployerServicePartial", Model.EmployerServiceInfo)
                    </div>
                    <div class="tab-pane fade" id="tab-1094-modal">
                        @await Html.PartialAsync("_AddEmployer1094Partial", Model)
                    </div>
                    <div class="tab-pane fade" id="tab-other-modal">
                        @await Html.PartialAsync("_AddOtherImportantInfoPartial", Model)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modals -->
@await Html.PartialAsync("Components/Modals/_TrackerModalsPartial")


<script>
    $(document).ready(function() {

        // ==============================================================
        // A. BUTTON LOCKING LOGIC
        // ==============================================================

        function toggleDependentButtons(enable) {
            // Ensure your buttons in the partials have class="dependent-save-btn"
            var $btns = $('.dependent-save-btn');

            if (enable) {
                $btns.prop('disabled', false).removeClass('disabled');
            } else {
                $btns.prop('disabled', true).addClass('disabled');
            }
        }

        // Check on Page Load
        var initialEmpId = $('#EmployerIdhdn_main').val();

        if (initialEmpId && initialEmpId !== "0" && initialEmpId !== "") {
            toggleDependentButtons(true);
        } else {
            toggleDependentButtons(false);
        }

        // ==============================================================
        // B. SAVE EMPLOYER (COMMON SECTION)
        // ==============================================================
          $('#btnSaveEmployer').on('click', function(e) {
        e.preventDefault();
        var token = $('input[name="__RequestVerificationToken"]').val();
        if (!$('#employerName').val()) {
            alert("Employer Name is required");
            return;
        }

        var employerData = {
            Employer: {
                Name: $('#employerName').val(),
                TaxId: $('#employerTaxId').val(),
                Type: $('#employerType').val(),
                FilingYear: $('#employerFilingYear').val(),
                IsForeignAddress: $('#employerIsForeignAddress').val(),
                Address1: $('#employerAddress1').val(),
                Address2: $('#employerAddress2').val(),
                City: $('#employerCity').val(),
                StateId: $('#employerState').val(),
                ZipCode: $('#employerZipCode').val(),
                CountryId: $('#employerCountry').val(),
                enableCallCenter: $('#employerEnableCallCenter').val(),
                IsCorrected: $('#employerIsCorrected').val()
            }
        };

        $.ajax({
            type: "POST",
            url: "/Employer/AddEmployerCommon",
            headers: {
             "RequestVerificationToken": token
            },
            data: employerData,
            success: function(response) {
                if (response.success) {
                    alert("Employer saved successfully!");

                    // FIX: Updated ID to match your HTML (#EmployerIdhdn_main)
                    $('.EmployerIdhdn_main').val(response.employerId);

                    // If you have other hidden fields in partials, update them too:
                    // $('#EmployerIdhdn').val(response.employerId);
                    $('.Employer_TrackerIdhdn').val(response.trackerEmployerId);

                    // 2. ENABLE ALL SAVE BUTTONS
                    toggleDependentButtons(true);

                    // 3. Switch to ER Info tab
                    var $erTabTrigger = $('button[data-bs-target="#tab-erinfo-modal"]');
                    $erTabTrigger.tab('show');

                    // 4. Focus logic
                    $erTabTrigger.one('shown.bs.tab', function (e) {
                        var $firmSelect = $('#Employer_FirmId');
                        if ($firmSelect.length) {
                            $firmSelect.removeAttr('disabled').focus();
                        }
                    });

                } else {
                    alert("Error: " + response.message);
                }
            },
            error: function(xhr, status, error) {
                console.error("AJAX Error:", status, error);
                alert("An error occurred while trying to save the employer.");
            }
        });
    });

        window.switchToNextTab = function() {
            var $activeTab = $('#employerTabList .nav-link.active');
            var $nextTab = $activeTab.parent().next().find('.nav-link');
            if ($nextTab.length > 0) {
                $nextTab.tab('show');
                document.getElementById('employerTabList').scrollIntoView({ behavior: 'smooth' });
            }
        };

    });
</script>