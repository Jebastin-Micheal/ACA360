<div>
    @await Html.PartialAsync("_AddEmployerCommonFieldsPartial", Model)

    <div class="accordion mt-3">
        <div class="accordion-item">
            <div class="accordion-header">
                <h6>Additional Employer Information</h6>
            </div>
            <div class="accordion-body">
               @*  <ul class="nav nav-pills mb-3" role="tablist" id="employerTabList">
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-erinfo-modal">ER Info</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-service-modal">Service Info</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-1094-modal">1094 Details</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-other-modal">Other Info</button>
