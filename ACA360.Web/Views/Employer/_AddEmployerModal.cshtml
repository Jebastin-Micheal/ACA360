                </ul> *@
                <ul class="nav nav-pills mb-3" role="tablist" id="employerTabList">
                    <li class="nav-item">
                        <button class="nav-link active"
                                id="erinfo-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#tab-erinfo-modal"
                                type="button"
                                role="tab"
                                aria-selected="true">
                            ER Info
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link"
                                id="service-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#tab-service-modal"
                                type="button"
                                role="tab"
                                aria-selected="false">
                            Service Info
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link"
                                id="1094-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#tab-1094-modal"
                                type="button"
