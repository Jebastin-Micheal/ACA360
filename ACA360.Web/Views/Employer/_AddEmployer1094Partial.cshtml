<!-- Modal -->


<div class="modal fade" id="matrixModal" tabindex="-1">
    <div class="modal-dialog modal-xl matrixcode-modal">
        <div class="modal-content p-3 p-md-5">
            <div class="modal-header d-block">
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">Manual Update Employer Detail</h3>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <p class="text-muted mb-0">Update monthly coverage information manually</p>
            </div>
            <div class="modal-body">

                <div class="table-responsive">
                    @{
                        string[] modalMonths = { "All", "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
                    }
                    <table class="table table-bordered text-center table-sm align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 150px;">Details</th>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <th>@modalMonths[i]</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-bold text-start">Min Coverage</td>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <td>
                                        <div class="d-flex justify-content-center">
                                            <input type="checkbox" class="form-check-input" id="modal_MinCov_@i"
                                                   @(Model._1094View.MinimumCoverage[i] == 1 ? "checked" : "") />
                                        </div>
                                    </td>
                                }
                            </tr>

                            <tr>
                                <td class="fw-bold text-start">Full-Time</td>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <td>
                                        <input type="text" class="form-control form-control-md text-center px-1 w-px-50" id="modal_FullTime_@i"
                                               value="@(Model._1094View.FullTime[i] == 0 ? "" : Model._1094View.FullTime[i].ToString())" />
                                    </td>
                                }
                            </tr>

                            <tr>
                                <td class="fw-bold text-start">Total</td>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <td>
                                        <input type="text" class="form-control form-control-sm text-center px-1 w-px-50" id="modal_Total_@i"
                                               value="@(Model._1094View.Total[i] == 0 ? "" : Model._1094View.Total[i].ToString())" />
                                    </td>
                                }
                            </tr>

                            <tr>
                                <td class="fw-bold text-start">Aggregate</td>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <td>
                                        <div class="d-flex justify-content-center">
                                            <input type="checkbox" class="form-check-input" id="modal_Agg_@i"
                                                   @(Model._1094View.AggregateGroup[i] == 1 ? "checked" : "") />
                                        </div>
                                    </td>
                                }
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="reset" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="syncMatrixToTable()">Update Table</button>
            </div>
               

        </div>
    </div>
</div>
<!-- Scripts -->

<script>
            function openMatrixModal() {
        // Check if Bootstrap 5 is loaded
        if (typeof bootstrap !== 'undefined') {
            var myModal = new bootstrap.Modal(document.getElementById('matrixModal'));
            myModal.show();
        } else {
            alert("Bootstrap JS is not loaded!");
        }
    }
        function syncMatrixToTable() {
        for (let i = 1; i <= 12; i++) {
            // Sync Min Coverage
            $(`#main_MinCov_${i}`).prop('checked', $(`#modal_MinCov_${i}`).is(':checked'));
            // Sync Full Time
            $(`#main_FullTime_${i}`).val($(`#modal_FullTime_${i}`).val());
            // Sync Total
            $(`#main_Total_${i}`).val($(`#modal_Total_${i}`).val());
            // Sync Aggregate
            $(`#main_Agg_${i}`).prop('checked', $(`#modal_Agg_${i}`).is(':checked'));
        }

        // Safer way to close modal in BS5
        var modalEl = document.getElementById('matrixModal');
        var modal = bootstrap.Modal.getInstance(modalEl);

        if (modal) {
            modal.hide();
        } else {
            // Fallback if instance not found (creates new instance just to hide it)
            new bootstrap.Modal(modalEl).hide();
        }
    }

                function save1094(isNext) {
        var form = $("#form1094Save");

        // ---------------------------------------------------------
        // FIX 1: Numbers (Already working)
        // Fill empty number fields with '0' to avoid gaps
        // ---------------------------------------------------------
        form.find("input[type=number]").each(function() {
            if ($(this).val() === "") {
                $(this).val(0);
            }
        });

        // ---------------------------------------------------------
        // FIX 2: Checkboxes (The new fix)
        // If a checkbox is UNCHECKED, it sends nothing.
        // We must manually add a hidden "false" input for it so the
        // Controller gets a complete list of 13 items (True/False).
        // ---------------------------------------------------------

        // First, remove any old temporary hidden inputs from previous clicks to avoid duplicates
        form.find(".checkbox-fallback").remove();

        form.find("input[type=checkbox]").each(function() {
            // If this checkbox is NOT checked...
            if (!$(this).is(':checked')) {
                // Create a hidden input with the SAME NAME but value="false"
                var fallback = $('<input>')
                    .attr('type', 'hidden')
                    .attr('class', 'checkbox-fallback') // Mark it so we can remove it later
                    .attr('name', $(this).attr('name'))
                    .attr('value', 'false');

                // Append it right after the checkbox
                $(this).after(fallback);
            }
        });

        // ---------------------------------------------------------
        // 3. Save
        // ---------------------------------------------------------
        var formData = form.serialize();
        var token = $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '/Employer/SaveEmployer1094Tab',
            type: 'POST',
            headers: {
             "RequestVerificationToken": token
            },
            data: formData,
            success: function (response) {
                                // Cleanup: Remove the temporary hidden inputs so the form stays clean
                form.find(".checkbox-fallback").remove();

                if (response.success) {
                    if (isNext) {
                        if (typeof window.switchToNextTab === "function") {
                            window.switchToNextTab();
                        }
                        Swal.fire({ icon: 'success', title: 'Saved!', text: response.message || 'Form 1094 details saved successfully.', timer: 1000, showConfirmButton: false });
                    } else {
                        Swal.fire({
                icon: 'success',
                title: 'Saved!',
                text: response.message || 'Form 1094 details saved successfully.',
                confirmButtonColor: '#696cff'
            });
                    }
                } else {
                    Swal.fire({
            icon: 'error',
            title: 'Error',
            text: response.message || 'Error saving Form 1094 details.'
        });
                }
            },
            error: function (xhr, status, error) {
                console.error("AJAX Error:", status, error);
                Swal.fire({
        icon: 'error',
        title: 'Unexpected Error',
        text: 'An unexpected error occurred while saving Form 1094 details.'
    });
            }
        });
    }
</script>
 