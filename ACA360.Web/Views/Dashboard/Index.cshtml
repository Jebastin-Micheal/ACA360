@using ACA360.Core.Constants
@model ACA360.Core.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

@* ── ACA360 Dashboard Design System (inlined — no partial needed) ── *@
<style>
    :root {
        --d-primary: #696cff;
        --d-success: #71dd37;
        --d-danger: #ff3e1d;
        --d-warning: #ffab00;
        --d-info: #03c3ec;
        --d-muted: #8592a3;
        --d-radius: 14px;
        --d-shadow: 0 4px 24px rgba(105,108,255,.10);
    }

    .d-metric {
        background: var(--bs-body-bg);
        border: 1px solid rgba(105,108,255,.14);
        border-radius: var(--d-radius);
        padding: 1.25rem 1.4rem;
        position: relative;
        overflow: hidden;
        transition: transform .2s, box-shadow .2s;
    }

        .d-metric:hover {
            transform: translateY(-2px);
            box-shadow: var(--d-shadow);
        }

        .d-metric::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--metric-accent, var(--d-primary));
            border-radius: var(--d-radius) var(--d-radius) 0 0;
        }

        .d-metric.accent-success {
            --metric-accent: var(--d-success);
        }

        .d-metric.accent-danger {
            --metric-accent: var(--d-danger);
        }

        .d-metric.accent-warning {
            --metric-accent: var(--d-warning);
        }

        .d-metric.accent-info {
            --metric-accent: var(--d-info);
        }

    .d-metric-value {
        font-size: 2.2rem;
        font-weight: 800;
        line-height: 1;
        letter-spacing: -1px;
        color: var(--bs-heading-color);
    }

    .d-metric-label {
        font-size: .72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .6px;
        margin-top: .3rem;
    }

    .d-metric-sub {
        font-size: .78rem;
        color: var(--d-muted);
        margin-top: .5rem;
    }

    .d-metric-icon {
        position: absolute;
        bottom: 2.75rem;
        right: 1rem;
        font-size: 3rem;
        opacity: .07;
        pointer-events: none;
    }

    .d-card {
        background: var(--bs-body-bg);
        border: 1px solid rgba(105,108,255,.1);
        border-radius: var(--d-radius);
        box-shadow: var(--d-shadow);
        overflow: hidden;
        --bs-card-spacer-y: 1rem;
        --bs-card-spacer-x: 1rem;
    }

    .d-card-header {
        padding: 1rem 1.4rem;
        border-bottom: 1px solid rgba(105,108,255,.08);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
    }

    .d-card-title {
        font-size: .82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .7px;
        color: var(--bs-heading-color);
        margin: 0;
    }

    .score-ring {
        transform: rotate(-90deg);
    }

    .score-ring-track {
        fill: none;
        stroke: rgba(105,108,255,.12);
    }

    .score-ring-fill {
        fill: none;
        stroke-linecap: round;
        transition: stroke-dashoffset .8s cubic-bezier(.4,0,.2,1);
    }

    .trend-up {
        color: var(--d-success);
        background: rgba(113,221,55,.1);
        padding: 2px 8px;
        border-radius: 20px;
        font-size: .72rem;
        font-weight: 700;
    }

    .trend-down {
        color: var(--d-danger);
        background: rgba(255,62,29,.1);
        padding: 2px 8px;
        border-radius: 20px;
        font-size: .72rem;
        font-weight: 700;
    }

    .trend-flat {
        color: var(--d-muted);
        background: rgba(133,146,163,.1);
        padding: 2px 8px;
        border-radius: 20px;
        font-size: .72rem;
        font-weight: 700;
    }

    .d-timeline {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .d-timeline li {
            display: flex;
            gap: .85rem;
            padding: .6rem 0;
            border-bottom: 1px solid rgba(105,108,255,.07);
            font-size: .82rem;
        }

            .d-timeline li:last-child {
                border: none;
            }

    .d-tl-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        margin-top: 4px;
        flex-shrink: 0;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        position: relative;
    }

        .pulse-dot::after {
            content: '';
            position: absolute;
            inset: -3px;
            border-radius: 50%;
            animation: pulse-ring 1.6s ease-out infinite;
        }

        .pulse-dot.green {
            background: var(--d-success);
        }

            .pulse-dot.green::after {
                border: 2px solid var(--d-success);
            }

        .pulse-dot.red {
            background: var(--d-danger);
        }

            .pulse-dot.red::after {
                border: 2px solid var(--d-danger);
            }

        .pulse-dot.orange {
            background: var(--d-warning);
        }

            .pulse-dot.orange::after {
                border: 2px solid var(--d-warning);
            }

    @@keyframes pulse-ring {
        0% {
            opacity: .8;
            transform: scale(1);
        }

        100% {
            opacity: 0;
            transform: scale(2.4);
        }
    }

    .d-progress {
        height: 5px;
        border-radius: 3px;
        background: rgba(105,108,255,.1);
        overflow: hidden;
    }

    .d-progress-fill {
        height: 100%;
        border-radius: 3px;
        background: var(--fill-color, var(--d-primary));
        transition: width 1s cubic-bezier(.4,0,.2,1);
    }

    .deadline-block {
        background: linear-gradient(135deg, rgba(255,62,29,.12), rgba(255,171,0,.08));
        border: 1px solid rgba(255,62,29,.2);
        border-radius: var(--d-radius);
        padding: 1rem 1.25rem;
    }

    .deadline-days {
        font-size: 3rem;
        font-weight: 900;
        line-height: 1;
        letter-spacing: -2px;
        background: linear-gradient(135deg, #ff3e1d, #ffab00);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .d-stat-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .55rem 0;
        border-bottom: 1px solid rgba(105,108,255,.06);
        font-size: .82rem;
    }

        .d-stat-row:last-child {
            border: none;
        }

    .risk-critical {
        background: rgba(255,62,29,.12);
        color: #ff3e1d;
        border: 1px solid rgba(255,62,29,.2);
        padding: 2px 10px;
        border-radius: 20px;
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .risk-high {
        background: rgba(255,171,0,.12);
        color: #ffab00;
        border: 1px solid rgba(255,171,0,.2);
        padding: 2px 10px;
        border-radius: 20px;
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .risk-ok {
        background: rgba(113,221,55,.1);
        color: #71dd37;
        border: 1px solid rgba(113,221,55,.2);
        padding: 2px 10px;
        border-radius: 20px;
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .d-scroll {
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: rgba(105,108,255,.2) transparent;
    }

        .d-scroll::-webkit-scrollbar {
            width: 4px;
        }

        .d-scroll::-webkit-scrollbar-thumb {
            background: rgba(105,108,255,.25);
            border-radius: 4px;
        }

    .hm-cell {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-size: .6rem;
        font-weight: 700;
        transition: transform .15s;
        cursor: default;
    }

        .hm-cell:hover {
            transform: scale(1.15);
            z-index: 1;
        }

    .hm-complete {
        background: rgba(113,221,55,.18);
        color: #71dd37;
        border: 1px solid rgba(113,221,55,.3);
    }

    .hm-partial {
        background: rgba(255,171,0,.15);
        color: #ffab00;
        border: 1px solid rgba(255,171,0,.25);
    }

    .hm-missing {
        background: rgba(133,146,163,.1);
        color: #8592a3;
        border: 1px solid rgba(133,146,163,.15);
    }
</style>

<script>
    (function () {
        function animateCounter(el) {
            var target = parseInt(el.dataset.target || el.textContent, 10);
            if (isNaN(target)) return;
            var duration = 900, start = performance.now();
            function step(now) {
                var p = Math.min((now - start) / duration, 1);
                var ease = 1 - Math.pow(1 - p, 3);
                el.textContent = Math.round(target * ease).toLocaleString();
                if (p < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
        }
        function initRing(el) {
            var score = parseInt(el.dataset.score || 0, 10);
            var fill  = el.querySelector('.score-ring-fill');
            if (!fill) return;
            var r     = parseFloat(fill.getAttribute('r') || 36);
            var circ  = 2 * Math.PI * r;
            fill.style.strokeDasharray  = circ;
            fill.style.strokeDashoffset = circ;
            setTimeout(function () { fill.style.strokeDashoffset = circ - (score / 100) * circ; }, 200);
        }
        function initProgress(el) {
            var pct = el.dataset.pct || 0;
            setTimeout(function () { el.style.width = pct + '%'; }, 100);
        }
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.counter[data-target]').forEach(animateCounter);
            document.querySelectorAll('.score-ring-wrap').forEach(initRing);
            document.querySelectorAll('.d-progress-fill[data-pct]').forEach(initProgress);
        });
        window.ACA = window.ACA || {};
        window.ACA.animateCounter = animateCounter;
        window.ACA.initRing = initRing;
    })();
</script>

@* ── Welcome header ─────────────────────────────────────── *@
<div class="container-fluid px-4 pb-5">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        @if (Model != null)
        {
            <div>
                <h4 class="fw-bold mb-1">
                    Welcome back, <span class="text-primary">@Model.Profile_Name</span>
                </h4>
                <p class="text-muted mb-0 small">
                    @DateTime.Now.ToString("D")
                    &nbsp;·&nbsp;
                    Role: <span class="fw-semibold text-primary">@Model.UserRole</span>
                </p>
            </div>
        }
        else
        {
            <div><h4 class="fw-bold mb-0 text-danger">Error: Profile Data Unavailable</h4></div>
        }
        <button class="btn btn-sm btn-outline-secondary" onclick="location.reload()">
            <i class='bx bx-refresh me-1'></i>Refresh
        </button>
    </div>

    @* ── Role dashboard ──────────────────────────────────── *@
    @if (Model != null && !string.IsNullOrEmpty(Model.UserRole))
    {
        @switch (Model.UserRole)
        {
            case UserRoles.SuperAdmin:
            case UserRoles.Admin:
                <partial name="_SuperAdminDashboard" model="Model" />
                break;
            case UserRoles.ACADirector:
                <partial name="_ACADirectorDashboard" model="Model" />
                break;
            case UserRoles.DASupervisor:
                <partial name="_DASupervisorDashboard" model="Model" />
                break;
            case UserRoles.AMSupervisor:
                <partial name="_AccountManagerSupervisorDashboard" model="Model" />
                break;
            case UserRoles.Broker:
                <partial name="_BrokerDashboard" model="Model" />
                break;
            case UserRoles.DataAnalyst:
                <partial name="_DataAnalystDashboard" model="Model" />
                break;
            case UserRoles.Employer:
                <partial name="_EmployerDashboard" model="Model" />
                break;
            case UserRoles.StaffAC:
                <partial name="_StaffACDashboard" model="Model" />
                break;
            case UserRoles.StaffAU:
                <partial name="_StaffAUDashboard" model="Model" />
                break;
            case UserRoles.AccountManager:
                <partial name="_AccountManagerDashboard" model="Model" />
                break;
            default:
                <div class="alert alert-info">
                    <h5>Welcome, @Model.Profile_Name</h5>
                    <p class="mb-0">No dashboard configured for role: <strong>@Model.UserRole</strong></p>
                </div>
                break;
        }
    }
    else
    {
        <div class="alert alert-danger shadow-sm">
            <h4 class="alert-heading"><i class='bx bx-error-circle me-2'></i>Dashboard Error</h4>
            <p>User profile could not be loaded. Please try logging out and back in.</p>
        </div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
