@model ACA360.Core.Models.DashboardViewModel
@{
    var amClients = Model.AmPortfolio ?? new List<ACA360.Core.Models.AmClientPortfolioDto>();
    var total = Model.TotalEmployers;
    var onTrack = Model.ClientsOnTrack;
    var missing = Model.ClientsMissingData;
    var inTriage = Model.FilesInQueue;
    var risk = Model.TotalPortfolioRisk.ToString("C0");
    var pending = Math.Max(0, total - Model.AmAcceptedCount - Model.AmRejectedCount);
    var deadline = new DateTime(DateTime.Now.Year + 1, 3, 31);
    var daysLeft = (deadline - DateTime.Now).Days;
    var filedPct = total > 0 ? (Model.AmAcceptedCount * 100 / total) : 0;
}

@* ── Row 1: Deadline hero + key metrics ──────────────── *@
<div class="row g-3 mb-4">

    @* Countdown hero *@
    <div class="col-12 col-md-4 col-xl-3">
        <div class="d-card h-100" style="background:linear-gradient(135deg,#696cff 0%,#5f61e6 100%);border-color:transparent;">
            <div class="card-body text-white d-flex flex-column justify-content-center text-center py-4">
                <div style="font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;opacity:.75;margin-bottom:.5rem;">
                    IRS Filing Deadline
                </div>
                <div style="font-size:4rem;font-weight:900;line-height:1;letter-spacing:-3px;">@daysLeft</div>
                <div style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;opacity:.75;">
                    Days Until March 31
                </div>
                <div class="mt-3 pt-3 border-top border-white border-opacity-25">
                    <div class="d-progress" style="background:rgba(255,255,255,.2);height:6px;">
                        <div class="d-progress-fill" data-pct="@filedPct"
                             style="--fill-color:#71dd37;"></div>
                    </div>
                    <div class="mt-1 opacity-75" style="font-size:.7rem;">@filedPct% of portfolio filed</div>
                </div>
            </div>
        </div>
    </div>

    @* Portfolio metrics *@
    <div class="col-12 col-md-8 col-xl-9">
        <div class="row g-3 h-100">
            <div class="col-6 col-xl-3">
                <div class="d-metric h-100">
                    <div class="d-metric-label">Total Clients</div>
                    <div class="d-metric-value counter" data-target="@total">@total</div>
                    <div class="d-metric-sub mt-2">
                        <span class="trend-up">@onTrack on track</span>
                    </div>
                    <i class='bx bx-briefcase-alt-2 d-metric-icon'></i>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="d-metric accent-danger h-100">
                    <div class="d-metric-label">Penalty Exposure</div>
                    <div class="d-metric-value text-danger" style="font-size:1.5rem;">@risk</div>
                    <div class="d-metric-sub mt-2">
                        <button class="btn btn-xs btn-outline-danger" style="font-size:.68rem;padding:2px 8px;" onclick="scrollToRisk()">
                            Identify At-Risk
                        </button>
                    </div>
                    <i class='bx bx-trending-down d-metric-icon'></i>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="d-metric accent-warning h-100">
                    <div class="d-metric-label">Missing Data</div>
                    <div class="d-metric-value counter text-warning" data-target="@missing">@missing</div>
                    <div class="d-metric-sub mt-2">
                        clients need upload
                    </div>
                    <i class='bx bx-time-five d-metric-icon'></i>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="d-metric accent-info h-100">
                    <div class="d-metric-label">In Triage</div>
                    <div class="d-metric-value counter text-info" data-target="@inTriage">@inTriage</div>
                    <div class="d-metric-sub mt-2">
                        files pending review
                    </div>
                    <i class='bx bx-wrench d-metric-icon'></i>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Row 2: Charts + Rejections ──────────────────────── *@
<div class="row g-3 mb-4">

    @* Health donut *@
    <div class="col-12 col-md-4 col-xl-3">
        <div class="d-card h-100">
            <div class="d-card-header">
                <h6 class="d-card-title"><i class='bx bx-heart-circle me-2 text-success'></i>Client Health</h6>
            </div>
            <div class="card-body d-flex flex-column align-items-center">
                <div id="healthChart" style="height:160px;width:100%;"></div>
                <div class="d-flex gap-3 mt-2" style="font-size:.73rem;">
                    <span><i class='bx bxs-circle text-success me-1'></i>On Track <strong>@onTrack</strong></span>
                    <span><i class='bx bxs-circle text-warning me-1'></i>Missing <strong>@missing</strong></span>
                </div>
            </div>
        </div>
    </div>

    @* Filing pipeline *@
    <div class="col-12 col-md-4 col-xl-3">
        <div class="d-card h-100">
            <div class="d-card-header">
                <h6 class="d-card-title"><i class='bx bx-git-repo-forked me-2 text-primary'></i>Filing Pipeline</h6>
            </div>
            <div class="card-body">
                <div id="pipelineChart" style="height:160px;"></div>
                <div class="d-flex flex-column gap-2 mt-2">
                    <div class="d-stat-row">
                        <span class="text-muted" style="font-size:.75rem;">Data Collection</span>
                        <span class="fw-bold">@Model.Stage_DataCollection</span>
                    </div>
                    <div class="d-stat-row">
                        <span class="text-muted" style="font-size:.75rem;">Codes Generated</span>
                        <span class="fw-bold">@Model.Stage_CodesGenerated</span>
                    </div>
                    <div class="d-stat-row">
                        <span class="text-muted" style="font-size:.75rem;">Finalized</span>
                        <span class="fw-bold text-success">@Model.Stage_Finalized</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* IRS outcome *@
    <div class="col-12 col-md-4 col-xl-3">
        <div class="d-card h-100">
            <div class="d-card-header">
                <h6 class="d-card-title"><i class='bx bx-file-blank me-2 text-info'></i>IRS Outcomes</h6>
                @if (Model.AmRejectedCount > 0)
                {
                    <span class="badge bg-danger">@Model.AmRejectedCount Failed</span>
                }
            </div>
            <div class="card-body">
                <div id="filingOutcomeChart" style="height:160px;"></div>
                <div class="d-flex flex-column gap-2 mt-2">
                    <div class="d-stat-row">
                        <span class="text-muted" style="font-size:.75rem;">Accepted</span>
                        <span class="fw-bold text-success">@Model.AmAcceptedCount</span>
                    </div>
                    <div class="d-stat-row">
                        <span class="text-muted" style="font-size:.75rem;">Rejected</span>
                        <span class="fw-bold text-danger">@Model.AmRejectedCount</span>
                    </div>
                    <div class="d-stat-row">
                        <span class="text-muted" style="font-size:.75rem;">Pending</span>
                        <span class="fw-bold text-warning">@pending</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Critical rejections *@
    <div class="col-12 col-xl-3">
        <div class="d-card h-100 d-flex flex-column">
            <div class="d-card-header" style="background:rgba(255,62,29,.06);">
                <h6 class="d-card-title text-danger"><i class='bx bx-error-circle me-2'></i>Action Required</h6>
                @if (Model.AmRecentRejections?.Any() == true)
                {
                    <span class="badge bg-danger">@Model.AmRecentRejections.Count</span>
                }
            </div>
            <div class="card-body p-0 flex-grow-1 d-scroll" style="max-height:260px;">
                @if (Model.AmRecentRejections?.Any() == true)
                {
                    @foreach (var err in Model.AmRecentRejections)
                    {
                        <div class="d-flex align-items-start gap-2 p-3 border-bottom">
                            <span class="pulse-dot red mt-1 flex-shrink-0"></span>
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-semibold text-truncate" style="font-size:.82rem;">@err.EmployerName</div>
                                <div class="text-danger text-truncate" style="font-size:.72rem;" title="@err.StatusMessage">
                                    @err.StatusMessage
                                </div>
                            </div>
                            <a href="@Url.Action("CorrectionDetails", "Irs", new { id = err.SubmissionId })"
                               class="btn btn-xs btn-outline-danger flex-shrink-0" style="font-size:.68rem;padding:2px 8px;">Fix</a>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class='bx bx-check-circle bx-lg text-success d-block mb-2 mx-auto'></i>
                        <p class="fw-semibold text-success mb-0" style="font-size:.82rem;">No rejections!</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* ── Row 3: Portfolio table ───────────────────────────── *@
<div class="d-card">
    <div class="d-card-header">
        <h6 class="d-card-title"><i class='bx bx-list-ul me-2 text-primary'></i>Client Portfolio</h6>
        <div class="d-flex gap-2">
            <input type="text" id="amSearch" class="form-control form-control-sm"
                   placeholder="Search clients…" style="width:200px;">
            <select id="amFilter" class="form-select form-select-sm" style="width:140px;">
                <option value="all">All</option>
                <option value="missing">Missing Data</option>
                <option value="ready">On Track</option>
            </select>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="portfolioTable" style="font-size:.82rem;">
            <thead style="background:rgba(105,108,255,.04);">
                <tr>
                    <th class="ps-4 py-3" style="font-size:.68rem;letter-spacing:.5px;">CLIENT</th>
                    <th class="py-3" style="font-size:.68rem;letter-spacing:.5px;">CONTACT</th>
                    <th class="py-3" style="font-size:.68rem;letter-spacing:.5px;">LAST UPLOAD</th>
                    <th class="py-3" style="font-size:.68rem;letter-spacing:.5px;">STATUS</th>
                    <th class="pe-4 py-3" style="text-align:right;font-size:.68rem;letter-spacing:.5px;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var client in amClients)
                {
                    var statusKey = (client.ComplianceStatusId == 2) ? "missing" : "ready";
                    <tr class="client-row" data-status="@statusKey">
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar avatar-sm">
                                    <span class="avatar-initial rounded-circle bg-label-primary fw-bold">
                                        @(client.EmployerName?.Length > 0 ? client.EmployerName[0] : '?')
                                    </span>
                                </div>
                                <div>
                                    <div class="fw-semibold">@client.EmployerName</div>
                                    <div class="text-muted" style="font-size:.72rem;">EIN: @client.TaxId</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div style="font-size:.8rem;">@client.ContactPerson</div>
                            <a href="mailto:@client.ContactEmail" class="text-muted" style="font-size:.72rem;">@client.ContactEmail</a>
                        </td>
                        <td>
                            @if (client.LastUploadDate.HasValue)
                            {
                                var daysAgo = (DateTime.Now - client.LastUploadDate.Value).Days;
                                <span style="font-size:.8rem;">@client.LastUploadDate.Value.ToString("MMM dd")</span>
                                <div class="text-muted" style="font-size:.7rem;">@daysAgo days ago</div>
                            }
                            else
                            {
                                <span class="text-muted fst-italic" style="font-size:.78rem;">Never uploaded</span>
                            }
                        </td>
                        <td>
                            @if (client.ComplianceStatusId == 2)
                            {
                                <span class="risk-high">Missing Data</span>
                            }
                            else
                            {
                                <span class="risk-ok">On Track</span>
                            }
                        </td>
                        <td class="pe-4 text-end">
                            <a href="@Url.Action("Dashboard", "Employer", new { id = client.EmployerId })"
                               class="btn btn-sm btn-icon btn-outline-secondary me-1" title="Dashboard">
                                <i class='bx bx-tachometer'></i>
                            </a>
                            <a href="@Url.Action("Index", "FileUpload", new { employerId = client.EmployerId })"
                               class="btn btn-sm btn-icon btn-outline-primary" title="Upload">
                                <i class='bx bx-upload'></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!amClients.Any())
                {
                    <tr><td colspan="5" class="text-center py-5 text-muted">No clients assigned.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const total   = @total;
        const onTrack = @onTrack;
        const missing = @missing;
        const accepted= @Model.AmAcceptedCount;
        const rejected= @Model.AmRejectedCount;
        const pending = @pending;

        new ApexCharts(document.querySelector('#healthChart'), {
            series: [onTrack, missing],
            labels: ['On Track', 'Missing Data'],
            chart: { type: 'donut', height: 160 },
            colors: ['#71dd37', '#ffab00'],
            legend: { show: false },
            dataLabels: { enabled: false },
            stroke: { width: 0 },
            plotOptions: { pie: { donut: { size: '72%',
                labels: { show: true, total: { show: true, label: 'Total',
                           fontWeight: 700, formatter: () => total } } } } }
        }).render();

        new ApexCharts(document.querySelector('#pipelineChart'), {
            series: [{ data: [@Model.Stage_DataCollection, @Model.Stage_CodesGenerated, @Model.Stage_Finalized] }],
            chart: { type: 'bar', height: 160, toolbar: { show: false } },
            plotOptions: { bar: { borderRadius: 5, horizontal: true, distributed: true, barHeight: '60%' } },
            colors: ['#8592a3', '#696cff', '#71dd37'],
            xaxis: { categories: ['Data', 'Codes', 'Final'], labels: { style: { fontSize: '11px' } } },
            legend: { show: false },
            grid: { show: false, padding: { left: 10 } },
            dataLabels: { enabled: true, style: { fontSize: '11px', fontWeight: 700 } }
        }).render();

        new ApexCharts(document.querySelector('#filingOutcomeChart'), {
            series: [accepted, rejected, pending],
            labels: ['Accepted', 'Rejected', 'Pending'],
            chart: { type: 'donut', height: 160 },
            colors: ['#71dd37', '#ff3e1d', '#8592a3'],
            legend: { show: false },
            dataLabels: { enabled: false },
            stroke: { width: 0 },
            plotOptions: { pie: { donut: { size: '72%',
                labels: { show: true, total: { show: true, label: 'Filed',
                           fontWeight: 700, formatter: () => accepted + rejected } } } } }
        }).render();

        // Search
        document.getElementById('amSearch').addEventListener('keyup', function() {
            const v = this.value.toLowerCase();
            document.querySelectorAll('#portfolioTable tbody tr').forEach(tr => {
                tr.style.display = tr.textContent.toLowerCase().includes(v) ? '' : 'none';
            });
        });

        // Filter
        document.getElementById('amFilter').addEventListener('change', function() {
            const val = this.value;
            document.querySelectorAll('.client-row').forEach(tr => {
                tr.style.display = (val === 'all' || tr.dataset.status === val) ? '' : 'none';
            });
        });
    });

    function scrollToRisk() {
        document.getElementById('amFilter').value = 'missing';
        document.getElementById('amFilter').dispatchEvent(new Event('change'));
        document.querySelector('#portfolioTable').scrollIntoView({ behavior: 'smooth' });
    }
</script>
