@model ACA360.Core.Models.RuleWhatIfResult
@{
    var files = Model.Files;
    var compare = files.Any(f => f.NowFlagged > 0) || Model.NoLongerFlagged > 0;
}

<div class="border rounded p-3 mt-2" data-what-if>
    <h6 class="mb-2"><i class="bx bx-test-tube me-1"></i>What this rule would flag</h6>

    @foreach (var problem in Model.Problems)
    {
        <div class="alert alert-warning py-2 mb-2" role="alert"><i class="bx bx-error me-1"></i>@problem</div>
    }

    @if (files.Count == 0)
    {
        <p class="mb-0 text-body opacity-75">No recent files have rows in this table to try it on.</p>
    }
    else
    {
        <p class="mb-2">
            In the @files.Count most recent file@(files.Count == 1 ? "" : "s") it would flag
            <strong data-would-flag>@Model.WouldFlag.ToString("N0")</strong> row@(Model.WouldFlag == 1 ? "" : "s")@(compare ? "" : ".")
            @if (compare)
            {
                <text>; the saved rule flags <strong>@Model.NowFlagged.ToString("N0")</strong> there now
                (<span class="text-danger">+@Model.NewlyFlagged.ToString("N0") new</span>,
                <span class="text-success">@Model.NoLongerFlagged.ToString("N0") no longer</span>).</text>
            }
        </p>
        <div class="table-responsive position-relative">
            <table class="table table-sm align-middle mb-2">
                <thead class="table-light">
                    <tr>
                        <th>File</th><th>Employer</th><th class="text-end">Rows</th>
                        @if (compare) { <th class="text-end">Now</th> }
                        <th class="text-end">Would flag</th>
                        @if (compare) { <th class="text-end">New</th><th class="text-end">No longer</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in files)
                    {
                        <tr>
                            <td class="text-break">@f.FileName <small class="text-body opacity-75">#@f.FileLogId</small></td>
                            <td>@f.EmployerName @(f.PlanYear is int y ? $"({y})" : "")</td>
                            <td class="text-end">@f.TotalRows.ToString("N0")</td>
                            @if (compare) { <td class="text-end">@f.NowFlagged.ToString("N0")</td> }
                            <td class="text-end fw-semibold">@f.WouldFlag.ToString("N0") <small class="text-body opacity-75">(@(f.TotalRows == 0 ? 0 : Math.Round(100.0 * f.WouldFlag / f.TotalRows, 1))%)</small></td>
                            @if (compare)
                            {
                                <td class="text-end text-danger">@(f.NewlyFlagged > 0 ? "+" + f.NewlyFlagged.ToString("N0") : "0")</td>
                                <td class="text-end text-success">@f.NoLongerFlagged.ToString("N0")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Samples.Count > 0)
        {
            <details>
                <summary class="small">Example rows (@Model.Samples.Count)</summary>
                <div class="table-responsive position-relative mt-2">
                    <table class="table table-sm mb-0">
                        <thead class="table-light"><tr><th>File</th><th>Row</th><th>Value</th><th>Flagged now?</th></tr></thead>
                        <tbody>
                            @foreach (var s in Model.Samples)
                            {
                                <tr>
                                    <td>#@s.FileLogId</td>
                                    <td>@s.RowNumber</td>
                                    <td class="text-break">@(string.IsNullOrEmpty(s.Value) ? "(empty)" : s.Value)</td>
                                    <td>@(s.NowFlagged ? "Yes" : "No")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }
        <p class="small text-body opacity-75 mb-0 mt-2">Nothing was saved. The files' own errors are unchanged until the rule is saved and the files are validated again.</p>
    }
</div>
