@model ACA360.Core.Models.ContactSettingsViewModel

<div class="modal-body">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" asp-for="FAQ_SupportPhone">Support Phone Number</label>
                    <div class="input-group input-group-merge">
                        <span class="input-group-text"><i class="bx bx-phone"></i></span>
                        <input type="number" asp-for="FAQ_SupportPhone" class="form-control" placeholder="+(1) 2548 2568" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label" asp-for="FAQ_SupportEmail">Support Email Address</label>
                    <div class="input-group input-group-merge">
                        <span class="input-group-text"><i class="bx bx-envelope"></i></span>
                        <input type="email" asp-for="FAQ_SupportEmail" class="form-control" placeholder="help@aca360.com" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer py-3">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-primary">Save changes</button>
    </div>

</div>
