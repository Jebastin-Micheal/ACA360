@model IEnumerable<ACA360.Core.Models.FaqModel>

@{
    ViewData["Title"] = "Help Center & FAQ";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // 1. SAFE GROUPING: Use a Tuple (Name, Icon) instead of a dynamic anonymous type
    var groupedFaqs = Model?
        .Where(f => !string.IsNullOrWhiteSpace(f.Category))
        .GroupBy(f => (Name: f.Category, Icon: f.CategoryIcon))
        .ToList();

    bool isAdmin = User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("superadmin");
}

<!-- Page Specific CSS (To match the purple banner from the screenshot) -->


<div>

    <div class="faq-header d-flex flex-column justify-content-center align-items-center h-px-300 position-relative rounded overflow-hidden">

        <!-- Added absolute positioning to force the image behind the flex content -->
        <img src="~/assets/img/illustrations/header.png"
             class="position-absolute top-0 start-0 w-100 h-100 scaleX-n1-rtl faq-banner-img z-n1"
             style="object-fit: cover;"
             alt="background image">

        <h4 class="text-center mb-2">Hello, how can we help?</h4>
        <!-- Changed mb-0 to mb-4 to give the search box a little breathing room -->
        <p class="text-center mb-4 px-4">or choose a category to quickly find the help you need</p>

        <div class="w-50 d-flex gap-2">
            <div class="input-group input-group-merge shadow-sm rounded">
                <span class="input-group-text"><i class="bx bx-search"></i></span>
                <input type="text" id="faqSearchInput" class="form-control" placeholder="Search articles...">
            </div>
            @if (isAdmin)
            {
                <button type="button" class="btn btn-primary shadow-sm text-nowrap" onclick="openFaqModal()">
                    <i class="bx bx-plus me-1"></i> Add FAQ
                </button>
            }
        </div>
    </div>

    <!-- Main Content Layout (Side Tabs) -->
    <div class="row mt-4" id="faqLayoutContainer">

        <!-- Left Navigation Sidebar -->
        <div class="col-md-3 col-12 mb-md-0 mb-4" id="faqSidebar">
            <div class="nav-align-left">
                <ul class="nav nav-pills flex-column w-100" role="tablist">
                    @{
                        bool isFirstNav = true;
                    }
                    @foreach (var group in groupedFaqs)
                    {
                        string safeId = group.Key.Name.Replace(" ", "-").ToLower();
                        <li class="nav-item">
                            <button class="nav-link text-start @(isFirstNav ? "active" : "")"
                                    data-bs-toggle="tab"
                                    data-bs-target="#tab-@safeId"
                                    aria-selected="@(isFirstNav ? "true" : "false")"
                                    role="tab">
                                <i class='bx @(group.Key.Icon) me-2'></i> @group.Key.Name
                            </button>
                        </li>
                        isFirstNav = false;
                    }
                </ul>
            </div>

            <!-- Sneat Help Center Illustration -->
            <div class="text-center mt-5 d-none d-md-block">
                <img src="~/assets/img/illustrations/sitting-girl-with-laptop.png" class="img-fluid" alt="Image" width="150" data-app-light-img="illustrations/sitting-girl-with-laptop.png" data-app-dark-img="illustrations/sitting-girl-with-laptop.png" style="visibility: visible;">
            </div>
        </div>

        <!-- Right Content Area (Accordions) -->
        <div class="col-md-9 col-12">
            <div class="tab-content p-0 m-0 border-0 bg-transparent" id="faqTabContent">

                @{
                    bool isFirstContent = true;
                }
                @foreach (var group in groupedFaqs)
                {
                    string safeId = group.Key.Name.Replace(" ", "-").ToLower();

                    <div class="tab-pane fade @(isFirstContent ? "show active" : "") faq-category-pane" id="tab-@safeId" role="tabpanel">
                        <div class="d-flex align-items-center mb-4 category-header">
                            <div class="avatar avatar-sm me-2">
                                <span class="avatar-initial rounded bg-label-primary"><i class="bx @(group.Key.Icon) fs-5"></i></span>
                            </div>
                            <div class="me-auto">
                                <h5 class="mb-0 fw-bold">@group.Key.Name</h5>
                                <small class="text-muted">Frequently asked questions</small>
                            </div>
                            <!-- ADMIN CATEGORY CONTROLS -->
                            @if (isAdmin)
                            {
                                // Extract the actual Category ID safely
                                string catId = group.First().CategoryId;

                                <div class="dropdown">
                                    <button class="btn p-0" type="button" id="catMenu_@catId" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="bx bx-dots-vertical-rounded fs-4"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end" aria-labelledby="catMenu_@catId">
                                        <a class="dropdown-item" href="javascript:void(0);" onclick="openEditCategoryModal('@catId')">
                                            <i class="bx bx-edit-alt me-1"></i> Edit Category
                                        </a>
                                        <a class="dropdown-item text-danger" href="javascript:void(0);" onclick="deleteCategory('@catId')">
                                            <i class="bx bx-trash me-1"></i> Delete Category
                                        </a>
                                    </div>
                                </div>
                            }                        
                        </div>

                        <div class="accordion" id="accordion-@safeId">

                            @foreach (var faq in group.OrderBy(f => f.SortOrder))
                            {
                                <div class="card accordion-item mb-3 shadow-sm border-0 faq-item">
                                    <h2 class="accordion-header d-flex align-items-center" id="heading_@faq.Id">
                                        <button type="button" class="accordion-button collapsed text-dark fw-medium" data-bs-toggle="collapse" data-bs-target="#collapse_@faq.Id">
                                            @faq.Question
                                        </button>
                                    </h2>

                                    <div id="collapse_@faq.Id" class="accordion-collapse collapse" data-bs-parent="#accordion-@safeId">
                                        <div class="accordion-body text-muted pt-3">
                                            @Html.Raw(faq.Answer)

                                            <!-- ADMIN CONTROLS -->
                                            @if (isAdmin)
                                            {
                                                <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-3">
                                                    @if (!faq.IsActive)
                                                    {
                                                        <span class="badge bg-label-warning me-auto align-self-center">Draft</span>
                                                    }
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="openFaqModal('@faq.Id')">
                                                        <i class="bx bx-edit-alt me-1"></i> Edit
                                                    </button>
                                                    <form asp-controller="Faq" asp-action="Delete" asp-route-id="@faq.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this FAQ?');" style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <!-- Delete Button -->
                                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteFaq('@faq.Id')">
                                                            <i class="bx bx-trash me-1"></i> Delete
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    isFirstContent = false;
                }

                <div id="noSearchResults" class="alert alert-warning mt-4 text-center" style="display: none;">
                    No results found matching your search.
                </div>
            </div>
        </div>
    </div>

    <!-- Contact Section -->
    <div class="row mt-5 pt-4 border-top">
        <div class="col-12 text-center mb-4">
            <span class="badge bg-label-primary mb-2">Question?</span>
            <h4 class="fw-bold">You still have a question?</h4>
            <p class="text-muted">If you can't find the question in our FAQ, you can contact us. We'll answer you shortly!</p>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0 text-center position-relative">
                @if (isAdmin)
                {
                    <button type="button" class="btn btn-icon btn-sm btn-label-secondary position-absolute top-0 end-0 m-2" onclick="openContactModal()" title="Edit Contact Details">
                        <i class="bx bx-pencil"></i>
                    </button>
                }
                <div class="card-body py-5">
                    <div class="contact-card-icon">
                        <i class="bx bx-phone fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-1">@(ViewBag.FAQ_SupportPhone ?? "+(1) 2548 2568")</h5>
                    <p class="text-muted mb-0">We are always happy to help</p>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0 text-center position-relative">
                @if (isAdmin)
                {
                    <button type="button" class="btn btn-icon btn-sm btn-label-secondary position-absolute top-0 end-0 m-2" onclick="openContactModal()" title="Edit Contact Details">
                        <i class="bx bx-pencil"></i>
                    </button>
                }
                <div class="card-body py-5">
                    <div class="contact-card-icon">
                        <i class="bx bx-envelope fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-1">@(ViewBag.FAQ_SupportEmail ?? "help@aca360.com")</h5>
                    <p class="text-muted mb-0">Best way to get a quick answer</p>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Empty Modal Container -->
<div class="modal fade" id="faqModal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="faqModalTitle">Manage FAQ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="faqForm" action="Faq/SaveFaq" method="post">
                @Html.AntiForgeryToken()
                <div id="faqModalBody">
                    <!-- Partial view loads here -->
                </div>
            </form>
        </div>
    </div>
</div>

<!-- category Modal Container -->
<div class="modal fade" id="categoryModal" aria-hidden="true" style="z-index: 99999;">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <!-- We will change this title via JS depending on Add or Edit -->
                <h5 class="modal-title" id="categoryModalTitle">Add New Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <!-- The action URL will be swapped via JS -->
            <form id="categoryForm" action="/Faq/AddNewCategory" method="post">
                @Html.AntiForgeryToken()

                <!-- ADD THIS HIDDEN FIELD -->
                <input type="hidden" id="categoryId" name="categoryId" />

                <div class="modal-body">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">
                                <div class="mb-3 text-start">
                                    <label class="form-label" for="newCategoryName">Category Name</label>
                                    <!-- Fully editable standard input -->
                                    <input type="text" id="newCategoryName" name="categoryName" class="form-control" placeholder="e.g., Compliance" required>
                                </div>

                                <div class="mb-3 text-start">
                                    <label class="form-label" for="newCategoryIcon">Category Icon</label>
                                    <div class="position-relative">
                                        <select id="newCategoryIcon" name="categoryIcon" class="select2-icons form-select" required>
                                            <!-- Added the default Select Icon option -->
                                            <option value="" data-icon="" selected disabled>-- Select Icon --</option>

                                            @if (ViewBag.IconOptions != null)
                                            {
                                                var icons = (List<(string Value, string Text, string CssClass)>)ViewBag.IconOptions;

                                                foreach (var icon in icons)
                                                {
                                                    <option value="@icon.Value" data-icon="bx @icon.CssClass">@icon.Text</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Contact Settings Modal Container -->
<div class="modal fade" id="contactModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Help Center Contact</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="contactForm" action="Faq/SaveContactSettings" method="post">
                @Html.AntiForgeryToken()
                <div id="contactModalBody">
                    <!-- Partial view loads here -->
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/pvscript/faq-admin.js" asp-append-version="true"></script>
}