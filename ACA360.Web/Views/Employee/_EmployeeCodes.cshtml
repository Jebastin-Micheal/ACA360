@model ACA360.Web.Models.EmployeeListViewModel

<div class="col-12 mb-4">
    <div class="card">
        <div class="card-header border-bottom py-3">

            <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                <div>
                    <h5 class="mb-0 text-primary text-uppercase">Employee Codes</h5>
                   
                </div>
               
            </div>

            <div class="d-flex justify-content-between align-items-center pt-2">
                <div>
                   
                    <div class="col-md-8">
                        <div class="d-flex gap-2">
                            <h5 class="mb-0 text-danger fw-bold" id="riskCountDisplay">0</h5>
                            <small class="text-muted mb-0">At Risk Months</small>
                            <div id="riskDisplay_List" class="d-flex align-items-center gap-1 ms-2"></div>
                        </div>
                    </div>
                </div>
                <div>
                    <button type="button" class="btn btn-outline-secondary btn-sm btn_history" onclick="showAuditTimeline()">
                        <i class="bx bx-history me-1"></i> History
                    </button>
                </div>
            </div>
        </div>
        <div class="alert alert-info d-flex align-items-center mb-3">
            <i class="bx bx-info-circle fs-4 me-2"></i>
            <div>
                <strong>How to use this page:</strong>
                <ul class="mb-0 ps-3">
                    <li><strong>Click anywhere on a row</strong> to manually edit and lock employee codes.</li>
                    <li><strong>Click the <i class="bx bx-info-circle text-danger"></i> icon</strong> to view penalty risk details and apply auto-fix.</li>
                </ul>
            </div>
        </div>
        <div class="card-body pt-4">
            @if (Model.SelectedEmployeeDetails?.MonthlyCodes != null)
            {
                var codes = Model.SelectedEmployeeDetails.MonthlyCodes;
                var months = new[] { "JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC" };

                <div id="hiddenInputsContainer" class="d-none">
                    @foreach (var m in months)
                    {
                        var rawLcmp = codes.GetType().GetProperty($"{m}_LCMP")?.GetValue(codes);
                        string formattedLcmp = rawLcmp != null ? string.Format("{0:0.##}", rawLcmp) : "";

                        <input type="hidden" id="val_@(m)_COC" value="@(codes.GetType().GetProperty($"{m}_COC")?.GetValue(codes))" />
                        <input type="hidden" id="val_@(m)_LCMP" value="@formattedLcmp" />
                        <input type="hidden" id="val_@(m)_SHC" value="@(codes.GetType().GetProperty($"{m}_SHC")?.GetValue(codes))" />
                        <input type="hidden" id="val_@(m)_ZIP" value="@(codes.GetType().GetProperty($"{m}_ZIP")?.GetValue(codes))" />
                    }
                </div>

                <div class="month-card-container perfectscroller_left d-flex gap-2">

                    <div class="card month-card border-primary" id="card_ALL" onclick="openEditModal('ALL')">
                        <div class="month-card-header bg-label-primary text-primary fw-bold">ALL MONTHS</div>
                        <div class="month-card-body position-relative">
                            <div class="mb-1 fw-bold fs-5 text-primary" id="view_ALL_COC">-</div>
                            <div class="mb-1 small text-muted" id="view_ALL_LCMP"></div>
                            <div class="fw-semibold text-secondary" id="view_ALL_SHC">-</div>
                            <div class="small text-info" id="view_ALL_ZIP" title="Line 17 ZIP (ICHRA)">@(codes.ALLM_ZIP)</div>
                        </div>
                    </div>

                    @foreach (var m in months)
                    {
                        var c14 = codes.GetType().GetProperty($"{m}_COC")?.GetValue(codes)?.ToString() ?? "-";
                        var c16 = codes.GetType().GetProperty($"{m}_SHC")?.GetValue(codes)?.ToString() ?? "-";
                        var lcmp = codes.GetType().GetProperty($"{m}_LCMP")?.GetValue(codes)?.ToString();
                        string c15 = (decimal.TryParse(lcmp, out decimal d) && d > 0) ? "$" + d.ToString("0.00") : "";
                        var c17 = codes.GetType().GetProperty($"{m}_ZIP")?.GetValue(codes)?.ToString() ?? "";
                        <div class="card month-card" id="card_@m" data-month="@m" onclick="openEditModal('@m')">
                            <div class="month-card-header">@m</div>
                            <div class="month-card-body position-relative">
                                <div class="mb-1 fw-bold fs-5">
                                    <span class="bg-danger border border-light bx bx-error-circle risk-indicator d-none" style="width:12px; height:12px; cursor:pointer;" onclick="event.stopPropagation(); showRiskDetails('@m');"></span>
                                </div>
                                <div class="mb-1 fw-bold fs-5" id="view_@(m)_COC" data-cmp-field="@(m) Line 14" data-cmp-nolist="1">@c14</div>
                                <div class="mb-1 small text-muted" id="view_@(m)_LCMP" data-cmp-field="@(m) Line 15" data-cmp-nolist="1">@c15</div>
                                <div class="fw-semibold text-secondary" id="view_@(m)_SHC" data-cmp-field="@(m) Line 16" data-cmp-nolist="1">@c16</div>
                                <div class="small text-info" id="view_@(m)_ZIP" title="Line 17 ZIP (ICHRA)" data-cmp-field="@(m) Line 17" data-cmp-nolist="1">@c17</div>

                            </div>
                        </div>
                    }
                </div>

                <!-- Code Editing Modal -->
                <div class="modal fade" id="editCodeModal" tabindex="-1" data-bs-backdrop="static">
                    <div class="modal-dialog modal-xl modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header border-0">
                                <h5 class="modal-title fw-bold">Manual Override</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-body">
                                            <div class="alert alert-warning border-0 d-flex align-items-center mb-3"><i class='bx bxs-lock-alt me-2 fs-4'></i><span>Saving changes will <strong>LOCK</strong> this record.</span></div>
                                            <div class="table-responsive">
                                                <table class="table table-bordered text-center align-middle mb-0">
                                                    <thead class="bg-light text-secondary small fw-bold">
                                                        <tr>
                                                            <th style="width: 60px;">LINE</th>
                                                            @foreach (var m in months)
                                                            {
                                                                <th>@m</th>
                                                            }
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td class="fw-bold">14</td>
                                                            @foreach (var m in months)
                                                            {
                                                                <td class="p-2">
                                                                    <select class="form-select form-select-sm modal-input select2-aca" id="modal_@(m)_COC" style="width: 100%;">
                                                                        <option value=""></option>
                                                                        @foreach (var code in ViewBag.Line14Codes)
                                                                        {
                                                                            <option value="@code">@code</option>
                                                                        }
                                                                    </select>
                                                                </td>
                                                            }
                                                        </tr>

                                                        <tr>
                                                            <td class="fw-bold">15</td>
                                                            @foreach (var m in months)
                                                            {
                                                                <td class="p-2 align-middle" style="min-width: 100px;">
                                                                    <div class="input-group input-group-sm flex-nowrap">
                                                                        <span class="input-group-text bg-light px-2 text-muted">$</span>
                                                                        <input type="number" step="0.01" class="form-control modal-input text-muted vw-6" id="modal_@(m)_LCMP" min="0" onkeydown="return event.key !== '-' && event.key !== '+' && event.key !== 'e';">
                                                                    </div>
                                                                </td>
                                                            }
                                                        </tr>

                                                        <tr>
                                                            <td class="fw-bold">16</td>
                                                            @foreach (var m in months)
                                                            {
                                                                <td class="p-2">
                                                                    <select class="form-select form-select-sm modal-input select2-aca" id="modal_@(m)_SHC" style="width: 100%;">
                                                                        <option value=""></option>
                                                                        @foreach (var code in ViewBag.Line16Codes)
                                                                        {
                                                                            <option value="@code">@code</option>
                                                                        }
                                                                    </select>

                                                                </td>
                                                            }
                                                        </tr>
                                                        <tr>
                                                            <td class="fw-bold">17<br /><small class="text-muted fw-normal">ZIP</small></td>
                                                            @foreach (var m in months)
                                                            {
                                                                <td class="p-2">
                                                                    <input type="text" maxlength="10" readonly class="form-control form-control-sm text-center text-info bg-light" id="modal_@(m)_ZIP" title="ICHRA Line 17 ZIP (from employee/plan)">
                                                                </td>
                                                            }
                                                        </tr>
                                                        <tr>
                                                            <td class="fw-bold">Action</td>
                                                            @foreach (var m in new[] { "JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC" })
                                                            {
                                                                <th class="text-center align-middle" style="min-width: 95px;">
                                                                    <div class="d-flex justify-content-center gap-12">
                                                                        <i class='bx bx-chevrons-left cursor-pointer text-primary fs-5'
                                                                           onclick="propagateMonth('@m', 'left')"
                                                                           data-bs-toggle="tooltip" title="Apply all 3 lines to prior months"></i>

                                                                        <i class='bx bx-chevrons-right cursor-pointer text-primary fs-5'
                                                                           onclick="propagateMonth('@m', 'right')"
                                                                           data-bs-toggle="tooltip" title="Apply all 3 lines to future months"></i>
                                                                    </div>
                                                                </th>
                                                            }
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer border-0 pt-0 mt-3">
                                <div class="form-check me-auto mx-4">
                                    <input type="checkbox" class="form-check-input" id="chk_islocked" checked />
                                    <label class="form-check-label">Disable Automatic Coding</label>
                                </div>
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary px-4 employee_code_save" onclick="saveFromModal()">Update Codes</button></div>
                        </div>
                    </div>
                </div>

                <!-- Audit Modal -->
                <div class="modal fade" id="auditTimelineModal" tabindex="-1">
                    <div class="modal-dialog modal-lg modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Audit History</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-body" id="auditTimelineBody">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Risk Analysis Modal -->
                <div class="modal fade" id="riskAnalysisModal" tabindex="-1">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg">
                            <div class="modal-header bg-danger text-white">
                                <h6 class="modal-title mb-0"><i class='bx bxs-error-circle'></i> Penalty Risk Detail</h6>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body bg-light p-4">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-body">
                                            <h6 class="fw-bold mb-3">Employee: @Model.SelectedEmployeeDetails?.FirstName @Model.SelectedEmployeeDetails?.LastName</h6>
                                            <div class="alert alert-danger d-flex align-items-start mb-4" style="background-color: #ffe6e6; border-color: #ffcccc; color: #cc0000;">
                                                <div class="me-2 fw-bold">IRS Rule Impacted:</div>
                                                <div>Full-time employee was not offered coverage during the following month(s), with no affordability safe harbor applied.</div>
                                            </div>
                                            <div class="row g-3 mb-4">
                                                <div class="col-md-6">
                                                    <div class="card p-3 h-100 border shadow-sm">
                                                        <small class="text-muted">Estimated Annual Penalty :</small>
                                                        <h2 class="text-danger fw-bold my-2">$4,320</h2>
                                                        <small class="text-secondary">IRC §4980H(b)</small>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="card p-3 h-100 border shadow-sm">
                                                        <small class="text-muted">Recommended Fix</small>
                                                        <p class="small fw-bold mt-2">Offer affordable minimum value coverage or apply a safe harbor (2G – Federal Poverty Line or 2H – Rate of Pay).</p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="p-3 bg-secondary bg-opacity-10 rounded mb-4 text-heading">
                                                <strong>IRS 226J Defense Language:</strong>
                                                <p class="small mb-0 mt-1 text-muted text-heading">The employee was full-time and did not receive an offer of minimum essential coverage for 12 month(s). No safe harbor protection applies under IRC §4980H(b).</p>
                                            </div>
                                            <div id="riskMonthsSection" class="mb-4">
                                                <h6 class="fw-bold mb-2 text-dark">Risk Months:</h6>
                                                <div id="riskMonthsBadgeContainer" class="d-flex flex-wrap gap-2"></div>
                                            </div>
                                            <div class="d-flex justify-content-end gap-2 py-3">
                                                <div class="form-check me-auto mx-4">
                                                    <input type="checkbox" class="form-check-input" id="chk_islocked" checked />
                                                    <label class="form-check-label">Disable Automatic Coding</label>
                                                </div>
                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                                                <button type="button" class="btn btn-success" onclick="applyAutoFix()"><i class='bx bxs-magic-wand me-1'></i> Auto-Fix (Safe Harbor)</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

