@model ACA360.Web.Models.EmployeeListViewModel

<div class="table-responsive">
    <table class="table table-striped table-bordered text-center ui-table" id="coveredIndividualsTable">
        <thead>
            <tr>
                <th>First Name</th>
                <th>Middle Name</th>
                <th>Last Name</th>
                <th class="min-vw-10">SSN</th>
                <th class="min-vw-10">DOB</th>
                <th>All</th>
                <th>Jan</th>
                <th>Feb</th>
                <th>Mar</th>
                <th>Apr</th>
                <th>May</th>
                <th>Jun</th>
                <th>Jul</th>
                <th>Aug</th>
                <th>Sep</th>
                <th>Oct</th>
                <th>Nov</th>
                <th>Dec</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.SelectedEmployeeDetails?.CoveredIndividualCodes != null && Model.SelectedEmployeeDetails.CoveredIndividualCodes.Any())
            {
                int index = 0;
                foreach (var c in Model.SelectedEmployeeDetails.CoveredIndividualCodes)
                {
                    <tr class="edit-ci-row" style="cursor: pointer;"
                        data-index="@index"
                        data-id="@c.Id"
                        data-first="@c.FirstName"
                        data-middle="@c.MiddleName"
                        data-last="@c.LastName"
                        data-filingyear="@c.FilingYear"
                        data-ssn="@(string.IsNullOrEmpty(c.SSN) ? "N/A" : (CanViewSSNorEIN ? c.SSN : DataMasker.MaskSSN(c.SSN)))"
                        data-dob="@(c.Birthday?.ToShortDateString())"
                        data-all="@c.AllM.ToString().ToLower()"
                        data-jan="@c.Jan.ToString().ToLower()"
                        data-feb="@c.Feb.ToString().ToLower()"
                        data-mar="@c.Mar.ToString().ToLower()"
                        data-apr="@c.Apr.ToString().ToLower()"
                        data-may="@c.May.ToString().ToLower()"
                        data-jun="@c.Jun.ToString().ToLower()"
                        data-jul="@c.Jul.ToString().ToLower()"
                        data-aug="@c.Aug.ToString().ToLower()"
                        data-sep="@c.Sep.ToString().ToLower()"
                        data-oct="@c.Oct.ToString().ToLower()"
                        data-nov="@c.Nov.ToString().ToLower()"
                        data-dec="@c.Dec.ToString().ToLower()">

                        <td>@c.FirstName</td>
                        <td>@c.MiddleName</td>
                        <td>@c.LastName</td>
                        <td>@(string.IsNullOrEmpty(c.SSN) ? "N/A" : (CanViewSSNorEIN ? c.SSN : DataMasker.MaskSSN(c.SSN)))</td>
                        <td>@(c.Birthday?.ToShortDateString())</td>
                        <td><input type="checkbox" disabled @(c.AllM ? "checked" : "")></td>
                        <td><input type="checkbox" disabled @(c.Jan ? "checked" : "")></td>
                        <td><input type="checkbox" disabled @(c.Feb ? "checked" : "")></td>
                        <td><input type="checkbox" disabled @(c.Mar ? "checked" : "")></td>
                        <td><input type="checkbox" disabled @(c.Apr ? "checked" : "")></td>
                        <td><input type="checkbox" disabled @(c.May ? "checked" : "")></td>
                        <td><input type="checkbox" disabled @(c.Jun ? "checked" : "")></td>
                        <td><input type="checkbox" disabled @(c.Jul ? "checked" : "")></td>
                        <td><input type="checkbox" disabled @(c.Aug ? "checked" : "")></td>
                        <td><input type="checkbox" disabled @(c.Sep ? "checked" : "")></td>
                        <td><input type="checkbox" disabled @(c.Oct ? "checked" : "")></td>
                        <td><input type="checkbox" disabled @(c.Nov ? "checked" : "")></td>
                        <td><input type="checkbox" disabled @(c.Dec ? "checked" : "")></td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr><td colspan="18">No Covered Individuals Found</td></tr>
            }
        </tbody>
    </table>
</div>

<!-- Edit Covered Individual Modal -->
<div class="modal fade" id="editCoveredIndividualModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Covered Individual Coverage</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <input type="hidden" id="modal-ci-index" />

                            <!-- Read-Only Info (Single Row Layout) -->
                            <div class="row g-2 mb-4">
                                <div class="col">
                                    <label class="form-label">First Name</label>
                                    <input type="text" id="modal-ci-first" class="form-control form-control-sm" disabled />
                                </div>
                                <div class="col">
                                    <label class="form-label">Middle Name</label>
                                    <input type="text" id="modal-ci-middle" class="form-control form-control-sm" disabled />
                                </div>
                                <div class="col">
                                    <label class="form-label">Last Name</label>
                                    <input type="text" id="modal-ci-last" class="form-control form-control-sm" disabled />
                                </div>
                                <div class="col">
                                    <label class="form-label">SSN</label>
                                    <input type="text" id="modal-ci-ssn" class="form-control form-control-sm" disabled />
                                </div>
                                <div class="col">
                                    <label class="form-label">DOB</label>
                                    <input type="text" id="modal-ci-dob" class="form-control form-control-sm" disabled />
                                </div>
                            </div>

                            <hr />

                            <!-- Editable Checkboxes (Single Row Flexbox Layout) -->
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
                                <div class="form-check mb-0 ms-6">
                                    <input class="form-check-input" type="checkbox" id="modal-chk-all">
                                    <label class="form-check-label fw-bold text-primary" for="modal-chk-all">All</label>
                                </div>

                                @*<div class="vr d-none d-md-block"></div> <!-- Visual separator --> *@
                                @{
                                    string[] months = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
                                    foreach (var m in months)
                                    {
                                        <div class="form-check mb-0">
                                            <input class="form-check-input modal-chk-month" type="checkbox" id="modal-chk-@m.ToLower()" data-month="@m.ToLower()">
                                            <label class="form-check-label" for="modal-chk-@m.ToLower()">@m</label>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 mt-3">
                <div class="form-check me-auto mx-4">
                    <input type="checkbox" class="form-check-input" id="CI_chk_disable_coding" checked />
                    <label class="form-check-label" for="CI_chk_disable_coding">Disable Automatic Coding</label>
                </div>                
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveCI">Save</button>
            </div>
        </div>
    </div>
</div>

