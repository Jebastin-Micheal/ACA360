@using ACA360.Core.Extensions
@using ACA360.Web.Helpers;
@model ACA360.Web.Models.EmployeeListViewModel



<div class="card border-0 shadow-none">
    <table class="table table-bordered mb-0 ui-table">
        <thead>
            <tr>
                <th>
                    <div class="d-flex align-items-center justify-content-between gap-2">
                        @await Html.PartialAsync("_SortableHeader", new { Title = "Name", Column = "0", SortColumn = Model.SortColumn, SortOrder = Model.SortOrder })
                        @* Collapse the list to a vertical rail (shown in split/compare view). *@
                        <button type="button" id="listToggleBtn" class="cmp-icon-btn cmp-list-toggle" title="Hide the list">
                            <i class="bx bx-chevrons-left"></i>
                        </button>
                    </div>
                </th>
            </tr>
        </thead>
            <tbody>
                @if (Model.Employees != null && Model.Employees.Count > 0)
                {
                    foreach (var emp in Model.Employees)
                    {
                        var fullName = (emp.FirstName ?? "") + " " + (emp.LastName ?? "");

                        // ✅ USING EXTENSIONS (Clean & Reusable)
                        var colorClass = fullName.GetAvatarColor();
                        var initials = fullName.GetInitials();
                        var rowClass = emp.IsMissingData ? "row-missing" : (emp.FlagId.HasValue ? "row-flagged" : "");

                        <tr class="@rowClass">
                        <td class="employee-active">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center employee-item cursor-pointer" data-id="@emp.Id">
                                    <div class="avatar-wrapper me-3">
                                        <div class="avatar avatar-sm">
                                            <span class="avatar-initial rounded-circle @colorClass">@initials</span>
                                        </div>
                                    </div>
                                    <div class="d-flex flex-column" style="min-width: 0;">
                                        <span class="d-flex align-items-center">
                                            <span class="text-primary text-truncate3">@fullName</span>
                                            @if (emp.FlagId.HasValue)
                                            {
                                                var flagColor = emp.FlagSeverity switch
                                                {
                                                    "Critical" => "text-danger",
                                                    "Error" => "text-danger",
                                                    "Warning" => "text-warning",
                                                    _ => "text-info"
                                                };
                                                <i class="bx bxs-flag-alt @flagColor ms-1 flex-shrink-0" data-bs-toggle="tooltip" title="@($"{emp.FlagSeverity}: {emp.FlagDescription}")"></i>
                                            }
                                        </span>
                                        <small class="text-muted">@(string.IsNullOrEmpty(emp?.SSN) ? "N/A" : (CanViewSSNorEIN ? emp.SSN : DataMasker.MaskSSN(emp.SSN)))</small>
                                    </div>
                                </div>


                                <div class="dropdown">
                                    <button type="button" class="btn btn-sm btn-icon dropdown-toggle hide-arrow action-dots-btn" data-bs-toggle="dropdown">
                                        <i class="bx bx-dots-vertical-rounded"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end m-0 shadow-sm" style="min-width: 220px; padding-bottom: 8px;">
                                        @* Consent/Employee-Portal feature *@
                                        @if (User.IsInRole(ACA360.Core.Constants.UserRoles.Employer)
                                                                        || User.IsInRole(ACA360.Core.Constants.UserRoles.Admin)
                                                                        || User.IsInRole(ACA360.Core.Constants.UserRoles.ACADirector)
                                                                        || User.IsInRole(ACA360.Core.Constants.UserRoles.SuperAdmin))
                                        {
                                            <a href="@Url.Action("Confirmation", "Consent", new { id = emp.Id })" class="dropdown-item" title="Electronic Delivery Consent">
                                                <i class="bx bx-check-shield text-success me-1"></i> Consent Confirmation
                                            </a>
                                            <a href="@Url.Action("Activate", "PortalAdmin", new { id = emp.Id })" class="dropdown-item" title="Activate Portal Access">
                                                <i class="bx bx-key text-primary me-1"></i> Activate Portal Access
                                            </a>
                                            <div class="dropdown-divider"></div>
                                        }
                                        @* end Consent/Employee-Portal feature *@
                                        <!-- Delete Option -->
                                        <a href="javascript:void(0);" class="dropdown-item text-danger delete-employee-btn" data-employee-id="@emp.Id">
                                            <i class="bx bx-trash me-1"></i> Delete
                                        </a>

                                        <div class="dropdown-divider"></div>

                                        <!-- Generate Form Header -->
                                        <div class="px-3 py-1">
                                            <span class="fw-bold text-muted" style="font-size: 11px; text-transform: uppercase;">Generate Form</span>
                                        </div>

                                        <!-- Suppress SSN Toggle -->
                                        <div class="dropdown-item form-check form-switch  mx-0 ps-0 mb-1">
                                            <input class="form-check-input suppress-ssn-chk ms-3" type="checkbox" id="suppressSsn_am_@emp.Id" style="cursor: pointer;">
                                            <label class="form-check-label text-muted small ps-3" for="suppressSsn_am_@emp.Id" style="cursor: pointer; font-size: 12px;">
                                                Suppress SSN
                                            </label>
                                        </div>

                                        <!-- Form Types -->
                                        <a href="javascript:void(0);" class="dropdown-item form-gen-btn" data-emp-id="@emp.Id" data-form-type="1095-C">
                                            <i class="bx bxs-file-pdf text-danger me-1"></i> 1095-C
                                        </a>
                                        <a href="javascript:void(0);" class="dropdown-item form-gen-btn" data-emp-id="@emp.Id" data-form-type="1095-B">
                                            <i class="bx bxs-file-pdf text-danger me-1"></i> 1095-B
                                        </a>
                                        @* <a href="javascript:void(0);" class="dropdown-item form-gen-btn" data-emp-id="@emp.Id" data-form-type="1094-C_1095-C">
                                             <i class="bx bxs-file-pdf text-danger me-1"></i> 1094-C & 1095-C
                                           </a>
                                          <a href="javascript:void(0);" class="dropdown-item form-gen-btn" data-emp-id="@emp.Id" data-form-type="1094-B_1095-B">
                                              <i class="bx bxs-file-pdf text-danger me-1"></i> 1094-B & 1095-B
                                           </a> *@

                                    </div>
                                </div>
                            </div>
                        </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td class="text-center p-3">No employees found.</td></tr>
                }
            </tbody>
        </table>
</div>

@await Html.PartialAsync("_GridPagination", Model.Metadata)

<script>
    if(typeof PerfectScrollbar !== 'undefined') {
        const container = document.getElementById('splitListScroll');
        if(container) { new PerfectScrollbar(container, { wheelSpeed: 1 }); }
    }
</script>

@* ❌ DELETED @functions BLOCK - Logic is now in ACA360.Core.Extensions *@