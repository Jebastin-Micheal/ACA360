<!-- Employee Form Preview Modal -->
<div class="modal fade" id="employeePdfPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content h-100">
            <!-- Header -->
            <div class="modal-header bg-lighter py-2 align-items-center">
                <h5 class="modal-title text-primary me-3">
                    <i class='bx bxs-file-pdf me-2'></i> Form Preview
                </h5>
                <div class="d-flex align-items-center flex-grow-1">
                    <span id="employeePreviewLabel" class="badge bg-label-secondary ms-2 fw-normal"></span>

                    <!-- Fullscreen Toggle Button -->
                    <button type="button" class="btn btn-sm btn-icon btn-outline-secondary ms-3 toggle-fullscreen" data-target-modal="employeePdfPreviewModal" title="Toggle Fullscreen">
                        <i class='bx bx-fullscreen'></i>
                    </button>
                </div>
                <!-- Close Button -->
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Body with Iframe and Loader -->
            <div class="modal-body p-0 bg-dark text-center position-relative">
                <div id="employeePreviewLoader" class="position-absolute top-50 start-50 translate-middle">
                    <div class="spinner-border text-light" style="width: 3rem; height: 3rem;" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="text-light mt-2">Rendering PDF...</div>
                </div>
                <iframe id="employeePdfFrame" src="" class="w-100 h-100 border-0" style="min-height: 85vh; display: none;"></iframe>
            </div>
        </div>
    </div>
</div>



