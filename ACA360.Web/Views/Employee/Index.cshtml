@using ACA360.Core.Extensions
@using ACA360.Web.ViewComponents
@model ACA360.Web.Models.EmployeeListViewModel

@{
    ViewData["Title"] = "Employee Management";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Common Toolbar Config (affordability export lives in the quick-filter bar)
    var addEmployeeBtn = User.HasPermission("Employee", "Add") ?
        "<button class='btn btn-primary addEmployeeBtn' type='button'><i class='bx bx-plus me-1'></i> Add Employee</button>" : "";

    var toolbarConfig = new
    {
        IsEmployerPage = false,
        CustomButtons = addEmployeeBtn
    };
}

<link href="~/css/loaderstyle.css" rel="stylesheet" />
<link href="~/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" rel="stylesheet" />
<link href="~/assets/vendor/libs/select2/select2.css" rel="stylesheet" />
<link href="~/css/compare-core.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/employee-compare.css" rel="stylesheet" asp-append-version="true" />
<style>
    /* --- 1. SHARED GRID STYLES --- */
    .view-transition {
        transition: all 0.3s ease-in-out;
    }

    .employee-item.active-row {
        background-color: #e7f1ff !important;
        border-left: 4px solid #696cff !important;
    }

    .grid-sort-header {
        cursor: pointer;
    }

    /* Fix for Select2 in Offcanvas/Modal */
    .select2-container {
        z-index: 9999;
    }

    .swal2-container {
        z-index: 9999 !important;
    }
    /* Scrollbar for Partial View */
    #splitListScroll {
        position: relative;
        max-height: 500px;
        overflow: hidden;
    }

    /* Table Avatar (Small) */
    .avatar-initial {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 600;
        font-size: 12px;
    }

    /* --- 2. MODERN DRILL-DOWN SIDEBAR STYLES --- */

    /* The Sidebar Itself (Shadow & Border) */
    #employerSelectionSidebar {
        width: 100% !important; /* Matches parent width */
        max-width: 400px; /* Same as filter sidebar */
        border-right: 1px solid rgba(0,0,0,0.05);
        box-shadow: 5px 0 15px rgba(0,0,0,0.05);
        background-color: #f8f9fa; /* Light grey background for the list area */
    }

    /* The List Item (Card Style) */
    .emp-rich-item {
        padding: 12px 16px;
        border-bottom: 1px solid #f4f5f7;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
        background: #fff;
        position: relative;
        overflow: hidden;
    }

        .emp-rich-item:hover {
            background-color: #f0f2f5;
            padding-left: 20px; /* Slide effect */
        }

        /* Selected State */
        .emp-rich-item.selected {
            background-color: #f2f6ff;
            border-left: 4px solid #696cff;
        }

    /* Modern Avatar (Sidebar) */
    .emp-avatar {
        width: 40px;
        height: 40px;
        border-radius: 10px; /* Soft square */
        font-weight: 700;
        font-size: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        transition: transform 0.2s;
    }

    .emp-rich-item:hover .emp-avatar {
        transform: scale(1.05);
    }

    /* Custom Check Circle */
    .emp-check-circle {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 2px solid #d9dee3;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

    /* Checkmark Animation */
    .emp-rich-item.selected .emp-check-circle {
        background-color: #696cff;
        border-color: #696cff;
    }

    .emp-check-circle::after {
        content: '\2713'; /* Checkmark symbol */
        color: white;
        font-size: 14px;
        font-weight: bold;
        opacity: 0;
        transform: scale(0);
        transition: all 0.2s;
    }

    .emp-rich-item.selected .emp-check-circle::after {
        opacity: 1;
        transform: scale(1);
    }

    /* Sticky Header & Footer */
    .sidebar-header-sticky {
        position: sticky;
        top: 0;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(5px);
        z-index: 10;
        border-bottom: 1px solid #ebeef0;
    }

    .sidebar-footer-sticky {
        position: sticky;
        bottom: 0;
        background: #fff;
        border-top: 1px solid #ebeef0;
        z-index: 10;
        box-shadow: 0 -4px 10px rgba(0,0,0,0.02);
    }

    /* Tooltip Customization */
    .custom-tooltip-inner {
        max-width: 300px;
        text-align: left;
        white-space: pre-wrap;
    }

    /* --- GMAIL STYLE CHIPS --- */
    .emp-chip {
        display: inline-flex;
        align-items: center;
        background-color: #e7e7ff; /* Light Primary Background */
        color: #696cff; /* Primary Text Color */
        border-radius: 50px; /* Pill Shape */
        padding: 4px 10px;
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.2s;
        border: 1px solid transparent;
        max-width: 100%;
    }

        .emp-chip:hover {
            background-color: #dce0ff;
            border-color: #c3c4ff;
        }

    /* The 'X' remove button on the chip */
    .emp-chip-remove {
        margin-left: 6px;
        cursor: pointer;
        opacity: 0.6;
        font-size: 1.1em;
        line-height: 1;
        display: flex;
        align-items: center;
    }

        .emp-chip-remove:hover {
            opacity: 1;
            color: #ff3e1d; /* Red on hover */
        }

    /* The "+5 more" Expand Chip */
    .emp-chip-more {
        background-color: #f5f5f9;
        color: #697a8d;
        cursor: pointer;
        border: 1px solid #d9dee3;
        font-size: 0.8rem;
        padding: 4px 10px;
        border-radius: 50px;
        font-weight: 600;
    }

        .emp-chip-more:hover {
            background-color: #eceef1;
        }

    /* --- FILTER ACCORDION SECTIONS --- */
    .filter-section {
        border: 1px solid #e4e6ec;
        border-radius: 8px;
        background: #fff;
        margin-bottom: 8px;
    }

    .filter-section-head {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 12px;
        font-size: .85rem;
        font-weight: 600;
        color: #384551;
        cursor: pointer;
    }

        .filter-section-head i:first-child {
            font-size: 1.1rem;
        }

    .fs-chevron {
        transition: transform .2s;
    }

    .filter-section-head[aria-expanded="true"] .fs-chevron {
        transform: rotate(180deg);
    }

    .fs-badge {
        margin-left: auto;
        font-size: .7rem;
        font-weight: 600;
        padding: 2px 10px;
        border-radius: 50px;
        background: #f5f5f9;
        color: #697a8d;
        max-width: 150px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        .fs-badge.on {
            background: #e7e7ff;
            color: #696cff;
        }

    .fs-search {
        padding: 0 12px 8px;
    }

    .fs-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 7px 12px;
        font-size: .85rem;
        color: #384551;
        cursor: pointer;
    }

        .fs-row:hover {
            background: #f8f9fb;
        }

    .fs-selectall {
        border-top: 1px solid #f0f1f5;
        border-bottom: 1px solid #f0f1f5;
    }

    .fs-options {
        max-height: 240px;
        overflow-y: auto;
        padding-bottom: 4px;
    }

    .fs-cb {
        width: 16px;
        height: 16px;
        border: 1px solid #b9bec7;
        border-radius: 4px;
        background: #fff;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
        line-height: 1;
        color: #fff;
    }

        .fs-cb.checked,
        .fs-cb.indet {
            background: #696cff;
            border-color: #696cff;
        }

            .fs-cb.checked::after {
                content: '\2713';
            }

            .fs-cb.indet::after {
                content: '\2212';
            }

    /* Flag severity dots */
    .fs-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .fs-dot-danger {
        background: #ff3e1d;
    }

    .fs-dot-warning {
        background: #ffab00;
    }

    .fs-dot-info {
        background: #03c3ec;
    }

    .fs-empty {
        padding: 10px 12px;
        font-size: .8rem;
        color: #8592a3;
        text-align: center;
    }

    /* --- QUICK FILTER BADGE BAR --- */
    .quick-filter-btn {
        cursor: pointer;
        border: 1px solid transparent;
        transition: all .15s;
        user-select: none;
    }

        .quick-filter-btn:hover {
            border-color: currentColor;
        }

        .quick-filter-btn.active {
            border-color: currentColor;
            box-shadow: 0 0 0 2px rgba(0, 0, 0, .04);
            font-weight: 700;
        }

    /* --- ROW HIGHLIGHTS (flagged = light yellow, missing data = light pink) --- */
    tr.row-flagged > td {
        background-color: #fff8e1 !important;
    }

        tr.row-flagged > td:first-child {
            border-left: 3px solid #ffab00;
        }

    tr.row-missing > td {
        background-color: #fdecf2 !important;
    }

        tr.row-missing > td:first-child {
            border-left: 3px solid #ed93b1;
        }

    /* --- DETAIL PANEL NAV ROW (Prev / Next above detail card) --- */
    #empNavRow {
        min-height: 2rem;
    }

    

</style>
@await Component.InvokeAsync("Breadcrumb", new {
pageTitle = "Employee List",
    items = new List<BreadcrumbItem>
{
    new BreadcrumbItem { Title = "Employer", Url = Url.Action("Index", "Employer"), IsActive = false },
    new BreadcrumbItem { Title = "List of Employees", Url = "", IsActive = true }
    }
})

<div id="employeeListContainerWrapper" style="position:relative;">
    <input type="hidden" id="CurrentFilingYear" value="@ViewBag.FilingYear" />
    <input type="hidden" id="CurrentEmployerId" value="@ViewBag.EmployerId" />
    <div id="loader" class="loader" style="display:none;">
        <div class="spinner"></div>
    </div>

    <div class="card mb-6">
        <div class="card-body">

            @await Html.PartialAsync("_GridToolbarCommon", toolbarConfig)
            @await Html.PartialAsync("_CompareToolbar")


            @* Quick filter badge bar (All / Flagged / Missing / Valid + exports) *@
            <div class="d-flex gap-2 flex-wrap align-items-center mb-3" id="quickFilterBar">
                <span class="badge quick-filter-btn active bg-primary bg-opacity-10 text-primary px-3 py-2" data-qf="all" role="button" title="Show all employees">
                    <i class="bx bx-group me-1"></i>
                    <span id="qf-count-all">-</span> All
                </span>
                <span class="badge quick-filter-btn bg-warning bg-opacity-10 text-warning px-3 py-2" data-qf="flagged" role="button" title="Employees with at least one flag">
                    <i class="bx bxs-flag-alt me-1"></i>
                    <span id="qf-count-flagged">-</span> Flagged
                </span>
                <span class="badge quick-filter-btn bg-danger bg-opacity-10 text-danger px-3 py-2" data-qf="missing" role="button" title="Missing hire, status, coverage or payroll data">
                    <i class="bx bx-error me-1"></i>
                    <span id="qf-count-missing">-</span> Missing Data
                </span>
                <span class="badge quick-filter-btn bg-success bg-opacity-10 text-success px-3 py-2" data-qf="valid" role="button" title="No flags and no missing data">
                    <i class="bx bx-check-circle me-1"></i>
                    <span id="qf-count-valid">-</span> Valid
                </span>

                <button type="button" class="btn btn-sm btn-label-warning" id="btnExportFlagged" title="Download flagged employees (Excel)">
                    <i class="bx bxs-flag-alt me-1"></i><i class="bx bx-download"></i>
                </button>
                <button type="button" class="btn btn-sm btn-label-primary" id="btnExportAffordability" title="Extract Affordability (Excel)">
                    <i class="bx bx-dollar-circle me-1"></i><i class="bx bx-download"></i>
                </button>
                <button type="button" class="btn btn-sm btn-label-danger" id="btnFixFlagged" title="Fix all flagged"><i class="bx bx-target-lock"></i></button>
                @* ── Prev / Record count / Next – same line as quick filter, right side ── *@
                @* Hidden until split view loads an employee (d-none toggled by updateNavBar) *@
                <div id="empNavRow" class="d-none ms-auto">
                    <div class="btn-group btn-group-sm" role="group" aria-label="Employee navigation">
                        <button type="button" id="btnEmpPrev"
                                class="btn btn-outline-secondary"
                                title="Previous employee" disabled>
                            <i class="bx bx-chevron-left me-1"></i>Prev
                        </button>
                        <button type="button" class="btn btn-outline-secondary pe-none border-start-0 border-end-0"
                                tabindex="-1" aria-hidden="true">
                            <span id="empNavCounter" class="emp-nav-counter fw-semibold text-body small">— of —</span>
                        </button>
                        <button type="button" id="btnEmpNext"
                                class="btn btn-outline-secondary"
                                title="Next employee" disabled>
                            Next<i class="bx bx-chevron-right ms-1"></i>
                        </button>
                    </div>
                </div>
                <span id="employeeCompareSlot" class="d-flex align-items-center gap-2"></span>
                <span id="employeeCompareRightSlot" class="d-flex align-items-center gap-2 d-none"></span>
            </div>

            <div class="row view-transition">
                @* 🔹 Dynamic List Column Classes *@
                <div id="mainListColumn" class="view-transition @(Model.ViewMode == "Split" ? "col-lg-4 col-md-5" : "col-12")">
                    <div class="emp-list-rail bg-primary" title="Show the employee list">
                        <div class="vs-tab">
                            <i class="bx bx-list-ul text-white"></i>
                            <span class="vs-tab-label">L<br>i<br>s<br>t</span>
                        </div>
                    </div>
                    <div id="employeeListContainer">
                        @* 🔹 Server-side choice of partial based on saved ViewMode *@
                        @if (Model.ViewMode == "Split")
                        {
                            @await Html.PartialAsync("_EmployeeListPartial_am", Model)
                        }
                        else
                        {
                            @await Html.PartialAsync("_EmployeeListPartial", Model)
                        }
                    </div>
                </div>

                @* 🔹 Dynamic Detail Column Visibility *@
                <div id="mainDetailColumn" class="view-transition @(Model.ViewMode == "Split" ? "col-lg-8 col-md-7" : "d-none")">
                    <div class="card h-100 border bg-lighter">
                        <div class="card-body" id="commonDetailContainer">
                            @await Html.PartialAsync("_DefaultEmployeedetails")
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="offcanvas offcanvas-start" tabindex="-1" id="filterSidebar">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title">Filters</h5>
        <a href="javascript:void(0);" id="btnResetAllFilters" class="small fw-semibold ms-auto me-3" title="Back to default: everything selected">Reset all</a>
        <button type="button" class="btn-close text-reset m-0" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <form id="filterForm">

            @* Active (non-default) filters as removable chips *@
            <div id="activeFilterChips" class="d-flex flex-wrap gap-2 mb-3"></div>

            <div class="mb-3">
                <label class="form-label fw-bold text-uppercase small text-muted">Employers</label>

                <div class="input-group input-group-merge shadow-sm" id="employerTriggerGroup" style="cursor: pointer; border-radius: 8px; overflow: hidden; border: 1px solid #d9dee3;">
                    <span class="input-group-text bg-white border-end-0 ps-3"><i class="bx bx-buildings text-primary"></i></span>
                    <input type="text" class="form-control bg-white border-start-0" id="employerDisplay" placeholder="Select Employers..." readonly style="font-weight: 500;">
                    <span class="input-group-text bg-white"><i class="bx bx-chevron-right text-muted"></i></span>
                </div>

                <div id="selectedEmployerChips" class="d-flex flex-wrap gap-2 mt-2"></div>

                <input type="hidden" id="employerFilterIDs" name="employerFilterIDs" />
            </div>

            <div id="filterAccordion">

            <div class="offcanvas offcanvas-start" tabindex="-1" id="employerSelectionSidebar" style="z-index: 10001;">

                <div class="offcanvas-header sidebar-header-sticky p-3">
                    <button type="button" class="btn btn-icon btn-sm btn-label-secondary me-2" data-bs-dismiss="offcanvas">
                        <i class="bx bx-arrow-back"></i>
                    </button>
                    <h5 class="offcanvas-title mb-0">Select Employers</h5>
                </div>

                <div class="px-3 pb-3 border-bottom bg-light">
                    <div class="input-group input-group-merge mb-3 bg-white rounded-pill shadow-sm" style="border: 1px solid #e0e0e0;">
                        <span class="input-group-text border-0 bg-transparent ps-3"><i class="bx bx-search text-muted"></i></span>
                        <input type="text" class="form-control border-0 bg-transparent" id="empSearchInput" placeholder="Search by name...">
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <div class="form-check m-0">
                            <input class="form-check-input" type="checkbox" id="selectAllEmp">
                            <label class="form-check-label fw-semibold text-muted" for="selectAllEmp">Select All</label>
                        </div>
                        <span class="badge bg-label-primary rounded-pill" id="selectedCountDisplay">0 Selected</span>
                    </div>
                </div>

                <div class="offcanvas-body p-0" id="employerListBody" style="background-color: #f8f9fa;">
                    <div class="text-center p-5"><div class="spinner-border text-primary"></div></div>
                </div>

                <div class="p-3 sidebar-footer-sticky d-flex gap-2">
                    <button type="button" class="btn btn-label-danger w-50" id="btnClearSelection">Clear</button>
                    <button type="button" class="btn btn-primary w-50 shadow-sm" data-bs-dismiss="offcanvas">
                        <i class="bx bx-check me-1"></i> Done
                    </button>
                </div>
            </div>

                <div class="filter-section">
                    <div class="filter-section-head" data-bs-toggle="collapse" data-bs-target="#fsBody_plan" role="button" aria-expanded="true">
                        <i class="bx bx-clipboard text-primary"></i>
                        <span>Plan</span>
                        <span class="fs-badge" id="fsBadge_plan">All</span>
                        <i class="bx bx-chevron-down fs-chevron text-muted"></i>
                    </div>
                    <div class="collapse show" id="fsBody_plan">
                        <div class="fs-search">
                            <input type="text" class="form-control form-control-sm fs-search-input" placeholder="Search plans...">
                        </div>
                        <div class="fs-row fs-selectall">
                            <span class="fs-cb"></span>
                            <span class="fw-semibold">Select all</span>
                            <span class="fs-matches ms-auto small text-muted"></span>
                        </div>
                        <div class="fs-options"></div>
                    </div>
                </div>

                <div class="filter-section">
                    <div class="filter-section-head" data-bs-toggle="collapse" data-bs-target="#fsBody_status" role="button" aria-expanded="true">
                        <i class="bx bx-user-check text-primary"></i>
                        <span>Status</span>
                        <span class="fs-badge" id="fsBadge_status">All</span>
                        <i class="bx bx-chevron-down fs-chevron text-muted"></i>
                    </div>
                    <div class="collapse show" id="fsBody_status">
                        <div class="fs-row fs-selectall">
                            <span class="fs-cb"></span>
                            <span class="fw-semibold">Select all</span>
                            <span class="fs-matches ms-auto small text-muted"></span>
                        </div>
                        <div class="fs-options"></div>
                    </div>
                </div>

                <div class="filter-section">
                    <div class="filter-section-head" data-bs-toggle="collapse" data-bs-target="#fsBody_enrollment" role="button" aria-expanded="true">
                        <i class="bx bx-shield-quarter text-primary"></i>
                        <span>Enrollment</span>
                        <span class="fs-badge" id="fsBadge_enrollment">All</span>
                        <i class="bx bx-chevron-down fs-chevron text-muted"></i>
                    </div>
                    <div class="collapse show" id="fsBody_enrollment">
                        <div class="fs-row fs-selectall">
                            <span class="fs-cb"></span>
                            <span class="fw-semibold">Select all</span>
                            <span class="fs-matches ms-auto small text-muted"></span>
                        </div>
                        <div class="fs-options"></div>
                    </div>
                </div>

                <div class="filter-section">
                    <div class="filter-section-head" data-bs-toggle="collapse" data-bs-target="#fsBody_flag" role="button" aria-expanded="true">
                        <i class="bx bx-flag text-primary"></i>
                        <span>Flag</span>
                        <span class="fs-badge" id="fsBadge_flag">All</span>
                        <i class="bx bx-chevron-down fs-chevron text-muted"></i>
                    </div>
                    <div class="collapse show" id="fsBody_flag">
                        <div class="fs-search">
                            <input type="text" class="form-control form-control-sm fs-search-input" placeholder="Search flags...">
                        </div>
                        <div class="fs-row fs-selectall">
                            <span class="fs-cb"></span>
                            <span class="fw-semibold">Select all</span>
                            <span class="fs-matches ms-auto small text-muted"></span>
                        </div>
                        <div class="fs-options"></div>
                    </div>
                </div>

                <div class="filter-section">
                    <div class="filter-section-head" data-bs-toggle="collapse" data-bs-target="#fsBody_other" role="button" aria-expanded="true">
                        <i class="bx bx-file text-primary"></i>
                        <span>Others</span>
                        <span class="fs-badge" id="fsBadge_other">All</span>
                        <i class="bx bx-chevron-down fs-chevron text-muted"></i>
                    </div>
                    <div class="collapse show" id="fsBody_other">
                        <div class="fs-row fs-selectall">
                            <span class="fs-cb"></span>
                            <span class="fw-semibold">Select all</span>
                            <span class="fs-matches ms-auto small text-muted"></span>
                        </div>
                        <div class="fs-options"></div>
                    </div>
                </div>

            </div>

        </form>
    </div>
    <div class="offcanvas-footer border-top p-3 d-flex gap-2">
        <button type="button" class="btn btn-label-danger w-100" id="btn_clear_filters">Clear</button>
        <button type="button" class="btn btn-label-secondary w-100" data-bs-dismiss="offcanvas">Cancel</button>
        <button type="button" class="btn btn-primary w-100" id="btn_apply_filters" data-bs-dismiss="offcanvas">Apply filters</button>
    </div>
</div>

<button type="button" class="btn btn-primary d-none" id="launch_modal" data-bs-toggle="modal" data-bs-target="#basicModal"></button>
<div class="modal fade" id="basicModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Employee</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body"></div>
        </div>
    </div>
