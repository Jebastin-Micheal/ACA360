            window.openFlaggedGrid($('#employerFilterIDs').val() || '', '@ViewBag.FilingYear', '@Url.Action("FlaggedGrid", "Flags")');
        });
    </script>
    <script>
        $(document).ready(function () {
            // =========================================================
            // 1. FIX MAIN FILTER BUTTON
            // =========================================================
            var $filterBtn = $('[data-bs-target="#filterCollapse"]');
            if ($filterBtn.length > 0) {
                $filterBtn.removeAttr('data-bs-toggle').removeAttr('data-bs-target');
                $filterBtn.on('click', function(e) {
                    e.preventDefault();
                    var el = document.getElementById('filterSidebar');
                    var bsOffcanvas = bootstrap.Offcanvas.getInstance(el) || new bootstrap.Offcanvas(el);
                    bsOffcanvas.show();
                });
            }
            // =========================================================
            // 2. INITIALIZE FILTER SECTIONS (accordion checklists)
            // =========================================================
            FilterSections.init('plan', 'Plan', []);
            FilterSections.init('status', 'Status', [
                { value: '0', text: 'FULL-TIME' },
                { value: '1', text: 'PART-TIME' },
                { value: '-2', text: 'No status' } // employees with no status history
            ]);
            FilterSections.init('enrollment', 'Enrollment', [
                { value: '1', text: 'Not Offered' },
                { value: '2', text: 'Offered & Waived' },
                { value: '3', text: 'Offered & Enrolled' },
                { value: '4', text: 'Union' },
                { value: '5', text: 'COBRA' },
                { value: '6', text: 'Retiree' }
            ]);
            FilterSections.init('flag', 'Flags', []);
            FilterSections.init('other', 'Others', [
                { value: '1', text: 'Receiving Forms' },
                { value: '0', text: 'Not Receiving Forms' }
            ]);

            $('#btnResetAllFilters').click(function () {
                // Back to default: everything selected
                FilterSections.resetAll();
                selectAllEmployers();
            });

            $('#btn_clear_filters').click(function () {
                // Empty every selection so the user can pick from scratch
                FilterSections.clearAll();
                clearEmployerSelection();
            });

            // =========================================================
            // 2b. QUICK FILTER BAR (All / Flagged / Missing / Valid)
            // =========================================================
            $('#quickFilterBar').on('click', '.quick-filter-btn', function () {
                $('#quickFilterBar .quick-filter-btn').removeClass('active');
                $(this).addClass('active');
                currentQuickFilter = $(this).data('qf');
                GridManager.reload({ pageIndex: 1 });
            });

            // Excel exports (fetch + blob: no page navigation, so the global
            // beforeunload page-loader never fires and can't get stuck)
            $('#btnExportFlagged').click(function () {
                var ids = encodeURIComponent($('#employerFilterIDs').val() || '');
                downloadFile('@Url.Action("ExportFlaggedEmployees", "Employee")' + '?employerIds=' + ids, $(this));
            });

            $('#btnExportAffordability').click(function () {
                downloadFile('@Url.Action("ExportAffordability", "Employee")', $(this));
            });

            refreshQuickStats();
         // =========================================================
         // TODO karthi: Prev/Next WHOLE-LIST navigation + split-view record helpers.
         // Whole filtered id list (syncNavList → GetFilteredEmployeeIds), page-following
         // (syncListToRecord), row highlight, detail load and first-row selection.
         // =========================================================
        function buildEmployeeFilters() {
            var empStr = $('#employerFilterIDs').val();
            var fs = (typeof FilterSections !== 'undefined' && FilterSections)
                ? FilterSections
                : { getValues: function () { return []; } };
            return {
                Employer_IDs: empStr ? empStr.split(',').map(Number) : [],
                PlanIDs: fs.getValues('plan'),
                Statuses: fs.getValues('status'),
                EnrollmentIDs: fs.getValues('enrollment'),
                Flags: fs.getValues('flag'),
                OtherIDs: fs.getValues('other'),
                QuickFilter: (typeof currentQuickFilter !== 'undefined' && currentQuickFilter) ? currentQuickFilter : 'all',
                viewMode: GridManager.getState().viewMode,
                FilingYear: '@ViewBag.FilingYear'
            };
        }

        var _lastNavFilterSig = null;
        function navFilterSignature() {
            var s = GridManager.getState();
            return JSON.stringify([s.search, s.sortColumn, s.sortOrder, buildEmployeeFilters()]);
        }

        var _pendingNavRecordId = null;

        var _navFetchInFlight = false;
        var _navFetchPending  = false;
        window.syncNavList = function () {
            if (_navFetchInFlight) { _navFetchPending = true; return; }
            _navFetchInFlight = true;

            var s = GridManager.getState();
           var params = $.extend({
            search: (s.search == null ? '' : s.search),
            sortColumn: (s.sortColumn == null ? 0 : s.sortColumn),
            sortOrder: (s.sortOrder == null ? 'asc' : s.sortOrder)
        }, buildEmployeeFilters());

            return $.ajax({
                url: '@Url.Action("GetFilteredEmployeeIds", "Employee")',
                type: 'GET', data: params, traditional: true
            }).done(function (ids) {
                var full = (ids || []).map(String);
                if (full.length) { EmployeeState.setFilteredList(full); window.updateNavBar(); }
            }).fail(function () {
                if (window.console) console.warn('syncNavList: full-list fetch failed; using current-page list.');
            }).always(function () {
                _navFetchInFlight = false;
                if (_navFetchPending) { _navFetchPending = false; window.syncNavList(); }
            });
        };

        window.highlightListRow = function (recordId) {
            var $row = $('.employee-item[data-id="' + String(recordId) + '"]');
            if (!$row.length) return false;
            $('.employee-active, tr.employee-item').removeClass('table-active active-row');
            $row.closest('.employee-active, tr').addClass('table-active active-row');
            $('#splitListScroll, #employeeListContainer').each(function () {
                var $c = $(this);
                var rowTop = $row.offset().top, listTop = $c.offset().top, st = $c.scrollTop();
                $c.animate({ scrollTop: st + (rowTop - listTop) - 80 }, 200);
            });
            return true;
        };

        window.syncListToRecord = function (recordId) {
            recordId = String(recordId);
            if (window.highlightListRow(recordId)) return;
            var list = EmployeeState.getFilteredList();
            var idx  = list.indexOf(recordId);
            if (idx < 0) return;
            var st = GridManager.getState();
            var pageSize = parseInt(st.pageSize, 10) || 25;
            var targetPage = Math.floor(idx / pageSize) + 1;
            if (targetPage !== parseInt(st.pageIndex, 10)) {
                _pendingNavRecordId = recordId;
                GridManager.reload({ pageIndex: targetPage });
            }
        };

        window.loadEmpDetail = function (recordId) {
            var $c = $('#commonDetailContainer');
            $c.html('<div class="text-center p-5"><div class="spinner-border text-primary"></div></div>');
            $.ajax({
                url: '@Url.Action("GetEmployeeBasicDetails", "Employee")',
                type: 'GET', data: { employeeId: recordId },
                success: function (data) {
                    $c.html(data);
                     if (window.EmployeeCompare) window.EmployeeCompare.onDetailLoaded(recordId, window.__cmpEmployeeYear);

                    if (typeof window.calculateRiskAll        === 'function') window.calculateRiskAll($c);
                    if (typeof window.fetchPenaltyDetails     === 'function') window.fetchPenaltyDetails($c);
                    if (typeof window.refreshMonthCardDisplay === 'function') window.refreshMonthCardDisplay($c);
                    if (typeof initModalUI                    === 'function') initModalUI($c);
                    if (typeof window.updateNavBar            === 'function') window.updateNavBar();
                },
                error: function () {
                    $.get('@Url.Action("GetDefaultView", "Employee")', function (html) { $('#commonDetailContainer').html(html); });
                    if (typeof window.updateNavBar === 'function') window.updateNavBar();
                }
            });
        };

        window.selectFirstRowOnPage = function () {
            var pageIds = (typeof EmployeeApi !== 'undefined') ? EmployeeApi.getFilteredIdsFromDom() : [];
            if (!pageIds.length) {
                $.get('@Url.Action("GetDefaultView", "Employee")', function (html) { $('#commonDetailContainer').html(html); });
                EmployeeState.setEmployeeId(null);
                if (typeof window.updateNavBar === 'function') window.updateNavBar();
                return;
            }
            var firstId = pageIds[0];
            EmployeeState.setEmployeeIdAndSync(firstId);
            window.highlightListRow(firstId);
            window.loadEmpDetail(firstId);
        };



