        //             if (result.isConfirmed) { $.ajax({ url: '/Employee/DeleteEmployee', type: 'POST', data: { id: empId }, success: function (response) { if (response.success) { Swal.fire('Deleted!', response.message, 'success'); GridManager.reload(); } else { Swal.fire('Failed!', response.message, 'error'); } } }); }
        //         });
        //     });

        });       

        // =========================================================
        // 6. HELPER FUNCTIONS
        // =========================================================

        // Active quick filter: 'all' | 'flagged' | 'missing' | 'valid'
        var currentQuickFilter = 'all';

        function refreshQuickStats() {
            // Send the SAME filters the grid uses (minus the quick filter itself)
            // so the badge counts always describe the currently applied subset.
            var empStr = $('#employerFilterIDs').val();
            $.ajax({
                url: '@Url.Action("GetEmployeeQuickStats", "Employee")',
                type: 'GET',
                traditional: true,
                data: {
                    Employer_IDs: empStr ? empStr.split(',').map(Number) : [],
                    PlanIDs: FilterSections.getValues('plan'),
                    Statuses: FilterSections.getValues('status'),
                    EnrollmentIDs: FilterSections.getValues('enrollment'),
                    Flags: FilterSections.getValues('flag'),
                    OtherIDs: FilterSections.getValues('other'),
                    Search: $('.grid-search-input').val() || ''
                },
                success: function (d) {
                    if (!d) return;
                    $('#qf-count-all').text(d.allCount ?? d.AllCount ?? 0);
                    $('#qf-count-flagged').text(d.flaggedCount ?? d.FlaggedCount ?? 0);
                    $('#qf-count-missing').text(d.missingCount ?? d.MissingCount ?? 0);
                    $('#qf-count-valid').text(d.validCount ?? d.ValidCount ?? 0);
                }
            });
        }

        // Download a file WITHOUT navigating: the layout shows the full-page
        // loader on beforeunload, and a file download never unloads the page,
        // so <a href> downloads left the loader spinning forever. fetch+blob
        // avoids navigation entirely; the button shows its own spinner.
        function downloadFile(url, $btn) {
            var originalHtml = $btn.html();
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

            fetch(url, { credentials: 'same-origin' })
                .then(function (resp) {
                    if (!resp.ok) throw new Error('Download failed (' + resp.status + ')');
                    var fileName = 'download.xlsx';
                    var cd = resp.headers.get('content-disposition');
                    if (cd) {
                        var m = /filename\*?=(?:UTF-8'')?"?([^";]+)"?/i.exec(cd);
                        if (m && m[1]) fileName = decodeURIComponent(m[1]);
                    }
                    return resp.blob().then(function (blob) { return { blob: blob, fileName: fileName }; });
                })
                .then(function (r) {
                    var a = document.createElement('a');
                    a.href = URL.createObjectURL(r.blob);
                    a.download = r.fileName;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    setTimeout(function () { URL.revokeObjectURL(a.href); }, 2000);
                })
                .catch(function (err) {
                    if (typeof Swal !== 'undefined') Swal.fire('Download failed', err.message, 'error');
                    else alert(err.message);
                })
                .finally(function () {
                    $btn.prop('disabled', false).html(originalHtml);
                });
        }

        // Accordion checklist filters. Everything selected (the default) or
        // nothing selected both mean "don't restrict by this filter" — the
        // request then sends an empty list so the SP skips the predicate.
        var FilterSections = (function () {
            var sections = {};

            function init(key, label, options) {
                sections[key] = { key: key, label: label, options: [], selected: {} };
                var $body = $('#fsBody_' + key);

                $body.find('.fs-search-input').on('keyup', function () { render(key); });

                $body.find('.fs-selectall').on('click', function () {
                    var s = sections[key];
                    var visible = visibleOptions(key);
                    var allChecked = visible.length > 0 && visible.every(function (o) { return s.selected[o.value]; });
                    visible.forEach(function (o) {
                        if (allChecked) delete s.selected[o.value];
                        else s.selected[o.value] = true;
                    });
                    render(key);
                });

                $body.find('.fs-options').on('click', '.fs-row', function () {
                    var s = sections[key];
                    var v = String($(this).data('value'));
                    if (s.selected[v]) delete s.selected[v];
                    else s.selected[v] = true;
                    render(key);
                });

                setOptions(key, options, false);
            }

            function searchTerm(key) {
                return ($('#fsBody_' + key).find('.fs-search-input').val() || '').toLowerCase();
            }

            function visibleOptions(key) {
                var term = searchTerm(key);
                return sections[key].options.filter(function (o) {
                    return !term || o.text.toLowerCase().indexOf(term) !== -1;
                });
            }

            function isDefault(key) {
                var s = sections[key];
                if (!s) return true; // section not initialized yet (init order)
                if (s.options.length === 0) return true;
                return Object.keys(s.selected).length >= s.options.length; // all selected = no filter
            }

            function selectAllMap(options) {
                var m = {};
                options.forEach(function (o) { m[o.value] = true; });
                return m;
            }

            // preserve=true keeps a narrowed selection across reloads (plans
            // when the employer selection changes); the default state stays
            // "everything selected".
            function setOptions(key, options, preserve) {
                var s = sections[key];
                options = (options || []).map(function (o) {
                    return { value: String(o.value), text: String(o.text), dot: o.dot };
                });
                var keepSubset = preserve && s.options.length > 0 && !isDefault(key);
                s.options = options;
                if (keepSubset) {
                    var kept = {};
                    options.forEach(function (o) { if (s.selected[o.value]) kept[o.value] = true; });
                    s.selected = Object.keys(kept).length ? kept : selectAllMap(options);
                } else {
                    s.selected = selectAllMap(options);
                }
                render(key);
            }

            function render(key) {
                var s = sections[key];
                var $body = $('#fsBody_' + key);
                var $list = $body.find('.fs-options').empty();
                var visible = visibleOptions(key);

                if (visible.length === 0) {
                    $list.append($('<div class="fs-empty"></div>').text(s.options.length ? 'No matches' : 'No options'));
                } else {
                    visible.forEach(function (o) {
                        var $row = $('<div class="fs-row"></div>').attr('data-value', o.value);
                        $row.append($('<span class="fs-cb"></span>').addClass(s.selected[o.value] ? 'checked' : ''));
                        if (o.dot) $row.append($('<span class="fs-dot"></span>').addClass(o.dot));
                        $row.append($('<span class="flex-grow-1"></span>').text(o.text));
                        $list.append($row);
                    });
                }

                var checkedVisible = visible.filter(function (o) { return s.selected[o.value]; }).length;
                $body.find('.fs-selectall .fs-cb')
                    .toggleClass('checked', visible.length > 0 && checkedVisible === visible.length)
                    .toggleClass('indet', checkedVisible > 0 && checkedVisible < visible.length);
                $body.find('.fs-matches').text(searchTerm(key) ? visible.length + ' matches' : '');

                var count = Object.keys(s.selected).length;
                var $badge = $('#fsBadge_' + key);
                if (count === 0 && s.options.length > 0) {
                    $badge.addClass('on').text('None'); // active filter: matches nothing
                } else if (isDefault(key)) {
                    $badge.removeClass('on').text('All' + (s.options.length ? ' · ' + s.options.length : ''));
                } else {
                    $badge.addClass('on').text(summary(key));
                }

                updateActiveChips();
            }

            function summary(key) {
                var s = sections[key];
                if (!s) return '';
                var count = Object.keys(s.selected).length;
                if (count === 0) return 'None';
                if (count === 1) {
                    var only = s.options.find(function (o) { return s.selected[o.value]; });
                    if (only) return only.text;
                }
                return count + ' of ' + s.options.length;
            }

            function getValues(key) {
                if (isDefault(key)) return [];
                var vals = Object.keys(sections[key].selected);
                // Nothing selected = match nothing: send an impossible value so
                // the list comes back empty instead of unfiltered.
                return vals.length === 0 ? ['-1'] : vals;
            }

            function reset(key) {
                var s = sections[key];
                s.selected = selectAllMap(s.options);
                $('#fsBody_' + key).find('.fs-search-input').val('');
                render(key);
            }

            function resetAll() {
                Object.keys(sections).forEach(reset);
            }

            function clear(key) {
                var s = sections[key];
                s.selected = {};
                $('#fsBody_' + key).find('.fs-search-input').val('');
                render(key);
            }

            function clearAll() {
                Object.keys(sections).forEach(clear);
            }

            return {
                init: init,
                setOptions: setOptions,
                getValues: getValues,
                isDefault: isDefault,
                summary: summary,
                reset: reset,
                resetAll: resetAll,
                clearAll: clearAll,
                labelOf: function (key) { return sections[key] ? sections[key].label : key; }
            };
        })();

        // Chip row at the top of the sidebar: one chip per non-default filter.
        // (Employer selection shows its own chips under the employer box.)
        function updateActiveChips() {
            var $c = $('#activeFilterChips');
            if ($c.length === 0) return;
            $c.empty();

            ['plan', 'status', 'enrollment', 'flag', 'other'].forEach(function (key) {
                if (!FilterSections.isDefault(key)) {
                    $c.append(makeFilterChip(FilterSections.labelOf(key) + ': ' + FilterSections.summary(key), function () {
                        FilterSections.reset(key);
                    }));
                }
            });
        }

        function makeFilterChip(text, onRemove) {
            var $chip = $('<span class="emp-chip"></span>').text(text);
            $('<span class="emp-chip-remove" title="Clear">&times;</span>').on('click', onRemove).appendTo($chip);
            return $chip;
        }

        function selectAllEmployers() {
            $('#employerListBody .emp-checkbox').prop('checked', true);
            $('#employerListBody .emp-rich-item').addClass('selected');
            $('#selectAllEmp').prop('checked', true);
            updateSelectionUI();
        }

        function clearEmployerSelection() {
            $('#employerListBody .emp-checkbox').prop('checked', false);
            $('#employerListBody .emp-rich-item').removeClass('selected');
            $('#selectAllEmp').prop('checked', false);
            updateSelectionUI();
        }

        function loadEmployers() {
            $.ajax({
                url: '/Employee/drp_employer',
                type: 'GET',
                success: function (data) {
                    var $container = $('#employerListBody');
                    $container.empty();

                    if (Array.isArray(data)) {
                        window.__employerTotal = data.length; // used by badge & chip summaries
                        var allEmployerIds = []; // 🔹 Array to hold all IDs

                        $.each(data, function (index, item) {
                            var id = item.id || item.Id;
                            var name = item.name || item.Name;
                            var isPrimary = item.isPrimary || item.IsPrimary;
                            var initials = item.initials || item.Initials;
                            var colorClass = item.colorClass || item.ColorClass;
                            var cleanName = name.replace(' (Primary)', '').replace(' (Affiliate)', '');

                            var badge = isPrimary
                                ? '<span class="badge bg-label-primary rounded-pill ms-2" style="font-size:0.7rem">Primary</span>'
                                : '';

                            var html = `
                                <div class="emp-rich-item d-flex align-items-center" id="row_${id}" onclick="toggleCheck('${id}')">
                                    <div class="emp-avatar ${colorClass} me-3">${initials}</div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center">
                                            <div class="emp-name text-truncate3" style="max-width: 200px;">${cleanName}</div>
                                            ${badge}
                                        </div>
                                    </div>
                                    <div class="emp-check-circle ms-2"></div>
                                    <input type="checkbox" class="emp-checkbox d-none" value="${id}" data-name="${cleanName}" id="chk_${id}">
                                </div>`;
                            $container.append(html);

                            allEmployerIds.push(id); // 🔹 Add ID to our list
                        });

                        // 🔹 NEW: Select ALL employers by default
                        if(data.length > 0) {
                            allEmployerIds.forEach(id => {
                                $('#chk_' + id).prop('checked', true);
                                $('#row_' + id).addClass('selected');
                            });

                            updateSelectionUI(); // Updates the visual chips
                             // TODO karthi: Employer selection is now populated (#employerFilterIDs set
                            // above). Re-sync the nav list so the "N of M" count reflects the WHOLE
                            // filtered set on FIRST load — the initial syncNavList ran before this async
                            // employer load finished (empty employer filter), so the count would
                            // otherwise stay at the page size (25) until a manual refresh.
                            if (typeof window.syncNavList === 'function') window.syncNavList();

                            // 🔹 Pass a comma-separated list of ALL employer IDs to get all plans
                            loadPlans(allEmployerIds.join(','));
                        }
                    } else {
                        $container.html('<div class="text-center p-3 text-muted">No employers found</div>');
                    }
                }
            });
        }

        function toggleCheck(id) {
            if(event && event.target.type === 'checkbox') return;
            var $chk = $('#chk_' + id);
            var $row = $('#row_' + id);

            var newState = !$chk.prop('checked');
            $chk.prop('checked', newState);

            if(newState) $row.addClass('selected');
            else $row.removeClass('selected');

            updateSelectionUI();
        }
        // ==========================================
        // 7. EMPLOYER SELECTION -> DISPLAY & CHIPS
        // ==========================================
        var isChipsExpanded = false;

        function updateSelectionUI() {
            var selected = [];

            // 1. Gather Data
            $('.emp-checkbox:checked').each(function() {
                selected.push({
                    id: $(this).val(),
                    name: $(this).data('name')
                });
            });

            // 2. Update Controller Input & Sidebar Count
            $('#employerFilterIDs').val(selected.map(s => s.id).join(','));
            $('#selectedCountDisplay').text(selected.length + ' Selected');

            // 3. Update Main Input Text
            var $display = $('#employerDisplay');
            if (selected.length === 0) {
                $display.val('');
                $display.attr('placeholder', 'Select Employers...');
            } else {
                $display.val(selected.length + ' Employer(s) Selected');
            }

            // 4. RENDER CHIPS
            var $container = $('#selectedEmployerChips');
            $container.empty();

            if (selected.length > 0) {
                var limit = 3;
                var countToShow = isChipsExpanded ? selected.length : limit;

                $.each(selected, function(index, item) {
                    if (index < countToShow) {
                        var $chip = $('<span class="emp-chip fade-in"></span>').attr('title', item.name).text(item.name);
                        $('<span class="emp-chip-remove" title="Remove">&times;</span>')
                            .on('click', function () { removeChip(item.id); })
                            .appendTo($chip);
                        $container.append($chip);
                    }
                });

                if (!isChipsExpanded && selected.length > limit) {
                    var remaining = selected.length - limit;
                    $('<span class="emp-chip-more"></span>').text('+' + remaining + ' more')
                        .on('click', function () { isChipsExpanded = true; updateSelectionUI(); })
                        .appendTo($container);
                }

                if (isChipsExpanded && selected.length > limit) {
                    $('<span class="emp-chip-more">Show Less</span>')
                        .on('click', function () { isChipsExpanded = false; updateSelectionUI(); })
                        .appendTo($container);
                }
            }
        }

        function removeChip(id) {
            $('#chk_' + id).prop('checked', false);
            $('#row_' + id).removeClass('selected');
            updateSelectionUI();
        }

        function loadPlans(employerIds) {
            if(!employerIds || employerIds == 0) {
                FilterSections.setOptions('plan', [], false);
                return;
            }
            $.ajax({
                url: '/Employee/drp_plan', type: 'GET', data: { Emp_ID: employerIds },
                success: function (data) {
                    // Endpoint returns [{ value, text }] (camelCase). Be tolerant of
                    // PascalCase too so a serializer change can't silently blank the list.
                    var opts = (Array.isArray(data) ? data : []).map(function (item) {
                        return { value: item.value ?? item.Value, text: item.text ?? item.Text };
                    }).filter(function (o) { return o.value != null; });
                    // Synthetic "No plan" option (-2): employees with no enrollment.
                    // Selected by default, so deselecting a real plan keeps
                    // plan-less employees in the list.
                    opts.unshift({ value: '-2', text: 'No plan' });
                    // preserve=true keeps a narrowed plan selection when employers change
                    FilterSections.setOptions('plan', opts, true);
                },
                error: function (xhr) {
                    console.error('drp_plan failed:', xhr.status, xhr.responseText);
                    FilterSections.setOptions('plan', [], false);
                }
            });
        }

        function loadFlags() {
            $.ajax({
                url: '/Flags/Options', type: 'GET',
                success: function (data) {
                    var opts = (Array.isArray(data) ? data : []).map(function (item) {
                        var sev = (item.severity || '').toLowerCase();
                        var dot = (sev === 'critical' || sev === 'error') ? 'fs-dot-danger'
                                : sev === 'warning' ? 'fs-dot-warning'
                                : 'fs-dot-info';
                        return { value: item.value, text: item.text, dot: dot };
                    });
                    // Synthetic "No flags" option (-2): employees without any flag.
                    // Selected by default, so deselecting a flag keeps clean employees visible.
                    opts.unshift({ value: '-2', text: 'No flags' });
                    FilterSections.setOptions('flag', opts, false);
                }
            });
        }
    </script>
    @if (ViewBag.FocusEmployeeId != null)
    {
        <script>
            // Deep-link from the consent page: once the grid is ready, open this employee in the split panel.
            (function () {
                var fid = '@ViewBag.FocusEmployeeId';
                var tries = 0;
                var timer = setInterval(function () {
                    tries++;
                    if (typeof window.loadEmpDetail === 'function') {
                        clearInterval(timer);
                        try {
                            if (typeof EmployeeState !== 'undefined' && EmployeeState.setEmployeeIdAndSync) EmployeeState.setEmployeeIdAndSync(fid);
                            if (typeof window.highlightListRow === 'function') window.highlightListRow(fid);
                            window.loadEmpDetail(fid);
                        } catch (e) { }
                    }
                    if (tries > 50) clearInterval(timer);
                }, 150);
            })();
        </script>
    }
