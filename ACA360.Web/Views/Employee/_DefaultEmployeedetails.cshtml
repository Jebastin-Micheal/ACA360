<style>
    /* --- Global Styles --- */
    .EmployeeDetailsScrollsize {
        max-height: 300px;
        position: relative;
        overflow: hidden;
        padding-right: 10px;
    }
    /* --- Card & Actions --- */
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
    }


    /* --- Month Card Design (ACA Codes) --- */
    .month-card-container {
        display: flex;
        gap: 10px;
        padding-bottom: 10px;
        overflow-x: auto;
    }


    .month-card {
        min-width: 90px;
        flex: 1;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
        position: relative;
    }


        .month-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }


    .month-card-header {
        background: #f5f5f9;
        padding: 6px;
        text-align: center;
        font-weight: 700;
        color: #566a7f;
        border-bottom: 1px solid #e0e0e0;
        font-size: 0.8rem;
    }


    .month-card-body {
        padding: 8px 4px;
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
        height: 90px;
    }


    /* Status Bars */
    .status-bar-neutral {
        border-bottom: 4px solid #8592a3;
    }


    /* Audit/Timeline Styles */
    .audit-item {
        border-left: 3px solid #d9dee3;
        padding-left: 12px;
        margin-bottom: 14px;
    }


    .audit-system {
        border-color: #8592a3;
    }


    .audit-manual {
        border-color: #696cff;
    }


    .audit-meta {
        font-size: 0.75rem;
        color: #8592a3;
    }

</style>

<div class="row">
    <div class="col-12 mb-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center border-bottom">
                <h5 class="mb-0 text-primary text-uppercase"><i class="bx bx-user me-2"></i>Employee Details</h5>
            </div>
            <div class="card-body mt-3">
                <form class="EmployeeDetailsScrollsize perfectscroller_bottom">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Employer Name</label>
                            <input type="text" class="form-control" placeholder="Employer Name" disabled />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check ms-3">
                                <input class="form-check-input" type="checkbox" disabled>
                                <label class="form-check-label">Corrected Indicator</label>
                            </div>
                        </div>
                        <div class="col-md-4"><label class="form-label">First Name</label><input type="text" class="form-control" disabled /></div>
                        <div class="col-md-4"><label class="form-label">Middle Name</label><input type="text" class="form-control" disabled /></div>
                        <div class="col-md-4"><label class="form-label">Last Name</label><input type="text" class="form-control" disabled /></div>
                        <div class="col-md-4"><label class="form-label">SSN</label><input type="text" class="form-control" disabled /></div>
                        <div class="col-md-4"><label class="form-label">Suffix</label><input type="text" class="form-control" disabled /></div>
                        <div class="col-md-4"><label class="form-label">Date of Birth</label><input type="date" class="form-control" disabled /></div>
                        <div class="col-12"><hr class="my-1"></div>
                        <div class="col-md-12"><label class="form-label">Address 1</label><input type="text" class="form-control" disabled /></div>
                        <div class="col-md-8"><label class="form-label">Address 2</label><input type="text" class="form-control" disabled /></div>
                        <div class="col-md-4"><label class="form-label">City</label><input type="text" class="form-control" disabled /></div>
                        <div class="col-md-4"><label class="form-label">State</label><input type="text" class="form-control" disabled /></div>
                        <div class="col-md-4"><label class="form-label">Zip</label><input type="text" class="form-control" disabled /></div>
                        <div class="col-md-4"><label class="form-label">Country</label><input type="text" class="form-control" disabled /></div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12 mb-4">
        <div class="card">
            <div class="card-header border-bottom py-3">
                <h5 class="mb-0 text-primary">Employee Codes</h5>
            </div>
            <div class="card-body pt-4">
                <div class="month-card-container perfectscroller_left">
                    @foreach (var m in new[] { "JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC" })
                    {
                        <div class="card month-card status-bar-neutral">
                            <div class="month-card-header">@m</div>
                            <div class="month-card-body">
                                <div class="mb-1 fw-bold fs-5">-</div>
                                <div class="mb-1 small text-muted"></div>
                                <div class="fw-semibold text-secondary">-</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 mb-4">
        <div class="card">
            <div class="card-header p-0 mx-3">
                <div class="d-flex justify-content-between align-items-center py-5">
                    <ul class="nav nav-pills nav-fill card-header-tabs" role="tablist">
                        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#def_covered"><i class="bx bx-user-check me-1"></i>Covered Individuals</button></li>
                        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#def_dependents"><i class="bx bx-group me-1"></i>Dependents</button></li>
                    </ul>
                </div>
            </div>
            <div class="card-body pt-4">
                <div class="tab-content p-0">
                    <div class="tab-pane fade show active perfectscroller" id="def_covered" role="tabpanel">
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered text-center ui-table">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>SSN</th>
                                        <th>DOB</th>
                                        <th>All</th>
                                        @foreach (var m in new[] { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" })
                                        {
                                            <th>@m</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr><td colspan="16">No Covered Individuals Found</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="tab-pane fade perfectscroller_dependents" id="def_dependents" role="tabpanel">
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered text-center ui-table">
                                <thead>
                                    <tr>
                                        <th>First Name</th>
                                        <th>Middle</th>
                                        <th>Last Name</th>
                                        <th>Suffix</th>
                                        <th>SSN</th>
                                        <th>DOB</th>
                                        <th>Start Date</th>
                                        <th>End Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr><td colspan="16">No Dependents Found</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card mb-4">
            <div class="card-header p-0 mx-3 py-4">
                <ul class="nav nav-pills nav-fill card-header-tabs" role="tablist">
                    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab_hire"><i class="bx bx-user-plus me-1"></i>Hire Info</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab_status"><i class="bx bx-info-circle me-1"></i>Status</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab_payroll"><i class="bx bx-money me-1"></i>Payroll</button></li>                    
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab_medical"><i class="bx bx-plus-medical me-1"></i>Medical</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab_cobra"><i class="bx bx-shield-plus me-1"></i>COBRA</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab_union"><i class="bx bx-group me-1"></i>Union</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab_retiree"><i class="bx bx-medal me-1"></i>Retiree</button></li>
                </ul>
            </div>
            <div class="card-body pt-4">
                <div class="tab-content p-0">

                    <div class="tab-pane fade show active" id="tab_hire" role="tabpanel">
                        <div class="section-header border-bottom"><h6 class="fw-bold mb-0">Hire History</h6></div>
                        <div class="row g-3 mb-3 p-3 bg-label-secondary rounded dynamic-row">
                            <div class="col-md-6"><label class="form-label small">Hire Date</label><input type="date" class="form-control" disabled /></div>
                            <div class="col-md-6"><label class="form-label small">Termination Date</label><input type="date" class="form-control" disabled /></div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="tab_status" role="tabpanel">
                        <div class="section-header border-bottom"><h6 class="fw-bold mb-0">Status History</h6></div>
                        <div class="row g-3 mb-3 p-3 bg-label-secondary rounded dynamic-row">
                            <div class="col-md-4"><label class="form-label small">Status</label><input type="text" class="form-control" disabled /></div>
                            <div class="col-md-4"><label class="form-label small">Start</label><input type="date" class="form-control" disabled /></div>
                            <div class="col-md-4"><label class="form-label small">End</label><input type="date" class="form-control" disabled /></div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="tab_payroll" role="tabpanel">
                        <div class="section-header border-bottom"><h6 class="fw-bold mb-0">Payroll Details</h6></div>
                        <div class="row g-3 mb-3 p-3 bg-label-secondary rounded dynamic-row align-items-end">
                            <div class="col-md-4"><label class="form-label small">Hourly</label><input type="number" class="form-control"  disabled></div>
                            <div class="col-md-4"><label class="form-label small">Salary</label><input type="number" class="form-control" disabled></div>
                            <div class="col-md-2"><label class="form-label small">Total Hours</label><input type="number" class="form-control" disabled></div>
                            <div class="col-md-2"><label class="form-label small">Additional</label><input type="number" class="form-control" disabled></div>
                            <div class="col-md-6"><label class="form-label small">Start</label><input type="date" class="form-control" disabled></div>
                            <div class="col-md-6"><label class="form-label small">End</label><input type="date" class="form-control" disabled></div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="tab_medical" role="tabpanel">
                        <div class="section-header border-bottom"><h6 class="fw-bold mb-0">Medical Enrollment</h6></div>
                        <div class="row g-3 mb-3 p-3 bg-label-secondary rounded dynamic-row">
                            <div class="col-12"><label class="form-label small">Plan Name</label><input type="text" class="form-control" disabled /></div>
                            <div class="col-6"><label class="form-label small">Offer Date</label><input type="date" class="form-control" disabled /></div>
                            <div class="col-6 d-flex align-items-end"><div class="form-check mx-3"><input type="checkbox" class="form-check-input" disabled /><label class="form-check-label">Enrolled</label></div></div>
                            <div class="col-6"><label class="form-label small">Start Date</label><input type="date" class="form-control" disabled></div>
                            <div class="col-5"><label class="form-label small">End Date</label><input type="date" class="form-control" disabled></div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="tab_cobra" role="tabpanel">
                        <div id="section_cobra">
                            <div class="section-header border-bottom">
                                <h6 class="fw-bold mb-0">COBRA Info</h6>
                            </div>
                            <div class="row g-3 mb-3 p-3 bg-label-secondary rounded dynamic-row">
                                <div class="col-12"><label class="form-label small">Plan Name</label><input type="text" class="form-control" disabled></div>
                                <div class="col-6"><label class="form-label small">Start</label><input type="date" class="form-control" disabled></div>
                                <div class="col-6"><label class="form-label small">End</label><input type="date" class="form-control" disabled></div>
                                <div class="col-12 d-flex align-items-center justify-content-between">
                                    <div class="form-check mx-3"><input class="form-check-input" type="checkbox" disabled><label class="form-check-label">COBRA Enrolled</label></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="tab_union" role="tabpanel">
                        <div id="section_union">
                            <div class="section-header border-bottom">
                                <h6 class="fw-bold mb-0">Union Info</h6>
                            </div>
                            <div class="row g-3 mb-3 p-3 bg-label-secondary rounded dynamic-row">
                                <div class="col-12"><label class="form-label small">Plan Name</label><input type="text" class="form-control" disabled></div>
                                <div class="col-6"><label class="form-label small">Start</label><input type="date" class="form-control" disabled></div>
                                <div class="col-6"><label class="form-label small">End</label><input type="date" class="form-control" disabled></div>
                                <div class="col-12 d-flex align-items-center justify-content-between">
                                    <div class="form-check mx-3"><input class="form-check-input" type="checkbox" disabled><label class="form-check-label">Union Member</label></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="tab_retiree" role="tabpanel">
                        <div id="section_retiree">
                            <div class="section-header border-bottom">
                                <h6 class="fw-bold mb-0">Retiree Info</h6>
                            </div>
                            <div class="row g-3 mb-3 p-3 bg-label-secondary rounded dynamic-row">
                                <div class="col-12"><label class="form-label small">Plan Name</label><input type="text" class="form-control" disabled></div>
                                <div class="col-6"><label class="form-label small">Start</label><input type="date" class="form-control" disabled></div>
                                <div class="col-6"><label class="form-label small">End</label><input type="date" class="form-control" disabled></div>
                                <div class="col-12 d-flex align-items-center justify-content-between">
                                    <div class="form-check mx-3"><input class="form-check-input" type="checkbox" disabled><label class="form-check-label">Retiree</label></div>
                                    <button class="btn btn-danger btn-sm delete-btn d-none" onclick="removeRow(this)"><i class="bx bx-x"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <div class="col-12">
       
            <div class="card">
                <div class="card-header border-bottom py-3">
                    <h5 class="mb-0 text-primary"><i class="bx bx-flag me-2"></i>Flags</h5>
                </div>
            <div class="card-body pt-4">
                <div class="table-responsive">
                    <table class="table table-bordered text-center ui-table">
                        <thead><tr><th>Severity</th><th>Flag</th><th>Category</th><th>Months</th><th>Suggested Fix</th></tr></thead>
                        <tbody><tr><td colspan="5">Select an employee to view flags.</td></tr></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="@(Url.Content("~/assets/vendor/libs/jquery/jquery.js"))"></script>
<script>



    $(document).ready(function() {
        // Initialize PerfectScrollbar for both covered individuals containers
        const coveredContainer = document.querySelector('.perfectscroller .table-responsive');
        const employeeCodeContainer = document.querySelector('.perfectscroller_left');
        const dependentContainer = document.querySelector('.perfectscroller_dependents .table-responsive');
        if (coveredContainer) {
            new PerfectScrollbar(coveredContainer, {
                wheelSpeed: 1,
                wheelPropagation: true,
                suppressScrollY: true, // Disable vertical scrolling
                minScrollbarLength: 20
            });
        }
        if (employeeCodeContainer) {
            new PerfectScrollbar(employeeCodeContainer, {
                wheelSpeed: 1,
                wheelPropagation: true,
                suppressScrollY: true, // Disable vertical scrolling
                minScrollbarLength: 20
            });
        }
        if (dependentContainer) {
            new PerfectScrollbar(dependentContainer, {
                wheelSpeed: 1,
                wheelPropagation: true,
                suppressScrollY: true, // Disable vertical scrolling
                minScrollbarLength: 20
            });
        }
        const employeeContainer = document.querySelector('.perfectscroller_bottom');
        const psEmployee = new PerfectScrollbar(employeeContainer, {
            wheelSpeed: 1,
            wheelPropagation: true,
            suppressScrollX: true, // Disable horizontal scroll
            minScrollbarLength: 20
        });
    });
</script>