@model ACA360.Web.Models.SetNewPasswordViewModel
@{
    ViewBag.Title = "Set New Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ACA360 - Set New Password</title>
    <link rel="stylesheet" href="~/css/material-icons.css">
    <link rel="stylesheet" href="~/css/CommonStyle.css">
    <link rel="stylesheet" href="~/css/fonts.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/css/loginstyle.css" rel="stylesheet" />

    <style>
        .password-requirements {
            font-size: 0.85rem;
            margin-top: 8px;
            padding-left: 5px;
        }

        .requirement {
            display: flex;
            align-items: center;
            margin-bottom: 4px;
            color: #aaa;
            transition: color 0.3s ease;
        }

            .requirement.valid {
                color: #28a745;
            }

            .requirement .material-icons {
                font-size: 16px;
                margin-right: 6px;
            }

        .input-group-text-btn {
            background: transparent;
            border-left: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            color: #6c757d;
        }

        .input-group .form-control {
            border-right: none;
        }

            .input-group .form-control:focus + .input-group-text-btn {
                border-color: #86b7fe;
            }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-form">
            <h1>Welcome to <span class="text-warning">ACA360</span></h1>
            <h5>Please set a new permanent password for your account</h5>


            @if (ViewData["ValidateMessage"] != null)
            {
                <div class="text-warning mt-2 mb-3">@ViewData["ValidateMessage"]</div>
            }

            <!-- Added id="passwordForm" to handle submit validation -->
            <form method="POST" asp-controller="Account" asp-action="SetNewPassword" id="passwordForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Username" />

                <!-- New Password Field -->
                <div class="my-3">
                    <div class="floating-group floating-password">
                        <div class="input-group">
                            <input type="password"
                                   asp-for="NewPassword"
                                   id="NewPassword"
                                   class="form-control"
                                   placeholder="············"
                                   required />
                            <label class="form-label">New Password</label>
                            <span class="input-group-text input-group-text-btn" onclick="togglePassword('NewPassword', 'eyeIcon1')">
                                <span class="material-icons" id="eyeIcon1">visibility</span>
                            </span>
                        </div>
                    </div>

                    <span asp-validation-for="NewPassword" class="text-warning small"></span>

                    <!-- Live Password Requirements Checklist -->
                    @{
                        var policy = ViewBag.PasswordPolicy as ACA360.Core.Models.SecuritySettingsDto
                        ?? new ACA360.Core.Models.SecuritySettingsDto();
                    }
                    <div class="password-requirements text-start">
                        <div id="req-length" class="requirement" data-min="@policy.MinPasswordLength">
                            <span class="material-icons">cancel</span> Minimum @policy.MinPasswordLength characters
                        </div>
                        @if (policy.RequireDigits)
                        {
                            <div id="req-number" class="requirement">
                                <span class="material-icons">cancel</span> At least 1 number (0-9)
                            </div>
                        }
                        @if (policy.RequireUppercase)
                        {
                            <div id="req-upper" class="requirement">
                                <span class="material-icons">cancel</span> At least 1 uppercase letter
                            </div>
                        }
                    </div>
                </div>

                <!-- Confirm Password Field -->
                <div class="mb-3">
                    <div class="floating-group floating-password">
                        <div class="input-group">
                            <input type="password"
                                   asp-for="ConfirmPassword"
                                   id="ConfirmPassword"
                                   class="form-control"
                                   placeholder="············"
                                   required />
                            <label class="form-label">Confirm Password</label>
                            <span class="input-group-text input-group-text-btn" onclick="togglePassword('ConfirmPassword', 'eyeIcon2')">
                                <span class="material-icons" id="eyeIcon2">visibility</span>
                            </span>
                        </div>
                    </div>




                    <span asp-validation-for="ConfirmPassword" class="text-warning small"></span>
                </div>

                <!-- Added id="submitBtn" to control enable/disable feature -->
                <button type="submit" id="submitBtn" class="btn css-rsbo1m w-100 mb-2" disabled>
                    <span class="material-icons">lock_reset</span>&nbsp Set Password
                </button>
                <div class="text-white text-center mt-2">
                    <a asp-controller="Account" asp-action="Login" class="text-light text-decoration-underline">
                        Back to Login
                    </a>
                </div>
            </form>
        </div>
        <div class="right-image d-none d-md-block"></div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function togglePassword(inputId, iconId) {
            const passwordInput = document.getElementById(inputId);
            const eyeIcon = document.getElementById(iconId);

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                eyeIcon.innerText = "visibility_off";
            } else {
                passwordInput.type = "password";
                eyeIcon.innerText = "visibility";
            }
        }

        const passwordInput = document.getElementById('NewPassword');
        const confirmInput = document.getElementById('ConfirmPassword');
        const submitBtn = document.getElementById('submitBtn');

        const reqLength = document.getElementById('req-length');
        const reqNumber = document.getElementById('req-number');
        const reqUpper = document.getElementById('req-upper');

        const minLength = reqLength ? parseInt(reqLength.getAttribute('data-min'), 10) || 6 : 6;

        function validatePasswordForm() {
            const value = passwordInput.value;
            const confirmValue = confirmInput.value;

            const isLengthValid = value.length >= minLength;
            const isNumberValid = reqNumber ? /\d/.test(value) : true;
            const isUpperValid = reqUpper ? /[A-Z]/.test(value) : true;
            const doPasswordsMatch = (value === confirmValue) && value !== "";

            updateRequirement(reqLength, isLengthValid);
            if (reqNumber) updateRequirement(reqNumber, isNumberValid);
            if (reqUpper) updateRequirement(reqUpper, isUpperValid);

            if (isLengthValid && isNumberValid && isUpperValid && doPasswordsMatch) {
                submitBtn.disabled = false;
            } else {
                submitBtn.disabled = true;
            }
        }

        function updateRequirement(element, isValid) {
            const icon = element.querySelector('.material-icons');
            if (isValid) {
                element.classList.add('valid');
                icon.innerText = 'check_circle';
            } else {
                element.classList.remove('valid');
                icon.innerText = 'cancel';
            }
        }

        // Event listeners to trigger check on typing
        passwordInput.addEventListener('input', validatePasswordForm);
        confirmInput.addEventListener('input', validatePasswordForm);
    </script>
</body>
</html>