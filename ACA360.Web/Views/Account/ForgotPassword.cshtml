@{
    ViewBag.Title = "Forgot Password";
    Layout = null;
    var supportEmail = ViewBag.SupportEmail as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ACA360 Forgot Password</title>
    <partial name="_PwaHead" />
    <link rel="stylesheet" href="~/css/material-icons.css">
    <link rel="stylesheet" href="~/css/CommonStyle.css">
    <link rel="stylesheet" href="~/css/fonts.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link href="~/css/loginstyle.css" rel="stylesheet" />
</head>
<body>

    <div class="login-container">
        <div class="login-form">
            <h1>Forgot your <span class="text-warning">password?</span></h1>
            <h5>Your ACA360 administrator can reset it for you.</h5>
            </br>

            <p>
                Ask your administrator to set a new password for your account in
                <strong>User Accounts</strong>. You'll get a temporary password and be
                asked to choose a new one the next time you log in.
            </p>

            @if (!string.IsNullOrWhiteSpace(supportEmail))
            {
                <p>
                    Contact:
                    <a href="mailto:@supportEmail?subject=ACA360%20password%20reset">@supportEmail</a>
                </p>
            }

            <a asp-controller="Account" asp-action="Login" class="btn css-rsbo1m w-100 mt-3">
                <span class="material-icons">arrow_back</span>&nbsp; Back to login
            </a>
        </div>

        <div class="right-image d-none d-md-block"></div>
    </div>

</body>
</html>
