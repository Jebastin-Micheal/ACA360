@using ACA360.Core.Extensions
@using ACA360.Web.ViewComponents
@model ACA360.Core.Models.UserProfileViewModel

@{
    ViewData["Title"] = "Executive Profile View";
    // Dynamically determine the color classes based on the health score
    string healthTextClass = Model.ProfileHealthPercentage <= 40 ? "text-danger" :
                            (Model.ProfileHealthPercentage <= 75 ? "text-warning" : "text-success");

    string healthBgClass = Model.ProfileHealthPercentage <= 40 ? "bg-danger" :
                          (Model.ProfileHealthPercentage <= 75 ? "bg-warning" : "bg-success");
}
@await Component.InvokeAsync("Breadcrumb", new {
pageTitle = "Executive Profile View",
    items = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "Home", Url = Url.Action("Index", "Home"), IsActive = false },
        new BreadcrumbItem { Title = "My Profile", Url = "", IsActive = true }
    }
})

<div class="card">

    <div class="bg-primary rounded-3 px-4 py-5 mb-4 shadow position-relative overflow-hidden" style="min-height: 240px;">
        <div class="position-absolute top-0 end-0 opacity-25" style="width: 300px; height: 300px; background: radial-gradient(circle, rgba(255,255,255,0.8) 0%, transparent 70%); transform: translate(30%, -30%);"></div>
        <div class="position-absolute bottom-0 start-0 opacity-25" style="width: 200px; height: 200px; background: radial-gradient(circle, rgba(255,255,255,0.6) 0%, transparent 70%); transform: translate(-20%, 20%);"></div>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center position-relative zindex-1">
            <div>
                <span class="badge bg-white text-primary fw-bold rounded-pill px-3 py-1 mb-2 shadow-sm"><i class="bx bx-check-shield me-1"></i> System Verified</span>
                <h2 class="text-white fw-bolder mb-0">Executive Directory</h2>
                <p class="text-white-50 fs-6 mt-1 mb-0">Comprehensive identity and access overview.</p>
            </div>
        </div>
    </div>

    <div class="row g-4" style="margin-top: -120px; position: relative; z-index: 2;">

        <div class="col-xl-4 col-lg-5 col-md-5">
            <div class="card h-100 shadow-lg border-0">
                <div class="card-body text-center pt-5 pb-4">

                    <div class="avatar avatar-xl mx-auto mb-4 position-relative" style="width: 150px; height: 150px;">
                        <div class="position-absolute w-100 h-100 rounded-circle border border-primary opacity-25" style="padding: 10px; top: -10px; left: -10px; width: calc(100% + 20px) !important; height: calc(100% + 20px) !important;"></div>
                        <img src="@(string.IsNullOrEmpty(Model.ProfilePicture) ? "/assets/img/avatars/1.png" : Model.ProfilePicture)"
                             alt="user-avatar"
                             class="rounded-circle border border-4 border-white shadow-sm"
                             style="object-fit: cover; width: 100%; height: 100%;" />
                    </div>

                    <h3 class="mb-1 fw-black text-dark">@Model.FirstName @Model.LastName</h3>
                    <p class="text-primary fw-medium mb-3 fs-6">@Model.Profile_Name</p>

                    <div class="d-inline-flex align-items-center bg-dark text-white px-4 py-2 rounded-pill fw-bold mb-4 shadow-sm">
                        <i class="bx bx-star text-warning me-2 fs-5"></i> @Model.RoleName
                    </div>

                    <div class="text-start bg-label-secondary rounded-3 p-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="fw-bold text-dark text-uppercase">Profile Health</small>
                            <small class="fw-bold @healthTextClass">@Model.ProfileHealthPercentage%</small>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar @healthBgClass shadow-none"
                                 role="progressbar"
                                 style="width: @Model.ProfileHealthPercentage%"
                                 aria-valuenow="@Model.ProfileHealthPercentage"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                            </div>
                        </div>
                    </div>

                    <div class="bg-label-primary rounded-3 p-3 text-start">
                        <small class="text-primary text-uppercase fw-bold ls-1 d-block mb-3 border-bottom border-primary pb-2 opacity-75">System Identifiers</small>

                        <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-2 rounded shadow-sm">
                            <span class="text-dark fw-medium"><i class="bx bx-fingerprint text-primary me-2"></i>User Name</span>
                            <span class="badge bg-primary bg-opacity-10 text-primary fw-bold fs-6">@Model.FirstName @Model.LastName</span>
                        </div>

                         <div class="d-flex justify-content-between align-items-center bg-white p-2 rounded shadow-sm">
                            <span class="text-dark fw-medium"><i class="bx bx-barcode-reader text-primary me-2"></i>User Role</span>
                            <span class="badge bg-primary bg-opacity-10 text-primary fw-bold fs-6">@(Model.RoleName)</span>
                        </div> 
                    </div>

                </div>
            </div>
        </div>

        <div class="col-xl-8 col-lg-7 col-md-7">

            <div class="bg-label-info rounded-4 p-4 mb-4 shadow-sm">
                <h5 class="fw-bold mb-3 text-info"><i class="bx bx-id-card me-2 fs-4"></i> Identity Overview</h5>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="bg-white rounded-3 p-3 h-100 shadow-sm border-start border-4 border-info d-flex align-items-center">
                            <i class="bx bx-user-circle text-info fs-1 me-3 opacity-50"></i>
                            <div>
                                <small class="text-muted text-uppercase fw-bold ls-1">First Name</small>
                                <h5 class="mb-0 text-dark fw-bolder mt-1">@(string.IsNullOrEmpty(Model.FirstName) ? "—" : Model.FirstName)</h5>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="bg-white rounded-3 p-3 h-100 shadow-sm border-start border-4 border-info d-flex align-items-center">
                            <i class="bx bx-user-check text-info fs-1 me-3 opacity-50"></i>
                            <div>
                                <small class="text-muted text-uppercase fw-bold ls-1">Last Name</small>
                                <h5 class="mb-0 text-dark fw-bolder mt-1">@(string.IsNullOrEmpty(Model.LastName) ? "—" : Model.LastName)</h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-label-success rounded-4 p-4 mb-4 shadow-sm">
                <h5 class="fw-bold mb-3 text-success"><i class="bx bx-network-chart me-2 fs-4"></i> Contact Network</h5>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="bg-white rounded-3 p-3 h-100 shadow-sm border-start border-4 border-success">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <small class="text-muted text-uppercase fw-bold ls-1">Primary Email</small>
                                <span class="badge bg-label-success rounded-pill"><i class="bx bx-check"></i> Verified</span>
                            </div>
                            <h5 class="mb-0 text-dark fw-bolder" title="@Model.Email">
                                <i class="bx bx-envelope text-success me-1"></i> @(string.IsNullOrEmpty(Model.Email) ? "Not Provided" : Model.Email)
                            </h5>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="bg-white rounded-3 p-3 h-100 shadow-sm border-start border-4 border-success">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <small class="text-muted text-uppercase fw-bold ls-1">Direct Phone</small>
                                <span class="badge bg-label-success rounded-pill"><i class="bx bx-check"></i> Verified</span>
                            </div>
                            <h5 class="mb-0 text-dark fw-bolder">
                                <i class="bx bx-phone-call text-success me-1"></i> @(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not Provided" : Model.PhoneNumber)
                            </h5>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-label-warning rounded-4 p-4 shadow-sm">
                <h5 class="fw-bold mb-3 text-warning"><i class="bx bx-map-alt me-2 fs-4"></i> Geographic Location</h5>
                <div class="bg-white rounded-3 p-4 shadow-sm">

                    <div class="d-flex align-items-start mb-4 border-bottom border-warning pb-4">
                        <div class="avatar avatar-lg me-4">
                            <span class="avatar-initial rounded bg-label-warning text-warning"><i class="bx bx-building-house fs-3"></i></span>
                        </div>
                        <div>
                            <small class="text-muted text-uppercase fw-bold ls-1">Registered Street Address</small>
                            <h4 class="mb-0 text-dark fw-bolder mt-1">@(string.IsNullOrEmpty(Model.Address1) ? "—" : Model.Address1)</h4>
                        </div>
                    </div>

                    <div class="row g-4 text-center">
                        <div class="col-sm-4 border-end">
                            <small class="text-muted text-uppercase fw-bold ls-1 d-block mb-1">City</small>
                            <h5 class="mb-0 text-dark fw-bolder">@(string.IsNullOrEmpty(Model.City) ? "—" : Model.City)</h5>
                        </div>
                        <div class="col-sm-4 border-end">
                            <small class="text-muted text-uppercase fw-bold ls-1 d-block mb-1">State / Region</small>
                            <h5 class="mb-0 text-dark fw-bolder">@(string.IsNullOrEmpty(Model.State) ? "—" : Model.State)</h5>
                        </div>
                        <div class="col-sm-4">
                            <small class="text-muted text-uppercase fw-bold ls-1 d-block mb-1">Postal Code</small>
                            <h5 class="mb-0 text-dark fw-bolder">@(string.IsNullOrEmpty(Model.ZipCode) ? "—" : Model.ZipCode)</h5>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>